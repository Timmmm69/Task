<UserControl x:Class="Task.Desktop.Views.PersonalRemindersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/><Style.Triggers><DataTrigger Binding="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Task.WindowWidthAtLeastConverter},ConverterParameter=650}" Value="False"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style><Grid Margin="20" MinHeight="520">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Напоминания и события" Style="{StaticResource Task.State.Title}"/><Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"/></Grid>
  <StackPanel Grid.Row="1" Margin="0,0,0,14">
   <Border Style="{StaticResource Task.State.Inline}"><TextBlock Text="Напоминания приходят, пока Task работает. Работа в фоне доступна в настройках." Style="{StaticResource Task.State.Body}"/></Border>
   <Expander Header="Новое напоминание" state:ViewState.Section="personal-reminders/v1/create" Margin="0,14,0,0" IsExpanded="False"><ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Task.Inspector.Panel}" Margin="0,8,0,0"><StackPanel>
    <WrapPanel><StackPanel Width="280" Margin="0,0,12,0"><TextBlock Text="Задача или событие" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="Title" AutomationProperties.AutomationId="PersonalReminderTarget"/></StackPanel><StackPanel Width="180"><TextBlock Text="Когда напомнить" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding Triggers}" SelectedItem="{Binding Trigger}" DisplayMemberPath="Name"/></StackPanel></WrapPanel>
    <WrapPanel><StackPanel Width="100" Margin="0,0,12,0" Visibility="{Binding IsRelativeReminder,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="За минут" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding OffsetMinutes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="240" Visibility="{Binding IsAbsoluteReminder,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="Дата и время" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding AbsoluteTime,UpdateSourceTrigger=PropertyChanged}" ToolTip="ДД.ММ.ГГГГ ЧЧ:ММ · местное время"/><TextBlock Text="ДД.ММ.ГГГГ ЧЧ:ММ" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,4,0,0"/></StackPanel><Button Content="Добавить напоминание" Command="{Binding AddReminderCommand}" Style="{StaticResource Task.Button.Primary}" VerticalAlignment="Bottom" Margin="12,12,0,0" AutomationProperties.AutomationId="PersonalAddReminder"/></WrapPanel>
   </StackPanel></Border></ScrollViewer></Expander>
  </StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Напоминания" Style="{StaticResource Task.State.Title}" Margin="0,0,0,12"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Task.DataList.Item}" AutomationProperties.Name="Напоминания" AutomationProperties.AutomationId="PersonalRemindersList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,12"><TextBlock Text="{Binding Title}" Style="{StaticResource Task.Table.TitleText}" TextWrapping="Wrap"/><TextBlock Text="{Binding DueText}" Style="{StaticResource Task.State.Body}" Margin="0,4,0,0"/><TextBlock Text="{Binding State}" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="1"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Reminders.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><TextBlock Text="Напоминаний пока нет" Style="{StaticResource Task.State.Title}"/><TextBlock Text="Добавьте напоминание о задаче или событии." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0"/></StackPanel></Border>
    <Button Grid.Row="2" Content="Отменить напоминание" Command="{Binding CancelReminderCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Центр уведомлений" Style="{StaticResource Task.State.Title}" Margin="0,0,0,12"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}" SelectedItem="{Binding SelectedNotification}" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Task.DataList.Item}" AutomationProperties.Name="Уведомления" AutomationProperties.AutomationId="PersonalNotificationsList"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource Task.Icon.Notifications}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Style="{StaticResource Task.Table.TitleText}" TextWrapping="Wrap"/><TextBlock Text="{Binding DeliveredText}" Style="{StaticResource Task.State.Body}" Margin="0,4,0,0"/><TextBlock Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Task.Inspector.FactLabel}"><Setter Property="Text" Value="Новое"/><Style.Triggers><DataTrigger Binding="{Binding IsRead}" Value="True"><Setter Property="Text" Value="Прочитано"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="1"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Notifications.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><Path Data="{StaticResource Task.Icon.Notifications}" Width="30" Height="30" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}" HorizontalAlignment="Left"/><TextBlock Text="Новых уведомлений нет" Style="{StaticResource Task.State.Title}" Margin="0,12,0,0"/><TextBlock Text="События и напоминания появятся здесь." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0"/></StackPanel></Border>
    <Button Grid.Row="2" Content="Отметить прочитанным" Command="{Binding ReadNotificationCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource Personal.Feedback}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
 </Grid>
</ScrollViewer></UserControl>
