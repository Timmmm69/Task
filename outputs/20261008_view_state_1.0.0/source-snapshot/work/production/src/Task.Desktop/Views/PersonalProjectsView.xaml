<UserControl x:Class="Task.Desktop.Views.PersonalProjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Личные проекты" Style="{StaticResource Task.State.Title}"/><TextBlock Text="Объединяйте задачи и материалы проекта." Style="{StaticResource Task.State.Body}" Margin="0,4,12,0"/></StackPanel>
   <WrapPanel Grid.Column="1"><Button Content="Изменить" Command="{Binding EditProjectCommand}" Margin="0,0,8,0"/><Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/><Button Content="Новый проект" Command="{Binding NewProjectCommand}" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalNewProject"/></WrapPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid>
    <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Task.DataList.Item}" AutomationProperties.Name="Личные проекты" AutomationProperties.AutomationId="PersonalProjectsList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,12"><TextBlock Text="{Binding Name}" Style="{StaticResource Task.Table.TitleText}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource Task.State.Body}" Margin="0,4,0,0"/><TextBlock Text="{Binding LifecycleText}" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><TextBlock Text="Проектов пока нет" Style="{StaticResource Task.State.Title}"/><TextBlock Text="Создайте проект, чтобы собрать задачи вместе." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Column="2">
    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.Inspector.Panel}"><Style.Triggers><DataTrigger Binding="{Binding IsProjectEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding SelectedProject.Name,TargetNullValue=Выберите проект,FallbackValue=Выберите проект}" Style="{StaticResource Task.State.Title}"/><TextBlock Text="{Binding SelectedProject.Description}" Style="{StaticResource Task.State.Body}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedProject.StatusText}" Margin="0,12,0,0"/><TextBlock Text="{Binding SelectedProject.LifecycleText}" Style="{StaticResource Task.State.Body}"/></StackPanel></Border>
    <Border Style="{StaticResource Task.Inspector.Panel}" Padding="0" Visibility="{Binding IsProjectEditing,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Проект" Style="{StaticResource Task.State.Title}" Margin="20,18"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,0,20,20">
       <TextBlock Text="Название" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding ProjectName,UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Название проекта" AutomationProperties.AutomationId="PersonalProjectName"/>
       <TextBlock Text="Описание" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding ProjectDescription,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="Описание проекта"/>
       <TextBlock Text="Статус" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding StatusChoices}" SelectedValue="{Binding ProjectStatus}" SelectedValuePath="Value" DisplayMemberPath="Name"/>
       <WrapPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Начало" Style="{StaticResource Personal.Label}"/><DatePicker SelectedDate="{Binding StartDate}" MinHeight="36"/></StackPanel><StackPanel><TextBlock Text="Плановое окончание" Style="{StaticResource Personal.Label}"/><DatePicker SelectedDate="{Binding EndDate}" MinHeight="36"/></StackPanel></WrapPanel>
       <Expander Header="Хранение проекта" state:ViewState.Section="personal-projects/v1/storage" Margin="0,18,0,0"><StackPanel><TextBlock Text="Состояние" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding LifecycleChoices}" SelectedValue="{Binding Lifecycle}" SelectedValuePath="Value" DisplayMemberPath="Name"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
      <Border Grid.Row="2" Padding="20,14" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,1,0,0"><WrapPanel HorizontalAlignment="Right"><Button Content="Отменить" Click="OnCancel" Margin="0,0,8,0"/><Button Content="Сохранить" Click="OnSave" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalSaveProject"/></WrapPanel></Border>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Personal.Feedback}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
 </Grid>
</UserControl>
