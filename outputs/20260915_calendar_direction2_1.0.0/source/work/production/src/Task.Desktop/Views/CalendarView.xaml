<UserControl x:Class="Task.Desktop.Views.CalendarView"
             x:Name="CalendarRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Task.Desktop.Views"
             xmlns:vm="clr-namespace:Task.Desktop.ViewModels"
             AutomationProperties.Name="Календарь"
             AutomationProperties.AutomationId="CalendarScreen"
             PreviewKeyDown="OnCalendarPreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="Calendar.ModeButton" TargetType="Button" BasedOn="{StaticResource Task.Button.Secondary}">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="Calendar.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Metadata}" />
            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Calendar.Card" TargetType="Button" BasedOn="{StaticResource Task.Button.Base}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Primary}" />
            <Setter Property="ToolTip" Value="{Binding Item.AutomationName}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Item.IsHighPriority}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.CriticalSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.HasConflict}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Warning}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Strong}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,14,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Календарь"
                           FontSize="{DynamicResource Task.Font.Size.PageTitle}"
                           FontWeight="{DynamicResource Task.Font.Weight.Semibold}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding WeekRangeText}" FontSize="{DynamicResource Task.Font.Size.Label}"
                               Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="CalendarWeekRange" />
                    <TextBlock Text=" · " Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding TimeZoneText}" FontSize="{DynamicResource Task.Font.Size.Label}"
                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="День" Command="{Binding DayModeCommand}"
                        AutomationProperties.Name="Режим дня">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Calendar.ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:CalendarViewMode.Day}">
                                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Primary}" />
                                    <Setter Property="FontWeight" Value="{DynamicResource Task.Font.Weight.Semibold}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Неделя" Command="{Binding WeekModeCommand}" AutomationProperties.Name="Режим недели">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Calendar.ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:CalendarViewMode.Week}">
                                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Primary}" />
                                    <Setter Property="FontWeight" Value="{DynamicResource Task.Font.Weight.Semibold}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Месяц" Command="{Binding MonthModeCommand}" AutomationProperties.Name="Режим месяца">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Calendar.ModeButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:CalendarViewMode.Month}">
                                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Primary}" />
                                    <Setter Property="FontWeight" Value="{DynamicResource Task.Font.Weight.Semibold}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <WrapPanel x:Name="CalendarToolbar" Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center"
                   AutomationProperties.Name="Команды календаря"
                   AutomationProperties.AutomationId="CalendarCommandBar">
            <Button Content="Назад" Command="{Binding PreviousWeekCommand}" Style="{StaticResource Task.Button.Secondary}"
                    Margin="0,0,6,0" AutomationProperties.Name="Предыдущий период" />
            <Button Content="Сегодня" Command="{Binding TodayCommand}" Style="{StaticResource Task.Button.Secondary}"
                    Margin="0,0,6,0" AutomationProperties.Name="Вернуться к текущей дате" />
            <Button Content="Вперёд" Command="{Binding NextWeekCommand}" Style="{StaticResource Task.Button.Secondary}"
                    Margin="0,0,12,0" AutomationProperties.Name="Следующий период" />
            <DatePicker x:Name="CalendarDatePicker" SelectedDate="{Binding SelectedDate}" MinWidth="132" Height="40"
                        Margin="0,0,6,0" AutomationProperties.Name="Дата календаря" />
            <Button Command="{Binding RefreshCommand}" Style="{StaticResource Task.Button.Icon}" Margin="0,0,12,0"
                    AutomationProperties.Name="Обновить календарь" AutomationProperties.AutomationId="CalendarRefresh">
                <Path Data="{DynamicResource Task.Icon.Refresh}" Width="18" Height="18" Stretch="Uniform"
                      Fill="{DynamicResource Task.Brush.Text.Primary}" />
            </Button>
            <Button Command="{Binding NewEventCommand}" Style="{StaticResource Task.Button.Primary}"
                    AutomationProperties.Name="Создать событие календаря" AutomationProperties.AutomationId="CalendarNewEvent">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource Task.Icon.Add}" Width="17" Height="17" Stretch="Uniform"
                          Fill="White" Margin="0,0,8,0" />
                    <TextBlock Text="Новое событие" />
                </StackPanel>
            </Button>
            <Button Content="Повторения" Command="{Binding Recurrence.OpenCommand}" Style="{StaticResource Task.Button.Secondary}"
                    Margin="6,0,0,0" AutomationProperties.Name="Повторяющиеся задачи" />
        </WrapPanel>

        <StackPanel Grid.Row="2">
            <Border Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowReadOnlyState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Path Data="{DynamicResource Task.Icon.Lock}" Width="18" Height="18" Stretch="Uniform"
                          Fill="{DynamicResource Task.Brush.Text.Secondary}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Только чтение" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="CalendarReadOnlyBanner" />
                        <TextBlock Text="{Binding WriteAccessText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.WarningSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Warning}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRollback}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding RollbackMessage}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.AutomationId="CalendarRollbackBanner" />
            </Border>
            <Border Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.CriticalSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowStateBanner}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Data="{DynamicResource Task.Icon.Error}" Width="18" Height="18" Stretch="Uniform"
                          Fill="{DynamicResource Task.Brush.Semantic.Critical}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StateTitle}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                   AutomationProperties.LiveSetting="Assertive"
                                   AutomationProperties.AutomationId="CalendarStateBanner" />
                        <TextBlock Text="{Binding StateDescription}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Повторить" Command="{Binding RefreshCommand}"
                            Style="{StaticResource Task.Button.Secondary}" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1"
                    CornerRadius="{DynamicResource Task.Radius.Window}" ClipToBounds="True"
                    Background="{DynamicResource Task.Brush.Surface.Base}">
                <Grid>
                    <ScrollViewer x:Name="CalendarHorizontalScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid Width="{Binding ActualWidth, ElementName=CalendarHorizontalScroll}" MinWidth="1060">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimelineMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="62" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Task.Brush.Surface.Subtle}"
                                    BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1" />
                            <TextBlock Grid.Row="0" Text="Время" Width="72" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding Days}" Margin="72,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding DataContext.CalendarColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1,0,0,0"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayName}" TextAlignment="Center"
                                                           TextOptions.TextFormattingMode="Display"
                                                           Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                                                <Border Padding="7,3" Margin="0,3,0,0" CornerRadius="12">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Primary}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DayNumberText}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Task.Brush.Surface.Subtle}"
                                        BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Весь день" Margin="8" TextWrapping="Wrap"
                                               FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                                </Border>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}" MinHeight="42">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding DataContext.CalendarColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,1,1" Padding="3">
                                                <ItemsControl ItemsSource="{Binding AllDayItems}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource Task.Button.Secondary}"
                                                                    MinHeight="30" Padding="6,3" Margin="0,0,0,3"
                                                                    HorizontalContentAlignment="Left"
                                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                                    AutomationProperties.AutomationId="CalendarAllDayItem">
                                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding AutomationName}" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <ScrollViewer x:Name="CalendarTimelineScroll" Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="True" AutomationProperties.Name="Недельная временная сетка"
                                          AutomationProperties.AutomationId="CalendarTimeline">
                                <Grid x:Name="CalendarTimelineHost" Height="{Binding TimelineCanvasHeight}">
                                    <ItemsControl ItemsSource="{Binding HourMarkers}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Top}" /></Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="{Binding ActualWidth, ElementName=CalendarTimelineHost}" Height="69">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Margin="0,8,10,0" TextAlignment="Right"
                                                               FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                                                    <Border Grid.Column="1" BorderBrush="{DynamicResource Task.Brush.Border.Default}"
                                                            BorderThickness="0,1,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Days}" Margin="72,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.CalendarColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="{Binding DataContext.TimelineCanvasHeight, ElementName=CalendarRoot}">
                                                    <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,1,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="#33EAF3FF" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Canvas IsHitTestVisible="False" Panel.ZIndex="8">
                                                        <Grid Height="20" Canvas.Top="{Binding CurrentTimeTop}"
                                                              Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                              AutomationProperties.Name="{Binding CurrentTimeText, StringFormat='Текущее время {0}'}">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowCurrentTime}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid Margin="0,8,0,0">
                                                                <Ellipse Width="8" Height="8" HorizontalAlignment="Left" Margin="-4,-3,0,0"
                                                                         Fill="{DynamicResource Task.Brush.Semantic.Critical}" />
                                                                <Border Height="2" Background="{DynamicResource Task.Brush.Semantic.Critical}" />
                                                            </Grid>
                                                        </Grid>
                                                    </Canvas>
                                                    <ItemsControl ItemsSource="{Binding TimelineItems}" Panel.ZIndex="10">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Top" Value="{Binding TimelineTop}" />
                                                                <Setter Property="Height" Value="{Binding TimelineHeight}" />
                                                                <Setter Property="Canvas.Left">
                                                                    <Setter.Value>
                                                                        <MultiBinding Converter="{StaticResource Task.CalendarLaneLeftConverter}">
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                            <Binding Path="TimelineLane" />
                                                                            <Binding Path="TimelineLaneCount" />
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Width">
                                                                    <Setter.Value>
                                                                        <MultiBinding Converter="{StaticResource Task.CalendarLaneWidthConverter}">
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                            <Binding Path="TimelineLaneCount" />
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding Item}"
                                                                        Style="{StaticResource Calendar.Card}"
                                                                        AutomationProperties.Name="{Binding Item.AutomationName}"
                                                                        AutomationProperties.ItemStatus="{Binding Item.ConflictText}"
                                                                        AutomationProperties.AutomationId="CalendarTimelineItem">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                                        <TextBlock Text="{Binding Item.Title}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                                                                   FontSize="{DynamicResource Task.Font.Size.Label}"
                                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"
                                                                                   ToolTip="{Binding Item.Title}" />
                                                                        <TextBlock Grid.Row="1" Text="{Binding Item.TimeText}"
                                                                                   FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                                                                   Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Row="2" Text="{Binding Item.ConflictText}"
                                                                                   FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                                                                   Foreground="{DynamicResource Task.Brush.Semantic.Critical}"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.ConflictText}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Item.HasConflict}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="132" Padding="8" BorderBrush="{DynamicResource Task.Brush.Border.Default}"
                                            BorderThickness="0,0,1,1" AutomationProperties.Name="{Binding AutomationName}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.55" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource Task.Button.Secondary}"
                                                                MinHeight="28" Padding="5,2" Margin="0,0,0,3"
                                                                HorizontalContentAlignment="Left"
                                                                AutomationProperties.Name="{Binding AutomationName}">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AutomationName}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Background="#F4FFFFFF" Panel.ZIndex="30">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowInitialLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Style="{StaticResource Task.Progress.Indeterminate}" IsIndeterminate="True" />
                            <TextBlock Text="Загрузка расписания…" TextAlignment="Center" Margin="0,14,0,0"
                                       FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="CalendarLoadingState" />
                            <TextBlock Text="Готовим неделю и сохраняем размеры сетки."
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>

                    <Border Background="#F4FFFFFF" Panel.ZIndex="29">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{DynamicResource Task.Icon.Calendar}" Width="32" Height="32" Stretch="Uniform"
                                  Fill="{DynamicResource Task.Brush.Text.Secondary}" HorizontalAlignment="Center" />
                            <TextBlock Text="В этом периоде пока нет записей" FontSize="{DynamicResource Task.Font.Size.Section}"
                                       FontWeight="{DynamicResource Task.Font.Weight.Semibold}" TextAlignment="Center" Margin="0,12,0,0"
                                       AutomationProperties.AutomationId="CalendarEmptyState" />
                            <TextBlock Text="Создайте событие или выберите другой период."
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,12" />
                            <Button Content="Новое событие" Command="{Binding NewEventCommand}"
                                    Style="{StaticResource Task.Button.Primary}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <GroupBox x:Name="CalendarInspector" Grid.Row="4"
                  Margin="0,12,0,0" MaxHeight="150"
                  AutomationProperties.Name="Инспектор выбранного элемента"
                  AutomationProperties.AutomationId="CalendarSelectionInspector">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border Style="{StaticResource Task.Inspector.Panel}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedItem}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel DataContext="{Binding SelectedItem}">
                    <TextBlock Text="{Binding TypeText}" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Task.Font.Size.Section}"
                               FontWeight="{DynamicResource Task.Font.Weight.Semibold}" TextWrapping="Wrap" Margin="0,2,0,4" />
                    <WrapPanel>
                        <TextBlock Text="{Binding TimeText}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding StatusText}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding PriorityText}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding ConflictText}" Foreground="{DynamicResource Task.Brush.Semantic.Critical}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Description, TargetNullValue=Описание не добавлено.}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Margin="0,5,0,0"
                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="CalendarEditEventButton" Content="Изменить событие" Command="{Binding EditEventCommand}"
                            Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="CalendarEditEvent" />
                    <Button Content="Снять выделение" Click="OnClearSelection" Style="{StaticResource Task.Button.Secondary}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="{Binding Announcement}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Announcement}" />

        <Border Grid.RowSpan="5" Background="#99000000" Padding="20" Panel.ZIndex="50"
                PreviewKeyDown="OnEditorPreviewKeyDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Editor}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border MaxWidth="680" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="20" Background="{DynamicResource Task.Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1"
                    CornerRadius="{DynamicResource Task.Radius.Window}"
                    DataContext="{Binding Editor}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Событие календаря" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding EditorTitle}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}"
                                       FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Margin="0,2,0,0"
                                       AutomationProperties.Name="{Binding EditorTitle}"
                                       AutomationProperties.AutomationId="CalendarEventEditor" />
                            <TextBlock Text="{Binding VersionText}" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Закрыть" Command="{Binding CancelCommand}"
                                Style="{StaticResource Task.Button.Secondary}" AutomationProperties.Name="Закрыть редактор события" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,16,0,14">
                        <StackPanel>
                            <Border Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.CriticalSoft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            <DataTrigger Binding="{Binding ValidationMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding ValidationTitle}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                               AutomationProperties.LiveSetting="Assertive"
                                               AutomationProperties.AutomationId="CalendarEditorState" />
                                    <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Название *" Style="{StaticResource Calendar.FieldLabel}" />
                            <TextBox x:Name="CalendarEditorTitle" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Task.Input.Text}" Margin="0,0,0,12"
                                     IsVisibleChanged="OnEditorTitleIsVisibleChanged"
                                     AutomationProperties.Name="Название события"
                                     AutomationProperties.AutomationId="CalendarEventTitle" />

                            <WrapPanel>
                                <StackPanel Width="300" Margin="0,0,12,12">
                                    <TextBlock Text="Дата *" Style="{StaticResource Calendar.FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding Date}" Height="40" AutomationProperties.Name="Дата события" />
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,0,12">
                                    <TextBlock Text="Часовой пояс" Style="{StaticResource Calendar.FieldLabel}" />
                                    <TextBox Text="{Binding TimeZoneText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Task.Input.Text}"
                                             AutomationProperties.Name="Часовой пояс события" AutomationProperties.IsOffscreenBehavior="Onscreen" />
                                </StackPanel>
                            </WrapPanel>

                            <CheckBox Content="Событие на весь день" IsChecked="{Binding IsAllDay}" Margin="0,0,0,12"
                                      AutomationProperties.Name="Событие на весь день" />

                            <WrapPanel Margin="0,0,0,2">
                                <StackPanel Width="145" Margin="0,0,10,12">
                                    <TextBlock Text="Начало *" Style="{StaticResource Calendar.FieldLabel}" />
                                    <TextBox Text="{Binding StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"
                                             AutomationProperties.Name="Время начала" />
                                </StackPanel>
                                <StackPanel Width="145" Margin="0,0,10,12">
                                    <TextBlock Text="Окончание *" Style="{StaticResource Calendar.FieldLabel}" />
                                    <TextBox Text="{Binding EndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"
                                             AutomationProperties.Name="Время окончания" />
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,0,12">
                                    <TextBlock Text="Дата окончания" Style="{StaticResource Calendar.FieldLabel}" />
                                    <DatePicker SelectedDate="{Binding EndDate}" Height="40" AutomationProperties.Name="Дата окончания события" />
                                </StackPanel>
                            </WrapPanel>

                            <WrapPanel>
                                <StackPanel Width="300" Margin="0,0,12,12">
                                    <TextBlock Text="Проект" Style="{StaticResource Calendar.FieldLabel}" />
                                    <TextBox Text="{Binding ProjectId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"
                                             ToolTip="Идентификатор доступного проекта; поле можно оставить пустым."
                                             AutomationProperties.Name="Идентификатор проекта" />
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,0,12">
                                    <TextBlock Text="Статус" Style="{StaticResource Calendar.FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Status, Mode=TwoWay}" Style="{StaticResource Task.Input.Combo}"
                                              AutomationProperties.Name="Статус события" />
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="Описание" Style="{StaticResource Calendar.FieldLabel}" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     MinHeight="76" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource Task.Input.Text}" Margin="0,0,0,14"
                                     AutomationProperties.Name="Описание события" />

                            <TextBlock Text="Участники" FontSize="{DynamicResource Task.Font.Size.Section}"
                                       FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Attendees}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1"
                                                CornerRadius="{DynamicResource Task.Radius.Control}" Padding="10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding KindText}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}" />
                                                    <TextBlock Text="{Binding Id}" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap" />
                                                    <WrapPanel Margin="0,7,0,0">
                                                        <ComboBox Width="150" SelectedValue="{Binding Role}" SelectedValuePath="Tag"
                                                                  Style="{StaticResource Task.Input.Combo}" Margin="0,0,6,0"
                                                                  AutomationProperties.Name="Роль участника">
                                                            <ComboBoxItem Tag="required" Content="Обязательный" />
                                                            <ComboBoxItem Tag="optional" Content="Необязательный" />
                                                            <ComboBoxItem Tag="observer" Content="Наблюдатель" />
                                                        </ComboBox>
                                                        <ComboBox Width="150" SelectedValue="{Binding ResponseStatus}" SelectedValuePath="Tag"
                                                                  Style="{StaticResource Task.Input.Combo}"
                                                                  AutomationProperties.Name="Ответ участника">
                                                            <ComboBoxItem Tag="pending" Content="Ожидается" />
                                                            <ComboBoxItem Tag="accepted" Content="Принят" />
                                                            <ComboBoxItem Tag="declined" Content="Отклонён" />
                                                            <ComboBoxItem Tag="tentative" Content="Под вопросом" />
                                                        </ComboBox>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Удалить"
                                                        Command="{Binding DataContext.RemoveAttendeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource Task.Button.Secondary}"
                                                        Margin="10,0,0,0" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel>
                                <TextBox Width="300" Text="{Binding AttendeeId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Task.Input.Text}"
                                         AutomationProperties.Name="Идентификатор сотрудника или контакта" />
                                <ComboBox Width="130" ItemsSource="{Binding AttendeeKinds}" DisplayMemberPath="Label"
                                          SelectedValue="{Binding IsUserAttendee}" SelectedValuePath="IsUser"
                                          Style="{StaticResource Task.Input.Combo}" Margin="6,0,0,0"
                                          AutomationProperties.Name="Тип участника" />
                                <Button Content="Добавить" Command="{Binding AddAttendeeCommand}"
                                        Style="{StaticResource Task.Button.Secondary}" Margin="6,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar Width="72" IsIndeterminate="True">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource Task.Progress.Indeterminate}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="Сохранение…" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="Сохранить" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Task.Button.Primary}" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="CalendarEventSave" />
                            <Button Content="Отмена" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Task.Button.Secondary}" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border Grid.RowSpan="5" Background="#99000000" Padding="12" Panel.ZIndex="60">
            <Border.Style>
                <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Recurrence.IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <views:RecurrenceView DataContext="{Binding Recurrence}" />
        </Border>
    </Grid>
</UserControl>
