<UserControl x:Class="Task.Desktop.Views.PersonalTasksView" x:Name="PersonalTasks"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure"
 xmlns:views="clr-namespace:Task.Desktop.Views" xmlns:api="clr-namespace:Task.Desktop.TaskApi">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Items.Count,StringFormat=Показано задач: {0}}" Style="{StaticResource Task.Shell.StatusText}"/>
   <WrapPanel Grid.Column="1"><Button Content="Изменить" Command="{Binding EditCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="PersonalEditTask"/><Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
    <Button Command="{Binding NewCommand}" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalNewTask"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Task.Icon.Add}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/><TextBlock Text="Новая задача"/></StackPanel></Button>
   </WrapPanel>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,0,0,12">
   <Border Style="{StaticResource Task.State.Inline}"><TextBlock Text="Личные задачи сохраняются на этом компьютере." TextWrapping="Wrap"/></Border>
   <Border Style="{StaticResource Task.State.Inline}" Visibility="{Binding IsInbox,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="Запишите задачу сейчас, детали добавьте позже." Style="{StaticResource Task.State.Body}" Margin="0,0,0,8"/>
    <DockPanel><Button Content="Записать" Command="{Binding CaptureCommand}" DockPanel.Dock="Right" Style="{StaticResource Task.Button.Primary}" Margin="12,0,0,0" AutomationProperties.AutomationId="PersonalCapture"/><TextBox Text="{Binding CaptureText,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.AutomationId="PersonalCaptureText" AutomationProperties.Name="Быстрая задача"/></DockPanel>
   </StackPanel></Border>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource Task.Brush.Surface.Subtle}" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1,1,1,0" Padding="16,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
     <TextBlock Text="ЗАДАЧА" Style="{StaticResource Task.Table.HeaderText}"/><TextBlock Grid.Column="1" Text="СТАТУС" Style="{StaticResource Task.Table.HeaderText}"/><TextBlock Grid.Column="2" Text="ПРИОРИТЕТ" Style="{StaticResource Task.Table.HeaderText}"/><TextBlock Grid.Column="3" Text="ПЛАН" Style="{StaticResource Task.Table.HeaderText}"/>
    </Grid>
   </Border>
   <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Task.DataList.Item}" IsEnabled="{Binding CanSelectTask}" AutomationProperties.AutomationId="PersonalTasksList" AutomationProperties.Name="Личные задачи">
    <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Title}" Style="{StaticResource Task.Table.TitleText}" Margin="0,0,12,0" ToolTip="{Binding Title}"/>
     <Border Grid.Column="1" Style="{StaticResource Task.Semantic.StatusPill}"><TextBlock Text="{Binding StatusText}" Style="{StaticResource Task.Table.CellText}"/></Border>
     <TextBlock Grid.Column="2" Text="{Binding PriorityText}" Style="{StaticResource Task.Table.CellText}"/><TextBlock Grid.Column="3" Text="{Binding ScheduleText}" Style="{StaticResource Task.Table.CellText}"/>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Row="1" Style="{StaticResource Task.State.Panel}" Visibility="{Binding ShowEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
    <Path Data="{StaticResource Task.Icon.Tasks}" Width="30" Height="30" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}"/><TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Task.State.Title}" TextAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="{Binding EmptyBody}" Style="{StaticResource Task.State.Body}" TextAlignment="Center" Margin="0,8,0,0"/>
    <Button Content="Создать задачу" Command="{Binding NewCommand}" Margin="0,16,0,0" AutomationProperties.AutomationId="PersonalEmptyCreateTask">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Task.Button.Primary}"><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
    </Button>
    <Button Content="Открыть задачи" Command="{Binding OpenTasksCommand}" Style="{StaticResource Task.Button.Primary}" Margin="0,16,0,0" Visibility="{Binding IsToday,Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="PersonalEmptyOpenTasks"/>
   </StackPanel></Border>
   <Border Grid.RowSpan="2" Background="{DynamicResource Task.Brush.Surface.Base}" Visibility="{Binding IsBusy,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="160" Style="{StaticResource Task.Progress.Indeterminate}"/><TextBlock Text="Обновляем задачи…" Style="{StaticResource Task.State.Body}" Margin="0,12,0,0"/></StackPanel></Border>
  </Grid>
  <Expander Grid.Row="3" Header="Сведения о задаче" state:ViewState.Section="personal-tasks/v1/details" Margin="0,12,0,0" IsExpanded="False" AutomationProperties.Name="Сведения о задаче">
   <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Task.Inspector.Panel}" Margin="0,8,0,0"><StackPanel>
    <TextBlock Text="{Binding Selected.Title,TargetNullValue=Выберите задачу}" Style="{StaticResource Task.State.Title}"/>
    <TextBlock Text="{Binding Selected.Source.Card.Description}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
    <StackPanel Visibility="{Binding HasSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
     <WrapPanel Margin="0,12,0,8"><Button Content="В работу" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.InProgress}" Margin="0,0,8,8"/><Button Content="На проверку" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Review}" Margin="0,0,8,8"/><Button Content="Выполнить" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Completed}" Margin="0,0,8,8" AutomationProperties.AutomationId="PersonalCompleteTask"/><Button Content="Отменить задачу" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Cancelled}" Margin="0,0,0,8"/></WrapPanel>
     <TextBlock Text="Чек-лист" Style="{StaticResource Task.State.Title}" Margin="0,0,0,8"/><views:TaskChecklistView/>
    </StackPanel>
   </StackPanel></Border></ScrollViewer>
  </Expander>
  <Border Grid.Row="4" Style="{StaticResource Personal.Feedback}"><StackPanel>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
   <Button Content="Открыть задачу" Command="{Binding OpenSavedTaskCommand}" Visibility="{Binding ShowSavedTaskAction,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Task.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.AutomationId="PersonalOpenSavedTask"/>
  </StackPanel></Border>

  <Grid Grid.RowSpan="5" Background="#66000000" Visibility="{Binding HasEditor,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Panel.ZIndex="50" Margin="-24" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Редактор личной задачи">
   <Border MaxWidth="660" Margin="20" Style="{StaticResource Task.Inspector.Panel}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Padding="24,18" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding Editor.Heading}" Style="{StaticResource Task.Shell.PageTitle}"/></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel DataContext="{Binding Editor}" Margin="24,0,24,20">
      <StackPanel IsEnabled="{Binding DataContext.IsNotBusy,ElementName=PersonalTasks}">
       <TextBlock Text="Название (обязательно)" Style="{StaticResource Personal.Label}"/><TextBox x:Name="TitleInput" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TabIndex="20" AutomationProperties.Name="Название задачи" AutomationProperties.HelpText="Обязательное поле, не более 500 символов" AutomationProperties.AutomationId="PersonalTaskTitle"/><TextBlock Text="Например: подготовить договор" Style="{StaticResource Task.State.Body}" FontSize="12"/><TextBlock Text="{Binding TitleError}" Style="{StaticResource Personal.Validation}"/>
       <TextBlock Text="Запланировать на день (необязательно)" Style="{StaticResource Personal.Label}"/>
       <TextBox Text="{Binding Card.Date,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Card.IsDateOnly}" TabIndex="23" AutomationProperties.Name="День задачи" AutomationProperties.AutomationId="PersonalScheduledDate" AutomationProperties.HelpText="{Binding Card.DateHint}"/>
       <TextBlock Text="{Binding Card.DateHint}" Style="{StaticResource Task.State.Body}" FontSize="12"/>
       <TextBlock Text="Описание (необязательно)" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding Card.Description,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" MaxLength="50000" TabIndex="24" AutomationProperties.AutomationId="PersonalTaskDescription" AutomationProperties.Name="Описание задачи"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Приоритет (обычный по умолчанию)" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" DisplayMemberPath="Text" TabIndex="21" AutomationProperties.Name="Приоритет"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Проект (необязательно)" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding Card.Projects}" SelectedItem="{Binding Card.Project}" DisplayMemberPath="Name" TabIndex="22" AutomationProperties.AutomationId="PersonalTaskProject" AutomationProperties.Name="Проект задачи"/></StackPanel>
       </Grid>
       <Expander Header="Планирование и связи" state:ViewState.Section="personal-tasks/v1/planning" Margin="0,20,0,0" IsExpanded="False"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Grid.ColumnSpan="3"><TextBlock Text="Длительность, минут (необязательно)" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding Card.Duration,UpdateSourceTrigger=PropertyChanged}" TabIndex="27" AutomationProperties.Name="Длительность"/></StackPanel>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Начало (необязательно)" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding StartText,UpdateSourceTrigger=PropertyChanged}" TabIndex="25" AutomationProperties.Name="Дата и время начала" AutomationProperties.HelpText="ДД.ММ.ГГГГ ЧЧ:ММ, местное время" AutomationProperties.AutomationId="PersonalStart"/><TextBlock Text="{Binding StartError}" Style="{StaticResource Personal.Validation}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Срок (необязательно)" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding DeadlineText,UpdateSourceTrigger=PropertyChanged}" TabIndex="26" AutomationProperties.Name="Срок задачи" AutomationProperties.HelpText="ДД.ММ.ГГГГ ЧЧ:ММ, местное время" AutomationProperties.AutomationId="PersonalDeadline"/><TextBlock Text="{Binding DeadlineError}" Style="{StaticResource Personal.Validation}"/></StackPanel>
        </Grid>
        <TextBlock Text="ДД.ММ.ГГГГ ЧЧ:ММ · местное время" Style="{StaticResource Task.State.Body}" FontSize="12" Margin="0,6,0,0"/>
        <TextBlock Text="Родительская задача (необязательно)" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding Card.Tasks}" SelectedItem="{Binding Card.Parent}" DisplayMemberPath="Name" TabIndex="28" AutomationProperties.Name="Родительская задача" AutomationProperties.AutomationId="PersonalParentTask"/>
       </StackPanel></Expander>
       <TextBlock Text="{Binding CardError}" Style="{StaticResource Personal.Validation}"/>
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Personal.Validation}"/>
      <Border Style="{StaticResource Task.State.Inline}" Margin="0,12,0,0" Visibility="{Binding HasConflict,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Задача изменилась. Ваш черновик сохранён. Загрузите актуальную версию, чтобы продолжить." TextWrapping="Wrap"/><Button Content="Загрузить актуальную версию" Command="{Binding DataContext.ReloadEditorCommand,ElementName=PersonalTasks}" Margin="0,10,0,0" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
     <Border Grid.Row="2" Padding="24,14" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Click="OnCancelEditor" TabIndex="41" Margin="0,0,10,0"/><Button Content="{Binding Editor.SubmitText}" Command="{Binding SaveCommand}" TabIndex="40" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalSaveTask" AutomationProperties.Name="{Binding Editor.SubmitText}"/></StackPanel></Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
