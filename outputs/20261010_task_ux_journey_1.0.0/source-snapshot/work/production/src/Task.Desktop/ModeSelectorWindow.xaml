<Window x:Class="Task.Desktop.ModeSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task — выбор режима" Icon="Assets/Task.ico"
        Width="580" Height="480" MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterScreen" Style="{StaticResource Task.Window.Style}"
        AutomationProperties.AutomationId="ModeSelectorWindow">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Выберите пространство" Style="{StaticResource Task.Shell.PageTitle}" TextWrapping="Wrap"/>
            <TextBlock Text="Личное и корпоративное пространства разделены." TextWrapping="Wrap" Margin="0,12,0,16"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center">
            <Button Content="Личное пространство" Click="OnPersonal"
                    Style="{StaticResource Task.Button.Primary}" Margin="0,0,0,8"
                    AutomationProperties.AutomationId="SelectPersonalModeButton"/>
            <TextBlock Text="Личные задачи, календарь и напоминания. Работает без подключения к серверу и входа." TextWrapping="Wrap" Margin="0,0,0,20"/>
            <Button Content="Пространство компании" Click="OnCorporate"
                    Style="{StaticResource Task.Button.Secondary}" Margin="0,0,0,8"
                    AutomationProperties.AutomationId="SelectCorporateModeButton"/>
            <TextBlock Text="Для совместной работы. Понадобятся подключение к серверу и учётная запись компании." TextWrapping="Wrap"/>
        </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Отмена" IsCancel="True" HorizontalAlignment="Right"
                Style="{StaticResource Task.Button.Secondary}" Margin="0,16,0,0"/>
    </Grid>
</Window>
