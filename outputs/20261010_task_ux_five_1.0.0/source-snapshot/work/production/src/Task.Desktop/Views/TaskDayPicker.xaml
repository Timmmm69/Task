<UserControl x:Class="Task.Desktop.Views.TaskDayPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <WrapPanel IsEnabled="{Binding IsDateOnly}" Margin="0,6,0,0">
  <DatePicker x:Name="Picker" SelectedDate="{Binding CalendarDate}" Width="150" MinHeight="32"
   AutomationProperties.Name="Календарь дня задачи" ToolTip="Выбрать день в календаре"/>
  <Button Content="Сегодня" Click="Today" Style="{StaticResource Task.Button.Secondary}" Margin="8,0,0,0"/>
  <Button Content="Завтра" Click="Tomorrow" Style="{StaticResource Task.Button.Secondary}" Margin="8,0,0,0"/>
 </WrapPanel>
</UserControl>
