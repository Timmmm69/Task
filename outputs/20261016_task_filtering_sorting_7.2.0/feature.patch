+    {
+        var tasks = Enum.GetValues<DesktopTaskStatus>().Select(value => CreateTask(status: value)
+            with { DeadlineAtUtc = new FilterClock().GetUtcNow().AddDays(-1) }).ToArray();
+        var client = new FakeTasksApiClient();
