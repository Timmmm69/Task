+        Assert.Equal(task.Metadata.Id, Guid.Parse(Assert.Single(search.Body!["items"]!.AsArray())!["objectId"]!.ToString()));
+        Assert.Empty(db.Call("search", "search", user: db.OtherUser, session: db.OtherSession, admin: false,
