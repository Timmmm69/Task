# Replace every image with a reviewed immutable linux/amd64 digest.
PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE
ALERTMANAGER_IMAGE=prom/alertmanager@sha256:REPLACE
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter@sha256:REPLACE
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter@sha256:REPLACE
NODE_EXPORTER_IMAGE=prom/node-exporter@sha256:REPLACE
PYTHON_IMAGE=python@sha256:REPLACE

TASK_DB_NAME=task
TASK_SECRET_ROOT=/srv/task/secrets
TASK_MONITORING_BIND_IP=127.0.0.1
TASK_PROMETHEUS_PORT=9090
TASK_METRICS_RETENTION=30d
TASK_MONITORING_VERSION=1.0.0
TASK_MONITORING_GID=29004
TASK_ALERT_DELIVERY_MODE=test
TASK_ALERT_OWNER=replace-with-company-operations-owner
