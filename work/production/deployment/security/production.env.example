# Copy only non-secret values to the deployment system. Never put passwords or keys here.
TASK_API_IMAGE=registry.company.internal/task-api@sha256:<64-hex-digest>
TASK_WORKER_IMAGE=registry.company.internal/task-worker@sha256:<64-hex-digest>
TASK_DATABASE_MIGRATOR_IMAGE=registry.company.internal/task-database-migrator@sha256:<64-hex-digest>
TASK_TLS_PROXY_IMAGE=registry.company.internal/nginx-unprivileged@sha256:<64-hex-digest>
POSTGRES_IMAGE=registry.company.internal/postgres@sha256:<64-hex-digest>
TASK_DB_NAME=task
TASK_SERVER_NAME=task.company.internal
TASK_HTTPS_BIND_IP=10.0.10.20
TASK_HTTPS_PORT=443
TASK_SECRET_ROOT=/var/lib/task/secrets
