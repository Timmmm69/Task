<Window x:Class="Task.Desktop.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Task.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Task — вход"
        Width="1120" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        AutomationProperties.Name="Авторизация Task"
        AutomationProperties.AutomationId="AuthWindow">
    <Window.Resources>
        <Style x:Key="HeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="BodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#596273" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldStyle" TargetType="Control">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,5,0,14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="145" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#316BC4" />
            <Setter Property="BorderBrush" Value="#24569F" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#102A56" />
                    <Setter Property="BorderThickness" Value="3" />
                </Trigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="MinWidth" Value="145" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#8B95A7" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#24569F" />
                    <Setter Property="BorderThickness" Value="3" />
                </Trigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
            <Setter Property="Foreground" Value="#A12828" />
            <Setter Property="Background" Value="#FDECEC" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,2,0,14" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            <Setter Property="AutomationProperties.Name" Value="Ошибка" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
            <Setter Property="Foreground" Value="#285D37" />
            <Setter Property="Margin" Value="0,2,0,14" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            <Setter Property="AutomationProperties.Name" Value="Состояние операции" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:ServerSetupViewModel}">
            <StackPanel AutomationProperties.Name="Первое подключение">
                <TextBlock Text="Шаг 1 из 3" Foreground="#316BC4" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Text="Первое подключение" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="Укажите адрес сервера, выданный ИТ-администратором. Task принимает только защищённый HTTPS-адрес."
                           Style="{StaticResource BodyStyle}" Margin="0,0,0,22" />
                <Label Content="Адрес сервера компании" Target="{Binding ElementName=ServerAddressTextBox}" Padding="0" />
                <TextBox x:Name="ServerAddressTextBox"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldStyle}" TabIndex="0"
                         AutomationProperties.Name="Адрес сервера компании"
                         AutomationProperties.AutomationId="ServerAddressTextBox"
                         AutomationProperties.HelpText="Абсолютный HTTPS-адрес без параметров и фрагмента"
                         Loaded="InitialFocus_Loaded" />
                <TextBlock Text="Проверка включает доступность сервера и его готовность к работе. Проверка TLS не отключается."
                           Style="{StaticResource BodyStyle}" Margin="0,0,0,14" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                           AutomationProperties.AutomationId="ServerSetupErrorText" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusTextStyle}"
                           AutomationProperties.AutomationId="ServerSetupStatusText" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Проверить подключение" Command="{Binding CheckConnectionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" TabIndex="1"
                            AutomationProperties.Name="Проверить подключение"
                            AutomationProperties.AutomationId="CheckServerConnectionButton" />
                    <Button Content="Продолжить" Command="{Binding ContinueCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" TabIndex="2"
                            AutomationProperties.Name="Продолжить после проверки сервера"
                            AutomationProperties.AutomationId="ContinueFromServerSetupButton" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <StackPanel AutomationProperties.Name="Вход в Task">
                <TextBlock Text="Шаг 2 из 3" Foreground="#316BC4" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Text="Вход в Task" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="Используйте корпоративную учётную запись. Пароль не сохраняется на компьютере."
                           Style="{StaticResource BodyStyle}" Margin="0,0,0,22" />
                <Label Content="Логин" Target="{Binding ElementName=LoginTextBox}" Padding="0" />
                <TextBox x:Name="LoginTextBox" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldStyle}" TabIndex="0"
                         AutomationProperties.Name="Логин"
                         AutomationProperties.AutomationId="LoginTextBox"
                         Loaded="InitialFocus_Loaded" />
                <Label Content="Пароль" Target="{Binding ElementName=LoginPasswordBox}" Padding="0" />
                <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource FieldStyle}" TabIndex="1"
                             AutomationProperties.Name="Пароль"
                             AutomationProperties.AutomationId="LoginPasswordBox"
                             Loaded="LoginPasswordBox_Loaded" Unloaded="LoginPasswordBox_Unloaded" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                           AutomationProperties.AutomationId="LoginErrorText" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusTextStyle}"
                           AutomationProperties.AutomationId="LoginStatusText" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Сменить сервер" Command="{Binding ChangeServerCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" TabIndex="2"
                            AutomationProperties.Name="Сменить адрес сервера"
                            AutomationProperties.AutomationId="ChangeServerButton" />
                    <Button Content="Войти" Click="LoginSubmit_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" TabIndex="3"
                            AutomationProperties.Name="Войти"
                            AutomationProperties.AutomationId="SignInButton" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PasswordChangeViewModel}">
            <StackPanel AutomationProperties.Name="Обязательная смена пароля">
                <TextBlock Text="Шаг 3 из 3" Foreground="#316BC4" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Text="Измените временный пароль" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="Без смены пароля открыть Task нельзя. После подтверждения текущая сессия продолжит работу."
                           Style="{StaticResource BodyStyle}" Margin="0,0,0,18" />
                <TextBlock Text="{Binding PasswordPolicy}" Style="{StaticResource BodyStyle}"
                           AutomationProperties.Name="Требования к новому паролю" Margin="0,0,0,18" />
                <Label Content="Текущий пароль" Target="{Binding ElementName=CurrentPasswordBox}" Padding="0" />
                <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource FieldStyle}" TabIndex="0"
                             AutomationProperties.Name="Текущий пароль"
                             AutomationProperties.AutomationId="CurrentPasswordBox"
                             Loaded="PasswordChangeBox_Loaded" Unloaded="PasswordChangeBox_Unloaded" />
                <Label Content="Новый пароль" Target="{Binding ElementName=NewPasswordBox}" Padding="0" />
                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource FieldStyle}" TabIndex="1"
                             AutomationProperties.Name="Новый пароль"
                             AutomationProperties.AutomationId="NewPasswordBox"
                             AutomationProperties.HelpText="Не менее 10 символов, заглавная буква, цифра и специальный символ"
                             Loaded="PasswordChangeBox_Loaded" Unloaded="PasswordChangeBox_Unloaded" />
                <Label Content="Подтверждение нового пароля" Target="{Binding ElementName=ConfirmPasswordBox}" Padding="0" />
                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource FieldStyle}" TabIndex="2"
                             AutomationProperties.Name="Подтверждение нового пароля"
                             AutomationProperties.AutomationId="ConfirmPasswordBox"
                             Loaded="PasswordChangeBox_Loaded" Unloaded="PasswordChangeBox_Unloaded" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                           AutomationProperties.AutomationId="PasswordChangeErrorText" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusTextStyle}"
                           AutomationProperties.AutomationId="PasswordChangeStatusText" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Выйти" Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" TabIndex="3"
                            AutomationProperties.Name="Выйти из текущей сессии"
                            AutomationProperties.AutomationId="PasswordChangeLogoutButton" />
                    <Button Content="Изменить пароль" Click="PasswordChangeSubmit_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" TabIndex="4"
                            AutomationProperties.Name="Изменить пароль"
                            AutomationProperties.AutomationId="ChangePasswordButton" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionRecoveryViewModel}">
            <StackPanel AutomationProperties.Name="Восстановление сессии">
                <TextBlock Text="Проверка сессии" Foreground="#316BC4" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Text="Не удалось подтвердить сессию" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyStyle}" Margin="0,0,0,18"
                           AutomationProperties.Name="Причина блокировки"
                           AutomationProperties.AutomationId="RecoveryMessageText"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="Основное окно останется закрытым, пока сервер не подтвердит состояние сессии."
                           Style="{StaticResource BodyStyle}" Margin="0,0,0,18" />
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorTextStyle}"
                           AutomationProperties.AutomationId="RecoveryErrorText" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusTextStyle}"
                           AutomationProperties.AutomationId="RecoveryStatusText" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Выйти локально" Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" TabIndex="0"
                            AutomationProperties.Name="Выйти и удалить локальную сессию"
                            AutomationProperties.AutomationId="RecoveryLogoutButton" />
                    <Button Content="Повторить проверку" Command="{Binding RetryCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" TabIndex="1"
                            AutomationProperties.Name="Повторить проверку сессии"
                            AutomationProperties.AutomationId="RetrySessionButton"
                            Loaded="InitialFocus_Loaded" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="0" />
            <ColumnDefinition Width="6*" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="58" Background="#EEF4FC">
            <StackPanel VerticalAlignment="Center" MaxWidth="390">
                <Border Width="58" Height="58" CornerRadius="12" Background="#316BC4"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock Text="✓" Foreground="White" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ЛОКАЛЬНАЯ СЕТЬ КОМПАНИИ" Foreground="#316BC4"
                           FontSize="12" FontWeight="Bold" Margin="0,0,0,24" />
                <TextBlock Text="Рабочие задачи — в одном спокойном пространстве."
                           FontSize="40" FontWeight="SemiBold" Foreground="#172033"
                           TextWrapping="Wrap" LineHeight="48" Margin="0,0,0,18" />
                <TextBlock Text="Task подключается только к одобренному серверу компании. Доступ открывается после проверки сервера и сессии."
                           Style="{StaticResource BodyStyle}" FontSize="16" LineHeight="24" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="28">
            <Grid MinHeight="500">
                <Border Background="White" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="10"
                        Padding="34" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid>
                        <ContentControl Content="{Binding CurrentViewModel}"
                                        AutomationProperties.AutomationId="AuthenticationPane" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="Starting">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="RestoringSession">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ProgressBar IsIndeterminate="True" Width="260" Height="6" Margin="0,0,0,22"
                                         AutomationProperties.Name="Выполняется проверка сессии" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HeadingStyle}"
                                       TextAlignment="Center" AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="StartupStatusText" />
                            <TextBlock Text="Основное окно откроется только после подтверждения состояния сессии."
                                       Style="{StaticResource BodyStyle}" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
