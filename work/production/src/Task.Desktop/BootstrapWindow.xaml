<Window x:Class="Task.Desktop.BootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task — подготовка данных"
        Width="1120" Height="700" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Task.Window.Style}"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="Подготовка разрешённых данных"
        AutomationProperties.AutomationId="BootstrapWindow">
    <Grid Background="{DynamicResource Task.Brush.Surface.Subtle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="6*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Task.Brush.Brand.Soft}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="48" Focusable="False">
            <StackPanel VerticalAlignment="Center" MaxWidth="420">
                <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource Task.Brush.Brand.Primary}" HorizontalAlignment="Left" Margin="0,0,0,24">
                    <Path Data="{StaticResource Task.Icon.Tasks}" Width="28" Height="28" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ЛОКАЛЬНАЯ СЕТЬ КОМПАНИИ" Foreground="{DynamicResource Task.Brush.Brand.Primary}" FontWeight="Bold" FontSize="12" Margin="0,0,0,24" />
                <TextBlock Text="Рабочие задачи — в одном спокойном пространстве." FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="46" Margin="0,0,0,18" />
                <TextBlock Text="Task подключается только к одобренному серверу компании и загружает данные, разрешённые вашей ролью." Style="{StaticResource Task.State.Body}" FontSize="16" LineHeight="24" Margin="0,0,0,22" />
                <TextBlock Text="✓  Сервер — источник актуальных данных" Margin="0,0,0,12" />
                <TextBlock Text="✓  Локальный кэш учитывает права доступа" Margin="0,0,0,12" />
                <TextBlock Text="✓  Состояние подключения видно всегда" />
            </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28" Focusable="False">
            <Grid MinHeight="500">
                <Border Background="{DynamicResource Task.Brush.Surface.Base}" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1" CornerRadius="10" Padding="32" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Task.Brush.Brand.Primary}" Margin="0,0,8,0"><TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Task.Brush.Brand.Primary}" Margin="0,0,8,0"><TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Task.Brush.Brand.Primary}"><TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                        </StackPanel>
                        <Path Data="{StaticResource Task.Icon.Catalog}" Width="34" Height="34" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}" HorizontalAlignment="Left" Margin="0,0,0,16" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Task.State.Title}" FontSize="25" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Task.State.Body}" Margin="0,8,0,20" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="BootstrapStatusText" />

                        <Border Style="{StaticResource Task.Surface.Subtle}" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Сессия и разрешённая область" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" Foreground="{DynamicResource Task.Brush.Brand.Primary}" FontWeight="SemiBold" Margin="12,0,0,0" /></Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="6" Foreground="{DynamicResource Task.Brush.Brand.Primary}" Background="{DynamicResource Task.Brush.Surface.Hover}" AutomationProperties.Name="Проверка разрешённых данных" AutomationProperties.AutomationId="BootstrapProgress" />
                                <TextBlock Text="Неразрешённые данные не сохраняются на этом устройстве." Style="{StaticResource Task.State.Body}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Task.Brush.Semantic.WarningSoft}" BorderBrush="{DynamicResource Task.Brush.Semantic.Warning}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="BootstrapError">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </Border>

                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Выйти" Command="{Binding LogoutCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,10,0" AutomationProperties.AutomationId="BootstrapLogoutButton" />
                            <Button Content="Повторить" Command="{Binding RetryCommand}" AutomationProperties.AutomationId="BootstrapRetryButton">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Task.Button.Primary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
