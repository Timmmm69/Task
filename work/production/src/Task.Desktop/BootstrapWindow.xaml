<Window x:Class="Task.Desktop.BootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Варава Дент — подготовка пространства компании"
        Icon="Assets/VoravaDent.ico"
        Width="1120" Height="700" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Task.Window.Style}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="Подготовка разрешённых данных"
        AutomationProperties.AutomationId="BootstrapWindow">
    <HeaderedContentControl Style="{StaticResource Task.Workspace.StartupFrame}">
        <HeaderedContentControl.Header>
            <Button Content="Сменить режим" Click="OnSwitchMode" Style="{StaticResource Task.Workspace.Button}"
                    AutomationProperties.AutomationId="SwitchModeButton" />
        </HeaderedContentControl.Header>
        <ScrollViewer x:Name="StartupViewport" Padding="28" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=StartupViewport}">
                <Border MaxWidth="500" Padding="24,16" VerticalAlignment="Center"
                        Style="{StaticResource Task.Workspace.Card}">
                    <StackPanel>
                        <TextBlock Text="Подключение к пространству" Style="{StaticResource Task.Workspace.Meta}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Task.Workspace.Title}" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Task.Workspace.Body}" Margin="0,6,0,14" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="BootstrapStatusText" />

                        <Border Style="{StaticResource Task.Workspace.Background}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Сессия и разрешённая область" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="6" Foreground="{DynamicResource Task.Brush.Brand.Primary}" Background="{DynamicResource Task.Brush.Surface.Hover}" AutomationProperties.Name="Проверка разрешённых данных" AutomationProperties.AutomationId="BootstrapProgress" />
                                <TextBlock Text="Неразрешённые данные не сохраняются на этом устройстве." Style="{StaticResource Task.Workspace.Body}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.CriticalSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="BootstrapError" />
                        </Border>

                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Выйти" Command="{Binding LogoutCommand}" Style="{StaticResource Task.Workspace.Button}" Margin="0,0,10,0" AutomationProperties.AutomationId="BootstrapLogoutButton" />
                            <Button Content="Повторить" Command="{Binding RetryCommand}" AutomationProperties.AutomationId="BootstrapRetryButton">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Task.Workspace.Primary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </HeaderedContentControl>
</Window>
