<Window x:Class="Task.Desktop.PersonalWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Task.Desktop.Views"
        Title="Task — Personal" Icon="Assets/Task.ico" Width="1200" Height="900" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen" Style="{StaticResource Task.Window.Style}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown" AutomationProperties.AutomationId="PersonalWindow" AutomationProperties.Name="Task — личное пространство">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="{DynamicResource Task.Shell.HeaderGridLength}"/><RowDefinition Height="*"/><RowDefinition Height="{DynamicResource Task.Shell.FooterGridLength}"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ActualWidth,ElementName=RootWindow,Converter={StaticResource Task.ShellNavigationWidthConverter}}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.RowSpan="3" Style="{StaticResource Task.Shell.NavigationSurface}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="{DynamicResource Task.Navigation.MenuGridLength}"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Width="48" Height="58" Margin="10,0,0,0" HorizontalAlignment="Left" ToolTip="Основная навигация"><Path Data="{StaticResource Task.Icon.Navigation}" Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Primary}"/></Border>
                <ListBox x:Name="SectionsList" Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" IsEnabled="{Binding CanNavigate}"
                         Style="{StaticResource Task.Navigation.List}" ItemContainerStyle="{StaticResource Personal.Navigation.Item}" ToolTip="{Binding NavigationHint}"
                         AutomationProperties.Name="Основная навигация" AutomationProperties.AutomationId="PersonalNavigationList">
                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path Data="{Binding IconKey,Converter={StaticResource Task.IconKeyToGeometryConverter}}" Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" FontSize="{DynamicResource Task.Font.Size.Navigation}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActualWidth,ElementName=RootWindow,Converter={StaticResource Task.WindowWidthAtLeastConverter},ConverterParameter=900}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="8,16"><TextBlock Text="Личное" Margin="8,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActualWidth,ElementName=RootWindow,Converter={StaticResource Task.WindowWidthAtLeastConverter},ConverterParameter=900}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <Button Click="OnSwitchMode" Style="{StaticResource Task.Button.Secondary}" ToolTip="Сменить режим" AutomationProperties.Name="Сменить режим" AutomationProperties.AutomationId="SwitchModeButton">
                        <TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Сменить режим"/><Style.Triggers><DataTrigger Binding="{Binding ActualWidth,ElementName=RootWindow,Converter={StaticResource Task.WindowWidthAtLeastConverter},ConverterParameter=900}" Value="False"><Setter Property="Text" Value="⇄"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="HeaderRegion" Grid.Column="1" Style="{StaticResource Task.Shell.HeaderSurface}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding SelectedSection.Title}" Style="{StaticResource Task.Shell.PageTitle}" AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock Text="{Binding SelectedSection.SupportingText}" Style="{StaticResource Task.Shell.StatusText}"/>
                </StackPanel>
                <Button Grid.Column="1" Click="OnSearch" Style="{StaticResource Task.Button.Icon}" Margin="0,0,8,0" IsEnabled="{Binding CanNavigate}" ToolTip="Поиск по Task · Ctrl+K" AutomationProperties.Name="Поиск по Task"><Path Data="{StaticResource Task.Icon.Search}" Width="19" Height="19" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Ellipse Width="9" Height="9" Fill="{DynamicResource Task.Brush.Semantic.Success}" Margin="0,0,7,0"/><TextBlock Text="На этом компьютере" Style="{StaticResource Task.Shell.StatusText}"/></StackPanel>
                <Button Grid.Column="3" Click="OnNotifications" Style="{StaticResource Task.Button.Icon}" IsEnabled="{Binding CanNavigate}" ToolTip="Уведомления" AutomationProperties.Name="Уведомления"><Path Data="{StaticResource Task.Icon.Notifications}" Width="20" Height="20" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" x:Name="WorkspaceRegion">
            <views:PersonalTasksView x:Name="TasksSurface" DataContext="{Binding Tasks}" Visibility="{Binding DataContext.IsTasks,ElementName=RootWindow,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
            <views:PersonalProjectsView DataContext="{Binding Planning}" Visibility="{Binding DataContext.IsProjects,ElementName=RootWindow,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
            <views:CalendarView DataContext="{Binding Calendar}" Visibility="{Binding DataContext.IsCalendar,ElementName=RootWindow,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
            <views:PersonalRemindersView DataContext="{Binding Planning}" Visibility="{Binding DataContext.IsNotifications,ElementName=RootWindow,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
            <views:PersonalWorkspaceView DataContext="{Binding Workspace}" Visibility="{Binding DataContext.IsWorkspace,ElementName=RootWindow,Converter={StaticResource Task.BooleanToVisibilityConverter}}" BackupRequested="OnBackup" RestoreRequested="OnRestore" BackgroundRequested="OnBackground"/>
        </Grid>
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Task.Shell.FooterSurface}"><TextBlock Text="{Binding NavigationHint}" Style="{StaticResource Task.Shell.StatusText}" AutomationProperties.LiveSetting="Polite"/></Border>
    </Grid>
</Window>
