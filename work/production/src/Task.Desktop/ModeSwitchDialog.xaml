<Window x:Class="Task.Desktop.ModeSwitchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task — несохранённые формы" Icon="Assets/Task.ico"
        Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" Style="{StaticResource Task.Window.Style}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.AutomationId="ModeSwitchGuardDialog">
    <Border Style="{StaticResource Task.Workspace.Card}" BorderThickness="0" CornerRadius="0">
        <StackPanel>
            <TextBlock Text="Есть незавершённые формы" Style="{StaticResource Task.Workspace.Title}" AutomationProperties.HeadingLevel="Level1" />
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Margin="0,16,0,12">
                <TextBlock x:Name="EditorsText" TextWrapping="Wrap" />
            </ScrollViewer>
            <TextBlock x:Name="SaveNotice" Style="{StaticResource Task.Workspace.Body}" Margin="0,0,0,20"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Сохранить" Click="OnSave" Style="{StaticResource Task.Workspace.Primary}" Margin="0,0,8,8"/>
                <Button Content="Отбросить" Click="OnDiscard" Style="{StaticResource Task.Workspace.Button}" Margin="0,0,8,8"/>
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource Task.Workspace.Button}" Margin="0,0,0,8"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
