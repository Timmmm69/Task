<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.Colors.xaml" />
        <ResourceDictionary Source="Tokens.Typography.xaml" />
        <ResourceDictionary Source="Tokens.Spacing.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Controls.Buttons.xaml" />
        <ResourceDictionary Source="Controls.Navigation.xaml" />
        <ResourceDictionary Source="Controls.Data.xaml" />
        <ResourceDictionary Source="Controls.States.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Task.Window.Style" TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource Task.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Surface.Base" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Surface.Subtle" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Subtle}" />
    </Style>

    <Style x:Key="Task.Grid.SurfaceBase" TargetType="Grid">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
