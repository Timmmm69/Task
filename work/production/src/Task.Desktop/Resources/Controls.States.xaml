<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Task.State.Inline" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Task.Radius.Small}" />
        <Setter Property="Padding" Value="12,8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.State.Panel" TargetType="Border">
        <Setter Property="MinHeight" Value="132" />
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Task.Radius.Control}" />
        <Setter Property="Padding" Value="24" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.State.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Section}" />
        <Setter Property="FontWeight" Value="{DynamicResource Task.Font.Weight.Semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Task.State.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Task.Progress.Indeterminate" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Brand.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Hover}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Inspector.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Task.Radius.Control}" />
        <Setter Property="Padding" Value="20" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Primary}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Inspector.FactLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Metadata}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="Task.Inspector.FactValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
