<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Task.FocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-3"
                            BorderBrush="{DynamicResource Task.Brush.Brand.Primary}"
                            BorderThickness="{DynamicResource Task.Thickness.Focus}"
                            CornerRadius="{DynamicResource Task.Radius.Control}" />
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Task.Button.Base" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource Task.Control.Height.Compact}" />
        <Setter Property="Padding" Value="{DynamicResource Task.Padding.Control}" />
        <Setter Property="FontFamily" Value="{DynamicResource Task.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Task.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Task.Brush.Surface.Hover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Task.Brush.Text.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Strong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Disabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Task.Button.Base}" />

    <Style x:Key="Task.Button.Primary" TargetType="Button" BasedOn="{StaticResource Task.Button.Base}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Primary}" />
        <Setter Property="FontWeight" Value="{DynamicResource Task.Font.Weight.Semibold}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Strong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Strong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Strong}" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Button.Icon" TargetType="Button" BasedOn="{StaticResource Task.Button.Secondary}">
        <Setter Property="Width" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="9" />
    </Style>

    <Style x:Key="Task.Button.FooterIcon" TargetType="Button" BasedOn="{StaticResource Task.Button.Icon}">
        <Setter Property="Width" Value="38" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="Task.Input.Text" TargetType="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{DynamicResource Task.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}" />
    </Style>

    <Style x:Key="Task.Input.Combo" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{DynamicResource Task.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}" />
    </Style>
</ResourceDictionary>
