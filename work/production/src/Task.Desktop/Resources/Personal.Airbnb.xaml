<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<SolidColorBrush x:Key="Personal.Airbnb.Accent" Color="#FF385C"/>
<SolidColorBrush x:Key="Personal.Airbnb.Hairline" Color="#DDDDDD"/>
<SolidColorBrush x:Key="Personal.Airbnb.Soft" Color="#F7F7F7"/>
<SolidColorBrush x:Key="Personal.Airbnb.Ink" Color="#222222"/>
<SolidColorBrush x:Key="Personal.Airbnb.Secondary" Color="#717171"/>
<ControlTemplate x:Key="Personal.Airbnb.ButtonTemplate" TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Ink}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  <Style x:Key="Personal.Airbnb.Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Secondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Personal.Airbnb.Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Personal.Airbnb.Pill" TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Ink}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Hairline}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="20,12"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template" Value="{StaticResource Personal.Airbnb.ButtonTemplate}"/>
  </Style>

<Style x:Key="Personal.Airbnb.Compact" TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Pill}"><Setter Property="Padding" Value="14,8"/></Style>
<Style x:Key="Personal.Airbnb.Input" TargetType="TextBox">
 <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Ink}"/>
 <Setter Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Hairline}"/><Setter Property="BorderThickness" Value="1"/>
 <Setter Property="Padding" Value="14,8"/><Setter Property="Height" Value="42"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
  <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
   <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
  </Border><ControlTemplate.Triggers>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Ink}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<ControlTemplate x:Key="Personal.Airbnb.NavigationTemplate" TargetType="ListBoxItem">
                    <Border x:Name="TodayNav" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}" Margin="0,2"><ContentPresenter VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TodayNav" Property="Background" Value="#F7F7F7"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TodayNav" Property="Background" Value="#F7F7F7"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TodayNav" Property="BorderBrush" Value="#222222"/><Setter TargetName="TodayNav" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
<!-- Shared compact browser rows; opt-in so existing screens retain their layout. -->
<Style x:Key="Personal.Airbnb.BrowserRow" TargetType="ListBoxItem">
 <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,2"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
  <Border x:Name="Row" CornerRadius="12" Background="White" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
  <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Personal.Airbnb.Soft}"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Personal.Airbnb.Soft}"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Ink}"/></Trigger>
   <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Ink}"/><Setter TargetName="Row" Property="BorderThickness" Value="2"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<!-- Finite browser viewports use a scroll owner that explicitly delegates to the virtual panel. -->
<Style x:Key="Personal.Airbnb.VirtualList" TargetType="ListBox">
 <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
 <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
 <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
 <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
 <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
 <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
 <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
   <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
  </Border>
 </ControlTemplate></Setter.Value></Setter>
</Style>
</ResourceDictionary>
