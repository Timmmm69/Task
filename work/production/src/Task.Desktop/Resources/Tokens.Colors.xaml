<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Stage 5 Direction 2 canonical colour roles. -->
    <Color x:Key="Task.Color.Brand.Primary">#0F6CBD</Color>
    <Color x:Key="Task.Color.Brand.Strong">#005A9E</Color>
    <Color x:Key="Task.Color.Brand.Soft">#EAF3FF</Color>
    <Color x:Key="Task.Color.Text.Primary">#1B1A19</Color>
    <Color x:Key="Task.Color.Text.Secondary">#605E5C</Color>
    <Color x:Key="Task.Color.Text.Disabled">#8A8886</Color>
    <Color x:Key="Task.Color.Surface.Base">#FFFFFF</Color>
    <Color x:Key="Task.Color.Surface.Subtle">#FAFAFA</Color>
    <Color x:Key="Task.Color.Surface.Hover">#F3F2F1</Color>
    <Color x:Key="Task.Color.Surface.Disabled">#F3F2F1</Color>
    <Color x:Key="Task.Color.Border.Default">#E1DFDD</Color>
    <Color x:Key="Task.Color.Border.Strong">#C8C6C4</Color>
    <Color x:Key="Task.Color.Semantic.Critical">#D13438</Color>
    <Color x:Key="Task.Color.Semantic.CriticalSoft">#FDE7E9</Color>
    <Color x:Key="Task.Color.Semantic.Success">#107C10</Color>
    <Color x:Key="Task.Color.Semantic.SuccessSoft">#DFF6DD</Color>
    <Color x:Key="Task.Color.Semantic.Warning">#F2A900</Color>
    <Color x:Key="Task.Color.Semantic.WarningSoft">#FFF4CE</Color>

    <SolidColorBrush x:Key="Task.Brush.Brand.Primary" Color="{StaticResource Task.Color.Brand.Primary}" />
    <SolidColorBrush x:Key="Task.Brush.Brand.Strong" Color="{StaticResource Task.Color.Brand.Strong}" />
    <SolidColorBrush x:Key="Task.Brush.Brand.Soft" Color="{StaticResource Task.Color.Brand.Soft}" />
    <SolidColorBrush x:Key="Task.Brush.Text.Primary" Color="{StaticResource Task.Color.Text.Primary}" />
    <SolidColorBrush x:Key="Task.Brush.Text.Secondary" Color="{StaticResource Task.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Task.Brush.Text.Disabled" Color="{StaticResource Task.Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Task.Brush.Surface.Base" Color="{StaticResource Task.Color.Surface.Base}" />
    <SolidColorBrush x:Key="Task.Brush.Surface.Subtle" Color="{StaticResource Task.Color.Surface.Subtle}" />
    <SolidColorBrush x:Key="Task.Brush.Surface.Hover" Color="{StaticResource Task.Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Task.Brush.Surface.Disabled" Color="{StaticResource Task.Color.Surface.Disabled}" />
    <SolidColorBrush x:Key="Task.Brush.Border.Default" Color="{StaticResource Task.Color.Border.Default}" />
    <SolidColorBrush x:Key="Task.Brush.Border.Strong" Color="{StaticResource Task.Color.Border.Strong}" />
    <SolidColorBrush x:Key="Task.Brush.Semantic.Critical" Color="{StaticResource Task.Color.Semantic.Critical}" />
    <SolidColorBrush x:Key="Task.Brush.Semantic.CriticalSoft" Color="{StaticResource Task.Color.Semantic.CriticalSoft}" />
    <SolidColorBrush x:Key="Task.Brush.Semantic.Success" Color="{StaticResource Task.Color.Semantic.Success}" />
    <SolidColorBrush x:Key="Task.Brush.Semantic.SuccessSoft" Color="{StaticResource Task.Color.Semantic.SuccessSoft}" />
    <SolidColorBrush x:Key="Task.Brush.Semantic.Warning" Color="{StaticResource Task.Color.Semantic.Warning}" />
    <SolidColorBrush x:Key="Task.Brush.Semantic.WarningSoft" Color="{StaticResource Task.Color.Semantic.WarningSoft}" />
</ResourceDictionary>
