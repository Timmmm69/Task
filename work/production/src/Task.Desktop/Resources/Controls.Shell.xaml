<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Direction 2 shell primitives. Kept separate from screen content to limit future shell churn. -->
    <Style x:Key="Task.Shell.NavigationSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Navigation.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Shell.HeaderSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{DynamicResource Task.Padding.ShellHeader}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Shell.FooterSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="18,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Task.Shell.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.PageTitle}" />
        <Setter Property="FontWeight" Value="{DynamicResource Task.Font.Weight.Semibold}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Task.Shell.PageContext" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Section}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Task.Shell.StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Metadata}" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
