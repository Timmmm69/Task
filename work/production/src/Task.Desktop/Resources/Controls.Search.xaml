<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:input="clr-namespace:Task.Desktop.Infrastructure">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.Buttons.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <CornerRadius x:Key="Task.Radius.Search">24</CornerRadius>
    <Visibility x:Key="Task.Search.EmptyHintVisibility">Visible</Visibility>
    <!-- One capsule-shaped search field for pages, dialogs and ComboBox popups.
         Tag supplies the contextual placeholder; the editable content has no inner chrome. -->
    <Style x:Key="Task.Input.Search" TargetType="TextBox" BasedOn="{StaticResource Task.Input.Text}">
        <Setter Property="Tag" Value="Найти…" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FontFamily" Value="{DynamicResource Task.Capsule.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Task.Capsule.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Task.Capsule.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Task.Capsule.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Task.Capsule.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="SearchChrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Task.Radius.Search}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid Margin="15,9,11,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <Path x:Name="SearchIcon" Data="M 11,11 L 15,15 M 12,6.5 A 5.5,5.5 0 1 1 1,6.5 A 5.5,5.5 0 1 1 12,6.5" Width="16" Height="16"
                                  Stretch="Uniform" Stroke="{DynamicResource Task.Capsule.Muted}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource Task.Capsule.Muted}" Visibility="Collapsed"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                            <Border x:Name="SearchHint" Grid.Column="2" Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                                    Background="{DynamicResource Task.Capsule.Panel}" BorderBrush="{DynamicResource Task.Capsule.Border}" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Text="/" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource Task.Capsule.Muted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Button x:Name="ClearSearch" Grid.Column="2" Width="24" Height="24" Padding="0" Focusable="False"
                                    Command="{x:Static input:SearchFieldCommands.Clear}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    AutomationProperties.Name="Очистить поиск" ToolTip="Очистить поиск">
                                <Button.Template><ControlTemplate TargetType="Button">
                                    <Border x:Name="ClearChrome" Background="Transparent" CornerRadius="12">
                                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Width="8" Height="8" Stretch="Uniform"
                                              Stroke="{DynamicResource Task.Capsule.Muted}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ClearChrome" Property="Background" Value="{DynamicResource Task.Capsule.Selected}"/>
                                    </Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SearchHint" Property="Visibility" Value="{DynamicResource Task.Search.EmptyHintVisibility}"/>
                            <Setter TargetName="ClearSearch" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{DynamicResource Task.Capsule.Accent}"/>
                            <Setter TargetName="SearchChrome" Property="Background" Value="{DynamicResource Task.Capsule.Panel}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter TargetName="SearchChrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                            <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter TargetName="SearchIcon" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter TargetName="SearchPlaceholder" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"/>
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Task.Capsule.Border}"/></Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
