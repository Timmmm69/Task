<Window x:Class="Task.Desktop.ModeSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task — выбор режима" Icon="Assets/Task.ico"
        Width="580" Height="480" MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterScreen" Style="{StaticResource Task.Window.Style}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.AutomationId="ModeSelectorWindow">
    <Window.Resources>
        <Style x:Key="ModeOption" TargetType="Button" BasedOn="{StaticResource Task.Workspace.Button}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Task.Workspace.Background}" Padding="18,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Выберите пространство" Style="{StaticResource Task.Workspace.Title}"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="Личные данные и данные компании хранятся отдельно." Style="{StaticResource Task.Workspace.Body}" Margin="0,5,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <Button Click="OnPersonal" Style="{StaticResource ModeOption}" Margin="0,0,0,8"
                            AutomationProperties.Name="Личное пространство" AutomationProperties.AutomationId="SelectPersonalModeButton">
                        <StackPanel>
                            <TextBlock Text="Личное пространство" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Задачи, календарь и напоминания без сервера и входа." Style="{StaticResource Task.Workspace.Body}" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnCorporate" Style="{StaticResource ModeOption}"
                            AutomationProperties.Name="Пространство компании" AutomationProperties.AutomationId="SelectCorporateModeButton">
                        <StackPanel>
                            <TextBlock Text="Пространство компании" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Совместная работа через сервер и учётную запись компании." Style="{StaticResource Task.Workspace.Body}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Отмена" IsCancel="True" HorizontalAlignment="Right" Margin="0,8,0,0"
                    Style="{StaticResource Task.Workspace.Button}" />
        </Grid>
    </Border>
</Window>
