<Application x:Class="Task.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Task.Desktop.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:IconKeyToGeometryConverter x:Key="Task.IconKeyToGeometryConverter" />
            <converters:ShellNavigationWidthConverter x:Key="Task.ShellNavigationWidthConverter" />
            <converters:WindowWidthAtLeastConverter x:Key="Task.WindowWidthAtLeastConverter" />
            <converters:ResponsiveGridLengthConverter x:Key="Task.ResponsiveGridLengthConverter" />
            <BooleanToVisibilityConverter x:Key="Task.BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
