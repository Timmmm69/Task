<Window x:Class="Task.Desktop.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Task.Desktop.Views" xmlns:inv="clr-namespace:Task.Desktop.Inventory" xmlns:vm="clr-namespace:Task.Desktop.ViewModels"
        mc:Ignorable="d"
        state:PersonalSelect.Scope="True"
        Title="Варава Дент — пространство компании"
        Icon="Assets/VoravaDent.ico"
        Width="1200" Height="900" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Task.Window.Style}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        AutomationProperties.Name="Варава Дент — рабочее пространство"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.HelpText="F6 переключает основные области; Ctrl+K открывает глобальный поиск; Escape закрывает overlay и возвращает фокус">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Tasks.CancelEditorCommand}" />
        <KeyBinding Key="N" Modifiers="Alt" Command="{Binding NewTaskCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <CollectionViewSource x:Key="NavigationSections" Source="{Binding Sections}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        <Style x:Key="RailItem" TargetType="ListBoxItem" BasedOn="{StaticResource Task.Workspace.NavigationItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=900}" Value="False">
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=540}" Value="False">
                    <Setter Property="Height" Value="24" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailLabel" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=900}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WideHeaderLabel" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=1080}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="TasksAccent" Color="{DynamicResource Task.Color.Brand.Primary}" />
        <SolidColorBrush x:Key="TasksAccentPressed" Color="{DynamicResource Task.Color.Brand.Strong}" />
        <SolidColorBrush x:Key="TasksSelection" Color="{DynamicResource Task.Color.Brand.Soft}" />

        <ControlTemplate x:Key="TasksPrimaryTemplate" TargetType="Button">
            <Border x:Name="Chrome" Background="{StaticResource TasksAccent}" CornerRadius="9"
                    BorderBrush="Transparent" BorderThickness="1">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TasksAccentPressed}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TasksAccentPressed}" />
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Task.Brush.Surface.Disabled}" />
                    <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}" />
                </Trigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="TasksPrimaryButton" TargetType="Button" BasedOn="{StaticResource Task.Button.Primary}">
            <Setter Property="Template" Value="{StaticResource TasksPrimaryTemplate}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource Task.ShellNavigationWidthConverter}}">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=900}" Value="True">
                                <Setter Property="MinWidth" Value="220" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="4" Style="{StaticResource Task.Shell.NavigationSurface}">
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Margin" Value="8,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=900}" Value="False">
                                <Setter Property="Margin" Value="3,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="48" Margin="5,0" ToolTip="Варава Дент · Пространство компании">
                    <Border Width="36" Height="36" VerticalAlignment="Center"
                            Background="{DynamicResource Task.Brush.Surface.Hover}" CornerRadius="12">
                        <Image Source="/Task.Desktop;component/Assets/VoravaDent.png" Width="30" Height="30" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="Варава Дент" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="8,0,0,0" Style="{StaticResource RailLabel}" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Click="OnSwitchMode" Margin="0,4,0,6" Padding="8,0"
                        Style="{StaticResource Task.Workspace.Button}" ToolTip="Сменить режим"
                        AutomationProperties.Name="Сменить режим" AutomationProperties.AutomationId="SwitchModeButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⇄" FontSize="18" VerticalAlignment="Center" />
                        <TextBlock Text="Сменить режим" Margin="7,0,0,0" VerticalAlignment="Center" Style="{StaticResource RailLabel}" />
                    </StackPanel>
                </Button>

                <ListBox x:Name="NavigationListBox" ItemsSource="{Binding Source={StaticResource NavigationSections}}"
                         SelectionChanged="OnNavigationSelectionChanged"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Style="{StaticResource Task.Navigation.List}" ItemContainerStyle="{StaticResource RailItem}"
                         TabIndex="0" AutomationProperties.Name="Основная навигация"
                         AutomationProperties.HelpText="Стрелки выбирают раздел, Enter открывает его"
                         AutomationProperties.AutomationId="NavigationListBox">
                    <ListBox.GroupStyle>
                        <StaticResource ResourceKey="Task.Navigation.Group" />
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=900}" Value="False">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <Path Data="{Binding IconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                                      Width="18" Height="18" Stretch="Uniform" Margin="2,0"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      IsHitTestVisible="False" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource RailLabel}" Margin="6,0,0,0"
                                           FontSize="{DynamicResource Task.Font.Size.Body}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border x:Name="HeaderRegion" Grid.Column="1">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Task.Shell.HeaderSurface}">
                    <Setter Property="Padding" Value="20,12,20,10" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualHeight, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=540}" Value="False">
                            <Setter Property="Padding" Value="16,5,16,5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding SelectedSection.Title}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedSection.Title}"
                               AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level1"
                               Style="{StaticResource Task.Workspace.Title}" />
                    <TextBlock Text="{Binding SelectedSectionSupportingText}" Style="{StaticResource Task.Workspace.Body}"
                               ToolTip="{Binding SelectedSection.SupportingText}" AutomationProperties.AutomationId="SectionHelpText" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TasksRefreshButton" Command="{Binding FooterRefreshCommand}" Margin="0,0,8,0"
                            TabIndex="2" ToolTip="Обновить текущий раздел" AutomationProperties.Name="Обновить текущий раздел"
                            AutomationProperties.AutomationId="TasksRefreshButton"
                            AutomationProperties.HelpText="Повторно загрузить данные текущего раздела">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Task.Workspace.IconButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTasksSectionSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsTodaySectionSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <Trigger Property="Command" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource Task.Icon.Refresh}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Command="{Binding NewTaskCommand}"
                            Margin="0,0,12,0" TabIndex="3" MinWidth="112" VerticalAlignment="Center"
                            ToolTip="{Binding ReadOnlyActionReason, TargetNullValue=Новая задача · Alt+N}"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Новая задача" AutomationProperties.AutomationId="NewTaskButton"
                            AutomationProperties.HelpText="{Binding ReadOnlyActionReason}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Task.Workspace.Primary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTasksSectionSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Task.Icon.Add}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Новая задача" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GlobalSearchButton" Click="OnOpenGlobalSearch" Margin="0,0,8,0" Padding="9,0"
                            Style="{StaticResource Task.Workspace.Button}" MinWidth="38" Height="38" VerticalAlignment="Center"
                            ToolTip="Поиск и команды · Ctrl+K"
                            AutomationProperties.Name="Палитра команд" AutomationProperties.AutomationId="GlobalSearchOverlayButton"
                            AutomationProperties.HelpText="Команды и поиск доступных объектов. Сочетание клавиш Ctrl+K.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Task.Icon.Search}" Width="17" Height="17" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Поиск по приложению" Margin="8,0,10,0" VerticalAlignment="Center" Style="{StaticResource WideHeaderLabel}" />
                            <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                                       VerticalAlignment="Center" Style="{StaticResource WideHeaderLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NotificationsButton" Click="OnOpenNotifications" Margin="0,0,8,0"
                            Style="{StaticResource Task.Workspace.IconButton}" IsEnabled="{Binding WorkHub.CanReadNotifications, FallbackValue=False}"
                            ToolTip="Центр уведомлений"
                            AutomationProperties.Name="{Binding WorkHub.UnreadCount, StringFormat=Уведомления: {0} непрочитанных, FallbackValue=Центр уведомлений}"
                            AutomationProperties.AutomationId="NotificationCenterButton">
                        <Grid>
                            <Path Data="{StaticResource Task.Icon.Notifications}" Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Border Background="{DynamicResource Task.Brush.Semantic.Critical}" CornerRadius="8"
                                    MinWidth="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,-8,-8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkHub.UnreadCount, FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding WorkHub.UnreadCount}" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Command="{Binding LogoutCommand}" Style="{StaticResource Task.Workspace.IconButton}" TabIndex="4"
                            ToolTip="Выйти из учётной записи" AutomationProperties.Name="Выйти из учётной записи" AutomationProperties.AutomationId="LogoutButton"
                            AutomationProperties.HelpText="Завершить серверную сессию и удалить локальные данные входа">
                        <Path Data="{StaticResource Task.Icon.SignOut}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="10"
                        ToolTip="{Binding ConnectionStatus}" AutomationProperties.Name="{Binding ConnectionStatus}"
                        AutomationProperties.HelpText="{Binding ConnectionContext}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Task.Workspace.Background}">
                            <Setter Property="Margin" Value="0,9,0,0" />
                            <Setter Property="Padding" Value="10,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualHeight, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=540}" Value="False">
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                    <Setter Property="Padding" Value="8,3" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnected}" Value="False" />
                                        <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.WarningSoft}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Task.Brush.Semantic.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="False"><Setter Property="Fill" Value="{DynamicResource Task.Brush.Semantic.Critical}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"><Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionTitle}" FontWeight="SemiBold" Margin="0,0,12,0"
                                       AutomationProperties.AutomationId="ConnectionStatusText" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ConnectionContext}" Style="{StaticResource Task.Workspace.Meta}"
                                       VerticalAlignment="Center" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SessionMessage}" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="SessionMessageText"
                           AutomationProperties.LiveSetting="Assertive">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Task.Workspace.Body}">
                            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid x:Name="ContentRegion" Grid.Row="1" Grid.Column="1"
              Style="{StaticResource Task.Grid.SurfaceBase}"
              AutomationProperties.AutomationId="SelectedSectionArea">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="520" Margin="24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTasksSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMonthlyPlanSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInboxSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCalendarSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTodaySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsProjectsSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWorkHubSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInventorySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAdministrationSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="{Binding SelectedSection.IconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                      Width="36" Height="36" Stretch="Uniform"
                      Fill="{DynamicResource Task.Brush.Text.Secondary}"
                      Margin="0,0,0,16" />
                <TextBlock Text="{Binding SelectedSection.Title}" Style="{StaticResource Task.Workspace.Title}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="{Binding SelectedSection.PlaceholderText}" Style="{StaticResource Task.Workspace.Body}"
                           TextAlignment="Center" />
            </StackPanel>

            <!-- CMP-009 PageLayout and Task read vertical slice -->
            <Grid DataContext="{Binding Tasks}"
                  AutomationProperties.Name="Экран задач"
                  AutomationProperties.AutomationId="TasksScreen">
                <Grid.Resources>
                    <CornerRadius x:Key="Task.Radius.Control">9</CornerRadius>
                    <SolidColorBrush x:Key="TasksCanvas" Color="#FAF8F7" />
                    <SolidColorBrush x:Key="TasksDivider" Color="#EBE5E2" />
                    <SolidColorBrush x:Key="Personal.Select.Accent" Color="{DynamicResource Task.Color.Brand.Primary}" />
                    <SolidColorBrush x:Key="Personal.Select.Soft" Color="{DynamicResource Task.Color.Brand.Soft}" />

                    <Style x:Key="TasksPanel" TargetType="Border" BasedOn="{StaticResource Task.State.Panel}">
                        <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
                        <Setter Property="BorderBrush" Value="{StaticResource TasksDivider}" />
                        <Setter Property="CornerRadius" Value="14" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                    <Style x:Key="TasksFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource Task.Input.Combo}">
                        <Setter Property="MinHeight" Value="38" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="TextSearch.TextPath" Value="Name" />
                        <Setter Property="ItemTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ToolTip" Value="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualHeight, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=600}" Value="False">
                                <Setter Property="MinHeight" Value="32" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="TasksActionButton" TargetType="Button" BasedOn="{StaticResource Task.Button.Secondary}">
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                    <Style x:Key="TasksFilterLabel" TargetType="TextBlock" BasedOn="{StaticResource Task.Inspector.FactLabel}">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style x:Key="TasksStatusPill" TargetType="Border" BasedOn="{StaticResource Task.Semantic.StatusPill}">
                        <Setter Property="Padding" Value="8,2" />
                        <Setter Property="Background" Value="#F3F0EE" />
                        <Style.Triggers>
                            <Trigger Property="Tag" Value="{x:Static vm:TaskVisualTone.Brand}"><Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}" /></Trigger>
                            <Trigger Property="Tag" Value="{x:Static vm:TaskVisualTone.Warning}"><Setter Property="Background" Value="#FFF2DA" /></Trigger>
                            <Trigger Property="Tag" Value="{x:Static vm:TaskVisualTone.Success}"><Setter Property="Background" Value="#E8F5ED" /></Trigger>
                            <Trigger Property="Tag" Value="{x:Static vm:TaskVisualTone.Critical}"><Setter Property="Background" Value="{StaticResource TasksSelection}" /></Trigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="TasksRowTitle" TargetType="TextBlock" BasedOn="{StaticResource Task.Table.CellText}">
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style x:Key="TasksRowMetadata" TargetType="TextBlock" BasedOn="{StaticResource Task.Table.CellText}">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}" />
                    </Style>
                </Grid.Resources>
                <Grid.Style>
                    <Style TargetType="Grid" BasedOn="{StaticResource Task.Grid.SurfaceBase}">
                        <Setter Property="Margin" Value="20,16,20,14" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActualHeight, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=600}" Value="False">
                                <Setter Property="Margin" Value="12,8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.IsTasksSectionSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14" Padding="12,8,12,10" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource TasksCanvas}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid KeyboardNavigation.TabNavigation="Continue">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.12*" />
                            <ColumnDefinition Width="1.62*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Статус" Style="{StaticResource TasksFilterLabel}" />
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedValue="{Binding SelectedStatusFilter}" SelectedValuePath="Value"
                                      Style="{StaticResource TasksFilterCombo}" TabIndex="3"
                                      AutomationProperties.Name="Фильтр задач: статус"
                                      AutomationProperties.AutomationId="TasksStatusFilter" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Проект" Style="{StaticResource TasksFilterLabel}" />
                            <ComboBox ItemsSource="{Binding ProjectFilters}" SelectedItem="{Binding SelectedProjectFilter}"
                                      Style="{StaticResource TasksFilterCombo}" TabIndex="4"
                                      AutomationProperties.Name="Фильтр задач: проект"
                                      AutomationProperties.AutomationId="TasksProjectFilter" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Приоритет" Style="{StaticResource TasksFilterLabel}" />
                            <ComboBox ItemsSource="{Binding PriorityFilters}" SelectedValue="{Binding SelectedPriorityFilter}" SelectedValuePath="Value"
                                      Style="{StaticResource TasksFilterCombo}" TabIndex="5"
                                      AutomationProperties.Name="Фильтр задач: приоритет"
                                      AutomationProperties.AutomationId="TasksPriorityFilter" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="Срок" Style="{StaticResource TasksFilterLabel}" />
                            <ComboBox ItemsSource="{Binding DeadlineFilters}" SelectedValue="{Binding SelectedDeadlineFilter}" SelectedValuePath="Value"
                                      Style="{StaticResource TasksFilterCombo}" TabIndex="6"
                                      AutomationProperties.Name="Фильтр задач: срок"
                                      AutomationProperties.AutomationId="TasksDeadlineFilter" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Сортировка" Style="{StaticResource TasksFilterLabel}" />
                            <ComboBox ItemsSource="{Binding SortOrders}" SelectedValue="{Binding SelectedSortOrder}" SelectedValuePath="Value"
                                      Style="{StaticResource TasksFilterCombo}" TabIndex="7"
                                      AutomationProperties.HelpText="При загрузке новых задач порядок пересчитывается."
                                      AutomationProperties.Name="Сортировка загруженных задач"
                                      AutomationProperties.AutomationId="TasksSortOrder" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Task.State.Inline}" Margin="0,0,0,8"
                        Visibility="{Binding IsReadOnly, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource Task.Icon.Lock}" Width="18" Height="18"
                              Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}"
                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding WriteAccessText}"
                                   FontSize="{DynamicResource Task.Font.Size.Label}"
                                   Foreground="{DynamicResource Task.Brush.Text.Primary}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="ReadOnlyNoticeText"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,0,0,12"
                        AutomationProperties.Name="Состояние списка задач"
                        AutomationProperties.AutomationId="TasksStateMessage"
                        AutomationProperties.LiveSetting="Assertive">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowInlineMessage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="{StaticResource Task.Icon.Info}"
                              Width="18" Height="18" Stretch="Uniform"
                              Fill="{DynamicResource Task.Brush.Brand.Primary}"
                              Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ScreenMessage}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="3"
                        AutomationProperties.Name="Загрузка списка задач"
                        AutomationProperties.LiveSetting="Polite">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TasksPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInitialLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,16"
                                     Style="{StaticResource Task.Progress.Indeterminate}"
                                     AutomationProperties.Name="Выполняется загрузка задач" />
                        <TextBlock Text="Загружаем задачи…" Style="{StaticResource Task.State.Title}"
                                   TextAlignment="Center" />
                        <TextBlock Text="Список появится после ответа сервера."
                                   Style="{StaticResource Task.State.Body}"
                                   Margin="0,6,0,0" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3"
                        AutomationProperties.Name="{Binding StateTitle}"
                        AutomationProperties.LiveSetting="Assertive">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TasksPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowBlockingState}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Path Data="{Binding StateIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                              Width="28" Height="28" Stretch="Uniform"
                              Fill="{DynamicResource Task.Brush.Text.Secondary}"
                              Margin="0,0,0,12" />
                        <TextBlock Text="{Binding StateTitle}" Style="{StaticResource Task.State.Title}"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding ScreenMessage}" Style="{StaticResource Task.State.Body}"
                                   Margin="0,6,0,16" TextAlignment="Center" />
                        <Button Content="Создать задачу" Command="{Binding NewTaskCommand}" ToolTip="{Binding CreateActionHint}" ToolTipService.ShowOnDisabled="True" MinWidth="160" AutomationProperties.AutomationId="TasksEmptyCreateTask">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TasksPrimaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TasksScreenState.Empty}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" MinWidth="108" AutomationProperties.Name="Повторить загрузку списка задач">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Task.Button.Secondary}"><Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:TasksScreenState.Empty}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="TasksContentViewport" Grid.Row="3"
                              Visibility="{Binding HasItems, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="TasksContentGrid" Height="{Binding ViewportHeight, ElementName=TasksContentViewport}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="MinHeight" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsExpanded, ElementName=TaskInspectorExpander}" Value="True" />
                                        <Condition Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=1160}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="MinHeight" Value="360" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="280" />
                        <ColumnDefinition Width="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource Task.ResponsiveGridLengthConverter}, ConverterParameter=1160:14}" />
                        <ColumnDefinition Width="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource Task.ResponsiveGridLengthConverter}, ConverterParameter=1160:320}" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource TasksPanel}" Padding="0"
                            ClipToBounds="True">
                        <ListBox x:Name="TasksList"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 Style="{StaticResource Task.DataList}"
                                 BorderThickness="0" Padding="0"
                                 TabIndex="8"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 IsEnabled="{Binding CanSelectTaskRows}" state:TaskRowAction.Command="{Binding OpenRowCommand}"
                                 KeyDown="OnTasksListKeyDown"
                                 AutomationProperties.Name="Список задач"
                                 AutomationProperties.AutomationId="TasksList"
                                 AutomationProperties.HelpText="Стрелки выбирают задачу, Enter открывает сведения; двойной щелчок — изменить или просмотреть">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}"
                                                BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right"
                                                        Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}"
                                                        Visibility="{Binding ComputedVerticalScrollBarVisibility, ElementName=ListScroll}" />
                                                <Grid Margin="19,0,11,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="124" />
                                                        <ColumnDefinition Width="115" />
                                                        <ColumnDefinition Width="105" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Задача" Style="{StaticResource Task.Table.HeaderText}" />
                                                    <TextBlock Grid.Column="1" Text="Статус" Style="{StaticResource Task.Table.HeaderText}" />
                                                    <TextBlock Grid.Column="2" Text="Приоритет" Style="{StaticResource Task.Table.HeaderText}" />
                                                    <TextBlock Grid.Column="3" Text="Срок" Style="{StaticResource Task.Table.HeaderText}" />
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                        <ScrollViewer x:Name="ListScroll" Grid.Row="1" Focusable="False"
                                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Grid>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="124" />
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                                                       Style="{StaticResource TasksRowTitle}" TextWrapping="Wrap"
                                                       LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36" />
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource TasksRowMetadata}"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1}">
                                                        <Binding Path="ProjectText" />
                                                        <Binding Path="AssigneeText" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Tag="{Binding StatusTone}" Style="{StaticResource TasksStatusPill}"
                                                AutomationProperties.Name="{Binding StatusText}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path views:CompletionFeedbackBehavior.Feedback="{Binding CompletionFeedback}"
                                                      Data="{Binding StatusIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                                                      Tag="{Binding StatusTone}" Style="{StaticResource Task.Semantic.Icon}" />
                                                <TextBlock Text="{Binding StatusText}" Margin="5,0,0,0" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <Path Data="{Binding PriorityIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                                                  Tag="{Binding PriorityTone}" Style="{StaticResource Task.Semantic.Icon}" />
                                            <TextBlock Text="{Binding PriorityText}" Margin="5,0,0,0"
                                                       Style="{StaticResource Task.Table.CellText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding DeadlineText}" ToolTip="{Binding DeadlineText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Task.Table.CellText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Task.DataList.Item}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
                                    <Setter Property="Margin" Value="6,0" />
                                    <Setter Property="Padding" Value="12,7,4,7" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1">
                                                    <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="9"
                                                            BorderBrush="Transparent" BorderThickness="1" Margin="0,2">
                                                        <Grid>
                                                            <Border x:Name="SelectionMark" Width="3" Margin="0,8"
                                                                    Background="{StaticResource TasksAccent}" CornerRadius="1.5"
                                                                    HorizontalAlignment="Left" Visibility="Collapsed" />
                                                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource TasksCanvas}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource TasksSelection}" />
                                                        <Setter TargetName="Row" Property="BorderBrush" Value="#E8CCD2" />
                                                        <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                        <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                                                        <Setter TargetName="SelectionMark" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                    </MultiDataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch"
                                  Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  AutomationProperties.Name="Изменить ширину списка и сведений">
                        <GridSplitter.Style>
                            <Style TargetType="GridSplitter">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=1320}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GridSplitter.Style>
                    </GridSplitter>

                    <Expander x:Name="TaskInspectorExpander" state:ViewState.Section="main/v1/inspector"
                              AutomationProperties.Name="Сведения о выбранной задаче">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource Task.Expander.Compact}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="Header" Value="Сведения о задаче" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MaxHeight" Value="10000" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=1160}" Value="False">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Setter Property="Header"><Setter.Value><WrapPanel>
                                            <TextBlock Text="Сведения о задаче" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="Добавить подзадачу" Command="{Binding DataContext.Tasks.AddSubtaskCommand,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Task.Button.Secondary}" ToolTip="{Binding DataContext.Tasks.SubtaskActionHint,RelativeSource={RelativeSource AncestorType=Window}}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Добавить подзадачу" AutomationProperties.AutomationId="CompactAddSubtaskButton"/>
                                        </WrapPanel></Setter.Value></Setter>
                                        <Setter Property="IsExpanded" Value="False" />
                                        <Setter Property="Margin" Value="0,12,0,0" />
                                        <Setter Property="MaxHeight" Value="240" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <Border Style="{StaticResource TasksPanel}" Padding="12" Margin="0,6,0,0">
                            <ScrollViewer x:Name="TaskDetailsArea"
                                          Focusable="True"
                                          KeyboardNavigation.TabIndex="7"
                                          FocusVisualStyle="{StaticResource Task.FocusVisualStyle}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.Name="Карточка выбранной задачи"
                                          AutomationProperties.AutomationId="TaskDetailsArea"
                                          AutomationProperties.HelpText="Основные данные выбранной задачи">
                                <Grid>
                                    <TextBlock Text="{Binding DetailMessage}"
                                               Style="{StaticResource Task.State.Body}"
                                               AutomationProperties.Name="Состояние карточки задачи"
                                               AutomationProperties.AutomationId="TaskDetailsState"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel DataContext="{Binding SelectedDetails}"
                                                AutomationProperties.Name="{Binding AutomationName}" TextElement.FontWeight="Normal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="{DynamicResource Task.Font.Size.DetailTitle}"
                                                   FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="76" Margin="0,0,0,10"
                                                   ToolTip="{Binding Title}" />
                                        <WrapPanel Margin="0,0,0,12">
                                            <Border Style="{StaticResource TasksStatusPill}" Tag="{Binding StatusTone}" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{Binding StatusIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                                                          Tag="{Binding StatusTone}"
                                                          Style="{StaticResource Task.Semantic.Icon}" />
                                                    <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{Binding PriorityIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                                                      Tag="{Binding PriorityTone}"
                                                      Style="{StaticResource Task.Semantic.Icon}" />
                                                <TextBlock Text="{Binding PriorityText}" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,0,0,4">
                                            <Button Content="Изменить"
                                                    Command="{Binding DataContext.Tasks.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,0,6,6"
                                                    AutomationProperties.Name="Изменить выбранную задачу"
                                                    AutomationProperties.AutomationId="EditTaskButton">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TasksActionButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.Tasks.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Подзадача" Command="{Binding DataContext.Tasks.AddSubtaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,6,6" ToolTip="{Binding DataContext.Tasks.SubtaskActionHint, RelativeSource={RelativeSource AncestorType=Window}}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Добавить подзадачу" AutomationProperties.AutomationId="AddSubtaskButton"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TasksActionButton}"><Style.Triggers><DataTrigger Binding="{Binding ActualWidth,ElementName=RootWindow,Converter={StaticResource Task.WindowWidthAtLeastConverter},ConverterParameter=1160}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                            <Button Content="Похожая" ToolTip="Создать похожую задачу"
                                                    Command="{Binding DataContext.Tasks.CreateSimilarTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Margin="0,0,6,6"
                                                    AutomationProperties.Name="Создать похожую задачу"
                                                    AutomationProperties.HelpText="Открыть форму создания с безопасными полями исходной задачи. Сохранение требует подтверждения."
                                                    AutomationProperties.AutomationId="CreateSimilarTaskButton">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource TasksActionButton}">
