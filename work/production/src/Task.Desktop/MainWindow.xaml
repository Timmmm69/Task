<Window x:Class="Task.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Task"
        Width="1000" Height="640" MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Visible connection status -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="#C00000"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ConnectionStatus}"
                           AutomationProperties.AutomationId="ConnectionStatusText"
                           AutomationProperties.LiveSetting="Polite"
                           VerticalAlignment="Center" Foreground="#333333" FontSize="12" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation panel -->
            <Border Grid.Column="0" Background="#F0F2F5" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Разделы" FontWeight="SemiBold" FontSize="14"
                               Margin="16,16,16,8" Foreground="#555555" />
                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             AutomationProperties.Name="Разделы"
                             AutomationProperties.HelpText="Выбор раздела для отображения в области содержимого"
                             AutomationProperties.AutomationId="NavigationListBox"
                             Background="Transparent" BorderThickness="0" Padding="8"
                             Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#E3E7EC" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#D5E4F5" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2B6CB0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Safe placeholder for the selected section -->
            <Grid Grid.Column="1" Background="White"
              AutomationProperties.AutomationId="SelectedSectionArea">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="520" Margin="40">
                    <TextBlock Text="{Binding SelectedSection.Title}"
                               AutomationProperties.LiveSetting="Polite"
                               FontSize="26" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding SelectedSection.PlaceholderText}"
                               AutomationProperties.LiveSetting="Polite"
                               FontSize="14" Foreground="#666666"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>