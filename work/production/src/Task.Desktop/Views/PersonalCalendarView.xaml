<UserControl x:Class="Task.Desktop.Views.PersonalCalendarView" x:Name="Surface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Task.Desktop.Views" xmlns:vm="clr-namespace:Task.Desktop.ViewModels"
    Background="White" Foreground="{DynamicResource Personal.Airbnb.Ink}" FontSize="13" SizeChanged="OnSurfaceSizeChanged"
    AutomationProperties.Name="Личный календарь" AutomationProperties.AutomationId="PersonalCalendarScreen">
    <UserControl.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Calendar.xaml"/></ResourceDictionary.MergedDictionaries>
        <local:PersonalCalendarValueConverter x:Key="Value"/><local:PersonalCalendarLabelOffsetConverter x:Key="LabelOffset"/><local:PersonalCalendarPeriodConverter x:Key="Period"/>
        <local:PersonalCalendarSelectedDateConverter x:Key="SelectedDate"/><local:PersonalCalendarLaneConverter x:Key="Lane"/>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <DataTemplate x:Key="CompactEntry">
            <Button Command="{Binding DataContext.SelectItemCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                Style="{StaticResource Personal.Calendar.Entry}" Margin="0,0,0,3" ToolTip="{Binding AutomationName}" AutomationProperties.Name="{Binding AutomationName}">
                <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Source.Status,Converter={StaticResource Value},ConverterParameter=StatusSymbol,Mode=OneWay}"/><Run Text="{Binding IsCalendarEvent,Converter={StaticResource Value},ConverterParameter=Symbol,Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Title,Mode=OneWay}"/></TextBlock>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="DayHeader"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button Click="OnChooseDay" Tag="{Binding}" Padding="2,5" ToolTip="{Binding AutomationName}" AutomationProperties.Name="{Binding AutomationName}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}">
                    <Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Ink}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Personal.Airbnb.Soft}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                    <Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource SelectedDate}"><Binding Path="Date"/><Binding Path="DataContext.SelectedDate" ElementName="Surface"/></MultiBinding></DataTrigger.Binding><Setter Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Ink}"/></DataTrigger></Style.Triggers>
                </Style></Button.Style>
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{Binding DayName}" FontWeight="Normal" Foreground="{StaticResource Personal.Airbnb.Secondary}"/><TextBlock Text="{Binding Items.Count,StringFormat=' · {0}'}" FontWeight="Normal" Foreground="{StaticResource Personal.Airbnb.Secondary}"/></StackPanel>
                    <Border Width="29" Height="29" CornerRadius="15" Margin="0,3,0,0">
                        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{StaticResource Personal.Airbnb.Ink}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding DayNumberText}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Border>
                </StackPanel>
            </Button>
        <Button Grid.Row="1" Click="OnOpenDay" Tag="{Binding}" Content="{Binding TimelineItems,Converter={StaticResource Value},ConverterParameter=WeekOverflowText}" Padding="4,1" HorizontalAlignment="Center" FontSize="11" AutomationProperties.Name="{Binding AutomationName,StringFormat=Открыть день: {0}}">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}">
                    <Setter Property="Visibility" Value="{Binding TimelineItems,Converter={StaticResource Value},ConverterParameter=WeekOverflowVisibility}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding DataContext.ViewMode,ElementName=Surface}" Value="{x:Static vm:CalendarViewMode.Day}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.ViewMode,ElementName=Surface}" Value="{x:Static vm:CalendarViewMode.Month}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style></Button.Style>
            </Button></Grid></DataTemplate>
    </ResourceDictionary></UserControl.Resources>
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="Page" Margin="24,16,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,14" VerticalAlignment="Center">
            <TextBlock Text="{Binding WeekRangeText}" FontSize="23" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,8" AutomationProperties.LiveSetting="Polite"/>
            <Button Content="Сегодня" Command="{Binding TodayCommand}" Style="{StaticResource Personal.Airbnb.Compact}" Margin="0,0,8,8"/>
            <Button Content="‹" Command="{Binding PreviousWeekCommand}" Style="{StaticResource Personal.Airbnb.Compact}" Margin="0,0,4,8" AutomationProperties.Name="Предыдущий период"/>
            <Button Content="›" Command="{Binding NextWeekCommand}" Style="{StaticResource Personal.Airbnb.Compact}" Margin="0,0,8,8" AutomationProperties.Name="Следующий период"/>
            <DatePicker x:Name="DatePicker" SelectedDate="{Binding SelectedDate}" Width="140" Margin="0,0,0,8" Style="{StaticResource Task.Input.Date}" AutomationProperties.Name="Дата календаря"/>
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="{StaticResource Personal.Airbnb.Soft}" CornerRadius="24" Padding="3" Margin="0,0,12,8"><StackPanel Orientation="Horizontal">
                <Button Content="День" Command="{Binding DayModeCommand}" Style="{StaticResource Personal.Calendar.DayMode}" AutomationProperties.Name="Режим дня"/>
                <Button Content="Неделя" Command="{Binding WeekModeCommand}" Style="{StaticResource Personal.Calendar.WeekMode}" AutomationProperties.Name="Режим недели"/>
                <Button Content="Месяц" Command="{Binding MonthModeCommand}" Style="{StaticResource Personal.Calendar.MonthMode}" AutomationProperties.Name="Режим месяца"/>
            </StackPanel></Border>
            <Button Content="+  Новое событие" Command="{Binding NewEventCommand}" Style="{StaticResource Personal.Calendar.Action}" Margin="0,3,8,8" AutomationProperties.AutomationId="PersonalCalendarNewEvent"/>
            <Button Content="Найти время" Command="{Binding FindTimeCommand}" Style="{StaticResource Personal.Airbnb.Compact}" Margin="0,3,8,8"/>
            <Button Content="Повторения" Command="{Binding Recurrence.OpenCommand}" AutomationProperties.AutomationId="PersonalOpenRecurrences" Style="{StaticResource Personal.Airbnb.Compact}" Margin="0,3,8,8"/>
            <Button Content="↻" Command="{Binding RefreshCommand}" Style="{StaticResource Personal.Airbnb.Compact}" Margin="0,3,8,8" AutomationProperties.Name="Обновить календарь"/>
            <TextBlock Text="○ Событие   □ Задача · ✓ Завершена" Foreground="{StaticResource Personal.Airbnb.Secondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"/>
        </WrapPanel>
        <StackPanel Grid.Row="2">
            <Border Visibility="{Binding ShowFreeTime,Converter={StaticResource Visible}}" Background="{StaticResource Personal.Airbnb.Soft}" CornerRadius="12" Padding="12" Margin="0,0,0,10" MaxHeight="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <WrapPanel><TextBlock Text="Свободное время" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,4"/>
                        <Button Content="15 мин" Command="{Binding FreeTimeDurationCommand}" CommandParameter="15" Style="{StaticResource Personal.Airbnb.Compact}"/>
                        <Button Content="30 мин" Command="{Binding FreeTimeDurationCommand}" CommandParameter="30" Style="{StaticResource Personal.Airbnb.Compact}"/>
                        <Button Content="60 мин" Command="{Binding FreeTimeDurationCommand}" CommandParameter="60" Style="{StaticResource Personal.Airbnb.Compact}"/>
                        <Button Content="Закрыть" Command="{Binding CloseFreeTimeCommand}" Style="{StaticResource Personal.Airbnb.Compact}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding FreeTimeMessage}" TextWrapping="Wrap" Margin="0,6" AutomationProperties.LiveSetting="Polite"/>
                    <ItemsControl ItemsSource="{Binding FreeTimeSlots}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding DataContext.ChooseFreeTimeCommand,ElementName=Surface}" CommandParameter="{Binding}" Style="{StaticResource Personal.Airbnb.Compact}" Margin="0,0,0,4" HorizontalAlignment="Left"/>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Button Content="Искать в следующей неделе" Command="{Binding MoreFreeTimeCommand}" Style="{StaticResource Personal.Airbnb.Compact}" HorizontalAlignment="Left"/>
                </StackPanel></ScrollViewer>
            </Border>
            <WrapPanel Visibility="{Binding HasChosenFreeTime,Converter={StaticResource Visible}}" Margin="0,0,0,10">
                <TextBlock Text="{Binding ChosenFreeTime.Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Создать задачу в это время" Command="{Binding CreateTaskAtFreeTimeCommand}" Style="{StaticResource Personal.Airbnb.Compact}"/>
                <TextBlock Text="Окно не зарезервировано." Foreground="{StaticResource Personal.Airbnb.Secondary}" Margin="10,8,0,0"/>
            </WrapPanel>
            <TextBlock Text="{Binding Message}" Visibility="{Binding ShowMessage,Converter={StaticResource Visible}}" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding RollbackMessage}" Visibility="{Binding ShowRollback,Converter={StaticResource Visible}}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#A13B21"/>
        </StackPanel>
        <Grid x:Name="Body" Grid.Row="3" SizeChanged="OnSurfaceSizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="300"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="CalendarRow" Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" Background="White">
                <Grid>
                    <ScrollViewer x:Name="HorizontalScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding IsTimelineMode,Converter={StaticResource Visible}}">
                        <Grid x:Name="TimelineGrid" Width="{Binding ActualWidth,ElementName=HorizontalScroll}" MinWidth="850">
                            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Время" Foreground="{StaticResource Personal.Airbnb.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                            <ItemsControl ItemsSource="{Binding Days}" Margin="58,0,0,0" ItemTemplate="{StaticResource DayHeader}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CalendarColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                            <Grid x:Name="AllDaySection" Grid.Row="1" MaxHeight="100" ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Без&#10;времени" Foreground="{StaticResource Personal.Airbnb.Secondary}" FontSize="11" Margin="6,2"/>
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CalendarColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EEEEEE" BorderThickness="1,1,0,1" Padding="3"><ItemsControl ItemsSource="{Binding AllDayItems}" ItemTemplate="{StaticResource CompactEntry}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                            <ScrollViewer x:Name="TimelineScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="Временная сетка · F6 для перехода к деталям">
                                <Grid Height="{Binding TimelineCanvasHeight}">
                                    <ItemsControl ItemsSource="{Binding HourMarkers}" IsHitTestVisible="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate><DataTemplate><Grid Width="{Binding ActualWidth,ElementName=TimelineGrid}" Height="69"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Personal.Airbnb.Secondary}" Margin="8,3"/><Border Margin="58,0,0,0" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Days}" Margin="58,0,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CalendarColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Height="{Binding DataContext.TimelineCanvasHeight,ElementName=Surface}" ClipToBounds="True">
                                                <Border BorderBrush="#EEEEEE" BorderThickness="1,0,0,0" IsHitTestVisible="False"/>
                                                <Canvas IsHitTestVisible="False" Panel.ZIndex="20" Visibility="{Binding ShowCurrentTime,Converter={StaticResource Visible}}"><Border Canvas.Top="{Binding CurrentTimeTop}" Height="1" Background="{StaticResource Personal.Airbnb.Accent}" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Grid}}"/></Canvas>
                                                <ItemsControl ItemsSource="{Binding TimelineItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Top" Value="{Binding TimelineTop}"/><Setter Property="Height" Value="{Binding TimelineHeight}"/>
                                                        <Setter Property="Canvas.Left"><Setter.Value><MultiBinding Converter="{StaticResource Lane}" ConverterParameter="Left"><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/><Binding Path="TimelineLane"/><Binding Path="TimelineLaneCount"/><Binding Path="DataContext.ViewMode" ElementName="Surface"/></MultiBinding></Setter.Value></Setter>
                                                        <Setter Property="Width"><Setter.Value><MultiBinding Converter="{StaticResource Lane}" ConverterParameter="Width"><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/><Binding Path="TimelineLane"/><Binding Path="TimelineLaneCount"/><Binding Path="DataContext.ViewMode" ElementName="Surface"/></MultiBinding></Setter.Value></Setter>
                                                        <Setter Property="Visibility"><Setter.Value><MultiBinding Converter="{StaticResource Lane}" ConverterParameter="Visibility"><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/><Binding Path="TimelineLane"/><Binding Path="TimelineLaneCount"/><Binding Path="DataContext.ViewMode" ElementName="Surface"/></MultiBinding></Setter.Value></Setter>
                                                    </Style></ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectItemCommand,ElementName=Surface}" CommandParameter="{Binding Item}" Style="{StaticResource Personal.Calendar.TimelineEntry}" ToolTip="{Binding Item.AutomationName}" AutomationProperties.Name="{Binding Item.AutomationName}" AutomationProperties.AutomationId="PersonalTimelineItem">
                                                            <Grid ClipToBounds="True"><Grid.RenderTransform><TranslateTransform><TranslateTransform.Y><MultiBinding Converter="{StaticResource LabelOffset}"><Binding Path="VerticalOffset" ElementName="TimelineScroll"/><Binding Path="TimelineTop"/><Binding Path="TimelineHeight"/></MultiBinding></TranslateTransform.Y></TranslateTransform></Grid.RenderTransform><Grid.RowDefinitions><RowDefinition Height="15"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                                <TextBlock FontSize="10" TextTrimming="CharacterEllipsis"><Run Text="{Binding Item.IsCalendarEvent,Converter={StaticResource Value},ConverterParameter=Symbol,Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Item.TimeText,Mode=OneWay}"/></TextBlock>
                                                                <TextBlock Grid.Row="1" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="48" VerticalAlignment="Top"><Run Text="{Binding Item.Source.Status,Converter={StaticResource Value},ConverterParameter=StatusSymbol,Mode=OneWay}"/><Run Text="{Binding Item.HasConflict,Converter={StaticResource Value},ConverterParameter=Conflict,Mode=OneWay}"/><Run Text="{Binding Item.Title,Mode=OneWay}"/></TextBlock>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Margin="58,0,0,0" VerticalAlignment="Top" Height="{Binding ChosenFreeTime.Height}" Background="#30222222" IsHitTestVisible="False" Visibility="{Binding ShowFreeTimeHighlight,Converter={StaticResource Visible}}">
                                        <Border.RenderTransform><TranslateTransform Y="{Binding ChosenFreeTime.Top}"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                    <ScrollViewer x:Name="MonthScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsMonthMode,Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Days}" Width="{Binding ViewportWidth,ElementName=MonthScroll}" MinWidth="700"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#EEEEEE" BorderThickness="0,0,1,1" Padding="4" Height="188">
                                <StackPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource DayHeader}"/>
                                    <ItemsControl ItemsSource="{Binding Items,Converter={StaticResource Value},ConverterParameter=Preview}" ItemTemplate="{StaticResource CompactEntry}"/>
                                    <Button Click="OnOpenDay" Tag="{Binding}" Content="{Binding Items.Count,Converter={StaticResource Value},ConverterParameter=OverflowText}" Visibility="{Binding Items.Count,Converter={StaticResource Value},ConverterParameter=OverflowVisibility}" Style="{StaticResource Personal.Airbnb.Compact}" Padding="6,3" HorizontalAlignment="Left" AutomationProperties.Name="{Binding AutomationName}"/>
                                </StackPanel>
                            </Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Background="#EFFFFFFF" Visibility="{Binding ShowInitialLoading,Converter={StaticResource Visible}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><ProgressBar Width="180" Height="3" IsIndeterminate="True"/><TextBlock Text="Загрузка расписания…" Margin="0,12"/></StackPanel></Border>
                    <Border Visibility="{Binding ShowEmptyState,Converter={StaticResource Visible}}" Background="#F4FFFFFF" Padding="16" IsHitTestVisible="False"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Пока нет записей" FontWeight="Bold" FontSize="20" TextAlignment="Center"/><TextBlock Text="Создайте событие или выберите другой период." Foreground="{StaticResource Personal.Airbnb.Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8"/></StackPanel></Border>
                </Grid>
            </Border>
            <Border x:Name="DetailsPane" Grid.Column="1" Margin="18,0,0,0" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1" CornerRadius="16" Background="White" Padding="16" AutomationProperties.Name="Записи дня и детали">
                <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True">
                    <Grid>
                        <StackPanel x:Name="DayAgenda">
                            <TextBlock Text="{Binding DayCaption,ElementName=Surface}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DayItems.Count,ElementName=Surface,StringFormat='Записей: {0} · местное время'}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,5,0,14"/>
                            <TextBlock Text="День свободен. Можно запланировать событие или найти время для задачи." TextWrapping="Wrap" Foreground="{StaticResource Personal.Airbnb.Secondary}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DayItems.Count,ElementName=Surface}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <ItemsControl ItemsSource="{Binding DayItems,ElementName=Surface}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Button Command="{Binding DataContext.SelectItemCommand,ElementName=Surface}" CommandParameter="{Binding}" Style="{StaticResource Personal.Calendar.Entry}" Margin="0,0,0,6" Padding="10" ToolTip="{Binding AutomationName}" AutomationProperties.Name="{Binding AutomationName}">
                                    <StackPanel><TextBlock FontSize="11" Foreground="{StaticResource Personal.Airbnb.Secondary}"><Run Text="{Binding TypeText,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TimeText,Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel x:Name="SelectionDetails" Visibility="{Binding HasSelectedItem,Converter={StaticResource Visible}}">
                            <Button x:Name="BackToDayButton" Content="‹  К записям дня" Click="OnClearSelection" Style="{StaticResource Personal.Airbnb.Compact}" Padding="0,6" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                            <StackPanel DataContext="{Binding SelectedItem}">
                                <TextBlock Text="{Binding TypeText}" Style="{StaticResource Personal.Airbnb.Muted}"/>
                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                <TextBlock Text="{Binding Source.LocalDate,StringFormat='{}{0:dddd, d MMMM}',ConverterCulture=ru-RU}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SelectedPeriod" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,4"><TextBlock.Text><MultiBinding Converter="{StaticResource Period}"><Binding/><Binding Path="DataContext.TimeZoneText" ElementName="Surface"/></MultiBinding></TextBlock.Text></TextBlock><TextBlock Text="{Binding StatusText}"/>
                                <TextBlock Text="{Binding PriorityText}" Foreground="{StaticResource Personal.Airbnb.Secondary}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap" Foreground="#A13B21" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Description,TargetNullValue='Описание не добавлено.'}" TextWrapping="Wrap" Margin="0,12,0,16"/>
                            </StackPanel>
                            <Button x:Name="EditEventButton" Content="Изменить событие" Command="{Binding EditEventCommand}" Style="{StaticResource Personal.Airbnb.Compact}" HorizontalAlignment="Left"><Button.Visibility><Binding Path="SelectedItem.IsCalendarEvent" Converter="{StaticResource Visible}"/></Button.Visibility></Button>
                            <Button Content="Открыть задачу" Click="OnOpenTask" HorizontalAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.IsCalendarEvent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <Button Content="Напоминания" Click="OnOpenReminders" Style="{StaticResource Personal.Airbnb.Compact}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            <Button Content="Открыть повторения" Command="{Binding Recurrence.OpenCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}"><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Source.RecurrenceSeriesId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
