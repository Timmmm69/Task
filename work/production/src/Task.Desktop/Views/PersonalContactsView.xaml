<UserControl x:Class="Task.Desktop.Views.PersonalContactsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Task.Desktop.Views" Background="White" Foreground="{DynamicResource Personal.Airbnb.Ink}" FontSize="14" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource Personal.Airbnb.Input}"/>
  <Style TargetType="Expander" BasedOn="{StaticResource Task.Expander.Compact}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,16,0,0"/></Style>
  <Style x:Key="Contacts.AddButton" TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}">
   <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="18,0"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="{StaticResource Personal.Airbnb.Accent}"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Ink}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Contacts.Row" TargetType="ListBoxItem" BasedOn="{StaticResource Personal.Airbnb.BrowserRow}"><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,1"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Preview}"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="{DynamicResource Task.Padding.Workspace}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="Ваши контакты" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="Люди, с которыми вы на связи" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,5,12,0"/></StackPanel>
   <Button Grid.Column="1" Click="OnNew" Style="{StaticResource Contacts.AddButton}" VerticalAlignment="Center" AutomationProperties.Name="Новый контакт" AutomationProperties.AutomationId="PersonalContactsNew" ToolTip="Новый контакт · Ctrl+N"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource Task.Icon.Add}" Width="16" Height="16" Stretch="Uniform" Fill="White" Margin="0,0,9,0"/><TextBlock Text="Новый контакт" VerticalAlignment="Center"/></StackPanel></Button>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid><TextBox x:Name="ContactSearch" Text="{Binding ContactQuery,UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Поиск контактов по имени, фамилии и заметкам" AutomationProperties.AutomationId="PersonalContactsSearch" ToolTip="Поиск по имени, фамилии, отображаемому имени и заметкам · Ctrl+F"/>
    <TextBlock Text="Имя, фамилия или текст заметки" Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource Personal.Airbnb.Secondary}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ContactQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <Button Grid.Column="1" Content="↻" Command="{Binding Hub.RefreshCommand}" Margin="10,0,0,0" Width="42" Padding="0" AutomationProperties.Name="Обновить контакты" ToolTip="Обновить контакты · F5"/>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,0,0,12">
   <WrapPanel><ComboBox Width="172" ItemsSource="{Binding ContactFilters}" SelectedItem="{Binding ContactFilter}" AutomationProperties.Name="Фильтр контактов" Margin="0,0,10,8"/><ComboBox Width="154" ItemsSource="{Binding ContactSortOrders}" SelectedItem="{Binding ContactSort}" AutomationProperties.Name="Сортировка контактов по имени" Margin="0,0,10,8"/>
    <Button Content="Сбросить" Click="OnReset" IsEnabled="{Binding HasContactFilters}" Padding="14,7" Margin="0,0,0,8" AutomationProperties.Name="Сбросить поиск и фильтры контактов"/>
   </WrapPanel>
   <TextBlock Text="{Binding ContactCountText}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  <ScrollViewer x:Name="BodyScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
   <Grid x:Name="BrowserGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="340"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
    <Grid x:Name="ListRegion" Margin="0,0,20,0">
     <ListBox x:Name="ContactsList" Style="{StaticResource Personal.Airbnb.VirtualList}" ItemContainerStyle="{StaticResource Contacts.Row}" ItemsSource="{Binding VisibleContacts}" SelectedItem="{Binding ContactSelection}" AutomationProperties.Name="Личные контакты" AutomationProperties.AutomationId="PersonalContactsList" PreviewKeyDown="OnListKey">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Personal.Airbnb.Soft}" VerticalAlignment="Center" HorizontalAlignment="Left"><Path Data="{StaticResource Task.Icon.Contacts}" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource Personal.Airbnb.Secondary}"/></Border>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Preview}" Foreground="{StaticResource Personal.Airbnb.Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" ToolTip="{Binding Preview}"/></StackPanel>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border Background="White" Padding="24" Visibility="{Binding ShowContactsEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"><TextBlock Text="{Binding ContactsEmptyTitle}" Style="{StaticResource Personal.Airbnb.Heading}" TextAlignment="Center"/><TextBlock Text="{Binding ContactsEmptyHint}" Style="{StaticResource Personal.Airbnb.Muted}" TextAlignment="Center" Margin="0,10,0,0"/></StackPanel></Border>
     <Border Background="White" Padding="24" Visibility="{Binding ContactLoadFailed,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center"><TextBlock Text="Не удалось обновить контакты" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="{Binding Hub.Message}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,10,0,16"/><Button Content="Повторить" Click="OnRefresh" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Background="White" Visibility="{Binding Hub.IsLoading,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="160" Height="3"/><TextBlock Text="Загружаем контакты…" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    </Grid>
    <Border x:Name="DetailsPanel" Grid.Column="1" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1" CornerRadius="16" Padding="24" VerticalAlignment="Top">
     <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <StackPanel Visibility="{Binding ShowContactSelectionHint,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="Карточка контакта" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="18"/><TextBlock Text="Выберите человека в списке — здесь появятся его данные и связанные записи." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,12,0,0"/><TextBlock Text="↑ ↓ — выбор · Enter — к карточке" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,18,0,0"/></StackPanel>
      <StackPanel Visibility="{Binding ShowContactDetails,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Personal.Airbnb.Soft}" VerticalAlignment="Top" HorizontalAlignment="Left"><Path Data="{StaticResource Task.Icon.Contacts}" Width="21" Height="21" Stretch="Uniform" Fill="{StaticResource Personal.Airbnb.Secondary}"/></Border>
        <StackPanel Grid.Column="1"><TextBlock Text="Личный контакт" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12"/><TextBlock Text="{Binding ContactSelection.Name}" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="20" Margin="0,5,0,0"/></StackPanel>
       </Grid>
       <TextBlock Text="Этот контакт скрыт поиском или фильтром. Карточка остаётся открытой." Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,14,0,0" Visibility="{Binding IsContactSelectionHidden,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
       <Border Background="{StaticResource Personal.Airbnb.Soft}" CornerRadius="12" Padding="14" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Имя" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ContactSelection.Source.FirstName}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="Фамилия" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,12,0,0" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ContactSelection.LastName}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="{Binding ContactSelection.HasPhone,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Телефон" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ContactSelection.Phone}" TextWrapping="Wrap"/></Grid>
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="{Binding ContactSelection.HasEmail,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Почта" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ContactSelection.Email}" TextWrapping="Wrap"/></Grid>
       </Grid></Border>
       <TextBlock Text="Заметки" FontWeight="Bold" Margin="0,20,0,8"/><TextBlock Text="{Binding ContactSelection.Notes}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="16"/>
       <Border Height="1" Background="{StaticResource Personal.Airbnb.Hairline}" Margin="0,20,0,16"/>
       <WrapPanel><Button Content="В архив" Command="{Binding ArchiveCommand}" Margin="0,0,8,0"/><Button Content="В корзину…" Click="OnTrash" IsEnabled="{Binding CanTrash}"/></WrapPanel>
       <Expander x:Name="LinksSection" Header="Связанные записи"><StackPanel Margin="0,10,0,0"><TextBlock Text="Связать с записью" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding ActiveObjects}" SelectedItem="{Binding Target}" AutomationProperties.Name="Связать контакт с записью"/><views:ObjectLinksView DataContext="{Binding Links}"/></StackPanel></Expander>
      </StackPanel>
      <StackPanel Visibility="{Binding IsContactCreating,Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="PersonalContactCreateForm">
       <TextBlock Text="Новый контакт" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="20"/><TextBlock Text="Укажите имя и то, как контакт будет выглядеть в списке." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,4"/>
       <TextBlock Text="Имя · обязательно" Style="{StaticResource Personal.Label}"/><TextBox x:Name="NewFirstName" Text="{Binding Hub.NewContactFirstName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Имя нового контакта"/>
       <TextBlock Text="Фамилия" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding Hub.NewContactLastName,UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Фамилия нового контакта"/>
       <TextBlock Text="Отображаемое имя · обязательно" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding Hub.NewContactDisplayName,UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Отображаемое имя нового контакта"/>
       <WrapPanel Margin="0,20,0,0"><Button Content="Создать контакт" Click="OnCreate" IsEnabled="{Binding CanSubmitContact}" Background="{StaticResource Personal.Airbnb.Ink}" Foreground="White" Margin="0,0,8,8" AutomationProperties.AutomationId="PersonalContactCreate"/><Button Content="К карточке" Click="OnCloseCreate" Margin="0,0,0,8" ToolTip="Закрыть форму, сохранив черновик"/></WrapPanel>
       <TextBlock Text="Черновик сохраняется при поиске и обновлении списка." Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,6,0,0"/>
      </StackPanel>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="4"><TextBlock Text="{Binding Hub.Message}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Assertive"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></StackPanel>
 </Grid>
</UserControl>
