<UserControl x:Class="Task.Desktop.Views.TodayView"
             x:Name="TodayRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Task.Desktop.Views" xmlns:state="clr-namespace:Task.Desktop.Infrastructure"
             AutomationProperties.Name="Сегодня"
             AutomationProperties.AutomationId="TodayScreen"
             FontSize="14"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/Personal.Calendar.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Today.CoralInk" Color="{DynamicResource Task.Color.Brand.Primary}" />
        <SolidColorBrush x:Key="Today.Rose" Color="{DynamicResource Task.Color.Brand.Soft}" />
        <SolidColorBrush x:Key="Today.RoseLine" Color="#E8CCD2" />
        <SolidColorBrush x:Key="Today.Teal" Color="#005A6E" />
        <SolidColorBrush x:Key="Today.TealSoft" Color="#E8F4F8" />
        <SolidColorBrush x:Key="Today.TealLine" Color="#D4E8EE" />

        <ControlTemplate x:Key="Today.ControlChrome" TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Task.Brush.Text.Secondary}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Task.Brush.Text.Primary}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Today.Action" TargetType="Button" BasedOn="{StaticResource Task.Button.Secondary}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
            <Setter Property="Template" Value="{StaticResource Today.ControlChrome}" />
        </Style>

        <Style x:Key="Today.Create" TargetType="Button" BasedOn="{StaticResource Today.Action}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <Trigger Property="Command" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Today.CoralInk}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Today.CoralInk}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Today.FlatButton" TargetType="Button" BasedOn="{StaticResource Personal.Calendar.EntryChrome}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Subtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}" />
            <Setter Property="Template" Value="{StaticResource Today.ControlChrome}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Text.Primary}" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="Выбрано" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Today.Rose}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Today.CoralInk}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Today.TimedEntry" TargetType="Button" BasedOn="{StaticResource Today.FlatButton}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                        <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Today.TealSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Today.TealLine}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Today.RoseSurface" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Today.Rose}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Today.RoseLine}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Today.TealSurface" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Subtle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Today.TealSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Today.TimedIcon" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource Task.Brush.Text.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource Today.Teal}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Today.CardSurface" TargetType="Border" BasedOn="{StaticResource Task.Workspace.Card}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="Today.Section" TargetType="Expander" BasedOn="{StaticResource Task.Card.Section}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="Today.PriorityIcon" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource Task.Brush.Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TodayTimelineCardTemplate">
            <Grid Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}"
                  Height="{Binding TimelineHeight}">
                <Button Style="{StaticResource Today.TimedEntry}"
                        Command="{Binding DataContext.SelectItemCommand, ElementName=TodayRoot}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding AutomationName}"
                        AutomationProperties.AutomationId="TodayTimelineTask" ToolTip="{Binding AutomationName}">
                    <Button.Margin>
                        <MultiBinding Converter="{StaticResource Task.TimelineLaneMarginConverter}">
                            <Binding Path="ActualWidth" ElementName="TimelineCanvasHost" />
                            <Binding Path="TimelineLane" />
                            <Binding Path="TimelineLaneCount" />
                        </MultiBinding>
                    </Button.Margin>
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Path Data="{Binding StatusIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Style="{StaticResource Today.TimedIcon}" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Task.Workspace.Meta}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding TimeText, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TodayAllDayTemplate">
            <Button Margin="0,0,8,0" Padding="12,6" MinHeight="44" Width="244" ToolTip="{Binding AutomationName}"
                    Style="{StaticResource Today.FlatButton}"
                    Command="{Binding DataContext.SelectItemCommand, ElementName=TodayRoot}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                               LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TodayQueueTemplate">
            <Button Style="{StaticResource Today.FlatButton}"
                    MinHeight="56" Margin="0,0,0,8" ToolTip="{Binding AutomationName}"
                    Command="{Binding DataContext.SelectItemCommand, ElementName=TodayRoot}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    AutomationProperties.AutomationId="TodayQueueTask">
                <StackPanel Margin="12,8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"
                               LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                               TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,4,0,0">
                        <Path DockPanel.Dock="Right" Data="{Binding PriorityIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                              Style="{StaticResource Today.PriorityIcon}" Margin="6,0,0,0"
                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Task.Workspace.Meta}">
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding DeadlineText, Mode=OneWay}" />
                            <Run Text=" · " Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                            <Run Text="{Binding ProjectText, Mode=OneWay}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:WorkdayFooter Grid.Row="4" DataContext="{Binding DataContext.Workday, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <Border Grid.RowSpan="3" Style="{StaticResource Task.Workspace.Background}" />

        <Border x:Name="TodayStateBanner" Grid.Row="0" Padding="16,10"
                BorderThickness="0,0,0,1"
                AutomationProperties.Name="{Binding StateTitle}"
                AutomationProperties.AutomationId="TodayStateBanner"
                AutomationProperties.LiveSetting="Assertive">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Warning}" />
                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.WarningSoft}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowStateBanner}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStateCritical}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                            <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.CriticalSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Task.Icon.Warning}" Width="18" Height="18" Stretch="Uniform"
                      Fill="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"
                      VerticalAlignment="Top" Margin="0,1,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding StateTitle}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                               AutomationProperties.AutomationId="TodayStateBanner" />
                    <TextBlock Text="{Binding StateDescription}" Margin="0,2,0,0"
                               FontSize="{DynamicResource Task.Font.Size.Metadata}"
                               Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding ActionMessage}" TextWrapping="Wrap" Margin="24,8,24,0"
                   AutomationProperties.Name="{Binding ActionMessage}"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="TodayActionMessage">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Task.Workspace.Body}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActionMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding ActionMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="2" Padding="12,0"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <views:TodayGettingStartedView DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Border>

        <Grid x:Name="TodayThreeZoneGrid" Grid.Row="3" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="256" MaxWidth="384" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Today.CardSurface}" Margin="0,0,16,0" Padding="0,0,0,6">
                <Grid x:Name="TodayPlannerRegion" ClipToBounds="True"
                      AutomationProperties.Name="План дня"
                      AutomationProperties.AutomationId="TodayPlannerRegion">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Today.RoseSurface}" CornerRadius="15,15,0,0"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="20,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="План дня" Style="{StaticResource Personal.Airbnb.Heading}"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Style="{StaticResource Task.Workspace.Meta}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding TimelineItems.Count, Mode=OneWay, StringFormat='По времени: {0}'}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding AllDayItems.Count, Mode=OneWay, StringFormat='Без времени: {0}'}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Today.Create}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.NewTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{Binding DataContext.ReadOnlyActionReason, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=Новая задача · Alt+N}"
                                    ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Новая задача"
                                    AutomationProperties.AutomationId="NewTaskButton">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Task.Icon.Add}" Width="14" Height="14" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Новая задача" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource Task.Brush.Border.Default}"
                            Visibility="{Binding HasAllDayItems, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Без времени" Margin="20,0,4,0" VerticalAlignment="Center"
                                       Style="{StaticResource Task.Workspace.Meta}" FontSize="11" FontWeight="Bold" />
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                                <ItemsControl ItemsSource="{Binding AllDayItems}"
                                              ItemTemplate="{StaticResource TodayAllDayTemplate}"
                                              AutomationProperties.Name="Весь день и без точного времени">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer x:Name="TimelineScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Временная шкала дня"
                                      AutomationProperties.AutomationId="TodayTimelineScroll">
                            <Grid x:Name="TimelineCanvasHost" Height="{Binding TimelineCanvasHeight}">
                                <ItemsControl ItemsSource="{Binding HourMarkers}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}" Height="69">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Margin="20,12,8,0" VerticalAlignment="Top"
                                                           Style="{StaticResource Task.Workspace.Meta}" />
                                                <Border Grid.Column="1" BorderThickness="0,0,0,1"
                                                        BorderBrush="{DynamicResource Task.Brush.Border.Default}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding TimelineItems}"
                                              ItemTemplate="{StaticResource TodayTimelineCardTemplate}"
                                              AutomationProperties.Name="Запланированные задачи">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Top" Value="{Binding TimelineTop}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>

                                <Canvas Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}"
                                        Height="{Binding TimelineCanvasHeight}"
                                        Panel.ZIndex="10" IsHitTestVisible="False">
                                <Grid Width="{Binding ActualWidth, ElementName=TimelineCanvasHost}" Height="20"
                                      Canvas.Top="{Binding CurrentTimeTop}"
                                      AutomationProperties.Name="{Binding CurrentTimeText, StringFormat='Текущее время {0}'}">
                                    <Grid.RenderTransform>
                                        <TranslateTransform Y="-8" />
                                    </Grid.RenderTransform>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding ShowCurrentTime}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CurrentTimeBadge" CornerRadius="8"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,8,0" Padding="6,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Task.Brush.Text.Primary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource Today.CoralInk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding CurrentTimeText}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource Task.Brush.Surface.Base}" />
                                    </Border>
                                    <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0">
                                        <Ellipse Width="7" Height="7" Margin="-3,-3,0,0" HorizontalAlignment="Left"
                                                 Fill="{Binding Background, ElementName=CurrentTimeBadge}" />
                                        <Border Height="1" Background="{Binding Background, ElementName=CurrentTimeBadge}" />
                                    </Grid>
                                </Grid>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <Border Padding="16" Margin="20,8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                AutomationProperties.Name="На сегодня записей нет">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Today.CardSurface}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasPlannerItems}" Value="False" />
                                                <Condition Binding="{Binding HasQueueItems}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource Task.Icon.Today}" Width="30" Height="30" Stretch="Uniform"
                                      Fill="{DynamicResource Task.Brush.Text.Secondary}" HorizontalAlignment="Center" />
                                <TextBlock Text="На сегодня ничего не запланировано" Margin="0,8,0,0"
                                           FontSize="16" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="Открыть задачи" Command="{Binding DataContext.OpenTasksCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        HorizontalAlignment="Center" Margin="0,12,0,0" AutomationProperties.AutomationId="TodayEmptyOpenTasks">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Today.Action}">
                                            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>


            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="3*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=TodayInspectorRegionExpansion}" Value="False">
                                        <Setter Property="Height" Value="Auto" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.HasSelectedItem, ElementName=TodayRoot}" Value="False">
                                        <Setter Property="Height" Value="Auto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="2*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=TodayQueueRegionExpansion}" Value="False">
                                        <Setter Property="Height" Value="Auto" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.HasQueueItems, ElementName=TodayRoot}" Value="False">
                                        <Setter Property="Height" Value="Auto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Today.CardSurface}">
                    <Grid x:Name="TodayInspectorRegion"
                          AutomationProperties.Name="Детали задачи"
                          AutomationProperties.AutomationId="TodayInspectorRegion">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Expander x:Name="TodayInspectorRegionExpansion" IsExpanded="True" Style="{StaticResource Today.Section}"
                                  state:ViewState.Section="today/v1/inspector" AutomationProperties.Name="Детали задачи">
                            <Expander.Header>
                                <TextBlock Text="Детали задачи" Margin="16,0,0,0" VerticalAlignment="Center"
                                           FontSize="18" FontWeight="Bold" AutomationProperties.HeadingLevel="Level2"
                                           AutomationProperties.AutomationId="TodayInspectorRegion" />
                            </Expander.Header>
                        </Expander>
                        <Grid Grid.Row="1" Visibility="{Binding IsExpanded, ElementName=TodayInspectorRegionExpansion, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasSelectedItem, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                <StackPanel Margin="16,0,16,16" DataContext="{Binding SelectedItem}">
                                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Border Padding="8,4" Margin="0,0,8,8" CornerRadius="8" Style="{StaticResource Today.TealSurface}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{Binding StatusIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                                                      Width="14" Height="14" Stretch="Uniform" Style="{StaticResource Today.TimedIcon}" />
                                                <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8" VerticalAlignment="Center">
                                            <Path Data="{Binding PriorityIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                                                  Style="{StaticResource Today.PriorityIcon}"
                                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PriorityText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Style="{StaticResource Task.Workspace.Meta}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Task.Icon.Calendar}" Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{DynamicResource Task.Brush.Semantic.Info}" />
                                            <TextBlock Text="{Binding DeadlineText, StringFormat='Срок: {0}'}" Margin="6,0,0,0"
                                                       Style="{StaticResource Task.Workspace.Meta}" />
                                        </StackPanel>
                                    </WrapPanel>

                                    <Button x:Name="TodayOpenSelectedButton" Content="Открыть карточку" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Style="{StaticResource Today.Action}"
                                            Command="{Binding DataContext.OpenSelectedItemCommand, ElementName=TodayRoot}"
                                            AutomationProperties.Name="Открыть выбранную карточку"
                                            AutomationProperties.AutomationId="TodayOpenSelectedButton" />

                                    <StackPanel DataContext="{Binding DataContext, ElementName=TodayRoot}" Margin="0,16,0,0"
                                                Visibility="{Binding ShowTaskActions, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="Действия с задачей">
                                        <TextBlock Text="Действия" FontWeight="Bold" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Начать работу" Style="{StaticResource Today.Action}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanStart, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                    Command="{Binding TransitionCommand}" CommandParameter="InProgress"
                                                    AutomationProperties.Name="Начать работу" AutomationProperties.AutomationId="TodayStartButton" />
                                            <Button Content="Вернуть на доработку" Style="{StaticResource Today.Action}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanReturnForRework, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                    Command="{Binding TransitionCommand}" CommandParameter="InProgress"
                                                    AutomationProperties.Name="Вернуть на доработку" AutomationProperties.AutomationId="TodayReturnForReworkButton" />
                                            <Button Content="Отправить на проверку" Style="{StaticResource Today.Action}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanSubmitForReview, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                    Command="{Binding TransitionCommand}" CommandParameter="Review"
                                                    AutomationProperties.Name="Отправить на проверку" AutomationProperties.AutomationId="TodayReviewButton" />
                                            <Button Content="Завершить" Style="{StaticResource Today.Action}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanComplete, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                    Command="{Binding TransitionCommand}" CommandParameter="Completed"
                                                    AutomationProperties.Name="Завершить задачу" AutomationProperties.AutomationId="TodayCompleteButton" />
                                            <Button Content="Отменить задачу" Style="{StaticResource Today.Action}" Margin="0,0,6,6"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                    Command="{Binding TransitionCommand}" CommandParameter="Cancelled"
                                                    AutomationProperties.Name="Отменить задачу" AutomationProperties.AutomationId="TodayCancelButton" />
                                        </WrapPanel>
                                        <StackPanel Visibility="{Binding IsTransitionConfirmationVisible, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding PendingTransitionText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button x:Name="TodayConfirmTransitionButton" Content="{Binding TransitionConfirmationLabel}" Command="{Binding ConfirmTransitionCommand}"
                                                        Style="{StaticResource Today.Action}" Margin="0,0,6,6"
                                                        AutomationProperties.Name="Подтвердить изменение статуса" AutomationProperties.AutomationId="TodayConfirmTransitionButton" />
                                                <Button Content="Вернуться" Command="{Binding CancelTransitionCommand}"
                                                        Style="{StaticResource Today.Action}" Margin="0,0,0,6"
                                                        AutomationProperties.Name="Отказаться от изменения статуса" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Content="Обновить задачу" Command="{Binding ReloadSelectedTaskCommand}" HorizontalAlignment="Left"
                                                Visibility="{Binding NeedsTaskReload, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                Style="{StaticResource Today.Action}" AutomationProperties.Name="Загрузить актуальную задачу" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Проект:" Margin="0,0,10,12" />
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding ProjectText}" Margin="0,0,0,12" />
                                        <TextBlock Grid.Row="1" Text="Тип:" Margin="0,0,10,12" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="{Binding KindText}" Margin="0,0,0,12" />
                                        <TextBlock Grid.Row="2" Text="Время:" Margin="0,0,10,12" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{Binding TimeText}" Margin="0,0,0,12" />
                                        <TextBlock Grid.Row="3" Text="Обновлена:" Margin="0,0,10,12" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Text="{Binding UpdatedText}" Margin="0,0,0,12" />
                                        <TextBlock Grid.Row="4" Text="Описание:" Margin="0,0,10,0" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Description}"
                                                   TextWrapping="Wrap" LineHeight="20" />
                                    </Grid>

                                    <Border Margin="0,16,0,0" Padding="12" BorderThickness="1" CornerRadius="8"
                                            BorderBrush="{DynamicResource Task.Brush.Semantic.Warning}"
                                            Background="{DynamicResource Task.Brush.Semantic.WarningSoft}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsReadOnly, ElementName=TodayRoot}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Только чтение. Изменения станут доступны после восстановления связи."
                                                   TextWrapping="Wrap" FontSize="{DynamicResource Task.Font.Size.Metadata}" />
                                    </Border>

                                    <StackPanel x:Name="TodayPlanningPanel" DataContext="{Binding DataContext, ElementName=TodayRoot}"
                                                Margin="0,16,0,0" Visibility="{Binding ShowPlanning, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="Планирование задачи">
                                        <TextBlock Text="Планирование" FontSize="18" FontWeight="Bold" />
                                        <TextBlock Text="{Binding PlanningAccessText}" Margin="0,6,0,8" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource Task.Font.Size.Metadata}" />
                                        <StackPanel IsEnabled="{Binding CanEditPlanning}">
                                            <Label Content="_Дата планирования" Target="{Binding ElementName=TodayPlanningDate}" Padding="0,0,0,4" />
                                            <DatePicker x:Name="TodayPlanningDate" SelectedDate="{Binding Planning.Date, UpdateSourceTrigger=PropertyChanged}"
                                                        DateValidationError="PlanningDateValidationError" LostKeyboardFocus="PlanningDateLostFocus" Language="ru-RU" SelectedDateFormat="Short"
                                                        AutomationProperties.Name="Дата планирования" AutomationProperties.AutomationId="TodayPlanningDate" />
                                            <Label Content="_Время начала" Target="{Binding ElementName=TodayPlanningTime}" Padding="0,8,0,4" />
                                            <TextBox x:Name="TodayPlanningTime" Text="{Binding Planning.Time, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource Personal.Airbnb.Input}" MaxLength="8"
                                                     AutomationProperties.Name="Время начала, ЧЧ:ММ, пустое поле — без времени" AutomationProperties.AutomationId="TodayPlanningTime" />
                                            <TextBlock Text="{Binding Planning.ZoneText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       FontSize="{DynamicResource Task.Font.Size.Metadata}" />
                                            <Label Content="Длительность, _мин" Target="{Binding ElementName=TodayPlanningDuration}" Padding="0,8,0,4" />
                                            <TextBox x:Name="TodayPlanningDuration" Text="{Binding Planning.Duration, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource Personal.Airbnb.Input}" MaxLength="5"
                                                     AutomationProperties.Name="Плановая длительность, от 1 до 10080 минут" AutomationProperties.AutomationId="TodayPlanningDuration" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Planning.Error}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Task.Brush.Semantic.Critical}" AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock Text="{Binding PlanningMessage}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="TodayPlanningMessage" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Сохранить" Command="{Binding SavePlanningCommand}" Style="{StaticResource Today.Action}"
                                                    Margin="0,0,6,6" AutomationProperties.Name="Сохранить планирование" AutomationProperties.AutomationId="TodaySavePlanning" />
                                            <Button Content="Отмена" Command="{Binding CancelPlanningCommand}" Style="{StaticResource Today.Action}"
                                                    Margin="0,0,0,6" AutomationProperties.Name="Отменить редактирование планирования" AutomationProperties.AutomationId="TodayCancelPlanning" />
                                        </WrapPanel>
                                        <Button Content="Загрузить актуальную задачу" Command="{Binding ReloadSelectedTaskCommand}" HorizontalAlignment="Left"
                                                Visibility="{Binding ShowPlanningReload, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                Style="{StaticResource Today.Action}" AutomationProperties.Name="Обновить планирование задачи" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <TextBlock Text="Выберите запись в плане дня или в очереди." Margin="16,0,16,16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Task.Workspace.Body}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasSelectedItem}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Today.CardSurface}" Margin="0,12,0,0">
                    <Grid x:Name="TodayQueueRegion"
                          AutomationProperties.Name="Очередь задач"
                          AutomationProperties.AutomationId="TodayQueueRegion">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Expander x:Name="TodayQueueRegionExpansion" IsExpanded="True" Style="{StaticResource Today.Section}"
                                  state:ViewState.Section="today/v1/queue" AutomationProperties.Name="Очередь задач">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                    <TextBlock Text="Очередь задач" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"
                                               AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="TodayQueueRegion" />
                                    <Border Style="{StaticResource Today.TealSurface}" CornerRadius="8" Margin="8,0,0,0" Padding="8,2">
                                        <TextBlock Text="{Binding QueueCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Expander.Header>
                        </Expander>
                        <Grid Grid.Row="1" Visibility="{Binding IsExpanded, ElementName=TodayQueueRegionExpansion, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasQueueItems, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                <StackPanel Margin="16,0,16,8">
                                    <TextBlock Text="Несрочные и просроченные" Style="{StaticResource Task.Workspace.Meta}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding QueueItems}" ItemTemplate="{StaticResource TodayQueueTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock Text="Нет несрочных и просроченных задач." Margin="16,0,16,16">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Task.Workspace.Body}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding HasQueueItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>


            <Border Grid.ColumnSpan="2" Background="{DynamicResource Task.Brush.Surface.Base}" Panel.ZIndex="40"
                    AutomationProperties.Name="Загрузка сегодняшнего плана"
                    AutomationProperties.AutomationId="TodayLoadingState"
                    AutomationProperties.LiveSetting="Polite">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding ShowInitialLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"
                                 Style="{StaticResource Task.Progress.Indeterminate}" />
                    <TextBlock Text="Формируем план дня…" Margin="0,14,0,0"
                               FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Подтверждаем расписание и доступные задачи сервера компании."
                               Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="{DynamicResource Task.Font.Size.Metadata}"
                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
