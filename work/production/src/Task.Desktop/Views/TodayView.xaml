<UserControl x:Class="Task.Desktop.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Сегодня"
             AutomationProperties.AutomationId="TodayScreen">

    <UserControl.Resources>
        <DataTemplate x:Key="TodayTaskTemplate">
            <Button Margin="0,0,0,8" Padding="12" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{Binding AutomationName}"
                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <WrapPanel>
                        <TextBlock Text="{Binding StatusText}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding PriorityText}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding DeadlineText}" />
                    </WrapPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="TodayScheduleItemTemplate">
            <Border Padding="12"
                    Margin="0,0,0,8"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Task.Brush.Border.Default}"
                    Background="{DynamicResource Task.Brush.Surface.Subtle}"
                    AutomationProperties.Name="{Binding AutomationName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding TimeText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               Margin="0,1,12,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding TypeText}"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                                       Margin="0,0,12,0" />

                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                                       Margin="0,0,12,0" />

                            <TextBlock Text="{Binding PriorityText}"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                        </WrapPanel>

                        <Button Content="Открыть карточку" HorizontalAlignment="Left" Margin="0,8,0,4"
                                Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />

                        <TextBlock Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource Task.Padding.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding DateText}"
                           FontSize="{DynamicResource Task.Font.Size.DetailTitle}"
                           FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="TodayDateText" />

                <TextBlock Text="{Binding LastSuccessfulRefreshText}"
                           Margin="0,4,0,0"
                           FontSize="{DynamicResource Task.Font.Size.Metadata}"
                           Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Task.Button.Secondary}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Обновить сегодняшний план">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Task.Icon.Refresh}"
                          Width="18"
                          Height="18"
                          Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Text="Обновить"
                               Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                AutomationProperties.Name="{Binding Message}"
                AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border"
                       BasedOn="{StaticResource Task.State.Inline}">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowMessage}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel>
                <ProgressBar DockPanel.Dock="Left"
                             Width="48"
                             Height="4"
                             IsIndeterminate="True"
                             Margin="0,0,10,0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTimedItems}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Расписание"
                               FontSize="{DynamicResource Task.Font.Size.Section}"
                               FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding TimedItems}"
                                  ItemTemplate="{StaticResource TodayScheduleItemTemplate}"
                                  AutomationProperties.Name="Расписание на сегодня" />
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUntimedItems}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Без точного времени и весь день"
                               FontSize="{DynamicResource Task.Font.Size.Section}"
                               FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding UntimedItems}"
                                  ItemTemplate="{StaticResource TodayScheduleItemTemplate}"
                                  AutomationProperties.Name="Задачи без точного времени" />
                </StackPanel>

                <TextBlock Text="{Binding TasksMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10" />
                <StackPanel Margin="0,0,0,18">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                        <DataTrigger Binding="{Binding OverdueTasks.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Просроченные задачи" FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding OverdueTasks}" ItemTemplate="{StaticResource TodayTaskTemplate}" AutomationProperties.Name="Просроченные задачи" />
                </StackPanel>
                <StackPanel Margin="0,0,0,18">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                        <DataTrigger Binding="{Binding ReviewTasks.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="На проверке" FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ReviewTasks}" ItemTemplate="{StaticResource TodayTaskTemplate}" AutomationProperties.Name="На проверке" />
                </StackPanel>
                <StackPanel Margin="0,0,0,18">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                        <DataTrigger Binding="{Binding WaitingTasks.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Ожидают других сотрудников" FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding WaitingTasks}" ItemTemplate="{StaticResource TodayTaskTemplate}" AutomationProperties.Name="Ожидают других сотрудников" />
                </StackPanel>
                <Border Padding="24"
                        AutomationProperties.Name="На сегодня записей нет">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource Task.State.Panel}">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowEmptyState}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource Task.Icon.Today}"
                              Width="32"
                              Height="32"
                              Stretch="Uniform"
                              Fill="{DynamicResource Task.Brush.Text.Secondary}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />

                        <TextBlock Text="На сегодня в расписании нет записей."
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
