<UserControl x:Class="Task.Desktop.Views.ObjectLinksView" x:Name="LinksRoot"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Task.Desktop.Views" xmlns:state="clr-namespace:Task.Desktop.Infrastructure"
 xmlns:converters="clr-namespace:Task.Desktop.Converters"
 Background="{DynamicResource Task.Brush.Surface.Base}" Foreground="{DynamicResource Task.Brush.Text.Primary}"
 UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="Связанные объекты">
 <UserControl.Resources>
  <converters:WindowWidthAtLeastConverter x:Key="Links.Wide"/>
  <Style x:Key="Links.Caption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}"/>
   <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Metadata}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Links.RegionHeader" TargetType="Border" BasedOn="{StaticResource Task.Surface.Subtle}">
   <Setter Property="MinHeight" Value="49"/><Setter Property="Padding" Value="16,10"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style x:Key="Links.RegionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Section}"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Links.Icon" TargetType="Path">
   <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/>
   <Setter Property="Stretch" Value="Uniform"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Fill" Value="{DynamicResource Task.Brush.Brand.Primary}"/>
   <Style.Triggers><DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
    <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
   </DataTrigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <StackPanel Margin="12">
  <Border Style="{StaticResource Task.Surface.Base}" BorderThickness="0,0,0,1" Padding="4,4,4,16">
   <StackPanel>
    <TextBlock Text="Связанные объекты" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold"/>
    <TextBlock Text="Все связи текущей карточки и добавление новых объектов" Style="{StaticResource Links.Caption}" Margin="0,5,0,12"/>
    <WrapPanel>
     <Button Style="{StaticResource Task.Button.Secondary}" Command="{Binding RefreshCommand}" Margin="0,0,8,4" AutomationProperties.Name="Обновить связи">
      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Task.Icon.Refresh}" Style="{StaticResource Links.Icon}" Margin="0,0,8,0"/><TextBlock Text="Обновить связи" VerticalAlignment="Center"/></StackPanel>
     </Button>
     <TextBlock Text="{Binding Items.Count, Mode=OneWay, StringFormat=Связей в карточке: {0}}" Style="{StaticResource Links.Caption}" VerticalAlignment="Center" Margin="4,0,0,4"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="4,8"
   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ObjectLinksStatus"/>
  <ProgressBar IsIndeterminate="True" Height="3" Style="{StaticResource Task.Progress.Indeterminate}" Margin="0,0,0,8"
   AutomationProperties.Name="Обновление связей" Visibility="{Binding IsBusy, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition">
     <Setter Property="Width" Value="0"/>
     <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
       <Condition Binding="{Binding ActualWidth, ElementName=LinksRoot, Converter={StaticResource Links.Wide}, ConverterParameter=760}" Value="True"/>
       <Condition Binding="{Binding HasCreationTypes}" Value="True"/>
      </MultiDataTrigger.Conditions><Setter Property="Width" Value="12"/></MultiDataTrigger></Style.Triggers>
    </Style></ColumnDefinition.Style></ColumnDefinition>
    <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition">
     <Setter Property="Width" Value="0"/>
     <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
       <Condition Binding="{Binding ActualWidth, ElementName=LinksRoot, Converter={StaticResource Links.Wide}, ConverterParameter=760}" Value="True"/>
       <Condition Binding="{Binding HasCreationTypes}" Value="True"/>
      </MultiDataTrigger.Conditions><Setter Property="Width" Value="*"/></MultiDataTrigger></Style.Triggers>
    </Style></ColumnDefinition.Style></ColumnDefinition>
   </Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <Border Style="{StaticResource Task.Surface.Base}" BorderThickness="1">
     <StackPanel>
      <Border Style="{StaticResource Links.RegionHeader}">
       <TextBlock Text="Связи карточки" Style="{StaticResource Links.RegionTitle}"/>
      </Border>
      <Grid>
    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
     CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True" SelectionMode="Single" SelectionUnit="FullRow"
     MinHeight="180" MaxHeight="300" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeaderWidth="0"
     Background="{DynamicResource Task.Brush.Surface.Base}" Foreground="{DynamicResource Task.Brush.Text.Primary}"
     EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
     AutomationProperties.Name="Таблица связей" AutomationProperties.AutomationId="ObjectLinksList">
     <DataGrid.ColumnHeaderStyle>
      <Style TargetType="DataGridColumnHeader">
       <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Subtle}"/>
       <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}"/>
       <Setter Property="Padding" Value="12,10"/><Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
      </Style>
     </DataGrid.ColumnHeaderStyle>
     <DataGrid.CellStyle>
      <Style TargetType="DataGridCell">
       <Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/>
       <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border>
       </ControlTemplate></Setter.Value></Setter>
       <Style.Triggers><Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Soft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}"/>
       </Trigger>
        <MultiDataTrigger><MultiDataTrigger.Conditions>
         <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"/>
         <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
        </MultiDataTrigger.Conditions>
         <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
         <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        </MultiDataTrigger>
       </Style.Triggers>
      </Style>
     </DataGrid.CellStyle>
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
       <Setter Property="MinHeight" Value="44"/><Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
       <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Hover}"/></Trigger></Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn state:ViewState.ColumnId="type" Header="Тип связи" Binding="{Binding TypeLabel}" SortMemberPath="TypeLabel" Width="160" MinWidth="60" MaxWidth="500"/>
      <DataGridTextColumn state:ViewState.ColumnId="title" Header="Объект" Binding="{Binding Title}" SortMemberPath="Title" Width="*" MinWidth="100" MaxWidth="1600">
       <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding Title}"/>
       </Style></DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
     </DataGrid.Columns>
    </DataGrid>
       <StackPanel IsHitTestVisible="False" Margin="20,52,20,20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Style><Style TargetType="StackPanel">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Items.Count}" Value="0"/><Condition Binding="{Binding IsBusy}" Value="False"/>
         </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
        </Style></StackPanel.Style>
        <Path Data="{StaticResource Task.Icon.Projects}" Style="{StaticResource Links.Icon}" Width="26" Height="26" HorizontalAlignment="Center"/>
        <TextBlock Text="Список связей пуст" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,4"/>
        <TextBlock Text="Добавленные объекты появятся здесь." Style="{StaticResource Links.Caption}" TextAlignment="Center"/>
       </StackPanel>
      </Grid>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Task.Surface.Base}" BorderThickness="1" Margin="0,12,0,0">
     <StackPanel>
      <Border Style="{StaticResource Links.RegionHeader}"><TextBlock Text="Выбранная связь" Style="{StaticResource Links.RegionTitle}"/></Border>
      <StackPanel Margin="16">
       <TextBlock Text="Выберите строку в таблице">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Links.Caption}">
         <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="{Binding Selected.Title}" FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Selected.TypeLabel}" Style="{StaticResource Links.Caption}" Margin="0,4,0,12"/>
       <Button Style="{StaticResource Task.Button.Secondary}" Content="Убрать связь" Command="{Binding RemoveCommand}"
        HorizontalAlignment="Left" AutomationProperties.Name="Убрать связь" ToolTip="Убрать только связь, сохранив сам объект"/>
       <TextBlock Text="Сам объект останется на месте." Style="{StaticResource Links.Caption}" Margin="0,8,0,0"/>
      </StackPanel>
     </StackPanel>
    </Border>
   </StackPanel>
   <Border BorderThickness="1" VerticalAlignment="Top">
    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
     <Setter Property="Grid.Row" Value="1"/><Setter Property="Grid.Column" Value="0"/><Setter Property="Margin" Value="0,12,0,0"/>
     <Style.Triggers>
      <MultiDataTrigger><MultiDataTrigger.Conditions>
       <Condition Binding="{Binding ActualWidth, ElementName=LinksRoot, Converter={StaticResource Links.Wide}, ConverterParameter=760}" Value="True"/>
       <Condition Binding="{Binding HasCreationTypes}" Value="True"/>
      </MultiDataTrigger.Conditions>
       <Setter Property="Grid.Row" Value="0"/><Setter Property="Grid.Column" Value="2"/><Setter Property="Margin" Value="0"/>
      </MultiDataTrigger>
      <DataTrigger Binding="{Binding HasCreationTypes}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
     </Style.Triggers>
    </Style></Border.Style>
   <StackPanel>
    <Border Style="{StaticResource Links.RegionHeader}">
     <StackPanel Orientation="Horizontal">
      <Path Data="{StaticResource Task.Icon.Add}" Style="{StaticResource Links.Icon}" Margin="0,0,8,0"/>
      <TextBlock Text="Новая связь" Style="{StaticResource Links.RegionTitle}"/>
     </StackPanel>
    </Border>
    <StackPanel Margin="16">
    <Label Content="Тип связи" Target="{Binding ElementName=LinkTypeBox}" Padding="0,0,0,4"/>
    <ComboBox x:Name="LinkTypeBox" Style="{DynamicResource Task.Input.Combo}" AutomationProperties.Name="Тип связи"
     ItemsSource="{Binding LinkTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LinkType}"
     HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
    <StackPanel Visibility="{Binding ShowTargetId, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="0,0,0,12">
     <Label Content="Идентификатор связанного объекта" Target="{Binding ElementName=TargetIdBox}" Padding="0,0,0,4"/>
     <TextBox x:Name="TargetIdBox" Style="{DynamicResource Task.Input.Text}" Text="{Binding TargetId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Идентификатор связанного объекта"/>
    </StackPanel>
    <StackPanel Visibility="{Binding ShowPicker, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
     <views:ObjectLinkTargetPickerView DataContext="{Binding TargetPicker}" Margin="0,0,0,12"/>
    </StackPanel>
    <Button Style="{DynamicResource Task.Button.Primary}" Content="Добавить связь" Command="{Binding AddCommand}"
     HorizontalAlignment="Left" AutomationProperties.AutomationId="AddObjectLink" ToolTip="Создать связь с подтверждённым объектом"/>

     <TextBlock Text="Подтвердите объект в результатах поиска, затем добавьте связь." Style="{StaticResource Links.Caption}" Margin="0,8,0,0"
      Visibility="{Binding ShowPicker, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
    </StackPanel>
   </StackPanel>
   </Border>
  </Grid>
 </StackPanel>
</UserControl>
