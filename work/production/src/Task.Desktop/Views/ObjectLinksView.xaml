<UserControl x:Class="Task.Desktop.Views.ObjectLinksView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Task.Desktop.Views" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" Background="{DynamicResource Task.Brush.Surface.Base}" Foreground="{DynamicResource Task.Brush.Text.Primary}">
 <StackPanel Margin="8">
  <WrapPanel>
   <Button Style="{DynamicResource Task.Button.Secondary}" Content="Обновить связи" AutomationProperties.Name="Обновить связи" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/>
   <ComboBox Style="{DynamicResource Task.Input.Combo}" Visibility="{Binding HasCreationTypes, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Тип связи" ItemsSource="{Binding LinkTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LinkType}" Width="140" Margin="0,0,8,8"/>
   <TextBox Style="{DynamicResource Task.Input.Text}" Visibility="{Binding ShowTargetId, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Text="{Binding TargetId,UpdateSourceTrigger=PropertyChanged}" Width="270" Margin="0,0,8,8" AutomationProperties.Name="Идентификатор связанного объекта"/>
   <Button Visibility="{Binding HasCreationTypes, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{DynamicResource Task.Button.Primary}" Content="Связать" Command="{Binding AddCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="AddObjectLink"/>
   <Button Style="{DynamicResource Task.Button.Secondary}" Content="Убрать связь" AutomationProperties.Name="Убрать связь" Command="{Binding RemoveCommand}" Margin="0,0,8,8"/>
  </WrapPanel>
  <StackPanel Visibility="{Binding ShowPicker, Converter={StaticResource Task.BooleanToVisibilityConverter}}"><views:ObjectLinkTargetPickerView DataContext="{Binding TargetPicker}" Margin="0,0,0,8"/></StackPanel>
  <TextBlock Text="Обновление связей…" Visibility="{Binding IsBusy, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"/>
  <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="130" AutomationProperties.AutomationId="ObjectLinksList">
   <DataGrid.Columns><DataGridTextColumn state:ViewState.ColumnId="type" Header="Тип" Binding="{Binding TypeLabel}" SortMemberPath="TypeLabel" Width="130" MinWidth="60" MaxWidth="500"/><DataGridTextColumn state:ViewState.ColumnId="title" Header="Объект" Binding="{Binding Title}" SortMemberPath="Title" Width="*" MinWidth="100" MaxWidth="1600"/></DataGrid.Columns>
  </DataGrid>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ObjectLinksStatus"/>
 </StackPanel>
</UserControl>
