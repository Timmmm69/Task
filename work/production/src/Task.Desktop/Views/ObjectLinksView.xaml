<UserControl x:Class="Task.Desktop.Views.ObjectLinksView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="8">
  <WrapPanel>
   <Button Content="Обновить связи" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/>
   <ComboBox ItemsSource="{Binding LinkTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LinkType}" Width="140" Margin="0,0,8,8"/>
   <TextBox Visibility="{Binding ShowTargetId, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Text="{Binding TargetId,UpdateSourceTrigger=PropertyChanged}" Width="270" Margin="0,0,8,8" AutomationProperties.Name="Идентификатор связанного объекта"/>
   <Button Content="Связать" Command="{Binding AddCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="AddObjectLink"/>
   <Button Content="Убрать связь" Command="{Binding RemoveCommand}" Margin="0,0,8,8"/>
  </WrapPanel>
  <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="130" AutomationProperties.AutomationId="ObjectLinksList">
   <DataGrid.Columns><DataGridTextColumn Header="Тип" Binding="{Binding TypeLabel}" Width="130"/><DataGridTextColumn Header="Объект" Binding="{Binding Title}" Width="*"/></DataGrid.Columns>
  </DataGrid>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
