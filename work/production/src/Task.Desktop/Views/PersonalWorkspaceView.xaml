<UserControl x:Class="Task.Desktop.Views.PersonalWorkspaceView" Language="ru-RU" UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" xmlns:views="clr-namespace:Task.Desktop.Views">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/><ResourceDictionary Source="../Resources/Personal.Workspace.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <views:WorkHubView DataContext="{Binding Hub}"/>
  <Border Grid.Row="1" Style="{StaticResource Personal.SectionHeader}" Visibility="{Binding ShowObjectActions,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><Expander Header="Управление записью и связи" state:ViewState.Section="personal-workspace/v1/actions" Padding="0" IsExpanded="False" Visibility="{Binding ShowObjectActions,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
   <ScrollViewer Style="{StaticResource Personal.AuxiliaryScroll}"><Border Padding="0,12,12,8"><StackPanel>
    <TextBlock Text="Выберите запись, чтобы изменить её состояние, папку или связи." Style="{StaticResource Personal.Metadata}"/>
    <TextBlock Text="Запись" Style="{StaticResource Personal.Label}"/><DockPanel><Button Content="Обновить" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox ItemsSource="{Binding Objects}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Запись для действий" AutomationProperties.AutomationId="PersonalMetadataObject"/></DockPanel>
    <TextBlock Text="{Binding Selected.LifecycleText}" Style="{StaticResource Task.State.Body}" Margin="0,8,0,0"/>
    <WrapPanel Margin="0,12,0,0"><Button Content="Архивировать" Command="{Binding ArchiveCommand}" Margin="0,0,8,8"/><Button Content="В корзину…" Click="OnTrash" IsEnabled="{Binding CanTrash}" Margin="0,0,8,8"/><Button Content="Восстановить" Command="{Binding RestoreCommand}" Margin="0,0,8,8"/><Button Content="Удалить навсегда…" Click="OnPurge" IsEnabled="{Binding CanPurge}" Margin="0,0,8,8"/></WrapPanel>
    <TextBlock Text="Расположение в каталоге" Style="{StaticResource Personal.Label}"/><DockPanel><Button Content="Переместить в папку" DockPanel.Dock="Right" Command="{Binding MoveCommand}" Margin="12,0,0,0"/><ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" AutomationProperties.Name="Папка каталога"/></DockPanel>
    <Border Style="{StaticResource Personal.Feedback}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
    <StackPanel Visibility="{Binding NeedsProjectRecovery,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="0,12,0,0"><TextBlock Text="Выберите, куда восстановить проект." Style="{StaticResource Task.State.Body}"/><WrapPanel Margin="0,8,0,0"><Button Content="В активные" Command="{Binding RecoverProjectCommand}" CommandParameter="active"/><Button Content="В архив" Command="{Binding RecoverProjectCommand}" CommandParameter="archived" Margin="8,0,0,0"/></WrapPanel></StackPanel>
    <Expander Header="Связанные записи" state:ViewState.Section="personal-workspace/v1/links" Margin="0,16,0,0"><StackPanel><TextBlock Text="Связать с записью" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding ActiveObjects}" SelectedItem="{Binding Target}" AutomationProperties.Name="Связанная запись" AutomationProperties.AutomationId="PersonalLinkTarget"/><views:ObjectLinksView state:ViewState.Surface="personal-links/v1" DataContext="{Binding Links}"/></StackPanel></Expander>
   </StackPanel></Border></ScrollViewer>
  </Expander></Border>
  <Border Grid.Row="2" Style="{StaticResource Personal.SectionHeader}" Visibility="{Binding Hub.IsSettings,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><Expander Header="Резервные копии и работа в фоне" state:ViewState.Section="personal-workspace/v1/backup" Padding="0" IsExpanded="False" Visibility="{Binding Hub.IsSettings,Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Резервные копии и работа в фоне">
   <ScrollViewer Style="{StaticResource Personal.AuxiliaryScroll}"><Border Padding="0,16,12,8"><StackPanel>
    <TextBlock Text="Резервная копия" Style="{StaticResource Personal.DetailTitle}"/><TextBlock Text="Сохраняет задачи, проекты, расписание, контакты и ссылки. Сами файлы каталога копируйте отдельно." Style="{StaticResource Task.State.Body}" Margin="0,6,0,12"/>
    <WrapPanel><Button Content="Создать резервную копию" Click="OnBackup" Style="{StaticResource Task.Button.Primary}" Margin="0,0,8,8" AutomationProperties.AutomationId="PersonalBackupButton"/><Button Content="Восстановить из копии…" Click="OnRestore" Margin="0,0,0,8" AutomationProperties.AutomationId="PersonalRestoreButton"/></WrapPanel>
    <Separator Margin="0,8,0,16"/><TextBlock Text="Напоминания в фоне" Style="{StaticResource Personal.DetailTitle}"/><TextBlock Text="Task продолжит работать без открытого окна. Вернуть окно можно значком Task в области уведомлений Windows. После полного выхода напоминания появятся при следующем запуске." Style="{StaticResource Task.State.Body}" Margin="0,6,0,12"/>
    <Button Content="Оставить Task в фоне" Click="OnBackground" HorizontalAlignment="Left" IsEnabled="{Binding DataContext.BackgroundAvailable,RelativeSource={RelativeSource AncestorType=Window}}"/>
   </StackPanel></Border></ScrollViewer>
  </Expander></Border>
 </Grid>
</UserControl>
