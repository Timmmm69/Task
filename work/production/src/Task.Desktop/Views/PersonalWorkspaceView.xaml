<UserControl x:Class="Task.Desktop.Views.PersonalWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Task.Desktop.Views">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid>
  <views:PersonalCatalogView Visibility="{Binding IsCatalog,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  <views:PersonalContactsView Visibility="{Binding IsContacts,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  <views:PersonalSearchView DataContext="{Binding Search}" Visibility="{Binding DataContext.IsSearch,RelativeSource={RelativeSource AncestorType=views:PersonalWorkspaceView},Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  <views:PersonalLifecycleView Visibility="{Binding IsLifecycle,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  <views:PersonalSettingsView DataContext="{Binding Hub}" Visibility="{Binding DataContext.IsSettings,RelativeSource={RelativeSource AncestorType=views:PersonalWorkspaceView},Converter={StaticResource Task.BooleanToVisibilityConverter}}" BackupRequested="OnBackup" RestoreRequested="OnRestore" BackgroundRequested="OnBackground"/>
 </Grid>
</UserControl>