<UserControl x:Class="Task.Desktop.Views.ObjectLinkTargetPickerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 AutomationProperties.Name="Выбор связанного объекта" KeyboardNavigation.TabNavigation="Continue"
 Background="{DynamicResource Task.Brush.Surface.Base}" Foreground="{DynamicResource Task.Brush.Text.Primary}"
 Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged" PreviewKeyDown="OnPreviewKeyDown">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Label Content="_Название объекта" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,4"/>
  <DockPanel Grid.Row="1">
   <Button DockPanel.Dock="Right" Content="_Найти" Command="{Binding SearchCommand}" Margin="8,0,0,0"
    Style="{DynamicResource Task.Button.Secondary}" AutomationProperties.Name="Найти связанный объект"/>
   <TextBox x:Name="SearchBox" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
    IsEnabled="{Binding CanQuery}" Style="{DynamicResource Task.Input.Text}"
    AutomationProperties.Name="Название связанного объекта" AutomationProperties.AutomationId="ObjectLinkTargetSearch"/>
  </DockPanel>
  <TextBlock Grid.Row="2" Text="{Binding StatusText,NotifyOnTargetUpdated=True}" TargetUpdated="OnStatusChanged" TextWrapping="Wrap" Margin="0,8"
   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ObjectLinkTargetStatus"/>
  <ListBox Grid.Row="3" x:Name="ResultsList" MinHeight="100" MaxHeight="320"
   ItemsSource="{Binding Results}" SelectedItem="{Binding Candidate}" IsEnabled="{Binding CanQuery}"
   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
   AutomationProperties.Name="Найденные объекты" AutomationProperties.AutomationId="ObjectLinkTargetResults">
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="AutomationProperties.Name">
      <Setter.Value><MultiBinding StringFormat="{}{0}, {1}"><Binding Path="Title"/><Binding Path="TypeLabel"/></MultiBinding></Setter.Value>
     </Setter>
     <Setter Property="AutomationProperties.HelpText" Value="{Binding ObjectId,StringFormat=ID: {0}}"/>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <StackPanel Margin="4">
      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding TypeLabel}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding UpdatedAt,StringFormat=Обновлён: {0:dd.MM.yyyy HH:mm zzz}}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding ObjectId,StringFormat=ID: {0}}" TextWrapping="Wrap"
       Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
     </StackPanel>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="4" Margin="0,8" AutomationProperties.AutomationId="ObjectLinkTargetSelection">
   <TextBlock Text="{Binding SelectedTarget.Title,StringFormat=Выбран: {0}}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding SelectedTarget.TypeLabel}" TextWrapping="Wrap"/>
  </StackPanel>
  <WrapPanel Grid.Row="5">
   <Button Content="_Выбрать" Command="{Binding ConfirmCommand}" Margin="0,0,8,8" AutomationProperties.Name="Подтвердить объект"/>
   <Button Content="_Очистить" Command="{Binding ClearCommand}" Margin="0,0,8,8" AutomationProperties.Name="Очистить выбор объекта"/>
   <Button Content="_Ещё" Command="{Binding LoadMoreCommand}" Margin="0,0,8,8" AutomationProperties.Name="Загрузить ещё объекты"/>
   <Button Content="_Повторить" Command="{Binding RetryCommand}" Margin="0,0,0,8" AutomationProperties.Name="Повторить поиск объектов"/>
  </WrapPanel>
 </Grid>
</UserControl>
