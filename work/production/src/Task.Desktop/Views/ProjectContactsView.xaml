<UserControl x:Class="Task.Desktop.Views.ProjectContactsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Task.Desktop.Views"
 AutomationProperties.Name="Контакты и компании проекта" KeyboardNavigation.TabNavigation="Continue">
 <StackPanel>
  <TextBlock Text="{Binding Section.StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ProjectContactsStatus"/>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,8" AutomationProperties.LiveSetting="Polite"/>
  <WrapPanel Margin="0,0,0,8">
   <Button Content="Обновить раздел" Command="{Binding RefreshCommand}" Style="{DynamicResource Task.Button.Secondary}" Margin="0,0,8,8"/>
   <Button Content="Связать контакт или компанию" Command="{Binding ChooseCommand}" Style="{DynamicResource Task.Button.Primary}" Margin="0,0,0,8" AutomationProperties.AutomationId="ProjectChooseContact"/>
  </WrapPanel>
  <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MaxHeight="300"
           AutomationProperties.Name="Связанные контакты и компании" AutomationProperties.AutomationId="ProjectContactsList"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
    <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding StringFormat="{}{0}, {1}"><Binding Path="Title"/><Binding Path="TypeLabel"/></MultiBinding></Setter.Value></Setter>
   </Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
   </StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <WrapPanel Margin="0,8,0,0">
   <Button Content="Открыть в CRM" Command="{Binding NavigateCommand}" Style="{DynamicResource Task.Button.Secondary}" Margin="0,0,8,8"/>
   <Button Content="Убрать связь" Command="{Binding RemoveCommand}" Style="{DynamicResource Task.Button.Secondary}" Margin="0,0,0,8"
           ToolTip="Удаляется только связь с проектом. Контакт, компания и их другие связи сохраняются."/>
  </WrapPanel>
  <StackPanel Margin="0,8,0,0">
   <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Choosing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
   <ContentControl Content="{Binding Picker}"><ContentControl.ContentTemplate><DataTemplate><views:ObjectLinkTargetPickerView/></DataTemplate></ContentControl.ContentTemplate></ContentControl>
   <Button Content="Подтвердить привязку" Command="{Binding AddCommand}" Style="{DynamicResource Task.Button.Primary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
  </StackPanel>
 </StackPanel>
</UserControl>
