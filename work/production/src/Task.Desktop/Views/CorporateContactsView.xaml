<UserControl x:Class="Task.Desktop.Views.CorporateContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Task.Desktop.Views"
             xmlns:converters="clr-namespace:Task.Desktop.Converters"
             x:Name="Workspace" FontFamily="{DynamicResource Task.Font.Family}" FontSize="14"
             Background="{DynamicResource Task.Brush.Surface.Base}" UseLayoutRounding="True"
             AutomationProperties.Name="Корпоративные контакты" AutomationProperties.AutomationId="CorporateContactsView">
    <UserControl.Resources>
        <converters:WindowWidthAtLeastConverter x:Key="Contacts.WidthAtLeast"/>
        <SolidColorBrush x:Key="Contacts.Coral" Color="#C91E47"/>
        <SolidColorBrush x:Key="Contacts.CoralPressed" Color="#A8173A"/>
        <SolidColorBrush x:Key="Contacts.Rose" Color="#FFF0F3"/>
        <SolidColorBrush x:Key="Contacts.RoseLine" Color="#F0CBD4"/>
        <Style x:Key="Contacts.Panel" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="Contacts.Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Contacts.Label" TargetType="TextBlock" BasedOn="{StaticResource Contacts.Muted}">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Contacts.OptionalText" TargetType="TextBlock" BasedOn="{StaticResource Contacts.Muted}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Contacts.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Contacts.Button" TargetType="Button" BasedOn="{StaticResource Task.Button.Secondary}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Task.Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Contacts.Primary" TargetType="Button" BasedOn="{StaticResource Contacts.Button}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background" Value="{StaticResource Contacts.Coral}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Contacts.Coral}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Contacts.CoralPressed}"/></Trigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Contacts.QuietButton" TargetType="Button" BasedOn="{StaticResource Contacts.Button}">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}"/>
        </Style>
        <Style x:Key="Contacts.Tab" TargetType="Button" BasedOn="{StaticResource Contacts.QuietButton}">
            <Setter Property="Padding" Value="12,8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Contacts.Coral}"/>
                    <Setter Property="Background" Value="{StaticResource Contacts.Rose}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Contacts.RoseLine}"/>
                    <Setter Property="AutomationProperties.ItemStatus" Value="Выбрано"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Contacts.Input" TargetType="TextBox" BasedOn="{StaticResource Task.Input.Text}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Task.Brush.Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Contacts.Row" TargetType="ListBoxItem" BasedOn="{StaticResource Task.DataList.Item}">
            <Setter Property="MinHeight" Value="62"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="8" BorderThickness="1" Background="Transparent" BorderBrush="Transparent">
                            <Grid>
                                <Border x:Name="Rail" Width="3" Margin="0,9" CornerRadius="1.5" HorizontalAlignment="Left"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Task.Brush.Surface.Subtle}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Contacts.Rose}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Contacts.RoseLine}"/>
                                <Setter TargetName="Rail" Property="Background" Value="{StaticResource Contacts.Coral}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Task.Brush.Text.Primary}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Contacts.ColumnList" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="35*"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Workspace, Converter={StaticResource Contacts.WidthAtLeast}, ConverterParameter=590}" Value="False">
                    <Setter Property="Width" Value="*"/>
                    <Setter Property="MaxWidth" Value="Infinity"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Contacts.ColumnDetail" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="65*"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Workspace, Converter={StaticResource Contacts.WidthAtLeast}, ConverterParameter=590}" Value="False">
                    <Setter Property="Width" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Contacts.ListPane" TargetType="Border" BasedOn="{StaticResource Contacts.Panel}">
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Workspace, Converter={StaticResource Contacts.WidthAtLeast}, ConverterParameter=590}" Value="False">
                    <Setter Property="Grid.RowSpan" Value="1"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Contacts.DetailPane" TargetType="Border" BasedOn="{StaticResource Contacts.Panel}">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=Workspace, Converter={StaticResource Contacts.WidthAtLeast}, ConverterParameter=590}" Value="False">
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="Grid.Row" Value="1"/>
                    <Setter Property="Grid.RowSpan" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,16,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Margin="0,0,0,10" Padding="0,0,0,8"
                BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Contacts.Button}"
                            AutomationProperties.AutomationId="WorkHubRefreshButton"/>
                    <Button x:Name="NewContactButton" Content="+ Новый контакт" Click="OpenCreate"
                            AutomationProperties.Name="Новый контакт" AutomationProperties.AutomationId="NewContactButton" Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Contacts.Primary}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanCreateContact}" Value="True"/>
                                            <Condition Binding="{Binding CanReadCurrentArea}" Value="True"/>
                                            <Condition Binding="{Binding ShowContactPeople}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasCompanies}" Value="True"/>
                                        <Condition Binding="{Binding CanReadCurrentArea}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="Люди" Command="{Binding ShowContactsCommand}" Tag="{Binding ShowContactPeople}"
                            Style="{StaticResource Contacts.Tab}" TabIndex="0" Margin="0,0,4,0"/>
                    <Button Content="Компании" Command="{Binding ShowCompaniesCommand}" Tag="{Binding ShowCompanies}"
                            Style="{StaticResource Contacts.Tab}" TabIndex="1"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,0,0,10" Padding="12,8" CornerRadius="8"
                AutomationProperties.AutomationId="WorkHubFeedback" AutomationProperties.LiveSetting="Polite"
                Visibility="{Binding HasFeedback, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FeedbackKind}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource Contacts.Rose}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Contacts.RoseLine}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="WorkHubFeedbackText"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid Visibility="{Binding CanReadCurrentArea, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <views:CompaniesView DataContext="{Binding Companies}"
                                     Visibility="{Binding DataContext.ShowCompanies, ElementName=Workspace, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                <Grid Visibility="{Binding ShowContactPeople, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14" HorizontalAlignment="Left"
                          Visibility="{Binding HasCompanies, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ContactSearch" Style="{StaticResource Task.Input.Search}" Width="284"
                                 Tag="Поиск по имени или заметке" Text="{Binding ContactQuery, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                 AutomationProperties.Name="Поиск контактов по имени или заметке" AutomationProperties.AutomationId="ContactSearch">
                            <TextBox.Resources>
                                <CornerRadius x:Key="Task.Radius.Search">8</CornerRadius>
                                <Visibility x:Key="Task.Search.EmptyHintVisibility">Collapsed</Visibility>
                            </TextBox.Resources>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding RefreshCommand}" CommandParameter="{Binding ContactQuery}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Найти" Command="{Binding RefreshCommand}" CommandParameter="{Binding ContactQuery}"
                                Style="{StaticResource Contacts.Button}" Margin="6,0,0,0" AutomationProperties.AutomationId="FindContactsButton"/>
                        <Button Grid.Column="2" Content="Сбросить" Command="{Binding RefreshCommand}" CommandParameter=""
                                AutomationProperties.Name="Сбросить поиск контактов" Margin="6,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Contacts.Button}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ContactQuery}" Value=""/>
                                                <Condition Binding="{Binding ContactResultsQuery}" Value=""/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Style="{StaticResource Contacts.ColumnList}"/>
                            <ColumnDefinition Style="{StaticResource Contacts.ColumnDetail}"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Contacts.ListPane}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Padding="14,10" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Contacts.Count, Mode=OneWay}"
                                                       Style="{StaticResource Contacts.Muted}" VerticalAlignment="Center"
                                                       AutomationProperties.Name="{Binding Contacts.Count, StringFormat='Загружено записей: {0}'}"/>
                                            <TextBlock Text="Список контактов" Style="{StaticResource Contacts.Heading}" Margin="0,0,6,0"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding ContactResultsQuery, StringFormat='Поиск: {0}'}" ToolTip="{Binding ContactResultsQuery}"
                                                   Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Contacts.Muted}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ContactResultsQuery}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="ContactList" Grid.Row="1" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Contacts.Row}"
                                         ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" SelectionChanged="OnContactSelected"
                                         Margin="6,6,6,0" BorderThickness="0" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="{Binding ContactsListName}" AutomationProperties.AutomationId="ContactsList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" HorizontalAlignment="Left" CornerRadius="8" Background="{DynamicResource Task.Brush.Surface.Subtle}">
                                                    <Path Data="{StaticResource Task.Icon.Contacts}" Width="15" Height="15" Stretch="Uniform"
                                                          Fill="{DynamicResource Task.Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Notes, TargetNullValue=''}" ToolTip="{Binding Notes}" Style="{StaticResource Contacts.OptionalText}"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="1" Margin="14,8" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=ContactList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding FeedbackKind}" Value="Error"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold"
                                               AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="По вашему запросу ничего не найдено"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ContactResultsQuery}" Value=""><Setter Property="Text" Value="Контактов пока нет"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Contacts.Muted}">
                                                <Setter Property="Text" Value="Уточните имя или сбросьте поиск."/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ContactResultsQuery}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Row="2" Content="Загрузить ещё" Command="{Binding LoadMoreCommand}" Style="{StaticResource Contacts.Button}"
                                        Visibility="{Binding HasMoreResults, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                        Margin="10,4,10,10" AutomationProperties.AutomationId="WorkHubLoadMoreButton"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Contacts.DetailPane}">
                            <Grid>
                                <StackPanel Margin="18,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedContact}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding Visibility, ElementName=CreatePanel}" Value="Collapsed"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource Task.Icon.Contacts}" Width="25" Height="25" Stretch="Uniform"
                                          Fill="{DynamicResource Task.Brush.Text.Secondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Выберите контакт" Style="{StaticResource Contacts.Heading}" Margin="0,8,0,0" TextAlignment="Center"/>
                                    <TextBlock Text="Здесь откроются данные и история общения." Style="{StaticResource Contacts.Muted}"
                                               Margin="0,4,0,0" TextAlignment="Center"/>
                                </StackPanel>
                                <ScrollViewer x:Name="DetailScroll" Margin="0,2,2,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              AutomationProperties.Name="Карточка контакта">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedContact}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=CreatePanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <StackPanel>
                                        <ContentControl Content="{Binding ContactCard}" Focusable="False">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel AutomationProperties.AutomationId="ContactCard">
                                                        <Border Padding="16,12" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1">
                                                            <StackPanel>
                                                                <TextBlock FontSize="23" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding DataContext.SelectedContact.DisplayName, RelativeSource={RelativeSource AncestorType=views:CorporateContactsView}}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDetails}" Value="True">
                                                                                    <Setter Property="Text" Value="{Binding Details.Contact.DisplayName}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Contacts.Muted}" Margin="0,3,0,0"
                                                                           Visibility="{Binding HasDetails, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                                                                <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Style="{StaticResource Task.Progress.Indeterminate}"
                                                                             AutomationProperties.Name="Загрузка карточки" Visibility="{Binding IsLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                                                                <TextBlock Text="{Binding Message, TargetNullValue=''}" Style="{StaticResource Contacts.OptionalText}"
                                                                           Margin="0,8,0,0" AutomationProperties.AutomationId="ContactCardMessage" AutomationProperties.LiveSetting="Polite"/>
                                                                <WrapPanel Margin="0,10,0,0">
                                                                    <WrapPanel.Style>
                                                                        <Style TargetType="WrapPanel">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </WrapPanel.Style>
                                                                    <Button Content="Редактировать" Command="{Binding EditCommand}" Style="{StaticResource Contacts.Button}"
                                                                            Margin="0,0,6,0" Visibility="{Binding HasDetails, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                                            AutomationProperties.AutomationId="EditContactButton"/>
                                                                    <Button Content="Обновить карточку" Command="{Binding ReloadCommand}" Style="{StaticResource Contacts.QuietButton}"/>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Margin="16,14,16,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDetails}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="О контакте" Style="{StaticResource Contacts.Heading}" Margin="0,0,0,8"/>
                                                            <TextBlock TextWrapping="Wrap">
                                                                <Run Text="{Binding Details.Contact.LastName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Details.Contact.FirstName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Details.MiddleName, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Details.Contact.Notes, TargetNullValue=''}" Style="{StaticResource Contacts.OptionalText}" Margin="0,7,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="16,12,16,0">
                                                            <StackPanel IsEnabled="{Binding CanChangeDraft}">
                                                                <TextBlock Text="Имя" Margin="0,12,0,6" TextWrapping="Wrap"/>
                                                                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource Contacts.Input}" AutomationProperties.Name="Имя контакта"/>
                                                                <TextBlock Text="Фамилия" Margin="0,12,0,6" TextWrapping="Wrap"/>
                                                                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource Contacts.Input}" AutomationProperties.Name="Фамилия контакта"/>
                                                                <TextBlock Text="Отчество" Margin="0,12,0,6" TextWrapping="Wrap"/>
                                                                <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource Contacts.Input}" AutomationProperties.Name="Отчество контакта"/>
                                                                <TextBlock Text="Отображаемое имя" Margin="0,12,0,6" TextWrapping="Wrap"/>
                                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Style="{StaticResource Contacts.Input}" AutomationProperties.Name="Отображаемое имя"/>
                                                                <TextBlock Text="Бизнес-статус" Margin="0,12,0,6" TextWrapping="Wrap"/>
                                                                <ComboBox Style="{StaticResource Task.Input.Combo}" ItemsSource="{Binding StatusChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Status}"/>
                                                                <TextBlock Text="Заметки" Margin="0,12,0,6" TextWrapping="Wrap"/>
                                                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180" VerticalScrollBarVisibility="Auto" Style="{StaticResource Contacts.Input}" AutomationProperties.Name="Заметки"/>
                                                            </StackPanel>
                                                            <WrapPanel Margin="0,12,0,0">
                                                                <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource Contacts.Primary}" AutomationProperties.AutomationId="SaveContactButton"/>
                                                                <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource Contacts.Button}" Margin="8,0,0,0"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                        <views:ContactRelationsView/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                        <views:InteractionsView DataContext="{Binding ContactInteractions}" Margin="12,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <ScrollViewer x:Name="CreatePanel" Visibility="Collapsed" IsEnabled="{Binding CanCreateContact}" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="WorkHubNewContactPanel">
                                    <StackPanel Margin="16,14">
                                        <TextBlock Text="Новый контакт" FontSize="23" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
                                        <TextBlock Text="Имя" Style="{StaticResource Contacts.Label}" Margin="0,14,0,5"/>
                                        <TextBox x:Name="CreateFirstName" Text="{Binding NewContactFirstName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Contacts.Input}" AutomationProperties.Name="Имя нового контакта" AutomationProperties.AutomationId="ContactFirstNameTextBox"/>
                                        <TextBlock Text="Фамилия (необязательно)" Style="{StaticResource Contacts.Label}" Margin="0,10,0,5"/>
                                        <TextBox Text="{Binding NewContactLastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Contacts.Input}" AutomationProperties.Name="Фамилия нового контакта"/>
                                        <TextBlock Text="Отображаемое имя" Style="{StaticResource Contacts.Label}" Margin="0,10,0,5"/>
                                        <TextBox Text="{Binding NewContactDisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Contacts.Input}"
                                                 AutomationProperties.Name="Отображаемое имя нового контакта" AutomationProperties.AutomationId="ContactDisplayNameTextBox"/>
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="Создать контакт" Command="{Binding CreateContactCommand}" Style="{StaticResource Contacts.Primary}"
                                                    Margin="0,0,6,4" AutomationProperties.AutomationId="CreateContactButton"/>
                                            <Button Content="Закрыть форму" Click="CloseCreate" Style="{StaticResource Contacts.Button}" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <Border Style="{StaticResource Contacts.Panel}" Padding="16"
                    Visibility="{Binding IsLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="WorkHubLoadingState" AutomationProperties.LiveSetting="Polite">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="140" IsIndeterminate="True" Style="{StaticResource Task.Progress.Indeterminate}"/>
                    <TextBlock Text="{Binding LoadingText}" Style="{StaticResource Contacts.Muted}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Contacts.Panel}" Padding="16"
                    Visibility="{Binding IsLimitedRole, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="WorkHubLimitedRoleState">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <Path Data="{StaticResource Task.Icon.Lock}" Width="25" Height="25" Fill="{DynamicResource Task.Brush.Text.Secondary}" Stretch="Uniform"/>
                    <TextBlock Text="Раздел недоступен для текущей роли" Style="{StaticResource Contacts.Heading}"
                               TextAlignment="Center" Margin="0,10,0,0" AutomationProperties.AutomationId="WorkHubLimitedRoleText"/>
                    <TextBlock Text="Обратитесь к администратору, если для работы нужен доступ к контактам." Style="{StaticResource Contacts.Muted}" TextAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
