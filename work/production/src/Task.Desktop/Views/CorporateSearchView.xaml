<UserControl x:Class="Task.Desktop.Views.CorporateSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Task.Desktop.Views" xmlns:controls="clr-namespace:Task.Desktop.Controls"
             AutomationProperties.Name="Поиск по данным компании" AutomationProperties.AutomationId="SearchSurface"
             PreviewKeyDown="OnSearchKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Search.Ink" Color="#222222"/>
        <SolidColorBrush x:Key="Search.Muted" Color="#616161"/>
        <SolidColorBrush x:Key="Search.Soft" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="Search.Line" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="Search.Coral" Color="{DynamicResource Task.Color.Brand.Primary}"/>
        <SolidColorBrush x:Key="Search.CoralHover" Color="{DynamicResource Task.Color.Brand.Strong}"/>
        <SolidColorBrush x:Key="Search.TealSoft" Color="#E8F4F8"/>
        <SolidColorBrush x:Key="Task.Capsule.Accent" Color="#222222"/>

        <Style x:Key="Search.Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Search.Muted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Search.Panel" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="Background" Value="{StaticResource Search.Soft}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Search.Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Search.Action" TargetType="Button" BasedOn="{StaticResource Task.Button.Base}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Search.Soft}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Hover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Search.Submit" TargetType="Button" BasedOn="{StaticResource Search.Action}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Search.Coral}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Search.CoralHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Search.CoralHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Disabled}"/>
                    <Setter Property="Foreground" Value="{StaticResource Search.Muted}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"/>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Search.Filter" TargetType="ListBoxItem" BasedOn="{StaticResource Task.DataList.Item}">
            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Search.Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="Все">
                    <Setter Property="AutomationProperties.Name" Value="Все типы"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Hover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Search.Ink}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Search.Ink}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Search.Result" TargetType="Button" BasedOn="{StaticResource Search.Action}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDestination}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Search.KindIcon" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource Task.Icon.Search}"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding GroupLabel}" Value="Задачи">
                    <Setter Property="Data" Value="{StaticResource Task.Icon.Tasks}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupLabel}" Value="Проекты">
                    <Setter Property="Data" Value="{StaticResource Task.Icon.Projects}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupLabel}" Value="Файлы">
                    <Setter Property="Data" Value="{StaticResource Task.Icon.Catalog}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupLabel}" Value="CRM">
                    <Setter Property="Data" Value="{StaticResource Task.Icon.Contacts}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupLabel}" Value="Сотрудники">
                    <Setter Property="Data" Value="{StaticResource Task.Icon.Contacts}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ObjectType}" Value="calendar_event">
                    <Setter Property="Data" Value="{StaticResource Task.Icon.Calendar}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel MaxWidth="1040" Margin="{DynamicResource Task.Padding.Workspace}" TextElement.FontFamily="{DynamicResource Task.Font.Family}">
            <Border Style="{StaticResource Search.Panel}" IsEnabled="{Binding CanUseSearchPage}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="{StaticResource Task.Icon.Lock}" Width="12" Height="12" Stretch="Uniform"
                              Fill="{Binding Foreground, ElementName=ScopeText}" Margin="0,0,7,0"/>
                        <TextBlock x:Name="ScopeText" Text="Доступные объекты компании" Style="{StaticResource Search.Caption}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QueryInput" Style="{StaticResource Task.Input.Search}" Height="48"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Название объекта или имя сотрудника…" Margin="0,0,8,0"
                                 AutomationProperties.Name="Запрос корпоративного поиска"
                                 AutomationProperties.HelpText="От 2 до 200 символов. Enter запускает поиск."
                                 AutomationProperties.AutomationId="GlobalSearchTextBox">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Найти" Command="{Binding SearchCommand}"
                                Style="{StaticResource Search.Submit}" MinWidth="94"
                                AutomationProperties.AutomationId="GlobalSearchButton"/>
                    </Grid>

                    <TextBlock Text="Тип результата" Style="{StaticResource Search.Caption}" Margin="0,12,0,5"/>
                    <ListBox Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Search.Filter}"
                             ItemsSource="{Binding SearchTypeFilters}" SelectedItem="{Binding SearchTypeFilter}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" KeyboardNavigation.DirectionalNavigation="Cycle"
                             AutomationProperties.Name="Тип результата" AutomationProperties.AutomationId="CorporateSearchTypeFilter"
                             AutomationProperties.HelpText="Фильтрует уже загруженные результаты.">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Search.Panel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchPageNotice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding SearchPageNotice.Title}" FontSize="16" FontWeight="SemiBold"
                               TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="AutomationProperties.AutomationId" Value="CorporateSearchStateTitle"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLimitedRole}" Value="True">
                                        <Setter Property="AutomationProperties.AutomationId" Value="WorkHubLimitedRoleText"/>
                                        <Setter Property="AutomationProperties.Name" Value="Ограниченная роль"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding SearchPageNotice.Body}" TextWrapping="Wrap" Margin="0,5,0,0"
                               AutomationProperties.AutomationId="WorkHubFeedbackText" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Search.Caption}">
                                <Setter Property="FontSize" Value="14"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource Task.Progress.Indeterminate}"
                                 Height="4" Width="112" Margin="0,10,0,0" HorizontalAlignment="Left"
                                 Visibility="{Binding IsSearchLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                 AutomationProperties.Name="Загрузка результатов поиска"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,4" Visibility="{Binding HasSearchResults, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Результаты" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock Grid.Column="1" Text="{Binding SearchResultCount, StringFormat={}Показано: {0}}"
                           Style="{StaticResource Search.Caption}" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="GlobalSearchSummary"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding SearchGroups}"
                          AutomationProperties.Name="Результаты по типам" AutomationProperties.AutomationId="GlobalSearchResults">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8,0,4">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Search.Caption}" FontWeight="SemiBold"
                                       Margin="0,2,0,3" AutomationProperties.HeadingLevel="Level3"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Search.Line}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource Search.Result}" HorizontalContentAlignment="Stretch"
                                                        Padding="4,8,8,8"
                                                        Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=views:CorporateSearchView}}"
                                                        CommandParameter="{Binding}" ToolTip="{Binding Title}"
                                                        AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding TypeLabel}"
                                                        AutomationProperties.AutomationId="CorporateSearchOpenResult">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
                                                                    <Setter Property="Background" Value="{StaticResource Search.TealSoft}"/>
                                                                </Style>
                                                            </Border.Style>
                                                            <Path Style="{StaticResource Search.KindIcon}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <controls:SearchHighlightTextBlock HighlightText="{Binding Title}" Query="{Binding DataContext.SearchQuery, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="15" TextWrapping="Wrap"/>
                                                            <controls:SearchHighlightTextBlock HighlightText="{Binding Source.Description}" Query="{Binding DataContext.SearchQuery, RelativeSource={RelativeSource AncestorType=UserControl}}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0">
                                                                <controls:SearchHighlightTextBlock.Style>
                                                                    <Style TargetType="controls:SearchHighlightTextBlock" BasedOn="{StaticResource Search.Caption}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers><DataTrigger Binding="{Binding Source.Description}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Source.Description}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </controls:SearchHighlightTextBlock.Style>
                                                            </controls:SearchHighlightTextBlock>
                                                            <WrapPanel Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Search.Caption}" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding UpdatedAt, StringFormat={}· Обновлено {0:dd.MM.yyyy}}" Style="{StaticResource Search.Caption}"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Search.Caption}">
                                                                    <Setter Property="Text" Value="Открыть →"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDestination}" Value="False">
                                                                            <Setter Property="Text" Value="Без карточки"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1" Content="Связи" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        Style="{StaticResource Search.Action}"
                                                        Command="{Binding DataContext.SelectLinkSourceCommand, RelativeSource={RelativeSource AncestorType=views:CorporateSearchView}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.HasLinks, RelativeSource={RelativeSource AncestorType=views:CorporateSearchView}, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat=Выбрать связи объекта: {0}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Загрузить ещё" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Style="{StaticResource Search.Action}" BorderBrush="{StaticResource Search.Line}"
                    Visibility="{Binding HasMoreResults, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="WorkHubLoadMoreButton"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
