        <Grid Grid.Row="2" Visibility="{Binding IsSearch, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Канонический глобальный поиск" AutomationProperties.AutomationId="SearchSurface" Margin="20,16">
