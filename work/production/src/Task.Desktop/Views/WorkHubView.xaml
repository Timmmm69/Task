<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Task.Desktop.Converters" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" xmlns:views="clr-namespace:Task.Desktop.Views" x:Class="Task.Desktop.Views.WorkHubView" AutomationProperties.Name="Рабочие данные" AutomationProperties.AutomationId="WorkHubView" Background="{DynamicResource Task.Brush.Surface.Base}" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewTextInput="CatalogSearchShortcut" x:Name="WorkHubRoot">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/CorporateCatalog.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <converters:WindowWidthAtLeastConverter x:Key="Task.WindowWidthAtLeastConverter"/>
        <Style x:Key="WorkHub.Panel" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style x:Key="WorkHub.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Section}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="WorkHub.Check" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Expander" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,12" FontSize="{DynamicResource Task.Font.Size.Section}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkHub.Region" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style x:Key="WorkHub.RegionHeader" TargetType="Border" BasedOn="{StaticResource Task.Surface.Subtle}">
            <Setter Property="MinHeight" Value="49"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="WorkHub.LeftColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="38*"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Width" Value="*"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.RightColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="62*"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Width" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Master" TargetType="Border" BasedOn="{StaticResource WorkHub.Region}">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Grid.RowSpan" Value="1"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Detail" TargetType="Border" BasedOn="{StaticResource WorkHub.Region}">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="Grid.Row" Value="1"/>
                    <Setter Property="Grid.RowSpan" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Footer" TargetType="Border" BasedOn="{StaticResource Task.Surface.Subtle}">
            <Setter Property="Margin" Value="-20,20,-20,-20"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="Auto"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsExpanded, ElementName=LinksExpander}" Value="True"/>
                                    <Condition Binding="{Binding Visibility, ElementName=LinksExpander}" Value="Visible"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="*"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="24,16,24,12" Style="{StaticResource Task.Surface.Subtle}"
                Visibility="{Binding IsCatalog, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <Border.Resources>
                <StaticResource x:Key="Task.Radius.Control" ResourceKey="Catalog.ControlRadius" />
                <StaticResource x:Key="Task.Brush.Brand.Primary" ResourceKey="Catalog.Accent" />
                <StaticResource x:Key="Task.Brush.Brand.Strong" ResourceKey="Catalog.AccentHover" />
                <StaticResource x:Key="Task.Capsule.Accent" ResourceKey="Catalog.Accent" />
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="54*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CatalogSearchBox" Style="{StaticResource Task.Input.Search}"
                         Tag="Поиск по названию" Text="{Binding CatalogSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanShowCatalog}" AutomationProperties.Name="Поиск в каталоге"
                         AutomationProperties.AutomationId="CatalogSearchBox">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{x:Static state:SearchFieldCommands.Clear}" />
                    </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource Catalog.SecondaryAction}"
                            Width="42" MinHeight="42" Padding="0" Margin="0,0,8,0" ToolTip="Обновить каталог"
                            AutomationProperties.Name="Обновить каталог" AutomationProperties.AutomationId="WorkHubRefreshButton">
                        <Path Data="{StaticResource Task.Icon.Refresh}" Style="{StaticResource Task.Files.Icon}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="CatalogCreateButton" Click="ShowCatalogCreation" IsEnabled="{Binding CanStartCatalogCreation}"
                            Style="{StaticResource Task.Button.Primary}" MinHeight="42" Padding="14,6"
                            ToolTip="{Binding CatalogCreationHint}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Добавить в каталог" AutomationProperties.HelpText="{Binding CatalogCreationHint}"
                            AutomationProperties.AutomationId="CatalogAddButton">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Task.Icon.Add}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Добавить" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Padding="20,16" BorderThickness="0,0,0,1" Grid.Row="0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCatalog}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="44,0,16,0">
                    <TextBlock Text="{Binding AreaTitle}" FontSize="{DynamicResource Task.Font.Size.PageTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AccessText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel VerticalAlignment="Top">
                    <Button Content="Загрузить ещё" Command="{Binding LoadMoreCommand}" Margin="0,0,8,0" Visibility="{Binding HasMoreResults, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="WorkHubLoadMoreButton"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="WorkHubRefreshButton"/>
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Margin" Value="16,4,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=620}" Value="False">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Margin" Value="44,12,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                </WrapPanel>
                <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="False">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource Task.Icon.Catalog}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsContacts}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Contacts}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSearch}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Search}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNotifications}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Notifications}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsArchive}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Archive}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTrash}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Trash}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Settings}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Task.State.Inline}" Margin="0" Visibility="{Binding HasFeedback, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Сообщение раздела" AutomationProperties.AutomationId="WorkHubFeedback" AutomationProperties.LiveSetting="Polite" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Task.Icon.Info}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}"/>
                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="WorkHubFeedbackText"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Task.State.Panel}" Panel.ZIndex="30" Visibility="{Binding IsLimitedRole, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Ограниченная роль" AutomationProperties.AutomationId="WorkHubLimitedRoleState">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Path Data="{StaticResource Task.Icon.Lock}" Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}"/>
                <TextBlock Text="Раздел недоступен для текущей роли" Style="{StaticResource Task.State.Title}" Margin="0,12,0,0" TextAlignment="Center" AutomationProperties.Name="Ограниченная роль" AutomationProperties.AutomationId="WorkHubLimitedRoleText"/>
                <TextBlock Text="Названия, совпадения, количество и связи защищённых объектов не раскрываются. Обратитесь к администратору, если доступ нужен для работы." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Task.Brush.Surface.Base}" Panel.ZIndex="20" Visibility="{Binding IsLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Загрузка раздела" AutomationProperties.AutomationId="WorkHubLoadingState" AutomationProperties.LiveSetting="Polite">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="160" Style="{StaticResource Task.Progress.Indeterminate}"/>
                <TextBlock Text="{Binding LoadingText}" Margin="0,12,0,0" Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>


        <Grid x:Name="CatalogDropArea" AllowDrop="True" PreviewDragOver="ExplorerDragOver" PreviewDrop="ExplorerDrop"
              DragLeave="ExplorerDragLeave" Grid.Row="2" Style="{StaticResource Task.Grid.SurfaceBase}"
              Visibility="{Binding CanShowCatalog, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <StaticResource x:Key="Task.Radius.Control" ResourceKey="Catalog.ControlRadius" />
                <StaticResource x:Key="Task.Brush.Brand.Primary" ResourceKey="Catalog.Accent" />
                <StaticResource x:Key="Task.Brush.Brand.Strong" ResourceKey="Catalog.AccentHover" />
                <StaticResource x:Key="Task.Brush.Brand.Soft" ResourceKey="Catalog.Selection" />
            </Grid.Resources>
            <Border Style="{StaticResource Task.Surface.Subtle}" Padding="24,0,24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="54*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Catalog.Card}" AutomationProperties.Name="Каталог файлов"
                            AutomationProperties.AutomationId="FilesCatalogRegion">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="16,12" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Task.Brush.Border.Default}">
                                    <DockPanel>
                                        <Button x:Name="CatalogRootDropButton" DockPanel.Dock="Right" Content="В корень"
                                                Command="{Binding SelectCatalogRootCommand}" Click="ClearCatalogSearch"
                                                Padding="8,4" MinHeight="32" Margin="8,0,0,0"
                                                AllowDrop="True" DragOver="CatalogRootDragOver" Drop="CatalogRootDrop"
                                                ToolTip="Корень каталога" AutomationProperties.Name="Корень каталога"
                                                AutomationProperties.AutomationId="CatalogRootButton">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Catalog.SecondaryAction}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedCatalogItem}" Value="{x:Null}" />
                                                                <Condition Binding="{Binding IsCatalogSearchActive}" Value="False" />
                                                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{StaticResource Catalog.Selection}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Catalog.Accent}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Catalog.Accent}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Catalog.Heading}">
                                                    <Setter Property="Text" Value="Файлы и папки" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCatalogSearchActive}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Items.Count, ElementName=CatalogResults, StringFormat=Найдено: {0}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <TreeView x:Name="CatalogTree" ItemsSource="{Binding CatalogRoots}" BorderThickness="0"
                                          Background="Transparent" Padding="8,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ItemContainerStyle="{StaticResource Catalog.TreeItem}"
                                          SelectedItemChanged="CatalogSelectionChanged" PreviewMouseLeftButtonDown="CatalogMouseDown"
                                          PreviewMouseMove="CatalogMouseMove" AllowDrop="True" DragOver="CatalogDragOver" Drop="CatalogDrop"
                                          AutomationProperties.Name="Дерево каталога" AutomationProperties.AutomationId="CatalogList">
                                    <TreeView.Style>
                                        <Style TargetType="TreeView">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCatalogSearchActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TreeView.Style>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Catalog.Entry}" />
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <ListBox x:Name="CatalogResults" Style="{StaticResource Task.DataList}"
                                         ItemsSource="{Binding CatalogSearchResults}" ItemTemplate="{StaticResource Catalog.Entry}"
                                         ItemContainerStyle="{StaticResource Catalog.SearchResult}"
                                         SelectedValuePath="Id" SelectedValue="{Binding SelectedCatalogItem.Id, Mode=OneWay}"
                                         SelectionChanged="CatalogSearchSelectionChanged" BorderThickness="0" Padding="8,6"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                                         Visibility="{Binding IsCatalogSearchActive, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                         AutomationProperties.Name="Результаты поиска в каталоге" AutomationProperties.AutomationId="CatalogSearchResults" />
                                <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCatalogEmpty}" Value="True" />
                                                        <Condition Binding="{Binding IsCatalogSearchActive}" Value="False" />
                                                        <Condition Binding="{Binding IsFeedbackError}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource Task.Icon.Catalog}" Style="{StaticResource Task.Files.Icon}" Width="24" Height="24" />
                                    <TextBlock Text="Каталог пуст" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="Здесь появятся файлы и папки." Style="{StaticResource Task.Files.Hint}" TextAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                            AutomationProperties.LiveSetting="Polite">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCatalogSearchActive}" Value="True" />
                                                        <Condition Binding="{Binding HasItems, ElementName=CatalogResults}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource Task.Icon.Search}" Style="{StaticResource Task.Files.Icon}" Width="24" Height="24" />
                                    <TextBlock Text="Ничего не найдено" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="Попробуйте изменить запрос." Style="{StaticResource Task.Files.Hint}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Catalog.Card}" AutomationProperties.Name="Файл и расположения"
                            AutomationProperties.AutomationId="FilesInspectorRegion">
                        <ScrollViewer x:Name="CatalogInspector" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16">
                                <Border x:Name="CatalogCreationPanel" Style="{StaticResource Catalog.Card}" Visibility="Collapsed"
                                        Padding="12" Margin="0,0,0,16" AutomationProperties.Name="Новая запись каталога"
                                        AutomationProperties.AutomationId="FilesCreateSection">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Закрыть" Click="HideCatalogCreation"
                                                    Style="{StaticResource Catalog.SecondaryAction}" MinHeight="32" Margin="8,0,0,0" />
                                            <TextBlock Text="Добавить в каталог" Style="{StaticResource Catalog.Heading}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding CatalogCreationLocation}" Style="{StaticResource Task.Files.Hint}" Margin="0,6,0,0" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <WrapPanel.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource Task.Files.Action}">
                                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="ToolTip" Value="Добавление с диска требует права создавать записи и расположения." />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button x:Name="CatalogPickFile" Content="_Файл с диска…" Click="AddPickedFile" IsEnabled="{Binding CanAddCatalogPaths}"
                                                    AutomationProperties.AutomationId="AddCatalogFilePicker" />
                                            <Button Content="_Папка с диска…" Click="AddPickedFolder" IsEnabled="{Binding CanAddCatalogPaths}"
                                                    AutomationProperties.AutomationId="AddCatalogFolderPicker" />
                                        </WrapPanel>
                                        <TextBlock Text="Файлы и папки также можно перетащить сюда из Проводника."
                                                   Style="{StaticResource Task.Files.Hint}" Margin="0" />
                                        <Separator Margin="0,12,0,0" />
                                        <TextBlock Text="Название" Style="{StaticResource Task.Files.Label}" />
                                        <TextBox x:Name="CatalogNameInput" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Task.Files.Text}" AutomationProperties.Name="Название записи"
                                                 AutomationProperties.AutomationId="CatalogNameInput" />
                                        <TextBlock Text="Тип записи" Style="{StaticResource Task.Files.Label}" />
                                        <ComboBox ItemsSource="{Binding CatalogItemTypes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding NewItemType}" Style="{StaticResource Task.Files.Combo}"
                                                  AutomationProperties.Name="Тип записи каталога" AutomationProperties.AutomationId="CatalogItemType" />
                                        <WrapPanel Margin="0,12,0,-8">
                                            <Button Content="Создать запись" Command="{Binding CreateCatalogItemCommand}"
                                                    Style="{StaticResource Task.Files.PrimaryAction}" AutomationProperties.AutomationId="CreateCatalogItemButton" />
                                            <Button Content="Создать папку" Command="{Binding CreateCatalogFolderCommand}"
