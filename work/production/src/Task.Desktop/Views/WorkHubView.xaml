<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" xmlns:views="clr-namespace:Task.Desktop.Views" x:Class="Task.Desktop.Views.WorkHubView" AutomationProperties.Name="Рабочие данные" AutomationProperties.AutomationId="WorkHubView" Background="{DynamicResource Task.Brush.Surface.Base}" UseLayoutRounding="True" SnapsToDevicePixels="True" x:Name="WorkHubRoot">
    <UserControl.Resources>
        <Style x:Key="WorkHub.Panel" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style x:Key="WorkHub.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Section}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="WorkHub.Check" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Expander" TargetType="Expander">
            <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,12" FontSize="{DynamicResource Task.Font.Size.Section}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkHub.Region" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style x:Key="WorkHub.RegionHeader" TargetType="Border" BasedOn="{StaticResource Task.Surface.Subtle}">
            <Setter Property="MinHeight" Value="49"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="WorkHub.LeftColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="38*"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Width" Value="*"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.RightColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="62*"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Width" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Master" TargetType="Border" BasedOn="{StaticResource WorkHub.Region}">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Grid.RowSpan" Value="1"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Detail" TargetType="Border" BasedOn="{StaticResource WorkHub.Region}">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="Grid.Row" Value="1"/>
                    <Setter Property="Grid.RowSpan" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Footer" TargetType="Border" BasedOn="{StaticResource Task.Surface.Subtle}">
            <Setter Property="Margin" Value="-20,20,-20,-20"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="Auto"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsExpanded, ElementName=LinksExpander}" Value="True"/>
                                    <Condition Binding="{Binding Visibility, ElementName=LinksExpander}" Value="Visible"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="*"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Task.Surface.Base}" Padding="20,16" BorderThickness="0,0,0,1" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="44,0,16,0">
                    <TextBlock Text="{Binding AreaTitle}" FontSize="{DynamicResource Task.Font.Size.PageTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AccessText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel VerticalAlignment="Top">
                    <Button Content="Загрузить ещё" Command="{Binding LoadMoreCommand}" Margin="0,0,8,0" Visibility="{Binding HasMoreResults, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="WorkHubLoadMoreButton"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="WorkHubRefreshButton"/>
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Margin" Value="16,4,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=620}" Value="False">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Margin" Value="44,12,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                </WrapPanel>
                <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="False">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource Task.Icon.Catalog}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsContacts}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Contacts}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSearch}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Search}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNotifications}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Notifications}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsArchive}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Archive}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTrash}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Trash}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Settings}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Task.State.Inline}" Margin="0" Visibility="{Binding HasFeedback, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Сообщение раздела" AutomationProperties.AutomationId="WorkHubFeedback" AutomationProperties.LiveSetting="Polite" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Task.Icon.Info}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}"/>
                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="WorkHubFeedbackText"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Task.State.Panel}" Panel.ZIndex="30" Visibility="{Binding IsLimitedRole, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Ограниченная роль" AutomationProperties.AutomationId="WorkHubLimitedRoleState">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Path Data="{StaticResource Task.Icon.Lock}" Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}"/>
                <TextBlock Text="Раздел недоступен для текущей роли" Style="{StaticResource Task.State.Title}" Margin="0,12,0,0" TextAlignment="Center" AutomationProperties.Name="Ограниченная роль" AutomationProperties.AutomationId="WorkHubLimitedRoleText"/>
                <TextBlock Text="Названия, совпадения, количество и связи защищённых объектов не раскрываются. Обратитесь к администратору, если доступ нужен для работы." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource Task.Brush.Surface.Base}" Panel.ZIndex="20" Visibility="{Binding IsLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Загрузка раздела" AutomationProperties.AutomationId="WorkHubLoadingState" AutomationProperties.LiveSetting="Polite">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="160" Style="{StaticResource Task.Progress.Indeterminate}"/>
                <TextBlock Text="{Binding LoadingText}" Margin="0,12,0,0" Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>


        <Grid x:Name="CatalogDropArea" Background="{DynamicResource Task.Brush.Surface.Base}" AllowDrop="True" PreviewDragOver="ExplorerDragOver" PreviewDrop="ExplorerDrop" DragLeave="ExplorerDragLeave" Grid.Row="2" Margin="0"
              UseLayoutRounding="True" SnapsToDevicePixels="True" Visibility="{Binding IsCatalog, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Style="{StaticResource WorkHub.LeftColumn}"/><ColumnDefinition Style="{StaticResource WorkHub.RightColumn}"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource WorkHub.Master}" Padding="0" AutomationProperties.Name="Каталог файлов" AutomationProperties.AutomationId="FilesCatalogRegion">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Task.Files.Header}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource Task.Icon.Catalog}" Style="{StaticResource Task.Files.Icon}"/>
                            <TextBlock Grid.Column="1" Text="Каталог" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Task.Files.Panel}" Padding="12,8">
                        <Button x:Name="CatalogRootDropButton" Content="Корень каталога" Command="{Binding SelectCatalogRootCommand}" Style="{StaticResource Task.Button.Secondary}"
                                AllowDrop="True" DragOver="CatalogRootDragOver" Drop="CatalogRootDrop" AutomationProperties.AutomationId="CatalogRootButton"/>
                    </Border>
                    <Grid Grid.Row="2">
                    <TreeView ItemsSource="{Binding CatalogRoots}" BorderThickness="0" Background="Transparent" Padding="8,4" SelectedItemChanged="CatalogSelectionChanged"
                              PreviewMouseLeftButtonDown="CatalogMouseDown" PreviewMouseMove="CatalogMouseMove" AllowDrop="True" DragOver="CatalogDragOver" Drop="CatalogDrop"
                              AutomationProperties.Name="Дерево каталога" AutomationProperties.AutomationId="CatalogList">
                        <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem" BasedOn="{StaticResource Task.Files.TreeItem}">
                            <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        </Style></TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid Margin="10,8" ToolTip="{Binding Name}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ItemTypeLabel}" Style="{StaticResource Task.Files.Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
                            </Grid>
                        </HierarchicalDataTemplate></TreeView.ItemTemplate>
                    </TreeView>
                        <StackPanel Margin="20,28" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsCatalogEmpty, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource Task.Icon.Catalog}" Style="{StaticResource Task.Files.Icon}" Width="26" Height="26"/>
                            <TextBlock Text="Каталог пуст" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Добавьте файл или папку справа либо создайте запись вручную." Style="{StaticResource Task.Files.Hint}" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Style="{StaticResource WorkHub.Detail}"><Grid AutomationProperties.Name="Файл и расположения" AutomationProperties.AutomationId="FilesInspectorRegion">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Task.Files.Header}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCatalogItem.Name, TargetNullValue=Файл и расположения}" Style="{StaticResource Task.Files.Title}"/>
                        <TextBlock Text="{Binding SelectedCatalogItem.ItemTypeLabel}" Style="{StaticResource Task.Files.Hint}"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Task.Files.Panel}">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,-8">
                                    <Button Content="Добавить _файл…" Click="AddPickedFile" IsEnabled="{Binding CanAddCatalogPaths}" Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="AddCatalogFilePicker"/>
                                    <Button Content="Добавить _папку…" Click="AddPickedFolder" IsEnabled="{Binding CanAddCatalogPaths}" Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="AddCatalogFolderPicker"/>
                                </WrapPanel>
                                <TextBlock Text="Или перетащите файл или папку из Проводника в каталог." Style="{StaticResource Task.Files.Hint}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Task.Files.Panel}">
                            <StackPanel>
                                <StackPanel Margin="20,24" HorizontalAlignment="Center">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedCatalogItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <Path Data="{StaticResource Task.Icon.Info}" Style="{StaticResource Task.Files.Icon}" Width="26" Height="26"/>
                                    <TextBlock Text="Выберите файл или папку" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="Пути и действия появятся здесь. Каталог останется слева." Style="{StaticResource Task.Files.Hint}" TextAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedCatalogItem.Description}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Content="Открыть" Command="{Binding OpenFileCommand}" Style="{StaticResource Task.Files.PrimaryAction}" HorizontalAlignment="Left" AutomationProperties.AutomationId="OpenCatalogFileButton"/>
                                <Border Visibility="{Binding IsCorporate, Converter={StaticResource Task.BooleanToVisibilityConverter}}"><views:FileLocationsView DataContext="{Binding Locations}"/></Border>
                                <StackPanel Visibility="{Binding IsPersonal, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CatalogPathLabel}" Style="{StaticResource Task.Files.Label}"/>
                                    <TextBox Text="{Binding NewItemPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Files.Text}" AutomationProperties.Name="Путь к файлу" AutomationProperties.AutomationId="CatalogLocationTextBox"/>
                                    <Button Content="Сохранить путь" Command="{Binding AddLocationCommand}" Style="{StaticResource Task.Files.Action}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FileBehaviorText}" Style="{StaticResource Task.Files.Hint}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Task.Files.Panel}">
                            <Expander Header="Новая запись каталога" AutomationProperties.Name="Новая запись каталога" AutomationProperties.AutomationId="FilesCreateSection" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding CatalogCreationLocation}" Style="{StaticResource Task.Files.Hint}"/>
                                    <TextBlock Text="Название" Style="{StaticResource Task.Files.Label}"/>
                                    <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Files.Text}" AutomationProperties.Name="Название записи"/>
                                    <TextBlock Text="Тип записи" Style="{StaticResource Task.Files.Label}"/>
                                    <ComboBox ItemsSource="{Binding CatalogItemTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NewItemType}" Style="{StaticResource Task.Files.Combo}" AutomationProperties.Name="Тип записи каталога" AutomationProperties.AutomationId="CatalogItemType"/>
                                    <WrapPanel Margin="0,16,0,-8">
                                        <Button Content="Создать запись" Command="{Binding CreateCatalogItemCommand}" Style="{StaticResource Task.Files.PrimaryAction}" AutomationProperties.AutomationId="CreateCatalogItemButton"/>
                                        <Button Content="Создать папку" Command="{Binding CreateCatalogFolderCommand}" Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="CreateCatalogFolderButton"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                        <Border Style="{StaticResource Task.Files.Panel}">
                            <Expander Header="Перемещение" AutomationProperties.Name="Перемещение записи каталога" AutomationProperties.AutomationId="FilesMoveSection" HorizontalContentAlignment="Stretch">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Переместить выбранный элемент в:" Style="{StaticResource Task.Files.Label}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding CatalogMoveDestinations}" SelectedItem="{Binding MoveDestination}" DisplayMemberPath="Label" Style="{StaticResource Task.Files.Combo}" AutomationProperties.Name="Папка назначения"/>
                                    <Button Content="Переместить в…" Command="{Binding MoveCatalogItemCommand}" Style="{StaticResource Task.Files.Action}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.AutomationId="MoveCatalogItemButton"/>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid></Border>

        </Grid>
        <DockPanel Grid.Row="2" Visibility="{Binding IsContacts, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding HasCompanies, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                <Button Content="Контакты" Command="{Binding ShowContactsCommand}" Style="{StaticResource Task.Button.Secondary}"/>
                <Button Content="Компании" Command="{Binding ShowCompaniesCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="8,0"/>
            </WrapPanel>
            <Grid>
                <views:CompaniesView DataContext="{Binding Companies}" Visibility="{Binding DataContext.ShowCompanies, RelativeSource={RelativeSource AncestorType=views:WorkHubView}, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                <Grid Visibility="{Binding ShowContactPeople, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Style="{StaticResource WorkHub.LeftColumn}"/>
                        <ColumnDefinition Style="{StaticResource WorkHub.RightColumn}"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource WorkHub.Master}">
                        <DockPanel>
                            <Border Style="{StaticResource WorkHub.RegionHeader}" DockPanel.Dock="Top">
                                <TextBlock Text="Контакты" Style="{StaticResource WorkHub.SectionTitle}"/>
                            </Border>
                            <ListBox ItemContainerStyle="{StaticResource Task.DataList.Item}" Style="{StaticResource Task.DataList}" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}" BorderThickness="0" AutomationProperties.Name="{Binding ContactsListName}" AutomationProperties.AutomationId="ContactsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource WorkHub.Detail}">
                        <DockPanel>
                            <Border Style="{StaticResource WorkHub.RegionHeader}" DockPanel.Dock="Top">
                                <TextBlock Text="Карточка и взаимодействия" Style="{StaticResource WorkHub.SectionTitle}"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20,16">
                                    <ContentControl Content="{Binding ContactCard}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,20" AutomationProperties.AutomationId="ContactCard">
                                                    <TextBlock Text="Карточка контакта" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Выберите контакт в списке для просмотра." Margin="0,8" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDetails}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding Message}" Margin="0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="ContactCardMessage"/>
                                                    <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding Details.Contact.DisplayName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <Grid Margin="0,16,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="Имя" Margin="0,0,12,12" Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                                                            <TextBlock Text="{Binding Details.Contact.FirstName}" Grid.Row="0" Grid.Column="1" Margin="0,0,12,12" TextWrapping="Wrap"/>
