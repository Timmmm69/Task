                <TextBox Text="{Binding LifecycleQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}" Margin="0,0,10,0" AutomationProperties.Name="Поиск в архиве и корзине" AutomationProperties.AutomationId="LifecycleSearchTextBox"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LifecycleTypeFilters}" SelectedItem="{Binding LifecycleTypeFilter}" Style="{StaticResource Task.Input.Combo}" AutomationProperties.Name="Тип объекта"/>
                <TextBlock Grid.Column="2" Text="{Binding VisibleLifecycleItems.Count, StringFormat={}{0} доступных объектов}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WorkHub.LeftColumn}"/>
                    <ColumnDefinition Style="{StaticResource WorkHub.RightColumn}"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource WorkHub.Master}">
                    <DockPanel>
                        <Border Style="{StaticResource WorkHub.RegionHeader}" DockPanel.Dock="Top">
                            <TextBlock Text="Объекты" Style="{StaticResource WorkHub.SectionTitle}"/>
                        </Border>
                        <ListBox ItemContainerStyle="{StaticResource Task.DataList.Item}" Style="{StaticResource Task.DataList}" ItemsSource="{Binding VisibleLifecycleItems}" SelectedItem="{Binding SelectedLifecycleItem}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Список доступных объектов" AutomationProperties.AutomationId="LifecycleItemsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,14" Margin="0" Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ChangedText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource WorkHub.Detail}">
                    <DockPanel>
                        <Border Style="{StaticResource WorkHub.RegionHeader}" DockPanel.Dock="Top">
                            <TextBlock Text="Детали объекта" Style="{StaticResource WorkHub.SectionTitle}"/>
                        </Border>
                        <Border AutomationProperties.Name="Инспектор lifecycle" AutomationProperties.AutomationId="LifecycleInspector" Padding="20,16" BorderThickness="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel DataContext="{Binding SelectedLifecycleItem}">
                                    <TextBlock Text="{Binding TypeLabel, TargetNullValue=Выберите объект}" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding LifecycleLabel}" Margin="0,5,0,16" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                                    <Border Style="{StaticResource Task.State.Inline}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Только чтение" FontWeight="SemiBold"/>
                                            <TextBlock Text="Работы завершены; история и разрешённые связи сохранены." TextWrapping="Wrap" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding ChangedText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RetentionText}" TextWrapping="Wrap" Margin="0,8,0,16" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                                    <Button Content="Восстановить" Command="{Binding DataContext.RestoreLifecycleItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Button.Primary}" HorizontalAlignment="Left" AutomationProperties.Name="Восстановить выбранный объект" AutomationProperties.AutomationId="RestoreLifecycleItemButton"/>
                                    <TextBlock Text="{Binding DataContext.LifecycleRestoreText,RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Task.Brush.Text.Secondary}" FontSize="12"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>
                <Border Grid.ColumnSpan="2" Panel.ZIndex="3" Grid.RowSpan="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleLifecycleItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource Task.Icon.Archive}" Width="28" Height="28" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}"/>
                        <TextBlock Text="Доступных объектов нет" Style="{StaticResource Task.State.Title}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding LifecycleEmptyText}" Style="{StaticResource Task.State.Body}" Margin="0,6,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <ScrollViewer Grid.Row="2" Visibility="{Binding IsSettings, Converter={StaticResource Task.BooleanToVisibilityConverter}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Настройки" AutomationProperties.AutomationId="SettingsView">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource WorkHub.Region}" Grid.Column="0">
                    <DockPanel>
                        <Border Style="{StaticResource WorkHub.RegionHeader}" DockPanel.Dock="Top">
                            <TextBlock Text="Разделы" Style="{StaticResource WorkHub.SectionTitle}"/>
                        </Border>
                        <ListBox Style="{StaticResource Task.DataList}" ItemsSource="{Binding SettingsSections}" SelectedItem="{Binding SettingsSection}" BorderThickness="0" BorderBrush="{DynamicResource Task.Brush.Border.Default}" Background="{DynamicResource Task.Brush.Surface.Base}" Padding="0" VerticalAlignment="Top" AutomationProperties.Name="Разделы настроек" AutomationProperties.AutomationId="SettingsNavigation">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Task.DataList.Item}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="MinHeight" Value="44"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="›" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Padding="20" Margin="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource WorkHub.Panel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanReadSettings}" Value="True"/>
                                            <Condition Binding="{Binding IsProfileSettings}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Task.Brush.Brand.Soft}" CornerRadius="10" Padding="9,4">
                                    <TextBlock Text="Личные" FontSize="11" Foreground="{DynamicResource Task.Brush.Brand.Primary}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Профиль и рабочий день" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SettingsPersistenceText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,4,0,12"/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Язык" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <ComboBox Style="{StaticResource Task.Input.Combo}" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding UserLanguage}" IsEditable="False" AutomationProperties.Name="Язык интерфейса" AutomationProperties.AutomationId="SettingsLanguage"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Первый день недели" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <ComboBox Style="{StaticResource Task.Input.Combo}" ItemsSource="{Binding WeekdayChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding FirstDayOfWeek}" IsEditable="False" AutomationProperties.Name="Первый день недели" AutomationProperties.AutomationId="SettingsFirstDay"/>
                                    <TextBlock Text="Формат времени" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <ComboBox Style="{StaticResource Task.Input.Combo}" ItemsSource="{Binding TimeFormatChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding UserTimeFormat}" AutomationProperties.Name="Формат времени" AutomationProperties.AutomationId="SettingsTimeFormat"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Начало рабочего дня" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBox Text="{Binding WorkdayStartDisplay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}" MaxLength="16" ToolTip="Часы и минуты, например 09:00" AutomationProperties.Name="Начало рабочего дня" AutomationProperties.AutomationId="SettingsWorkdayStart"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Конец рабочего дня" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBox Text="{Binding WorkdayEndDisplay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}" MaxLength="16" ToolTip="Часы и минуты, например 09:00" AutomationProperties.Name="Конец рабочего дня" AutomationProperties.AutomationId="SettingsWorkdayEnd"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Длительность задачи, мин" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBox Text="{Binding DefaultTaskDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"/>
                                </StackPanel>
                                <StackPanel Width="300" Margin="0,0,12,10">
                                    <TextBlock Text="Время напоминания для задач со сроком без времени" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding ReminderTimeDisplay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}" MaxLength="16" ToolTip="Часы и минуты, например 09:00" AutomationProperties.Name="Время напоминания для срока без времени" AutomationProperties.AutomationId="SettingsReminderTime"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Напоминать за, мин" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBox Text="{Binding DefaultReminderOffsetMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"/>
                                </StackPanel>
                            </WrapPanel>
                            <CheckBox Style="{StaticResource WorkHub.Check}" Content="Запускать Task вместе с Windows" IsChecked="{Binding AutostartEnabled}" Margin="0,4"/>
                            <CheckBox Style="{StaticResource WorkHub.Check}" Content="Разрешать локальные пути" IsChecked="{Binding AllowLocalPaths}" Margin="0,4"/>
                            <CheckBox Style="{StaticResource WorkHub.Check}" Content="Подтверждать удаление записей каталога" IsChecked="{Binding ConfirmCatalogDelete}" Margin="0,4"/>
                            <StackPanel Width="320" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <TextBlock Text="Если файл недоступен" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                <ComboBox Style="{StaticResource Task.Input.Combo}" SelectedValue="{Binding MissingFileBehavior}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Показать действия" Tag="show_actions"/>
                                    <ComboBoxItem Content="Оставить неактивным" Tag="keep_inactive"/>
                                    <ComboBoxItem Content="Предложить новый путь" Tag="prompt_relink"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Время вводится в формате ЧЧ:ММ, например 09:00." Margin="0,10,0,0" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                            <TextBlock Foreground="{DynamicResource Task.Brush.Semantic.Critical}" Margin="0,8,0,0" Text="{Binding ProfileSettingsError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SettingsProfileError"/>
                            <Border Style="{StaticResource WorkHub.Footer}">
                                <Button Content="Сохранить личные настройки" Command="{Binding SaveUserSettingsCommand}" Style="{StaticResource Task.Button.Primary}" HorizontalAlignment="Left" Margin="0" AutomationProperties.AutomationId="SaveUserSettingsButton"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Padding="20" Margin="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource WorkHub.Panel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanReadSettings}" Value="True"/>
                                            <Condition Binding="{Binding IsNotificationSettings}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Уведомления" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="Не беспокоить" Style="{StaticResource WorkHub.SectionTitle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Укажите часы и минуты. Пустые поля отключают режим." Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <StackPanel Width="120" Margin="0,0,12,12">
                                    <TextBlock Text="С" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource Task.Input.Text}" Text="{Binding QuietStartDisplay, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" ToolTip="Часы и минуты, например 22:00" AutomationProperties.Name="Начало режима Не беспокоить" AutomationProperties.AutomationId="SettingsQuietStart"/>
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,12,12">
                                    <TextBlock Text="До" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource Task.Input.Text}" Text="{Binding QuietEndDisplay, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" ToolTip="Часы и минуты, например 07:00" AutomationProperties.Name="Конец режима Не беспокоить" AutomationProperties.AutomationId="SettingsQuietEnd"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,12">
                                    <TextBlock Text="Часовой пояс" Margin="0,0,0,6"/>
                                    <TextBox Style="{StaticResource Task.Input.Text}" Text="{Binding QuietHoursTimeZone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Часовой пояс режима Не беспокоить" ToolTip="Часовой пояс, например Europe/Minsk"/>
                                </StackPanel>
                            </WrapPanel>
                            <CheckBox Style="{StaticResource WorkHub.Check}" Content="Получать уведомления" IsChecked="{Binding NotificationsEnabled}" Margin="0,12,0,4"/>
                            <CheckBox Style="{StaticResource WorkHub.Check}" Content="Показывать desktop-уведомления" IsChecked="{Binding DesktopNotificationsEnabled}" Margin="0,4"/>
                            <TextBlock Text="Закрытие окна оставляет Task в системном трее, если он доступен. Полный выход — через меню значка Task; после выхода уведомления не показываются." TextWrapping="Wrap" Margin="0,6"/>
                            <CheckBox Style="{StaticResource WorkHub.Check}" Content="Воспроизводить звук" IsChecked="{Binding NotificationSoundEnabled}" Margin="0,4"/>
                            <StackPanel Width="260" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <TextBlock Text="Отсрочка по умолчанию, мин" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                <TextBox Text="{Binding DefaultSnoozeMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"/>
                            </StackPanel>
                            <TextBlock Foreground="{DynamicResource Task.Brush.Semantic.Critical}" Margin="0,8,0,0" Text="{Binding NotificationSettingsError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SettingsNotificationError"/>
                            <Border Style="{StaticResource WorkHub.Footer}">
                                <Button Content="Сохранить уведомления" Command="{Binding SaveNotificationPreferencesCommand}" Style="{StaticResource Task.Button.Primary}" HorizontalAlignment="Left" Margin="0" AutomationProperties.AutomationId="SaveNotificationPreferencesButton"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Padding="20" Margin="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource WorkHub.Panel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerSettings}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Task.Brush.Surface.Hover}" CornerRadius="10" Padding="9,4">
                                    <TextBlock Text="Управляется организацией" FontSize="11"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Подключение и сервер" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Проверенный HTTPS endpoint и server-managed параметры." Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Task.State.Inline}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ServerAddress}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SettingsConnectionStatus}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="TLS" Foreground="{DynamicResource Task.Brush.Semantic.Success}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource Task.Brush.Semantic.WarningSoft}" BorderBrush="{DynamicResource Task.Brush.Semantic.Warning}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14" Visibility="{Binding IsOffline, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                <TextBlock Text="Сервер недоступен. Параметры показаны из последнего подтверждённого состояния; сохранение заблокировано." TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Настройки организации" FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold" Visibility="{Binding CanReadOrganization, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Серверные сроки хранения и горизонт повторений. Изменение доступно только администратору." Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12" Visibility="{Binding CanReadOrganization, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                            <WrapPanel Visibility="{Binding CanReadOrganization, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Корзина, дней" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBox Text="{Binding TrashRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="История, дней" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBox Text="{Binding HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Change feed, дней" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBox Text="{Binding ChangeFeedRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"/>
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,10">
                                    <TextBlock Text="Горизонт повторений, дней" TextWrapping="Wrap" Margin="0,6,0,6"/>
                                    <TextBox Text="{Binding RecurrenceHorizonDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}"/>
                                </StackPanel>
                            </WrapPanel>
                            <Border Style="{StaticResource WorkHub.Footer}">
                                <Button Content="Сохранить настройки организации" Command="{Binding SaveOrganizationSettingsCommand}" Style="{StaticResource Task.Button.Primary}" HorizontalAlignment="Left" Margin="0" AutomationProperties.AutomationId="SaveOrganizationSettingsButton" Visibility="{Binding CanReadOrganization, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Expander x:Name="LinksExpander" Style="{StaticResource WorkHub.Expander}" Margin="0" Grid.Row="3" Header="{Binding LinksHeader}" state:ViewState.Section="work/v1/links" Visibility="{Binding HasLinks, Converter={StaticResource Task.BooleanToVisibilityConverter}}" BorderThickness="0,1,0,0">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,12">
                <views:ObjectLinksView state:ViewState.Surface="work-links/v1" DataContext="{Binding Links}"/>
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
