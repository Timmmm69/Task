                                                    <Button Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Button.Secondary}" HorizontalContentAlignment="Stretch" Padding="12" Margin="0,0,0,6" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="Открыть доступный результат">
