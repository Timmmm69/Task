<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:Task.Desktop.Converters" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" xmlns:views="clr-namespace:Task.Desktop.Views" x:Class="Task.Desktop.Views.WorkHubView" AutomationProperties.Name="Рабочие данные" AutomationProperties.AutomationId="WorkHubView" Background="{DynamicResource Task.Brush.Surface.Base}" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewTextInput="CatalogSearchShortcut" x:Name="WorkHubRoot">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/CorporateCatalog.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <converters:WindowWidthAtLeastConverter x:Key="Task.WindowWidthAtLeastConverter"/>
        <Style x:Key="WorkHub.SectionChrome" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCatalog}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSearch}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsContacts}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsLifecycle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.SectionFeedback" TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
            <Setter Property="Visibility" Value="{Binding HasFeedback, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearch}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsContacts}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsLifecycle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.SectionLimitedRole" TargetType="Border" BasedOn="{StaticResource Task.State.Panel}">
            <Setter Property="Visibility" Value="{Binding IsLimitedRole, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearch}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsContacts}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsLifecycle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.SectionLoading" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="Visibility" Value="{Binding IsLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearch}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsContacts}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsLifecycle}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Section}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="WorkHub.Expander" TargetType="Expander" BasedOn="{StaticResource Task.Expander.Compact}">
            <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,12" FontSize="{DynamicResource Task.Font.Size.Section}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkHub.Region" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style x:Key="WorkHub.RegionHeader" TargetType="Border" BasedOn="{StaticResource Task.Surface.Subtle}">
            <Setter Property="MinHeight" Value="49"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="WorkHub.LeftColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="38*"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Width" Value="*"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.RightColumn" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="62*"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Width" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Master" TargetType="Border" BasedOn="{StaticResource WorkHub.Region}">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Grid.RowSpan" Value="1"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WorkHub.Detail" TargetType="Border" BasedOn="{StaticResource WorkHub.Region}">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.RowSpan" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=860}" Value="False">
                    <Setter Property="Grid.Column" Value="0"/>
                    <Setter Property="Grid.Row" Value="1"/>
                    <Setter Property="Grid.RowSpan" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="Auto"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsExpanded, ElementName=LinksExpander}" Value="True"/>
                                    <Condition Binding="{Binding Visibility, ElementName=LinksExpander}" Value="Visible"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="*"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="20,16,20,12" Style="{StaticResource Task.Surface.Subtle}"
                Visibility="{Binding IsCatalog, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <Border.Resources>
                <StaticResource x:Key="Task.Radius.Control" ResourceKey="Catalog.ControlRadius" />
                <StaticResource x:Key="Task.Brush.Brand.Primary" ResourceKey="Catalog.Accent" />
                <StaticResource x:Key="Task.Brush.Brand.Strong" ResourceKey="Catalog.AccentHover" />
                <StaticResource x:Key="Task.Capsule.Accent" ResourceKey="Catalog.Accent" />
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="54*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CatalogSearchBox" Style="{StaticResource Task.Input.Search}"
                         Tag="Поиск по названию" Text="{Binding CatalogSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanShowCatalog}" AutomationProperties.Name="Поиск в каталоге"
                         AutomationProperties.AutomationId="CatalogSearchBox">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{x:Static state:SearchFieldCommands.Clear}" />
                    </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource Catalog.SecondaryAction}"
                            Width="42" MinHeight="42" Padding="0" Margin="0,0,8,0" ToolTip="Обновить каталог"
                            AutomationProperties.Name="Обновить каталог" AutomationProperties.AutomationId="WorkHubRefreshButton">
                        <Path Data="{StaticResource Task.Icon.Refresh}" Style="{StaticResource Task.Files.Icon}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="CatalogCreateButton" Click="ShowCatalogCreation" IsEnabled="{Binding CanStartCatalogCreation}"
                            Style="{StaticResource Task.Button.Primary}" MinHeight="42" Padding="14,6"
                            ToolTip="{Binding CatalogCreationHint}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Добавить в каталог" AutomationProperties.HelpText="{Binding CatalogCreationHint}"
                            AutomationProperties.AutomationId="CatalogAddButton">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Task.Icon.Add}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Добавить" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource WorkHub.SectionChrome}" Padding="20,16" BorderThickness="0,0,0,1" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="44,0,16,0">
                    <TextBlock Text="{Binding AreaTitle}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AccessText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel VerticalAlignment="Top">
                    <Button Content="Загрузить ещё" Command="{Binding LoadMoreCommand}" Margin="0,0,8,0" Visibility="{Binding HasMoreResults, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="WorkHubLoadMoreButton"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="WorkHubRefreshButton"/>
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Margin" Value="16,4,0,0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=WorkHubRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=620}" Value="False">
                                    <Setter Property="Grid.Column" Value="0"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Margin" Value="44,12,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                </WrapPanel>
                <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" IsHitTestVisible="False">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource Task.Icon.Catalog}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsContacts}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Contacts}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNotifications}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Notifications}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSettings}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource Task.Icon.Settings}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource WorkHub.SectionFeedback}" Margin="0" AutomationProperties.Name="Сообщение раздела" AutomationProperties.AutomationId="WorkHubFeedback" AutomationProperties.LiveSetting="Polite" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Task.Icon.Info}" Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}"/>
                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="WorkHubFeedbackText"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource WorkHub.SectionLimitedRole}" Panel.ZIndex="30" AutomationProperties.Name="Ограниченная роль" AutomationProperties.AutomationId="WorkHubLimitedRoleState">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <Path Data="{StaticResource Task.Icon.Lock}" Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}"/>
                <TextBlock Text="Раздел недоступен для текущей роли" Style="{StaticResource Task.State.Title}" Margin="0,12,0,0" TextAlignment="Center" AutomationProperties.Name="Ограниченная роль" AutomationProperties.AutomationId="WorkHubLimitedRoleText"/>
                <TextBlock Text="Названия, совпадения, количество и связи защищённых объектов не раскрываются. Обратитесь к администратору, если доступ нужен для работы." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource WorkHub.SectionLoading}" Panel.ZIndex="20" AutomationProperties.Name="Загрузка раздела" AutomationProperties.AutomationId="WorkHubLoadingState" AutomationProperties.LiveSetting="Polite">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="160" Style="{StaticResource Task.Progress.Indeterminate}"/>
                <TextBlock Text="{Binding LoadingText}" Margin="0,12,0,0" Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>


        <Grid x:Name="CatalogDropArea" AllowDrop="True" PreviewDragOver="ExplorerDragOver" PreviewDrop="ExplorerDrop"
              DragLeave="ExplorerDragLeave" Grid.Row="2" Style="{StaticResource Task.Grid.SurfaceBase}"
              Visibility="{Binding CanShowCatalog, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <Grid.Resources>
                <StaticResource x:Key="Task.Radius.Control" ResourceKey="Catalog.ControlRadius" />
                <StaticResource x:Key="Task.Brush.Brand.Primary" ResourceKey="Catalog.Accent" />
                <StaticResource x:Key="Task.Brush.Brand.Strong" ResourceKey="Catalog.AccentHover" />
                <StaticResource x:Key="Task.Brush.Brand.Soft" ResourceKey="Catalog.Selection" />
            </Grid.Resources>
            <Border Style="{StaticResource Task.Surface.Subtle}" Padding="20,0,20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="54*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Catalog.Card}" AutomationProperties.Name="Каталог файлов"
                            AutomationProperties.AutomationId="FilesCatalogRegion">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="16,12" BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Task.Brush.Border.Default}">
                                    <DockPanel>
                                        <Button x:Name="CatalogRootDropButton" DockPanel.Dock="Right" Content="В корень"
                                                Command="{Binding SelectCatalogRootCommand}" Click="ClearCatalogSearch"
                                                Padding="8,4" MinHeight="32" Margin="8,0,0,0"
                                                AllowDrop="True" DragOver="CatalogRootDragOver" Drop="CatalogRootDrop"
                                                ToolTip="Корень каталога" AutomationProperties.Name="Корень каталога"
                                                AutomationProperties.AutomationId="CatalogRootButton">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Catalog.SecondaryAction}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedCatalogItem}" Value="{x:Null}" />
                                                                <Condition Binding="{Binding IsCatalogSearchActive}" Value="False" />
                                                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{StaticResource Catalog.Selection}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Catalog.Accent}" />
                                                            <Setter Property="Foreground" Value="{StaticResource Catalog.Accent}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Catalog.Heading}">
                                                    <Setter Property="Text" Value="Файлы и папки" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCatalogSearchActive}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Items.Count, ElementName=CatalogResults, StringFormat=Найдено: {0}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <TreeView x:Name="CatalogTree" ItemsSource="{Binding CatalogRoots}" BorderThickness="0"
                                          Background="Transparent" Padding="8,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ItemContainerStyle="{StaticResource Catalog.TreeItem}"
                                          SelectedItemChanged="CatalogSelectionChanged" PreviewMouseLeftButtonDown="CatalogMouseDown"
                                          PreviewMouseMove="CatalogMouseMove" AllowDrop="True" DragOver="CatalogDragOver" Drop="CatalogDrop"
                                          AutomationProperties.Name="Дерево каталога" AutomationProperties.AutomationId="CatalogList">
                                    <TreeView.Style>
                                        <Style TargetType="TreeView">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCatalogSearchActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TreeView.Style>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Catalog.Entry}" />
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <ListBox x:Name="CatalogResults" Style="{StaticResource Task.DataList}"
                                         ItemsSource="{Binding CatalogSearchResults}" ItemTemplate="{StaticResource Catalog.Entry}"
                                         ItemContainerStyle="{StaticResource Catalog.SearchResult}"
                                         SelectedValuePath="Id" SelectedValue="{Binding SelectedCatalogItem.Id, Mode=OneWay}"
                                         SelectionChanged="CatalogSearchSelectionChanged" BorderThickness="0" Padding="8,6"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                                         Visibility="{Binding IsCatalogSearchActive, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                                         AutomationProperties.Name="Результаты поиска в каталоге" AutomationProperties.AutomationId="CatalogSearchResults" />
                                <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCatalogEmpty}" Value="True" />
                                                        <Condition Binding="{Binding IsCatalogSearchActive}" Value="False" />
                                                        <Condition Binding="{Binding IsFeedbackError}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource Task.Icon.Catalog}" Style="{StaticResource Task.Files.Icon}" Width="24" Height="24" />
                                    <TextBlock Text="Каталог пуст" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="Здесь появятся файлы и папки." Style="{StaticResource Task.Files.Hint}" TextAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                            AutomationProperties.LiveSetting="Polite">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCatalogSearchActive}" Value="True" />
                                                        <Condition Binding="{Binding HasItems, ElementName=CatalogResults}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource Task.Icon.Search}" Style="{StaticResource Task.Files.Icon}" Width="24" Height="24" />
                                    <TextBlock Text="Ничего не найдено" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="Попробуйте изменить запрос." Style="{StaticResource Task.Files.Hint}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Catalog.Card}" AutomationProperties.Name="Файл и расположения"
                            AutomationProperties.AutomationId="FilesInspectorRegion">
                        <ScrollViewer x:Name="CatalogInspector" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16">
                                <Border x:Name="CatalogCreationPanel" Style="{StaticResource Catalog.Card}" Visibility="Collapsed"
                                        Padding="12" Margin="0,0,0,16" AutomationProperties.Name="Новая запись каталога"
                                        AutomationProperties.AutomationId="FilesCreateSection">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Закрыть" Click="HideCatalogCreation"
                                                    Style="{StaticResource Catalog.SecondaryAction}" MinHeight="32" Margin="8,0,0,0" />
                                            <TextBlock Text="Добавить в каталог" Style="{StaticResource Catalog.Heading}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding CatalogCreationLocation}" Style="{StaticResource Task.Files.Hint}" Margin="0,6,0,0" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <WrapPanel.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource Task.Files.Action}">
                                                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="ToolTip" Value="Добавление с диска требует права создавать записи и расположения." />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Resources>
                                            <Button x:Name="CatalogPickFile" Content="_Файл с диска…" Click="AddPickedFile" IsEnabled="{Binding CanAddCatalogPaths}"
                                                    AutomationProperties.AutomationId="AddCatalogFilePicker" />
                                            <Button Content="_Папка с диска…" Click="AddPickedFolder" IsEnabled="{Binding CanAddCatalogPaths}"
                                                    AutomationProperties.AutomationId="AddCatalogFolderPicker" />
                                        </WrapPanel>
                                        <TextBlock Text="Файлы и папки также можно перетащить сюда из Проводника."
                                                   Style="{StaticResource Task.Files.Hint}" Margin="0" />
                                        <Separator Margin="0,12,0,0" />
                                        <TextBlock Text="Название" Style="{StaticResource Task.Files.Label}" />
                                        <TextBox x:Name="CatalogNameInput" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Task.Files.Text}" AutomationProperties.Name="Название записи"
                                                 AutomationProperties.AutomationId="CatalogNameInput" />
                                        <TextBlock Text="Тип записи" Style="{StaticResource Task.Files.Label}" />
                                        <ComboBox ItemsSource="{Binding CatalogItemTypes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding NewItemType}" Style="{StaticResource Task.Files.Combo}"
                                                  AutomationProperties.Name="Тип записи каталога" AutomationProperties.AutomationId="CatalogItemType" />
                                        <WrapPanel Margin="0,12,0,-8">
                                            <Button Content="Создать запись" Command="{Binding CreateCatalogItemCommand}"
                                                    Style="{StaticResource Task.Files.PrimaryAction}" AutomationProperties.AutomationId="CreateCatalogItemButton" />
                                            <Button Content="Создать папку" Command="{Binding CreateCatalogFolderCommand}"
                                                    Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="CreateCatalogFolderButton" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="8,28" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCatalogItem}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=CatalogCreationPanel}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource Task.Icon.Catalog}" Style="{StaticResource Task.Files.Icon}" Width="24" Height="24" />
                                    <TextBlock Text="Выберите запись" Style="{StaticResource Catalog.Heading}" TextAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Text="Здесь откроются сведения и действия для файла или папки."
                                               Style="{StaticResource Task.Files.Hint}" TextAlignment="Center" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCatalogItem}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding SelectedCatalogParentPath}" Style="{StaticResource Task.Files.Hint}"
                                               Margin="0,0,0,8" AutomationProperties.Name="Папка записи" />
                                    <TextBlock Text="{Binding SelectedCatalogItem.Name, NotifyOnTargetUpdated=True}" TargetUpdated="CatalogDetailsUpdated">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Catalog.Heading}">
                                                <Setter Property="FontSize" Value="22" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=CatalogInspector, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=380}" Value="False">
                                                        <Setter Property="FontSize" Value="19" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedCatalogItem.ItemTypeLabel}" Style="{StaticResource Task.Files.Hint}" />
                                    <TextBlock Text="{Binding SelectedCatalogItem.Description}" Margin="0,10,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="Открыть" Command="{Binding OpenFileCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                            AutomationProperties.AutomationId="OpenCatalogFileButton" ToolTipService.ShowOnDisabled="True">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Catalog.SecondaryAction}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedCatalogItem.IsFolder}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CanOpenFile}" Value="False">
                                                        <Setter Property="ToolTip" Value="Требуется право открывать файлы и папки" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border Margin="0,12,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                                            BorderBrush="{DynamicResource Task.Brush.Border.Default}">
                                        <Expander Header="Перемещение" AutomationProperties.Name="Перемещение записи каталога"
                                                  AutomationProperties.AutomationId="FilesMoveSection" HorizontalContentAlignment="Stretch">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="Папка назначения" Style="{StaticResource Task.Files.Label}" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding CatalogMoveDestinations}" SelectedItem="{Binding MoveDestination}"
                                                          DisplayMemberPath="Label" Style="{StaticResource Task.Files.Combo}" AutomationProperties.Name="Папка назначения" />
                                                <Button Content="Переместить в…" Command="{Binding MoveCatalogItemCommand}" Style="{StaticResource Task.Files.Action}"
                                                        HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.AutomationId="MoveCatalogItemButton" />
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                    <Border Margin="0,8,0,0" Visibility="{Binding IsCorporate, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                        <views:FileLocationsView DataContext="{Binding Locations}">
                                            <views:FileLocationsView.Resources>
                                                <Style x:Key="Task.Files.PrimaryAction" TargetType="Button" BasedOn="{StaticResource Task.Files.Action}" />
                                            </views:FileLocationsView.Resources>
                                        </views:FileLocationsView>
                                    </Border>
                                    <StackPanel Visibility="{Binding IsPersonal, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding CatalogPathLabel}" Style="{StaticResource Task.Files.Label}" />
                                        <TextBox Text="{Binding NewItemPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Files.Text}"
                                                 AutomationProperties.Name="Путь к файлу" AutomationProperties.AutomationId="CatalogLocationTextBox" />
                                        <Button Content="Сохранить путь" Command="{Binding AddLocationCommand}" Style="{StaticResource Task.Files.Action}"
                                                HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FileBehaviorText}" Style="{StaticResource Task.Files.Hint}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <views:CorporateContactsView Grid.Row="0" Grid.RowSpan="3"
                                     Visibility="{Binding IsContacts, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
        <views:CorporateSearchView Grid.Row="2" Visibility="{Binding IsSearch, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
        <Grid Grid.Row="2" Visibility="{Binding IsNotifications, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Центр уведомлений" AutomationProperties.AutomationId="NotificationsSurface">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding NotificationFilters}" SelectedItem="{Binding NotificationFilter}" MinWidth="170" Style="{StaticResource Task.Input.Combo}" AutomationProperties.Name="Фильтр уведомлений"/>
                    <TextBlock Text="{Binding UnreadCount, StringFormat=Непрочитано: {0}}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Прочитать все" Command="{Binding MarkAllReadCommand}" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="MarkAllNotificationsReadButton"/>
            </Grid>
            <Grid Grid.Row="1" Grid.RowSpan="2" Margin="20,0,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource WorkHub.LeftColumn}"/>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition" BasedOn="{StaticResource WorkHub.RightColumn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanManageCorporateReminders}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource WorkHub.Master}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanManageCorporateReminders}" Value="False">
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="Grid.RowSpan" Value="2"/>
                                    <Setter Property="Height" Value="Auto"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Border Style="{StaticResource WorkHub.RegionHeader}" DockPanel.Dock="Top">
                            <TextBlock Text="Входящие уведомления" Style="{StaticResource WorkHub.SectionTitle}"/>
                        </Border>
                        <Grid>
                            <ListBox ItemContainerStyle="{StaticResource Task.DataList.Item}" Style="{StaticResource Task.DataList}" ItemsSource="{Binding VisibleNotifications}" SelectedItem="{Binding SelectedNotification}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Уведомления по срочности" AutomationProperties.AutomationId="NotificationsList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="20,14" Margin="0" CornerRadius="0" BorderThickness="0,0,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/>
                                                    <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="warning">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Warning}"/>
                                                            <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.WarningSoft}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="critical">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}"/>
                                                            <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.CriticalSoft}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Task.Brush.Brand.Primary}" VerticalAlignment="Top" Margin="0,6,0,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUnread}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                                    <TextBlock>
                                                        <Run Text="{Binding SeverityLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding TimeText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1" Grid.Row="1" Margin="10,12,0,0">
                                                    <Button Content="Открыть" Command="{Binding DataContext.OpenNotificationSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,8,6"/>
                                                    <Button Content="Прочитано" Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,8,6"/>
                                                    <Button Content="Отложить" Command="{Binding DataContext.SnoozeNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding CanSnooze,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,8,6"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Panel.ZIndex="2">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVisibleNotifications}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Task.Icon.Notifications}" Width="28" Height="28" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}"/>
                                    <TextBlock Text="Новых уведомлений нет" Style="{StaticResource Task.State.Title}" Margin="0,10,0,0"/>
                                    <TextBlock Text="Здесь появятся только разрешённые события." Style="{StaticResource Task.State.Body}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource WorkHub.Detail}" Visibility="{Binding CanManageCorporateReminders,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                    <Expander Style="{StaticResource WorkHub.Expander}" Header="Мои корпоративные напоминания" Margin="0" Visibility="{Binding CanManageCorporateReminders,Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="CorporateRemindersPanel" Padding="0" BorderThickness="0" IsExpanded="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,12,20,20">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Style="{StaticResource Task.Button.Secondary}" Content="Обновить" Command="{Binding RefreshRemindersCommand}"/>
                                    <Button Style="{StaticResource Task.Button.Secondary}" Content="Новое" Command="{Binding NewReminderCommand}" Margin="8,0"/>
                                </WrapPanel>
                                <ListBox ItemContainerStyle="{StaticResource Task.DataList.Item}" Style="{StaticResource Task.DataList}" ItemsSource="{Binding CorporateReminders}" SelectedItem="{Binding SelectedCorporateReminder}" DisplayMemberPath="DisplayText" MaxHeight="160" Margin="0,0,0,20" AutomationProperties.Name="Мои напоминания"/>
                                <TextBlock Text="Настройка напоминания" Style="{StaticResource WorkHub.SectionTitle}" Margin="0,0,0,12"/>
                                <TextBlock Text="Задача или событие (при редактировании можно оставить прежний объект)" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,6,0,8">
                                    <TextBox Style="{StaticResource Task.Input.Search}" Tag="Найти объект напоминания…" Text="{Binding ReminderSearch,UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="Поиск цели напоминания"/>
                                    <Button Style="{StaticResource Task.Button.Secondary}" Content="Найти" Command="{Binding SearchReminderTargetsCommand}" Margin="8,0"/>
                                </WrapPanel>
                                <ComboBox Style="{StaticResource Task.Input.Combo}" ItemsSource="{Binding ReminderTargets}" SelectedItem="{Binding ReminderTarget}" DisplayMemberPath="Title" Margin="0,6" AutomationProperties.Name="Выбор задачи или события"/>
                                <WrapPanel>
                                    <StackPanel Width="160" Margin="0,0,12,8">
                                        <TextBlock Text="Когда напомнить" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <ComboBox Style="{StaticResource Task.Input.Combo}" ItemsSource="{Binding ReminderTriggers}" SelectedItem="{Binding ReminderTrigger}"/>
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,12,8">
                                        <TextBlock Text="Отступ, мин (пусто — настройка)" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource Task.Input.Text}" Text="{Binding ReminderOffset,UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Width="240" Margin="0,0,12,8">
                                        <TextBlock Text="Дата и время (dd.MM.yyyy HH:mm)" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource Task.Input.Text}" Text="{Binding ReminderAbsolute,UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Style="{StaticResource Task.Button.Primary}" Content="Сохранить" Command="{Binding SaveReminderCommand}"/>
                                    <Button Style="{StaticResource Task.Button.Secondary}" Content="Отменить" Command="{Binding CancelReminderCommand}" Margin="8,0"/>
                                    <Button Style="{StaticResource Task.Button.Secondary}" Content="Восстановить" Command="{Binding RestoreReminderCommand}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,8">
                                    <ComboBox Style="{StaticResource Task.Input.Combo}" ItemsSource="{Binding SnoozePresets}" SelectedItem="{Binding SnoozePreset}" MinWidth="150" AutomationProperties.Name="Время отсрочки"/>
                                    <TextBox Style="{StaticResource Task.Input.Text}" Text="{Binding SnoozeUntil,UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="8,0" ToolTip="Для собственной отсрочки: dd.MM.yyyy HH:mm"/>
                                    <Button Style="{StaticResource Task.Button.Secondary}" Content="Отложить" Command="{Binding SnoozeReminderCommand}"/>
                                    <Button Style="{StaticResource Task.Button.Secondary}" Content="Закрыть срабатывание" Command="{Binding DismissReminderCommand}" Margin="8,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Border>
            </Grid>
        </Grid>
        <views:CorporateLifecycleView Grid.RowSpan="3"
                                      Visibility="{Binding IsLifecycle, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
        <views:CorporateSettingsView Grid.Row="2"
                                     Visibility="{Binding IsSettings, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
        <Expander x:Name="LinksExpander" Style="{StaticResource WorkHub.Expander}" Margin="0" Grid.Row="3" Header="{Binding LinksHeader}" state:ViewState.Section="work/v1/links" Visibility="{Binding HasLinks, Converter={StaticResource Task.BooleanToVisibilityConverter}}" BorderThickness="0,1,0,0">
            <Border Padding="20,12">
                <views:ObjectLinksView state:ViewState.Surface="work-links/v1" DataContext="{Binding Links}"/>
            </Border>
        </Expander>
    </Grid>
</UserControl>
