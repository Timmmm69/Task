<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" xmlns:views="clr-namespace:Task.Desktop.Views" xmlns:api="clr-namespace:Task.Desktop.TaskApi" Language="ru-RU" UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Task.Desktop.Views.PersonalTasksView" x:Name="PersonalTasks">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Personal.Controls.xaml"/>
                <ResourceDictionary Source="../Resources/Personal.Workspace.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Personal.Toolbar}">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                    <Button Command="{Binding NewCommand}" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalNewTask" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Task.Icon.Add}" Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,8,0"/>
                            <TextBlock Text="Новая задача"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Text="{Binding Items.Count,StringFormat=Задачи · {0}}" Style="{StaticResource Personal.SectionTitle}"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="SplitWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Style="{StaticResource Personal.DetailColumn}"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Style="{StaticResource Personal.DetailRow}"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Personal.Pane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Personal.SectionHeader}">
                        <StackPanel Visibility="{Binding IsTasks,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                            <CheckBox Content="Скрыть завершённые" IsChecked="{Binding HideCompleted}" Margin="0,0,0,8"/>
                            <StackPanel Visibility="{Binding HasHiddenTasks,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                <TextBlock Text="Завершённые и отменённые задачи скрыты." TextWrapping="Wrap"/>
                                <Button Content="Показать завершённые" Command="{Binding ShowCompletedCommand}" HorizontalAlignment="Left" Margin="0,6,0,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Task.State.Inline}" Visibility="{Binding IsInbox,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Grid.Row="1" Margin="16,12">
                        <StackPanel>
                            <TextBlock Text="Запишите задачу сейчас, детали добавьте позже." Style="{StaticResource Task.State.Body}" Margin="0,0,0,8"/>
                            <TextBlock Text="Enter — записать" Margin="0,0,0,6"/>
                            <DockPanel>
                                <Button Content="Записать" Command="{Binding CaptureCommand}" DockPanel.Dock="Right" Style="{StaticResource Task.Button.Primary}" Margin="12,0,0,0" AutomationProperties.AutomationId="PersonalCapture"/>
                                <TextBox state:FormKeyboard.Capture="{Binding CaptureCommand}" Text="{Binding CaptureText,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.AutomationId="PersonalCaptureText" AutomationProperties.Name="Быстрая задача"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="TasksList" state:TaskRowAction.Command="{Binding OpenRowCommand}" ToolTip="Двойной щелчок — изменить или просмотреть задачу" AutomationProperties.HelpText="Двойной щелчок — изменить или просмотреть задачу" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource Personal.WorkspaceList}" ItemContainerStyle="{StaticResource Personal.WorkspaceItem}" IsEnabled="{Binding CanSelectTask}" AutomationProperties.AutomationId="PersonalTasksList" AutomationProperties.Name="Личные задачи">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource Personal.TaskStatusIcon}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Task.Table.TitleText}" TextWrapping="Wrap"/>
                                            <WrapPanel Margin="0,7,0,0">
                                                <Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,0,10,4">
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Personal.Metadata}"/>
                                                </Border>
                                                <TextBlock Text="{Binding PriorityText}" Style="{StaticResource Personal.Metadata}" Margin="0,3,0,4"/>
                                            </WrapPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding ScheduleText,StringFormat=План: {0}}" Style="{StaticResource Personal.Metadata}" Margin="0,0,12,2"/>
                                                <TextBlock Text="{Binding DeadlineText,StringFormat=Срок: {0}}" Style="{StaticResource Personal.Metadata}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Style="{StaticResource Task.State.Panel}" Visibility="{Binding ShowEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Grid.Row="0" Margin="16" Padding="16" MinHeight="0" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                <Path Data="{StaticResource Task.Icon.Tasks}" Width="30" Height="30" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}"/>
                                <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Task.State.Title}" TextAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding EmptyBody}" Style="{StaticResource Task.State.Body}" TextAlignment="Center" Margin="0,8,0,0"/>
                                <Button Content="Создать задачу" Command="{Binding NewCommand}" Margin="0,16,0,0" AutomationProperties.AutomationId="PersonalEmptyCreateTask">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Task.Button.Primary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Открыть задачи" Command="{Binding OpenTasksCommand}" Style="{StaticResource Task.Button.Primary}" Margin="0,16,0,0" Visibility="{Binding IsToday,Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="PersonalEmptyOpenTasks"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Task.Brush.Surface.Base}" Visibility="{Binding IsBusy,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="160" Style="{StaticResource Task.Progress.Indeterminate}"/>
                                <TextBlock Text="Обновляем задачи…" Style="{StaticResource Task.State.Body}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <Border Style="{StaticResource Personal.DetailPane}" AutomationProperties.AutomationId="PersonalTaskInspector">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Personal.SectionHeader}">
                        <Expander x:Name="DetailsExpander" Header="Детали задачи" state:ViewState.Section="personal-tasks/v1/details" IsExpanded="{Binding DetailsExpanded,Mode=TwoWay}" AutomationProperties.Name="Сведения о задаче" Padding="0"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsExpanded,ElementName=DetailsExpander,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                        <StackPanel Margin="20,16,20,24">
                            <TextBlock Text="{Binding Selected.Title,TargetNullValue=Выберите задачу}" Style="{StaticResource Personal.DetailTitle}"/>
                            <StackPanel Visibility="{Binding HasSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                <WrapPanel Margin="0,14,0,8">
                                    <Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,0,12,8">
                                        <TextBlock Text="{Binding Selected.StatusText}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Selected.PriorityText,StringFormat=Приоритет: {0}}" Style="{StaticResource Personal.Metadata}" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <Border Style="{StaticResource Task.Surface.Subtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="ПЛАНИРОВАНИЕ" Style="{StaticResource Task.Table.HeaderText}"/>
                                        <TextBlock Text="{Binding Selected.ScheduleText,StringFormat=План: {0}}" Margin="0,8,0,6" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Selected.DeadlineText,StringFormat=Срок: {0}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Описание" Style="{StaticResource Personal.SectionTitle}" Margin="0,20,0,8"/>
                                <TextBlock Text="{Binding Selected.Source.Card.Description,TargetNullValue=Описание не добавлено}" Style="{StaticResource Task.State.Body}"/>
                                <TextBlock Text="Действия" Style="{StaticResource Personal.SectionTitle}" Margin="0,20,0,8"/>
                                <WrapPanel>
                                    <Button Content="Изменить" Command="{Binding EditCommand}" Margin="0,0,8,8" AutomationProperties.AutomationId="PersonalEditTask"/>
                                    <Button Content="Добавить подзадачу" Command="{Binding DataContext.AddSubtaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{Binding DataContext.SubtaskActionHint,RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Добавить подзадачу" AutomationProperties.AutomationId="PersonalAddSubtask" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,12,0,8">
                                    <Button Content="В работу" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.InProgress}" Margin="0,0,8,8"/>
                                    <Button Content="На проверку" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Review}" Margin="0,0,8,8"/>
                                    <Button Content="Выполнить" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Completed}" Margin="0,0,8,8" AutomationProperties.AutomationId="PersonalCompleteTask"/>
                                    <Button Content="Отменить задачу" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Cancelled}" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Text="Чек-лист" Style="{StaticResource Personal.SectionTitle}" Margin="0,12,0,8"/>
                                <views:TaskChecklistView/>
                            </StackPanel>
                            <TextBlock Text="Выберите задачу в списке — здесь появятся описание, даты и действия." Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Task.State.Body}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Style="{StaticResource Personal.Feedback}" Grid.Row="2">
            <StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                <Button Content="Открыть задачу" Command="{Binding OpenSavedTaskCommand}" Visibility="{Binding ShowSavedTaskAction,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Task.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.AutomationId="PersonalOpenSavedTask"/>
            </StackPanel>
        </Border>
        <Grid Grid.RowSpan="3" Background="#66000000" Visibility="{Binding HasEditor,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Panel.ZIndex="50" Margin="0" KeyboardNavigation.TabNavigation="Cycle" state:FormKeyboard.Save="{Binding SaveCommand}" AutomationProperties.Name="Редактор личной задачи">
            <Border MaxWidth="660" Margin="20" Style="{StaticResource Task.Inspector.Panel}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Padding="24,18" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding Editor.Heading}" Style="{StaticResource Task.Shell.PageTitle}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel DataContext="{Binding Editor}" Margin="24,0,24,20">
                            <StackPanel IsEnabled="{Binding DataContext.IsNotBusy,ElementName=PersonalTasks}">
                                <TextBlock Visibility="{Binding Card.HasParent,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Text="{Binding Card.Parent.Name,StringFormat=Родитель: {0}}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Название (обязательно)" Style="{StaticResource Personal.Label}"/>
                                <TextBox x:Name="TitleInput" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TabIndex="20" AutomationProperties.Name="Название задачи" AutomationProperties.HelpText="Обязательное поле, не более 500 символов" AutomationProperties.AutomationId="PersonalTaskTitle"/>
                                <TextBlock Text="Например: подготовить договор" Style="{StaticResource Task.State.Body}" FontSize="12"/>
                                <TextBlock Text="{Binding TitleError}" Style="{StaticResource Personal.Validation}"/>
                                <TextBlock Text="Запланировать на день (необязательно)" Style="{StaticResource Personal.Label}"/>
                                <TextBox Text="{Binding Card.Date,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Card.IsDateOnly}" TabIndex="23" AutomationProperties.Name="День задачи" AutomationProperties.AutomationId="PersonalScheduledDate" AutomationProperties.HelpText="{Binding Card.DateHint}"/>
                                <views:TaskDayPicker DataContext="{Binding Card}"/>
                                <TextBlock Text="{Binding Card.DateHint}" Style="{StaticResource Task.State.Body}" FontSize="12"/>
                                <TextBlock Text="Описание (необязательно)" Style="{StaticResource Personal.Label}"/>
                                <TextBox Text="{Binding Card.Description,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" MaxLength="50000" TabIndex="24" AutomationProperties.AutomationId="PersonalTaskDescription" AutomationProperties.Name="Описание задачи"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Приоритет (обычный по умолчанию)" Style="{StaticResource Personal.Label}"/>
                                        <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" DisplayMemberPath="Text" TabIndex="21" AutomationProperties.Name="Приоритет"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Проект (необязательно)" Style="{StaticResource Personal.Label}"/>
                                        <ComboBox ItemsSource="{Binding Card.Projects}" SelectedItem="{Binding Card.Project}" DisplayMemberPath="Name" TabIndex="22" AutomationProperties.AutomationId="PersonalTaskProject" AutomationProperties.Name="Проект задачи"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="Срок (необязательно)" Style="{StaticResource Personal.Label}"/>
                                    <TextBox Text="{Binding DeadlineText,UpdateSourceTrigger=PropertyChanged}" TabIndex="26" AutomationProperties.Name="Срок задачи" AutomationProperties.HelpText="ДД.ММ.ГГГГ или ДД.ММ.ГГГГ ЧЧ:ММ, местное время" AutomationProperties.AutomationId="PersonalDeadline"/>
                                    <TextBlock Text="ДД.ММ.ГГГГ или ДД.ММ.ГГГГ ЧЧ:ММ · местное время" Style="{StaticResource Personal.DateHint}"/>
                                    <TextBlock Text="{Binding DeadlineError}" Style="{StaticResource Personal.Validation}"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,12">
                                    <TextBlock Text="Напомнить" Style="{StaticResource Personal.Label}"/>
                                    <ComboBox ItemsSource="{Binding ReminderOptions}" SelectedItem="{Binding ReminderOption}" DisplayMemberPath="Text" AutomationProperties.Name="Напомнить" AutomationProperties.AutomationId="TaskDeadlineReminder"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomReminder,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                        <TextBox Width="100" Text="{Binding CustomReminderMinutes,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Другой интервал, минут"/>
                                        <TextBlock Text="минут до срока" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReminderPreview}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock Text="{Binding ReminderRecipientHint}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                                <Expander Header="Планирование и связи" state:ViewState.Section="personal-tasks/v1/planning" Margin="0,20,0,0" IsExpanded="False">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.ColumnSpan="3">
                                                <TextBlock Text="Длительность, минут (необязательно)" Style="{StaticResource Personal.Label}"/>
                                                <TextBox Text="{Binding Card.Duration,UpdateSourceTrigger=PropertyChanged}" TabIndex="27" AutomationProperties.Name="Длительность"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.ColumnSpan="3">
                                                <TextBlock Text="Начало (необязательно)" Style="{StaticResource Personal.Label}"/>
                                                <TextBox Text="{Binding StartText,UpdateSourceTrigger=PropertyChanged}" TabIndex="25" AutomationProperties.Name="Дата и время начала" AutomationProperties.HelpText="ДД.ММ.ГГГГ ЧЧ:ММ, местное время" AutomationProperties.AutomationId="PersonalStart"/>
                                                <TextBlock Text="{Binding StartError}" Style="{StaticResource Personal.Validation}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Personal.DateHint}"/>
                                        <TextBlock Text="Родительская задача (необязательно)" Style="{StaticResource Personal.Label}"/>
                                        <ComboBox ItemsSource="{Binding Card.Tasks}" SelectedItem="{Binding Card.Parent}" DisplayMemberPath="Name" TabIndex="28" AutomationProperties.Name="Родительская задача" AutomationProperties.AutomationId="PersonalParentTask"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="{Binding CardError}" Style="{StaticResource Personal.Validation}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Personal.Validation}"/>
                            <Border Style="{StaticResource Task.State.Inline}" Margin="0,12,0,0" Visibility="{Binding HasConflict,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Задача изменилась. Ваш черновик сохранён. Загрузите актуальную версию, чтобы продолжить." TextWrapping="Wrap"/>
                                    <Button Content="Загрузить актуальную версию" Command="{Binding DataContext.ReloadEditorCommand,ElementName=PersonalTasks}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="24,14" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Click="OnCancelEditor" TabIndex="41" Margin="0,0,10,0"/>
                            <TextBlock Text="Ctrl+Enter — сохранить" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="{Binding Editor.SubmitText}" Command="{Binding SaveCommand}" TabIndex="40" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalSaveTask" AutomationProperties.Name="{Binding Editor.SubmitText}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
