<UserControl x:Class="Task.Desktop.Views.InboxView"
             x:Name="InboxRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Входящие"
             AutomationProperties.AutomationId="InboxScreen">
    <Grid Background="{DynamicResource Task.Brush.Surface.Subtle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="{Binding ActualWidth, ElementName=InboxRoot, Converter={StaticResource Task.ResponsiveGridLengthConverter}, ConverterParameter=640:8}" />
            <ColumnDefinition Width="{Binding ActualWidth, ElementName=InboxRoot, Converter={StaticResource Task.ResponsiveGridLengthConverter}, ConverterParameter=640:320}" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Task.Brush.Surface.Base}"
                BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,1,0"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource Task.Icon.Inbox}" Width="20" Height="20" Stretch="Uniform"
                          Fill="{DynamicResource Task.Brush.Brand.Primary}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding CaptureText, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500" Margin="10,0" TabIndex="10"
                             Style="{StaticResource Task.Input.Text}"
                             AutomationProperties.Name="Быстро добавить во входящие"
                             AutomationProperties.AutomationId="InboxCaptureTextBox"
                             AutomationProperties.HelpText="Введите короткую запись без проекта, срока и исполнителя" />
                    <Button Grid.Column="2" Content="Добавить" Command="{Binding CaptureCommand}"
                            Style="{StaticResource Task.Button.Primary}" MinWidth="104" TabIndex="11"
                            AutomationProperties.Name="Добавить запись во входящие"
                            AutomationProperties.AutomationId="InboxCaptureButton" />
                </Grid>

                <Border Grid.Row="1" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.AutomationId="InboxReadOnlyNotice">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="{StaticResource Task.Icon.Lock}" Width="17" Height="17"
                              Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding WriteAccessText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Margin="0,0,0,10" Padding="0,0,0,8"
                        BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1"
                        AutomationProperties.LiveSetting="Polite">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding ScreenMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ScreenMessage}" Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                               FontSize="{DynamicResource Task.Font.Size.Label}" TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="3">
                    <Border AutomationProperties.Name="Загрузка входящих" AutomationProperties.LiveSetting="Polite">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsInitialLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="210" Style="{StaticResource Task.Progress.Indeterminate}" />
                            <TextBlock Text="Загружаем входящие…" Style="{StaticResource Task.State.Title}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>

                    <Border AutomationProperties.Name="{Binding StateTitle}" AutomationProperties.LiveSetting="Assertive">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding ShowBlockingState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <Path Data="{Binding StateIconKey, Converter={StaticResource Task.IconKeyToGeometryConverter}}"
                                  Width="28" Height="28" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding StateTitle}" Style="{StaticResource Task.State.Title}" Margin="0,12,0,0" TextAlignment="Center" />
                            <TextBlock Text="{Binding ScreenMessage}" Style="{StaticResource Task.State.Body}" Margin="0,6,0,16" TextAlignment="Center" />
                            <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Task.Button.Secondary}"
                                    AutomationProperties.Name="Повторить загрузку входящих" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="InboxList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             TabIndex="12" KeyDown="OnInboxListKeyDown"
                             AutomationProperties.Name="Записи входящих" AutomationProperties.AutomationId="InboxList"
                             AutomationProperties.HelpText="Стрелки выбирают запись, Enter открывает преобразование">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource Task.DataList}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Task.DataList.Item}">
                                <Setter Property="MinHeight" Value="72" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource Task.Icon.Inbox}" Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Task.Brush.Brand.Primary}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="10,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                                   TextWrapping="Wrap" MaxHeight="42" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding CreatedText, StringFormat='Без классификации · {0}'}"
                                                   Margin="0,3,0,0" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                                   Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                      AutomationProperties.Name="Изменить ширину входящих и сведений" />

        <Expander x:Name="InboxInspectorExpander"
                  AutomationProperties.Name="Сведения о записи входящих"
                  AutomationProperties.AutomationId="InboxInspectorExpander">
            <Expander.Style>
                <Style TargetType="Expander">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="2" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Header" Value="{x:Null}" />
                    <Setter Property="IsExpanded" Value="True" />
                    <Setter Property="MaxHeight" Value="10000" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, ElementName=InboxRoot, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=640}" Value="False">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="3" />
                            <Setter Property="Header" Value="Сведения о записи" />
                            <Setter Property="IsExpanded" Value="False" />
                            <Setter Property="MaxHeight" Value="260" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <Border Background="{DynamicResource Task.Brush.Surface.Subtle}" Padding="28"
                    BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                            </StackPanel.Style>
                            <TextBlock Text="ЗАПИСЬ ВХОДЯЩИХ" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                       FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding SelectedItem.Title}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}"
                                       FontWeight="{DynamicResource Task.Font.Weight.Semibold}" TextWrapping="Wrap" Margin="0,12,0,20" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Создано" Style="{StaticResource Task.Inspector.FactLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedItem.CreatedText}" Style="{StaticResource Task.Inspector.FactValue}" />
                                <TextBlock Grid.Row="1" Text="Состояние" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,10,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Без классификации" Style="{StaticResource Task.Inspector.FactValue}" Margin="0,10,0,0" />
                            </Grid>
                            <TextBlock Text="Классифицируйте запись: при необходимости выберите проект и укажите срок. Исходная запись закроется, а связь сохранится в истории задачи."
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap" LineHeight="21" />
                            <Button Content="Преобразовать в задачу" Command="{Binding ConvertCommand}"
                                    CommandParameter="{Binding SelectedItem}" Style="{StaticResource Task.Button.Primary}"
                                    HorizontalAlignment="Left" Margin="0,20,0,0" TabIndex="13"
                                    AutomationProperties.Name="Преобразовать выбранную запись в задачу"
                                    AutomationProperties.AutomationId="InboxConvertButton" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSelectedItem}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Task.Icon.Inbox}" Width="28" Height="28" Stretch="Uniform"
                                  Fill="{DynamicResource Task.Brush.Text.Disabled}" HorizontalAlignment="Center" />
                            <TextBlock Text="Выберите запись" Margin="0,10,0,0" Style="{StaticResource Task.State.Title}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Expander>

        <Border Grid.RowSpan="2" Grid.ColumnSpan="3" Background="#66000000" Panel.ZIndex="30">
            <Border.Style>
                <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasConversion}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
            </Border.Style>
            <Border HorizontalAlignment="Right" Width="510" MaxWidth="510"
                    Background="{DynamicResource Task.Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Task.Brush.Border.Strong}" BorderThickness="1,0,0,0"
                    Padding="26" DataContext="{Binding Conversion}"
                    AutomationProperties.Name="Преобразовать в задачу"
                    AutomationProperties.AutomationId="InboxConversionPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="INBOX → TASK" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                           Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                                <TextBlock Text="Преобразовать в задачу" FontSize="{DynamicResource Task.Font.Size.DetailTitle}"
                                           FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Margin="0,8,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Закрыть" Style="{StaticResource Task.Button.Secondary}"
                                    Command="{Binding DataContext.CancelConversionCommand, ElementName=InboxRoot}"
                                    AutomationProperties.Name="Закрыть преобразование" />
                        </Grid>

                        <TextBlock Text="Название задачи" FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Margin="0,0,0,5" />
                        <TextBox x:Name="InboxConversionTitleBox" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="500" Style="{StaticResource Task.Input.Text}" TabIndex="30"
                                 AutomationProperties.Name="Название преобразуемой задачи"
                                 AutomationProperties.AutomationId="InboxConversionTitleBox" />
                        <TextBlock Text="{Binding TitleError}" Foreground="{DynamicResource Task.Brush.Semantic.Critical}"
                                   TextWrapping="Wrap" Margin="0,4,0,12" AutomationProperties.LiveSetting="Assertive" />

                        <TextBlock Text="Проект" FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Card.Projects}" SelectedItem="{Binding Card.Project}"
                                  DisplayMemberPath="Name" Style="{StaticResource Task.Input.Combo}" TabIndex="31"
                                  AutomationProperties.Name="Проект задачи" AutomationProperties.AutomationId="InboxConversionProject" />
                        <TextBlock Text="{Binding Card.Message}" Foreground="{DynamicResource Task.Brush.Text.Secondary}"
                                   FontSize="{DynamicResource Task.Font.Size.Metadata}" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Приоритет" FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" DisplayMemberPath="Text"
                                          Style="{StaticResource Task.Input.Combo}" TabIndex="32"
                                          AutomationProperties.Name="Приоритет задачи" AutomationProperties.AutomationId="InboxConversionPriority" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Срок" FontWeight="{DynamicResource Task.Font.Weight.Semibold}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding DeadlineText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Task.Input.Text}" TabIndex="33"
                                         AutomationProperties.Name="Срок задачи" AutomationProperties.AutomationId="InboxConversionDeadline"
                                         AutomationProperties.HelpText="Дата и время, например 29.07.2026 17:00" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding DeadlineError}" Foreground="{DynamicResource Task.Brush.Semantic.Critical}"
                                   TextWrapping="Wrap" Margin="0,-12,0,12" AutomationProperties.LiveSetting="Assertive" />

                        <Border Background="{DynamicResource Task.Brush.Brand.Soft}" BorderBrush="{DynamicResource Task.Brush.Brand.Primary}"
                                BorderThickness="3,0,0,0" Padding="12" Margin="0,0,0,20">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Data="{StaticResource Task.Icon.Inbox}" Width="16" Height="16"
                                      Stretch="Uniform" Fill="{DynamicResource Task.Brush.Brand.Primary}" Margin="0,1,9,0" />
                                <StackPanel>
                                    <TextBlock Text="Исходная запись будет закрыта" FontWeight="{DynamicResource Task.Font.Weight.Semibold}" />
                                    <TextBlock Text="Связь с задачей сохранится в истории." Margin="0,3,0,0"
                                               FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                               Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Margin="0,0,0,16">
                            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        </Border>

                        <StackPanel Margin="0,0,0,16">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasConflict}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="Запись изменилась на сервере. Ваш черновик сохранён; Task ничего не перезапишет автоматически."
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button Content="Загрузить актуальную версию" Style="{StaticResource Task.Button.Secondary}"
                                    HorizontalAlignment="Left" Command="{Binding DataContext.ReloadConflictCommand, ElementName=InboxRoot}"
                                    AutomationProperties.Name="Загрузить актуальную версию входящей записи"
                                    AutomationProperties.AutomationId="InboxReloadConflictButton" />
                        </StackPanel>

                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="Отмена" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,10,0" TabIndex="34"
                                    Command="{Binding DataContext.CancelConversionCommand, ElementName=InboxRoot}" />
                            <Button Content="Создать задачу" Style="{StaticResource Task.Button.Primary}" MinWidth="142" TabIndex="35"
                                    Command="{Binding DataContext.SaveConversionCommand, ElementName=InboxRoot}"
                                    AutomationProperties.Name="Создать задачу из входящей записи"
                                    AutomationProperties.AutomationId="InboxSaveConversionButton" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
