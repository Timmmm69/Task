<UserControl x:Class="Task.Desktop.Views.PersonalCatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Task.Desktop.Views" Background="White" Foreground="#222222" FontSize="14">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}"/>
  <Style x:Key="Catalog.Row" TargetType="ListBoxItem" BasedOn="{StaticResource Personal.Airbnb.BrowserRow}"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding TypeLabel}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,1"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Personal.Airbnb.Input}"/>
  <Style TargetType="Expander" BasedOn="{StaticResource Task.Expander.Compact}"><Setter Property="Margin" Value="0,16,0,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,8">
   <Button Content="+ Добавить файл…" Click="OnAddFile" Background="{StaticResource Personal.Airbnb.Accent}" Foreground="White" IsEnabled="{Binding Hub.CanAddCatalogPaths}" Margin="0,0,8,8" AutomationProperties.AutomationId="PersonalCatalogAddFile"/>
   <Button Content="Папка на диске…" Click="OnAddFolder" IsEnabled="{Binding Hub.CanAddCatalogPaths}" Margin="0,0,8,8"/>
   <Button Content="Новая запись" Click="OnNew" Margin="0,0,8,8"/>
   <Button Content="↻" Command="{Binding Hub.RefreshCommand}" ToolTip="Обновить каталог" AutomationProperties.Name="Обновить каталог" Margin="0,0,0,8"/>
  </WrapPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,4">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Поиск по названию" Style="{StaticResource Personal.Airbnb.Muted}"/><TextBox x:Name="CatalogSearch" Width="230" Text="{Binding CatalogQuery,UpdateSourceTrigger=PropertyChanged,Delay=150}" Margin="0,4,0,0" AutomationProperties.Name="Поиск в каталоге по названию"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Тип записи" Style="{StaticResource Personal.Airbnb.Muted}"/><ComboBox Width="174" ItemsSource="{Binding CatalogTypeFilters}" SelectedItem="{Binding CatalogTypeFilter}" Margin="0,4,0,0" AutomationProperties.Name="Тип записи в каталоге"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Сортировка" Style="{StaticResource Personal.Airbnb.Muted}"/><ComboBox Width="190" ItemsSource="{Binding CatalogSortOrders}" SelectedItem="{Binding CatalogSort}" Margin="0,4,0,0" AutomationProperties.Name="Сортировка каталога"/></StackPanel>
   <Button Content="Сбросить" Click="OnReset" VerticalAlignment="Bottom" Margin="0,0,12,8"/>
   <CheckBox Content="Во всём каталоге" IsChecked="{Binding CatalogEverywhere}" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
  </WrapPanel>
  <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid x:Name="BrowserGrid" Height="600"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition x:Name="DetailsColumn" Width="1*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
    <Grid x:Name="ListRegion" Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,10">
      <WrapPanel><Button Content="Каталог" Click="OnRoot" Padding="12,6" Margin="0,0,8,4"/><Button Content="↑ Выше" Click="OnUp" IsEnabled="{Binding CanGoCatalogUp}" Padding="12,6" Margin="0,0,0,4"/></WrapPanel>
      <TextBlock Text="{Binding CatalogLocation}" ToolTip="{Binding CatalogLocation}" TextTrimming="CharacterEllipsis" Margin="2,4,0,6"/>
      <TextBlock Text="{Binding CatalogCountText}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
     <Border Grid.Row="1" Background="{StaticResource Personal.Airbnb.Soft}" CornerRadius="8" Padding="14,9" Margin="0,0,0,4"><TextBlock Text="Название · тип · путь" FontWeight="Bold"/></Border>
     <ListBox x:Name="CatalogList" Style="{StaticResource Personal.Airbnb.VirtualList}" Grid.Row="2" ItemsSource="{Binding VisibleCatalogRows}" SelectedItem="{Binding CatalogSelection}" Background="White" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource Catalog.Row}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="OnActivate" PreviewKeyDown="OnListKey" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" AutomationProperties.Name="Личный каталог" AutomationProperties.AutomationId="PersonalCatalogList">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Top" Fill="{StaticResource Personal.Airbnb.Secondary}"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M3,1 L11,1 17,7 17,21 3,21 Z M4,2 L4,20 16,20 16,8 10,8 10,2 Z M11,2 L11,7 16,7 Z"/><Style.Triggers><DataTrigger Binding="{Binding Source.ItemType}" Value="virtual_folder"><Setter Property="Data" Value="{StaticResource Task.Icon.Projects}"/></DataTrigger><DataTrigger Binding="{Binding Source.ItemType}" Value="folder_reference"><Setter Property="Data" Value="{StaticResource Task.Icon.Projects}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
       <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
       <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" FontSize="12" Foreground="{StaticResource Personal.Airbnb.Secondary}" Margin="12,1,0,0"/>
       <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PathLabel}" FontSize="12" Foreground="{StaticResource Personal.Airbnb.Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathLabel}" Margin="0,6,0,0"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border Grid.Row="2" Background="White" Visibility="{Binding ShowCatalogEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center" Margin="20"><TextBlock Text="{Binding CatalogEmptyTitle}" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="18"/><TextBlock Text="{Binding CatalogEmptyHint}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,16"/><Button Content="Сбросить фильтры" Click="OnReset" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Grid.Row="2" Background="White" Visibility="{Binding Hub.IsLoading,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="160"/><TextBlock Text="Загружаем каталог…" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Grid.Row="2" Background="White" Visibility="{Binding CatalogLoadFailed,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center" Margin="20"><TextBlock Text="Не удалось обновить каталог" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding Hub.Message}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,16"/><Button Content="Повторить" Command="{Binding Hub.RefreshCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    </Grid>
    <Border x:Name="DetailsPanel" Grid.Column="1" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1" CornerRadius="16" Padding="20" Background="White">
     <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Width="{Binding ViewportWidth,ElementName=DetailsScroll}">
      <TextBlock Text="Сведения и действия" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
      <TextBlock Text="Выберите запись в списке"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Personal.Airbnb.Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasCatalogSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <StackPanel Visibility="{Binding HasCatalogSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
       <TextBox Text="{Binding CatalogSelection.Name,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="Auto" MaxHeight="100" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0" FontWeight="Bold" FontSize="18" Background="Transparent" AutomationProperties.Name="Название выбранной записи"/>
       <TextBlock Text="{Binding CatalogSelection.TypeLabel}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,6,0,12"/>
       <TextBlock Text="{Binding CatalogSelection.Source.Description}" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <TextBox Text="{Binding CatalogSelection.ParentLocation,Mode=OneWay}" IsReadOnly="True" Height="Auto" MaxHeight="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Расположение записи в каталоге"/>
       <Button Content="Перейти в папку" Click="OnEnterFolder" Visibility="{Binding CatalogSelection.IsFolder,Converter={StaticResource Task.BooleanToVisibilityConverter}}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
       <StackPanel Visibility="{Binding CanEditCatalogPath,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
        <Button Content="Открыть" Command="{Binding Hub.OpenFileCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.AutomationId="PersonalCatalogOpen"/>
        <TextBlock Text="Путь к файлу или папке" Style="{StaticResource Personal.Label}"/>
        <TextBox x:Name="PathEditor" Text="{Binding CatalogPathDraft,UpdateSourceTrigger=PropertyChanged}" Height="Auto" MinHeight="64" MaxHeight="128" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Путь выбранной записи"/>
        <Button Content="Сохранить путь" Command="{Binding SaveCatalogPathCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        <TextBlock Text="Доступность проверяется при открытии. Приложение хранит ссылку на файл." Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,10,0,0"/>
       </StackPanel>
       <Expander Header="Перемещение и управление"><StackPanel Margin="0,10,0,0">
        <ComboBox ItemsSource="{Binding Hub.CatalogMoveDestinations}" SelectedItem="{Binding Hub.MoveDestination}" DisplayMemberPath="Label" AutomationProperties.Name="Папка назначения"/>
        <Button Content="Переместить в…" Command="{Binding Hub.MoveCatalogItemCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        <WrapPanel Margin="0,12,0,0"><Button Content="В архив" Command="{Binding ArchiveCommand}" Margin="0,0,8,8"/><Button Content="В корзину…" Click="OnTrash" IsEnabled="{Binding CanTrash}" Margin="0,0,0,8"/></WrapPanel>
       </StackPanel></Expander>
       <Expander Header="Связанные записи"><StackPanel Margin="0,10,0,0"><ComboBox ItemsSource="{Binding ActiveObjects}" SelectedItem="{Binding Target}" AutomationProperties.Name="Связать с записью"/><views:ObjectLinksView DataContext="{Binding Links}"/></StackPanel></Expander>
      </StackPanel>
      <Expander x:Name="CreateSection" Header="Новая запись каталога"><StackPanel Margin="0,10,0,0">
       <TextBlock Text="{Binding Hub.CatalogCreationLocation}" Style="{StaticResource Personal.Airbnb.Muted}"/>
       <TextBlock Text="Название" Style="{StaticResource Personal.Label}"/><TextBox x:Name="NewName" Text="{Binding Hub.NewItemName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Название новой записи каталога"/>
       <TextBlock Text="Тип записи" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding Hub.CatalogItemTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Hub.NewItemType}" AutomationProperties.Name="Тип новой записи каталога"/>
       <WrapPanel Margin="0,12,0,0"><Button Content="Создать запись" Command="{Binding Hub.CreateCatalogItemCommand}" Margin="0,0,8,8"/><Button Content="Создать папку" Command="{Binding Hub.CreateCatalogFolderCommand}" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel></Expander>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding Hub.Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
 </Grid>
</UserControl>
