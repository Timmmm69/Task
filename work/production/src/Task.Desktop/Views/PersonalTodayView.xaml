<UserControl x:Class="Task.Desktop.Views.PersonalTodayView" x:Name="Today"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:state="clr-namespace:Task.Desktop.Infrastructure"
 xmlns:api="clr-namespace:Task.Desktop.TaskApi"
 xmlns:views="clr-namespace:Task.Desktop.Views"
 Background="White" Foreground="#222222" FontFamily="Segoe UI" FontSize="14">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Airbnb.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,0,16">
   <Border Background="White" CornerRadius="40" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1" Padding="24,10,10,10" Margin="0,0,0,28">
    <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.08"/></Border.Effect>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="На сегодня" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="TaskCountLabel" Foreground="{StaticResource Personal.Airbnb.Secondary}" Margin="0,4,0,0"/></StackPanel>
     <Border Grid.Column="1" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1,0,0,0" Padding="20,0,12,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="В работе" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="ActiveCountLabel" Foreground="{StaticResource Personal.Airbnb.Secondary}" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1,0,0,0" Padding="20,0,12,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="По плану" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="DurationLabel" Foreground="{StaticResource Personal.Airbnb.Secondary}" Margin="0,4,0,0"/></StackPanel></Border>
     <Button Grid.Column="3" Command="{Binding NewCommand}" Style="{StaticResource Personal.Airbnb.Pill}" Background="{StaticResource Personal.Airbnb.Accent}" Foreground="White" BorderThickness="0" Padding="20,16" AutomationProperties.AutomationId="PersonalTodayNewTask">
      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Task.Icon.Add}" Width="16" Height="16" Stretch="Uniform" Fill="White" Margin="0,0,8,0"/><TextBlock Text="Новая задача"/></StackPanel>
     </Button>
    </Grid>
   </Border>
   <ContentControl HorizontalContentAlignment="Stretch"
                   Visibility="{Binding ShowEmptyTodayPlan, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
    <views:TodayGettingStartedView DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
   </ContentControl>
   <Grid x:Name="ContentGrid">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="320"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,24,0">
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel HorizontalAlignment="Left"><TextBlock Text="Ваши задачи" Style="{StaticResource Personal.Airbnb.Heading}"/><Border Height="2" Background="{DynamicResource Task.Brush.Semantic.Info}" Margin="0,12,0,0"/></StackPanel>
      <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource Personal.Airbnb.Pill}" Padding="12,8" BorderThickness="0" ToolTip="Обновить список" AutomationProperties.Name="Обновить задачи на сегодня"><Path Data="{StaticResource Task.Icon.Refresh}" Fill="#222222" Width="18" Height="18" Stretch="Uniform"/></Button>
     </Grid>
     <ListBox x:Name="TodayTasks" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanSelectTask}"
       state:TaskRowAction.Command="{Binding OpenRowCommand}" Background="White" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
       AutomationProperties.Name="Задачи на сегодня" AutomationProperties.AutomationId="PersonalTodayTasksList" ToolTip="Двойной щелчок — открыть задачу">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,8"/>
       <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="Transparent"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F7F7F7"/></Trigger>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#222222"/></Trigger>
         <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#222222"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="14" Background="#F7F7F7" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0"><Path Data="{StaticResource Task.Icon.Tasks}" Width="14" Height="14" Stretch="Uniform" Fill="#222222"/></Border>
        <StackPanel Grid.Column="1">
         <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
         <WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Personal.Airbnb.Secondary}"/><TextBlock Text=" · " Foreground="{StaticResource Personal.Airbnb.Secondary}"/><TextBlock Text="{Binding PriorityText}" Foreground="{StaticResource Personal.Airbnb.Secondary}"/><TextBlock Text="{Binding CompactDurationText}" Foreground="{StaticResource Personal.Airbnb.Secondary}"/></WrapPanel>
        </StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border Background="#F7F7F7" CornerRadius="16" Padding="24" Visibility="{Binding ShowEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
      <StackPanel><TextBlock Text="На сегодня задач нет" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="Можно запланировать что-нибудь или оставить день свободным." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,16"/><Button Content="Открыть задачи" Command="{Binding OpenTasksCommand}" Style="{StaticResource Personal.Airbnb.Pill}" HorizontalAlignment="Left"/>
      </StackPanel>
     </Border>
     <TextBlock Text="Обновляем задачи…" Style="{StaticResource Personal.Airbnb.Muted}" Visibility="{Binding IsBusy,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="16" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <Border x:Name="DetailsCard" Grid.Column="1" CornerRadius="16" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1" Padding="24" VerticalAlignment="Top" Margin="0,0,0,8">
     <StackPanel>
      <TextBlock Text="Детали задачи" Style="{StaticResource Personal.Airbnb.Heading}"/>
      <TextBlock Text="{Binding Selected.Title,TargetNullValue=Выберите задачу из списка,FallbackValue=Выберите задачу из списка}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,24,0,0"/>
      <TextBlock Text="{Binding Selected.Source.Card.Description}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,12,0,0"/>
      <StackPanel Visibility="{Binding HasSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
       <Border Height="1" Background="#EBEBEB" Margin="0,24"/>
       <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Запланировать на" FontSize="12" Foreground="{StaticResource Personal.Airbnb.Secondary}"/><TextBlock Text="{Binding Selected.ScheduleText}" Margin="0,5,8,0" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Приоритет" FontSize="12" Foreground="{StaticResource Personal.Airbnb.Secondary}"/><TextBlock Text="{Binding Selected.PriorityText}" Margin="0,5,0,0"/></StackPanel>
       </Grid>
       <Button Content="Открыть задачу" Command="{Binding EditCommand}" Style="{StaticResource Personal.Airbnb.Pill}" Background="#222222" Foreground="White" BorderBrush="#222222"/>
       <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0"><Button Content="В работу" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.InProgress}" Style="{StaticResource Personal.Airbnb.Pill}" Padding="12,10" BorderThickness="0"/><Button Content="Выполнить" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Completed}" Style="{StaticResource Personal.Airbnb.Pill}" Padding="12,10" BorderThickness="0"/></WrapPanel>
       <Border Height="1" Background="#EBEBEB" Margin="0,20,0,16"/>
       <Expander x:Name="TodayChecklist" Header="Чек-лист" IsExpanded="False" AutomationProperties.Name="Чек-лист выбранной задачи"><views:TaskChecklistView Margin="0,8,0,0"/></Expander>
       <Button Content="Добавить подзадачу" Command="{Binding AddSubtaskCommand}" Style="{StaticResource Personal.Airbnb.Pill}" Padding="12,10" Margin="0,16,0,0" ToolTip="{Binding SubtaskActionHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="PersonalTodayAddSubtask"/>
       <Expander x:Name="TodayMoreActions" Header="Другие действия" Margin="0,16,0,0"><WrapPanel Margin="0,8,0,0">
        <Button Content="На проверку" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Review}" Style="{StaticResource Personal.Airbnb.Pill}" Padding="12,10" Margin="0,0,0,8"/>
        <Button Content="Отменить задачу" Command="{Binding TransitionCommand}" CommandParameter="{x:Static api:DesktopTaskStatus.Cancelled}" Style="{StaticResource Personal.Airbnb.Pill}" Padding="12,10"/>
       </WrapPanel></Expander>
      </StackPanel>
     </StackPanel>
    </Border>
   </Grid>
   <views:WorkdayFooter DataContext="{Binding DataContext.Workday, RelativeSource={RelativeSource AncestorType=Window}}"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
