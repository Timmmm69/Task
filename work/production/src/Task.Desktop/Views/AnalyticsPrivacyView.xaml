<UserControl x:Class="Task.Desktop.Views.AnalyticsPrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <StackPanel>
        <TextBlock Text="Статистика использования" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Text="С вашего разрешения Task отправляет в PostHog тип и время запуска или успешного действия, режим, версию приложения и случайные коды установки и сеанса. Содержимое задач, событий и проектов не передаётся."
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <CheckBox x:Name="Consent" IsEnabled="False" Checked="OnConsentChanged" Unchecked="OnConsentChanged"
                  Content="Отправлять статистику использования"
                  AutomationProperties.Name="Отправлять статистику использования"
                  AutomationProperties.AutomationId="TaskAnalyticsConsent"/>
        <TextBlock Text="При выключении Task прекращает отправку и удаляет код установки и очередь с этого компьютера."
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
