<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="clr-namespace:Task.Desktop.Administration"
             x:Class="Task.Desktop.Views.AdministrationView"
             AutomationProperties.Name="Администрирование" AutomationProperties.AutomationId="AdministrationView"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Corporate.Management.xaml"/>
                <ResourceDictionary Source="../Resources/Calendar.Forms.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Admin.Heading" TargetType="TextBlock" BasedOn="{StaticResource Corporate.Management.Heading}">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="Admin.RegionHeader" TargetType="Border">
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
            <Style x:Key="Admin.DetailRegion" TargetType="Border" BasedOn="{StaticResource Corporate.Management.Card}">
                <Setter Property="ClipToBounds" Value="True"/>
            </Style>
            <Style x:Key="Admin.Section" TargetType="Border">
                <Setter Property="Padding" Value="0,14,0,0"/>
                <Setter Property="Margin" Value="0,14,0,0"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
            </Style>
            <Style x:Key="Admin.Row" TargetType="ListBoxItem" BasedOn="{StaticResource Corporate.Management.Row}">
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            </Style>
            <Style x:Key="Admin.UserRow" TargetType="ListBoxItem" BasedOn="{StaticResource Admin.Row}">
                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding StatusLabel}"/>
            </Style>
            <Style x:Key="Admin.WriteAccessNote" TargetType="TextBlock" BasedOn="{StaticResource Corporate.Management.Muted}">
                <Style.Triggers>
                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Admin.Tab" TargetType="ListBoxItem" BasedOn="{StaticResource Corporate.Management.Tab}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource Task.Surface.Subtle}" Padding="20,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshCommand}" VerticalAlignment="Top"
                        Style="{StaticResource Corporate.Management.Button}" Margin="6,0,0,0" AutomationProperties.AutomationId="AdminRefreshButton"/>
                <ListBox IsEnabled="{Binding CanSelectUser}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Разделы администрирования" AutomationProperties.AutomationId="AdministrationTabs" ItemContainerStyle="{StaticResource Admin.Tab}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource Corporate.Management.InfoPanel}" Padding="10,6" Margin="0,0,0,8"
                        Visibility="{Binding HasMessage, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                        AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AdministrationFeedback">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Margin="0,0,0,8" Visibility="{Binding IsLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock Text="Обновляем данные…" Style="{StaticResource Corporate.Management.Muted}" Margin="0,0,0,3"/>
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource Task.Progress.Indeterminate}" Height="3"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource Corporate.Management.Card}" Padding="20"
                    Visibility="{Binding IsLimitedRole, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Ограниченная роль" AutomationProperties.AutomationId="AdministrationLimitedRoleState">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="520">
                    <TextBlock Text="Раздел недоступен для вашей роли" Style="{StaticResource Corporate.Management.Heading}" Margin="0,0,0,6"/>
                    <TextBlock Text="Обратитесь к администратору, если вам нужен доступ к этому разделу." Style="{StaticResource Corporate.Management.Muted}"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Visibility="{Binding CanReadCurrentArea, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="37*" MinWidth="214"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="63*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Style="{StaticResource Corporate.Management.Card}" Padding="20" Visibility="{Binding IsAccessManagement, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="AdminRoleAssignmentsUnavailable">
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="620">
                        <TextBlock Text="Назначение ролей недоступно" Style="{StaticResource Admin.Heading}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding RoleAssignmentLimitation}" Style="{StaticResource Corporate.Management.Muted}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Admin.DetailRegion}" Visibility="{Binding IsUsers, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                    <Grid Visibility="{Binding IsUsers, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Admin.RegionHeader}">
                            <Button Content="Создать пользователя" Command="{Binding CreateUserCommand}" HorizontalAlignment="Left"
                                    Style="{StaticResource Corporate.Management.Primary}" AutomationProperties.AutomationId="AdminCreateUserButton"/>
                        </Border>
                        <DockPanel Margin="12,10" IsEnabled="{Binding CanSearchUsers}" Grid.Row="1">
                            <Button DockPanel.Dock="Right" Content="Найти" Command="{Binding SearchUsersCommand}" Margin="8,0,0,0" Style="{StaticResource Corporate.Management.Button}" AutomationProperties.AutomationId="AdminSearchUsersButton"/>
                            <TextBox Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AutomationProperties.Name="Поиск сотрудников по имени, логину или email" AutomationProperties.AutomationId="AdminUserSearch" Style="{StaticResource Task.Input.Search}" Tag="Поиск…" ToolTip="По имени, логину или email">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchUsersCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2" Visibility="{Binding IsUserListEmpty, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                            <Path Data="{StaticResource Task.Icon.Info}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Disabled}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Пользователи не найдены" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="По текущему запросу пользователей нет." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Task.State.Body}" FontSize="{DynamicResource Task.Font.Size.Metadata}"/>
                        </StackPanel>
                        <ListBox Grid.Row="2" IsEnabled="{Binding CanSelectUser}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderThickness="0" Background="Transparent" Visibility="{Binding IsUsers, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Пользователи" AutomationProperties.AutomationId="AdminUsersList" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Admin.UserRow}" Padding="0" Margin="8,0,8,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0" Margin="0" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Padding="0" Style="{StaticResource Corporate.Management.InfoPanel}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                <TextBlock Text="{Binding Login}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Login}" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/>
                                                <TextBlock Text="{Binding StatusLabel}" Margin="0,3,0,0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="3" Content="Показать ещё" Command="{Binding MoreUsersCommand}" Style="{StaticResource Corporate.Management.Button}" Visibility="{Binding HasMoreUsers, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="12,6"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Admin.DetailRegion}" Visibility="{Binding IsRoles, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                    <Grid Visibility="{Binding IsRoles, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" BorderThickness="0" Background="Transparent" Visibility="{Binding IsRoles, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Роли" AutomationProperties.AutomationId="AdminRolesList" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Admin.Row}" Padding="0" Margin="8,0,8,0" Grid.Row="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0" Margin="0" Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding KindLabel}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Roles.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                                <Condition Binding="{Binding HasMessage}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Task.Icon.Info}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Disabled}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Список пуст" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="В этом разделе пока нет доступных записей." Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Task.State.Body}" FontSize="{DynamicResource Task.Font.Size.Metadata}">
                            </TextBlock>
                        </StackPanel>
                        <Border Style="{StaticResource Admin.RegionHeader}">
                            <TextBlock Text="Роли и права" Style="{StaticResource Admin.Heading}"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Admin.DetailRegion}" Visibility="{Binding IsResources, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                    <Grid Visibility="{Binding IsResources, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding Resources}" SelectedItem="{Binding SelectedResource}" BorderThickness="0" Background="Transparent" Visibility="{Binding IsResources, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.Name="Сетевые ресурсы" AutomationProperties.AutomationId="AdminResourcesList" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Admin.Row}" Padding="0" Margin="8,0,8,0" Grid.Row="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0" Margin="0" Background="Transparent">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding PathLabel}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathLabel}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Resources.Count}" Value="0"/>
                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                                <Condition Binding="{Binding HasMessage}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Task.Icon.Info}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Disabled}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Список пуст" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="В этом разделе пока нет доступных записей." Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Task.State.Body}" FontSize="{DynamicResource Task.Font.Size.Metadata}">
                            </TextBlock>
                        </StackPanel>
                        <Border Style="{StaticResource Admin.RegionHeader}">
                            <TextBlock Text="Сетевые ресурсы" Style="{StaticResource Admin.Heading}"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" AutomationProperties.AutomationId="AdminUserInspector">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Admin.DetailRegion}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsUserInspectorVisible}" Value="True"/>
                                        <Condition Binding="{Binding IsTransitionOpen}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Admin.RegionHeader}">
                            <TextBlock Text="Учётная запись" Style="{StaticResource Admin.Heading}"/>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel Margin="16,12,16,16">
                                <TextBlock Text="{Binding SelectedUser.DisplayName, TargetNullValue=Выберите пользователя}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedUser.Login}" Margin="0,4,0,10" Style="{StaticResource Corporate.Management.Muted}"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button Content="Редактировать" Command="{Binding EditUserCommand}" Style="{StaticResource Corporate.Management.Button}" Margin="0,0,8,4" AutomationProperties.AutomationId="AdminEditUserButton"/>
                                    <Button Content="Активировать" Command="{Binding BeginUserTransitionCommand}" CommandParameter="{x:Static admin:DesktopUserTransition.Activate}" Visibility="{Binding ShowActivate, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Corporate.Management.Button}" Margin="0,0,8,4" AutomationProperties.AutomationId="AdminActivateButton"/>
                                    <Button Content="Разблокировать" Command="{Binding BeginUserTransitionCommand}" CommandParameter="{x:Static admin:DesktopUserTransition.Unblock}" Visibility="{Binding ShowUnblock, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Corporate.Management.Button}" Margin="0,0,8,4" AutomationProperties.AutomationId="AdminUnblockButton"/>
                                    <Button Content="Восстановить учётную запись" Command="{Binding BeginUserTransitionCommand}" CommandParameter="{x:Static admin:DesktopUserTransition.Reactivate}" Visibility="{Binding ShowReactivate, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Corporate.Management.Button}" Margin="0,0,8,4" AutomationProperties.AutomationId="AdminReactivateButton"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding UserWriteAccessText}" Style="{StaticResource Admin.WriteAccessNote}" Margin="0,0,0,8"/>
                                <TextBlock Text="Загрузка актуальной записи…" Visibility="{Binding IsUserEditorLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Статус" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap" Grid.Row="0" Grid.Column="0" Margin="0,0,10,12"/>
                                    <Border Style="{StaticResource Corporate.Management.InfoPanel}" Padding="8,4" CornerRadius="8" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectedUser.StatusLabel}" Style="{StaticResource Task.Inspector.FactValue}" TextWrapping="Wrap" Margin="0"/>
                                    </Border>
                                    <TextBlock Text="Должность" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,0,10,12" TextWrapping="Wrap" Grid.Row="1" Grid.Column="0"/>
                                    <TextBlock Text="{Binding SelectedUser.JobTitle, TargetNullValue=Не указана}" Style="{StaticResource Task.Inspector.FactValue}" TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>
                                    <TextBlock Text="Версия" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,0,10,12" TextWrapping="Wrap" Grid.Row="2" Grid.Column="0"/>
                                    <TextBlock Text="{Binding SelectedUser.Version, StringFormat=серверная v{0}}" Style="{StaticResource Task.Inspector.FactValue}" TextWrapping="Wrap" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"/>
                                </Grid>
                                <Border Margin="0,6,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Corporate.Management.RosePanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowBlock}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ShowDeactivate}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Ограничение доступа" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Заблокировать" Command="{Binding BeginUserTransitionCommand}" CommandParameter="{x:Static admin:DesktopUserTransition.Block}" Visibility="{Binding ShowBlock, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Corporate.Management.Danger}" Margin="0,0,8,4" AutomationProperties.AutomationId="AdminBlockButton"/>
                                            <Button Content="Деактивировать" Command="{Binding BeginUserTransitionCommand}" CommandParameter="{x:Static admin:DesktopUserTransition.Deactivate}" Visibility="{Binding ShowDeactivate, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Corporate.Management.Danger}" Margin="0,0,8,4" AutomationProperties.AutomationId="AdminDeactivateButton"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Task.Icon.Info}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Disabled}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Выберите пользователя" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="Сведения и действия с учётной записью появятся здесь." Style="{StaticResource Task.State.Body}" Margin="0,3,0,0" FontSize="{DynamicResource Task.Font.Size.Metadata}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Corporate.Management.RosePanel}" Padding="0"
                        Visibility="{Binding IsTransitionOpen, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
                        IsVisibleChanged="OnConfirmationVisibilityChanged" AutomationProperties.AutomationId="AdminTransitionConfirmation"
                        AutomationProperties.Name="Подтверждение изменения состояния">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="14,12">
                                <TextBlock Text="{Binding TransitionTitle}" Style="{StaticResource Admin.Heading}" AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock Text="{Binding TransitionConsequences}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                <StackPanel Visibility="{Binding TransitionRequiresReason, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Причина * (до 2000 символов)" Style="{StaticResource Corporate.Management.Label}"/>
                                    <TextBox x:Name="TransitionReasonField" Text="{Binding TransitionReason, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditTransitionReason}" MaxLength="2000" AcceptsReturn="True" MinHeight="60"
                                             TextWrapping="Wrap" Style="{StaticResource Calendar.Form.Text}" AutomationProperties.Name="Причина изменения состояния"
                                             AutomationProperties.AutomationId="AdminTransitionReason"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource Admin.RegionHeader}" Padding="12,8" BorderThickness="0,1,0,0">
                            <WrapPanel>
                                <Button x:Name="ConfirmTransitionButton" Content="{Binding TransitionConfirmLabel}" Command="{Binding ConfirmUserTransitionCommand}"
                                        Style="{StaticResource Corporate.Management.Primary}" Margin="0,0,8,0" AutomationProperties.AutomationId="AdminConfirmTransitionButton"/>
                                <Button x:Name="CancelTransitionButton" Content="Отмена" Command="{Binding CancelUserTransitionCommand}"
                                        Style="{StaticResource Corporate.Management.Button}" AutomationProperties.AutomationId="AdminCancelTransitionButton"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Admin.DetailRegion}" Visibility="{Binding IsEditorOpen, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="AdminUserEditor" IsVisibleChanged="OnEditorVisibilityChanged">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Admin.RegionHeader}">
                            <TextBlock Text="{Binding UserEditor.Title}" FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding UserEditor.Title}"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,12,16,16">
                                <StackPanel IsEnabled="{Binding DataContext.CanEditUserFields, RelativeSource={RelativeSource AncestorType=UserControl}}" DataContext="{Binding UserEditor}">
                                    <Border Style="{StaticResource Admin.Section}" Margin="0" Padding="0" BorderThickness="0">
                                        <StackPanel>
                                            <TextBlock Text="Личные данные" Style="{StaticResource Admin.Heading}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Имя *" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Calendar.Form.Text}" AutomationProperties.Name="Имя" AutomationProperties.AutomationId="AdminFirstName" x:Name="FirstNameField" Margin="0,4,0,12"/>
                                            <TextBlock Text="Фамилия *" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Calendar.Form.Text}" AutomationProperties.Name="Фамилия" AutomationProperties.AutomationId="AdminLastName" Margin="0,4,0,12"/>
                                            <TextBlock Text="{Binding DisplayNameLabel}" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Calendar.Form.Text}" AutomationProperties.Name="Отображаемое имя" AutomationProperties.AutomationId="AdminDisplayName" Margin="0,4,0,12"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Admin.Section}" Margin="0,16,0,0" Padding="0,16,0,0" BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Рабочие сведения" Style="{StaticResource Admin.Heading}" Margin="0,0,0,12"/>
                                            <TextBlock Text="Логин *" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Calendar.Form.Text}" AutomationProperties.Name="Логин" AutomationProperties.AutomationId="AdminLogin" Margin="0,4,0,12"/>
                                            <TextBlock Text="Рабочий email (необязательно)" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding WorkEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Calendar.Form.Text}" AutomationProperties.Name="Рабочий email" AutomationProperties.AutomationId="AdminWorkEmail" Margin="0,4,0,12"/>
                                            <TextBlock Text="Должность (необязательно)" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Calendar.Form.Text}" AutomationProperties.Name="Должность" AutomationProperties.AutomationId="AdminJobTitle" Margin="0,4,0,12"/>
                                            <TextBlock Text="{Binding DepartmentHint}" TextWrapping="Wrap" Style="{StaticResource Task.Inspector.FactLabel}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding UserWriteAccessText}" Style="{StaticResource Admin.WriteAccessNote}" Margin="0,12,0,0"/>
                                <TextBlock Text="Новая учётная запись ожидает активации. Учётные данные для входа выдаются отдельно." Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Corporate.Management.Muted}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserEditor.Original}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding UserEditorMessage}" Foreground="{DynamicResource Task.Brush.Semantic.Critical}" TextWrapping="Wrap" Margin="0,12,0,12" AutomationProperties.LiveSetting="Assertive" AutomationProperties.AutomationId="AdminUserEditorFeedback"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Style="{StaticResource Admin.RegionHeader}" Padding="14,8" BorderThickness="0,1,0,0" Grid.Row="2">
                            <WrapPanel>
                                <Button Content="Сохранить" Command="{Binding SaveUserCommand}" Style="{StaticResource Corporate.Management.Primary}" AutomationProperties.AutomationId="AdminSaveUserButton" Margin="0,0,8,0"/>
                                <Button Content="Отмена" Command="{Binding CancelUserCommand}" Style="{StaticResource Corporate.Management.Button}" AutomationProperties.AutomationId="AdminCancelUserButton" Margin="0,0,8,0"/>
                                <TextBlock Text="Сохранение…" VerticalAlignment="Center" Margin="8,0" Visibility="{Binding IsSavingUser, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Admin.DetailRegion}" Visibility="{Binding IsRoles, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="AdminRoleInspector">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Admin.RegionHeader}">
                            <TextBlock Text="Определение роли" Style="{StaticResource Admin.Heading}"/>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRole}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel DataContext="{Binding SelectedRole}" Margin="16,12,16,16">
                                <TextBlock Text="{Binding KindLabel, TargetNullValue=Выберите роль}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold" Margin="0,8,0,2" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Code}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap"/>
                                <Separator Margin="0,16"/>
                                <TextBlock Text="Опубликованные разрешения" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,6,0,0" AutomationProperties.Name="Опубликованные разрешения">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding PermissionSummary}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Corporate.Management.Muted}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Permissions.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Style="{StaticResource Corporate.Management.InfoPanel}" Margin="0,16,0,0">
                                    <TextBlock Text="Здесь показаны разрешения роли. Назначения конкретного сотрудника в этом разделе недоступны." TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRole}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Task.Icon.Info}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Disabled}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Выберите роль" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="Здесь появятся описание роли и опубликованные разрешения." Style="{StaticResource Task.State.Body}" Margin="0,3,0,0" FontSize="{DynamicResource Task.Font.Size.Metadata}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Admin.DetailRegion}" Visibility="{Binding IsResources, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="AdminResourceInspector">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Admin.RegionHeader}">
                            <TextBlock Text="Сведения о ресурсе" Style="{StaticResource Admin.Heading}"/>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel DataContext="{Binding SelectedResource}" Margin="16,12,16,16">
                                <TextBlock Text="Сетевой ресурс" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Name, TargetNullValue=Выберите ресурс}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold" Margin="0,8,0,2" TextWrapping="Wrap"/>
                                <Border Style="{StaticResource Task.Surface.Base}" MinHeight="38" Padding="10,7" BorderThickness="1" CornerRadius="{DynamicResource Task.Radius.Control}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0"/>
                                </Border>
                                <Separator Margin="0,16"/>
                                <TextBlock Text="Корневой путь" Style="{StaticResource Task.Inspector.FactLabel}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PathLabel}" Style="{StaticResource Task.Inspector.FactValue}" TextWrapping="Wrap"/>
                                <TextBlock Text="Описание" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,14,0,3" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description, TargetNullValue=Не указано}" Style="{StaticResource Task.Inspector.FactValue}" TextWrapping="Wrap"/>
                                <Border Style="{StaticResource Corporate.Management.InfoPanel}" Margin="0,16,0,0">
                                    <TextBlock Text="Полный путь отображается только при наличии права на просмотр чувствительных расположений." TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedResource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Task.Icon.Info}" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Disabled}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Выберите ресурс" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="Здесь появятся сведения о расположении и доступе." Style="{StaticResource Task.State.Body}" Margin="0,3,0,0" FontSize="{DynamicResource Task.Font.Size.Metadata}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
