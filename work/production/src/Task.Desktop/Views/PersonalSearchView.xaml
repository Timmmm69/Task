<UserControl x:Class="Task.Desktop.Views.PersonalSearchView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Task.Desktop.Controls" Background="White" Foreground="{DynamicResource Personal.Airbnb.Ink}" FontSize="14" PreviewKeyDown="OnKeyDown" SizeChanged="OnSizeChanged">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}"/>
  <Style x:Key="Search.ClearButton" TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="36"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Padding" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Secondary}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource Personal.Airbnb.Soft}"/><Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Ink}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EBEBEB"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Ink}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.3"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Search.Row" TargetType="ListBoxItem" BasedOn="{StaticResource Personal.Airbnb.BrowserRow}"><Setter Property="Padding" Value="12,8"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding TypeLabel}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource Personal.Airbnb.Input}"/>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="{DynamicResource Task.Padding.Workspace}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="IntroPanel" Margin="0,0,0,18"><TextBlock Text="Найдите нужное среди ваших записей" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="Задачи, проекты, каталог и контакты — в одном месте." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,6,0,0"/></StackPanel>
  <StackPanel Grid.Row="1">
   <Label Content="Поиск в личном пространстве" Target="{Binding ElementName=QueryInput}" FontWeight="Bold" Padding="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid><TextBox x:Name="QueryInput" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" MinHeight="48" AutomationProperties.Name="Поиск в личном пространстве" AutomationProperties.AutomationId="PersonalSearchInput" ToolTip="От 2 до 200 символов · Enter — найти · Ctrl+F — к запросу"/>
     <TextBlock Text="Название или фрагмент текста…" Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource Personal.Airbnb.Secondary}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Button Grid.Column="1" Style="{StaticResource Search.ClearButton}" Command="{Binding ClearCommand}" Margin="8,0" AutomationProperties.Name="Очистить запрос" ToolTip="Очистить запрос · Esc в поле поиска"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
    <Button Grid.Column="2" Content="Найти" Command="{Binding SubmitCommand}" Padding="24,0" Background="{StaticResource Personal.Airbnb.Accent}" Foreground="White" BorderThickness="0" AutomationProperties.AutomationId="PersonalSearchSubmit"/>
   </Grid>
  </StackPanel>
  <StackPanel Grid.Row="2" Margin="0,14,0,12">
   <WrapPanel><TextBlock Text="Тип записи" VerticalAlignment="Center" Margin="0,0,12,8"/><ComboBox ItemsSource="{Binding Hub.SearchTypeFilters}" SelectedItem="{Binding Hub.SearchTypeFilter}" Width="156" Margin="0,0,10,8" AutomationProperties.Name="Тип результата поиска"/>
    <Button Content="Сбросить фильтр" Command="{Binding ResetCommand}" Margin="0,0,0,8"/>
   </WrapPanel>
   <TextBlock Text="{Binding Summary}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
   <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsLoading,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  </StackPanel>
  <Grid Grid.Row="3" x:Name="BrowserGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="310"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="ListRegion" Margin="0,0,20,0">
    <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Style="{StaticResource Personal.Airbnb.VirtualList}" ItemContainerStyle="{StaticResource Search.Row}" PreviewKeyDown="OnListKey" AutomationProperties.Name="Результаты личного поиска" AutomationProperties.AutomationId="PersonalSearchResults">
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource Personal.Airbnb.Secondary}" FontSize="12" Margin="0,3,8,0"/>
      <StackPanel Grid.Column="1"><controls:SearchHighlightTextBlock HighlightText="{Binding Title}" Query="{Binding Query}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
       <controls:SearchHighlightTextBlock HighlightText="{Binding Preview}" Query="{Binding Query}" Foreground="{StaticResource Personal.Airbnb.Secondary}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,0" ToolTip="{Binding Context}"/>
       <TextBlock Text="{Binding Metadata}" Foreground="{StaticResource Personal.Airbnb.Secondary}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Background="White" Visibility="{Binding ShowPrompt,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Padding="24"><StackPanel VerticalAlignment="Center" MaxWidth="400"><TextBlock Text="{Binding PromptTitle}" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="{Binding PromptText}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Background="White" Visibility="{Binding ShowEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Padding="24"><StackPanel VerticalAlignment="Center" MaxWidth="400"><TextBlock Text="Совпадений не найдено" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="Попробуйте другой фрагмент текста или сбросьте фильтр типа." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,12,0,0"/><TextBlock Text="{Binding Constraint}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Background="White" Visibility="{Binding IsLoading,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Padding="24"><TextBlock Text="Ищем совпадения…" Style="{StaticResource Personal.Airbnb.Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
   </Grid>
   <Border x:Name="DetailsPanel" Grid.Column="1" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1" CornerRadius="16" Padding="20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid><StackPanel Visibility="{Binding ShowSelectionHint,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="О выбранной записи" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="18"/><TextBlock Text="Выберите результат, чтобы прочитать полный текст. Откройте запись отдельной кнопкой или клавишей Enter." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,12,0,0"/></StackPanel>
       <StackPanel Visibility="{Binding HasSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock x:Name="DetailType" Text="{Binding Selected.TypeLabel}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12"/><TextBlock x:Name="DetailTitle" ToolTip="{Binding Selected.Title}" Text="{Binding Selected.Title}" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="20" Margin="0,8,0,0"/><TextBlock x:Name="DetailMeta" Text="{Binding Selected.Metadata}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,12,0,0"/><Border x:Name="DetailDivider" Height="1" Background="{StaticResource Personal.Airbnb.Hairline}" Margin="0,18"/><TextBlock x:Name="DetailContext" Text="{Binding Selected.DetailText}" TextWrapping="Wrap"/></StackPanel>
      </Grid>
     </ScrollViewer>
     <Button Grid.Row="1" Content="Открыть запись →" Height="44" MinHeight="44" Padding="22,0" FontSize="14" BorderThickness="0" Background="{StaticResource Personal.Airbnb.Ink}" Foreground="White" Command="{Binding OpenCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" Visibility="{Binding HasSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="PersonalSearchOpen"/>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,10,0,0">
   <Border Background="{StaticResource Personal.Airbnb.Soft}" CornerRadius="12" Padding="12" Visibility="{Binding HasError,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/><Button Content="Повторить поиск" Command="{Binding SubmitCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
   <TextBlock Text="Ctrl+F — к запросу · ↓ — к результатам · Enter — открыть · Ctrl+K — быстрый поиск" FontSize="11" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,0"/>
  </StackPanel>
 </Grid>
</UserControl>
