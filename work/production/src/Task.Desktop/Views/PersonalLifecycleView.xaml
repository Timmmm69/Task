<UserControl x:Class="Task.Desktop.Views.PersonalLifecycleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Task.Desktop.Views">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Management.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="Lifecycle.Row" TargetType="ListBoxItem" BasedOn="{StaticResource Personal.Airbnb.BrowserRow}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Type}"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding LifecycleDescription}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,0,0,18"/>
  <WrapPanel Grid.Row="1" Margin="0,0,0,8">
   <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Поиск по названию" Margin="0,0,0,6"/><TextBox Text="{Binding LifecycleQuery,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск по названию" AutomationProperties.AutomationId="LifecycleSearch"/></StackPanel>
   <StackPanel Width="155" Margin="0,0,12,10"><TextBlock Text="Тип записи" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding LifecycleTypes}" SelectedItem="{Binding LifecycleType}" AutomationProperties.Name="Тип записи"/></StackPanel>
   <StackPanel Width="195" Margin="0,0,12,10"><TextBlock Text="Порядок" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding LifecycleSortOrders}" SelectedItem="{Binding LifecycleSort}" AutomationProperties.Name="Порядок записей"/></StackPanel>
  </WrapPanel>
  <DockPanel Grid.Row="2" Margin="0,0,0,14"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Сбросить" Click="OnReset" IsEnabled="{Binding HasLifecycleFilters}" Margin="0,0,8,0"/><Button Content="Обновить" Command="{Binding RefreshCommand}"/></StackPanel><TextBlock Text="{Binding LifecycleCountText}" Style="{StaticResource Personal.Airbnb.Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
  <ScrollViewer x:Name="BodyScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Grid x:Name="BrowserGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="330"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
    <Grid x:Name="ListRegion" Margin="0,0,20,0">
     <ListBox x:Name="RecordsList" Style="{StaticResource Personal.Airbnb.VirtualList}" ItemContainerStyle="{StaticResource Lifecycle.Row}" ItemsSource="{Binding VisibleLifecycleRows}" SelectedItem="{Binding LifecycleSelection}" AutomationProperties.Name="Записи раздела" AutomationProperties.AutomationId="LifecycleList">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Bold" ToolTip="{Binding Title}"/><TextBlock Text="{Binding DateText}" Foreground="{StaticResource Personal.Airbnb.Secondary}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#F7F7F7" CornerRadius="8" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding Type}" FontSize="12"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding ShowLifecycleEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="{Binding LifecycleEmptyTitle}" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="{Binding LifecycleEmptyText}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,0" MaxWidth="340"/></StackPanel>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding ShowLifecycleNoResults,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="Ничего не найдено" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="Измените запрос или сбросьте фильтры." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,12"/><Button Content="Сбросить фильтры" Click="OnReset" HorizontalAlignment="Left"/></StackPanel>
     <TextBlock Text="{Binding LifecycleError}" Style="{StaticResource Personal.Validation}" VerticalAlignment="Center" Margin="24"/>
    </Grid>
    <Border x:Name="DetailsPanel" Grid.Column="1" Style="{StaticResource Management.Card}">
     <Grid><TextBlock Text="Выберите запись, чтобы увидеть сведения и доступные действия."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Personal.Airbnb.Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasLifecycleSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <DockPanel Visibility="{Binding HasLifecycleSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">       <Button Content="Восстановить" Command="{Binding RestoreCommand}" Style="{StaticResource Management.Primary}" HorizontalAlignment="Left"/><Button Content="В корзину…" Click="OnTrash" IsEnabled="{Binding CanTrash}" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding Hub.IsArchive,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
       <StackPanel Visibility="{Binding NeedsProjectRecovery,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="0,12,0,0"><TextBlock Text="Исходное состояние проекта неизвестно. Выберите, куда восстановить." Style="{StaticResource Personal.Airbnb.Muted}"/><WrapPanel Margin="0,10,0,0"><Button Content="В активные" Command="{Binding RecoverProjectCommand}" CommandParameter="active"/><Button Content="В архив" Command="{Binding RecoverProjectCommand}" CommandParameter="archived" Margin="6,0,0,0"/></WrapPanel></StackPanel>
       <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0" Visibility="{Binding IsTrash,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Необратимое действие" Foreground="#A32B17" FontWeight="Bold"/><TextBlock Text="Удалится запись и её связи в Task. Файлы на диске останутся." Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,8,0,14"/><Button Content="Удалить навсегда…" Click="OnPurge" IsEnabled="{Binding CanPurge}" Style="{StaticResource Management.Danger}" HorizontalAlignment="Left" AutomationProperties.AutomationId="LifecyclePurge"/></StackPanel></Border>
</StackPanel><ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasLifecycleSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel>
       <TextBlock Text="{Binding LifecycleSelection.Type}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12"/><TextBlock Text="{Binding LifecycleSelection.Title}" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="20" Margin="0,8,0,20"/>
       <TextBlock Text="{Binding LifecycleDateLabel}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12"/><TextBlock Text="{Binding LifecycleSelection.DateText}" Margin="0,5,0,14"/>
       <TextBlock Text="Последнее изменение" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12"/><TextBlock Text="{Binding LifecycleSelection.UpdatedText}" Margin="0,5,0,14"/>

       <Expander Header="Связанные записи" Margin="0,20,0,0"><views:ObjectLinksView DataContext="{Binding Links}"/></Expander>
      </StackPanel></ScrollViewer></DockPanel>
     </Grid>
    </Border>
   </Grid>
  </ScrollViewer>
  <Border Grid.Row="4" Background="#F7F7F7" CornerRadius="12" Padding="12" Margin="0,12,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid>
</UserControl>
