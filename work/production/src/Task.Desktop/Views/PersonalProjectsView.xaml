<UserControl x:Class="Task.Desktop.Views.PersonalProjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" Background="White" Foreground="#222222" FontSize="14">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries><Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}"/><Style TargetType="TextBox" BasedOn="{StaticResource Personal.Airbnb.Input}"/></ResourceDictionary></UserControl.Resources>
 <Grid Margin="{DynamicResource Task.Padding.Workspace}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16" LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/><Button Content="Новый проект" Command="{Binding NewProjectCommand}" Background="{StaticResource Personal.Airbnb.Accent}" Foreground="White" AutomationProperties.AutomationId="PersonalNewProject"/></StackPanel>
   <StackPanel><TextBlock Text="Ваши проекты" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="{Binding ProjectResultCount}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  </DockPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Поиск по названию" Style="{StaticResource Personal.Airbnb.Muted}"/><TextBox Width="230" Text="{Binding ProjectSearch,UpdateSourceTrigger=PropertyChanged,Delay=150}" Margin="0,4,0,0" AutomationProperties.Name="Поиск проектов по названию" AutomationProperties.AutomationId="PersonalProjectSearch"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Статус" Style="{StaticResource Personal.Airbnb.Muted}"/><ComboBox Width="164" ItemsSource="{Binding ProjectStatusFilters}" SelectedIndex="{Binding ProjectStatusFilter}" Margin="0,4,0,0" AutomationProperties.Name="Фильтр статуса проектов"/></StackPanel>
   <StackPanel Margin="0,0,12,8"><TextBlock Text="Сортировка" Style="{StaticResource Personal.Airbnb.Muted}"/><ComboBox Width="236" ItemsSource="{Binding ProjectSortOrders}" SelectedIndex="{Binding ProjectSort}" Margin="0,4,0,0" AutomationProperties.Name="Сортировка проектов"/></StackPanel>
   <Button Content="Сбросить" Click="OnReset" IsEnabled="{Binding HasProjectFilters}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
  </WrapPanel>
  <ScrollViewer Grid.Row="2" x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="BrowserGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="1.3*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="ListRegion" Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Personal.Airbnb.Soft}" CornerRadius="8" Padding="14,9" Margin="0,0,0,4"><TextBlock Text="Проект · статус · даты" FontWeight="Bold"/></Border>
    <ListBox x:Name="ProjectList" Grid.Row="1" ItemsSource="{Binding VisibleProjects}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding CanSelectProject}" Background="White" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource Personal.Airbnb.BrowserRow}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Личные проекты" AutomationProperties.AutomationId="PersonalProjectsList">
     <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><DockPanel Margin="0,6,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding DateSummary}" Foreground="{StaticResource Personal.Airbnb.Secondary}" Margin="8,0,0,0"/><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Personal.Airbnb.Secondary}"/></DockPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="1" Background="White" Visibility="{Binding ShowProjectEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center" Margin="14" MaxWidth="310"><TextBlock Text="{Binding ProjectEmptyTitle}" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="18"/><TextBlock Text="{Binding ProjectEmptyBody}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,0"/><Button Content="Сбросить фильтры" Click="OnReset" HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="{Binding HasProjectFilters}"/></StackPanel></Border>
    <Border Grid.Row="1" Background="White" Visibility="{Binding IsBusy,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="160"/><TextBlock Text="Обновляем проекты…" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border>
    <Border Grid.Row="1" Background="White" Visibility="{Binding ProjectLoadFailed,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center" Margin="14"><TextBlock Text="Не удалось обновить проекты" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="Проверьте доступ к личной базе и повторите попытку. Черновик остался в форме." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8"/><Button Content="Повторить" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <TextBlock Grid.Row="2" Text="Сохраните или отмените изменения, чтобы выбрать другой проект." Style="{StaticResource Personal.Airbnb.Muted}" Margin="14,8" Visibility="{Binding IsProjectEditing,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
   </Grid>
   <Border Grid.Column="1" x:Name="DetailsPanel" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="1" CornerRadius="16" Padding="20">
    <Grid>
     <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsProjectEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <TextBlock Text="Выберите проект из списка" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Personal.Airbnb.Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasProjectSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Grid Visibility="{Binding HasProjectSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Изменить" Command="{Binding EditProjectCommand}" Margin="12,0,0,0" VerticalAlignment="Top"/><TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="20" MaxHeight="84" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProject.Name}"/></DockPanel>
       <ScrollViewer x:Name="ProjectInfoScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="310"><StackPanel>
        <TextBlock Text="{Binding SelectedProject.StatusText}" FontWeight="Bold" Margin="0,0,0,12"/>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Начало" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12"/><TextBlock Text="{Binding SelectedProject.StartDateText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Плановое окончание" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12"/><TextBlock Text="{Binding SelectedProject.PlannedEndDateText}" Margin="0,4,0,0"/></StackPanel></Grid>
        <Expander Header="Описание" IsExpanded="True" Margin="0,0,0,12"><TextBox x:Name="ProjectDescriptionReader" Text="{Binding ProjectDescriptionText,Mode=OneWay}" IsReadOnly="True" Height="Auto" MinHeight="32" MaxHeight="130" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="0,8,8,4" Background="Transparent" AutomationProperties.Name="Описание выбранного проекта"/></Expander>
        <Expander Header="Дополнительные сведения" Margin="0,0,0,12"><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding SelectedProject.ActualEndText,StringFormat=Завершение: {0}}" Style="{StaticResource Personal.Airbnb.Muted}"/><TextBlock Text="{Binding SelectedProject.LifecycleText,StringFormat=Хранение: {0}}" Style="{StaticResource Personal.Airbnb.Muted}"/><TextBlock Text="{Binding SelectedProject.DefaultTimeZone,TargetNullValue=Не задан,StringFormat=Часовой пояс: {0}}" Style="{StaticResource Personal.Airbnb.Muted}"/><TextBlock Text="{Binding SelectedProject.ColorCode,TargetNullValue=Не задан,StringFormat=Цвет: {0}}" Style="{StaticResource Personal.Airbnb.Muted}"/></StackPanel></Expander>
       </StackPanel></ScrollViewer>
       <Border Grid.Row="2" BorderBrush="{StaticResource Personal.Airbnb.Hairline}" BorderThickness="0,1,0,0" Padding="0,16,0,10"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Добавить задачу" Command="{Binding DataContext.AddProjectTaskCommand,RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.ProjectTaskActionHint,RelativeSource={RelativeSource AncestorType=Window}}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="PersonalProjectAddTask"/><TextBlock Text="Связанные задачи" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding ProjectTaskSummary}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Border>
       <ListBox x:Name="RelatedTasksList" Grid.Row="3" ItemsSource="{Binding RelatedProjectTasks}" Background="White" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource Personal.Airbnb.BrowserRow}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Связанные задачи проекта">
        <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,5,0,0"><Run Text="{Binding StatusText,Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PriorityText,Mode=OneWay}"/></TextBlock></StackPanel><Button Grid.Column="1" Content="Открыть" Command="{Binding DataContext.OpenProjectTaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,6" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title,StringFormat=Открыть задачу {0}}"/></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Grid.Row="3" Text="В этом проекте пока нет задач. Добавьте первую." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,16,0,0" Visibility="{Binding NoRelatedProjectTasks,Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
      </Grid>
     </Grid>
     <Grid Visibility="{Binding IsProjectEditing,Converter={StaticResource Task.BooleanToVisibilityConverter}}" PreviewKeyDown="OnEditorKey"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Редактор проекта" Style="{StaticResource Personal.Airbnb.Heading}" FontSize="20" Margin="0,0,0,12"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,12">
       <TextBlock Text="Название" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding ProjectName,UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Название проекта" AutomationProperties.AutomationId="PersonalProjectName"/>
       <TextBlock Text="Описание" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding ProjectDescription,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="Auto" MinHeight="110" MaxHeight="180" MaxLength="10000" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Описание проекта"/>
       <TextBlock Text="Статус" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding StatusChoices}" SelectedValue="{Binding ProjectStatus}" SelectedValuePath="Value" DisplayMemberPath="Name" AutomationProperties.Name="Статус проекта"/>
       <WrapPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Начало" Style="{StaticResource Personal.Label}"/><DatePicker SelectedDate="{Binding StartDate}" MinHeight="36" AutomationProperties.Name="Начало проекта"/></StackPanel><StackPanel><TextBlock Text="Плановое окончание" Style="{StaticResource Personal.Label}"/><DatePicker SelectedDate="{Binding EndDate}" MinHeight="36" AutomationProperties.Name="Плановое окончание проекта"/></StackPanel></WrapPanel>
       <Expander Header="Хранение проекта" state:ViewState.Section="personal-projects/v1/storage" Margin="0,18,0,0"><StackPanel><TextBlock Text="Состояние" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding LifecycleChoices}" SelectedValue="{Binding Lifecycle}" SelectedValuePath="Value" DisplayMemberPath="Name" AutomationProperties.Name="Хранение проекта"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Ctrl+Enter — сохранить" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,0,0,8"/><WrapPanel HorizontalAlignment="Right"><Button Content="Отменить" Click="OnCancel" Margin="0,0,8,0"/><Button Content="Сохранить" Click="OnSave" Background="{StaticResource Personal.Airbnb.Accent}" Foreground="White" AutomationProperties.AutomationId="PersonalSaveProject"/></WrapPanel></StackPanel>
     </Grid>
    </Grid>
   </Border>
  </Grid></ScrollViewer>
  <Border Grid.Row="3"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Personal.Feedback}"><Setter Property="Background" Value="{StaticResource Personal.Airbnb.Soft}"/><Setter Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Hairline}"/><Setter Property="CornerRadius" Value="8"/></Style></Border.Style><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
 </Grid>
</UserControl>
