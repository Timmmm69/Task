<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" Language="ru-RU" UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Task.Desktop.Views.PersonalProjectsView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Personal.Controls.xaml"/>
                <ResourceDictionary Source="../Resources/Personal.Workspace.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Personal.Toolbar}">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="Изменить" Command="{Binding EditProjectCommand}" Margin="0,0,8,0"/>
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                    <Button Content="Новый проект" Command="{Binding NewProjectCommand}" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalNewProject" Margin="0,0,8,0"/>
                </WrapPanel>
                <TextBlock Text="{Binding Projects.Count,StringFormat=Проекты · {0}}" Style="{StaticResource Personal.SectionTitle}"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="SplitWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Style="{StaticResource Personal.DetailColumn}"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Style="{StaticResource Personal.DetailRow}"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Personal.Pane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Personal.SectionHeader}">
                        <TextBlock Text="Мои проекты" Style="{StaticResource Personal.SectionTitle}"/>
                    </Border>
                    <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Style="{StaticResource Personal.WorkspaceList}" ItemContainerStyle="{StaticResource Personal.WorkspaceItem}" AutomationProperties.Name="Личные проекты" AutomationProperties.AutomationId="PersonalProjectsList" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource Task.Icon.Projects}" Style="{StaticResource Personal.LeadingIcon}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Task.Table.TitleText}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Personal.Metadata}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
                                        <WrapPanel>
                                            <Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,0,12,4">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Personal.Metadata}"/>
                                            </Border>
                                            <TextBlock Text="{Binding PlannedEndDate,StringFormat=До {0:dd.MM.yyyy},TargetNullValue=Без срока}" Style="{StaticResource Personal.Metadata}" Margin="0,3,0,0"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1" Margin="16" Padding="16" MinHeight="0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Проектов пока нет" Style="{StaticResource Task.State.Title}"/>
                            <TextBlock Text="Создайте проект, чтобы собрать задачи вместе." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border AutomationProperties.AutomationId="PersonalProjectInspector">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Personal.DetailPane}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsProjectEditing}" Value="True"/>
                                    <Condition Binding="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Task.WindowWidthAtLeastConverter},ConverterParameter=1100}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.RowSpan" Value="2"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Personal.Pane}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProjectEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Personal.SectionHeader}">
                                <TextBlock Text="Детали проекта" Style="{StaticResource Personal.SectionTitle}"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                                <StackPanel Margin="20,16,20,24">
                                    <TextBlock Text="{Binding SelectedProject.Name,TargetNullValue=Выберите проект,FallbackValue=Выберите проект}" Style="{StaticResource Personal.DetailTitle}"/>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,12,0,8">
                                            <TextBlock Text="{Binding SelectedProject.StatusText}" Style="{StaticResource Task.Table.CellText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Task.Surface.Subtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,8,0,16">
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Начало" Style="{StaticResource Personal.Label}"/>
                                                <TextBlock Text="{Binding SelectedProject.StartDate,StringFormat={}{0:dd.MM.yyyy},TargetNullValue=Без даты}"/>
                                                <TextBlock Text="Плановое окончание" Style="{StaticResource Personal.Label}"/>
                                                <TextBlock Text="{Binding SelectedProject.PlannedEndDate,StringFormat={}{0:dd.MM.yyyy},TargetNullValue=Без даты}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Описание" Style="{StaticResource Personal.SectionTitle}"/>
                                        <TextBlock Text="{Binding SelectedProject.Description}" Style="{StaticResource Task.State.Body}" Margin="0,8,0,16"/>
                                        <TextBlock Text="{Binding SelectedProject.LifecycleText}" Style="{StaticResource Task.State.Body}"/>
                                        <TextBlock Text="Действия" Style="{StaticResource Personal.SectionTitle}" Margin="0,20,0,0"/>
                                        <Button Content="Добавить задачу" Command="{Binding DataContext.AddProjectTaskCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="{Binding DataContext.ProjectTaskActionHint,RelativeSource={RelativeSource AncestorType=Window}}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Добавить задачу" AutomationProperties.AutomationId="PersonalProjectAddTask"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Personal.Pane}" Padding="0" PreviewKeyDown="OnEditorKey" Visibility="{Binding IsProjectEditing,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Редактор проекта" Style="{StaticResource Personal.SectionTitle}" Margin="20,16"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="24,0,24,24">
                                    <TextBlock Text="Название (обязательно)" Style="{StaticResource Personal.Label}"/>
                                    <TextBox Text="{Binding ProjectName,UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Название проекта" AutomationProperties.AutomationId="PersonalProjectName"/>
                                    <TextBlock Text="Описание" Style="{StaticResource Personal.Label}"/>
                                    <TextBox Text="{Binding ProjectDescription,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="Описание проекта"/>
                                    <TextBlock Text="Статус" Style="{StaticResource Personal.Label}"/>
                                    <ComboBox ItemsSource="{Binding StatusChoices}" SelectedValue="{Binding ProjectStatus}" SelectedValuePath="Value" DisplayMemberPath="Name" AutomationProperties.Name="Статус проекта"/>
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Начало" Style="{StaticResource Personal.Label}"/>
                                            <DatePicker SelectedDate="{Binding StartDate}" Width="170" AutomationProperties.Name="Дата начала проекта"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Плановое окончание" Style="{StaticResource Personal.Label}"/>
                                            <DatePicker SelectedDate="{Binding EndDate}" Width="170" AutomationProperties.Name="Плановое окончание проекта"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="ДД.ММ.ГГГГ · даты необязательны" Style="{StaticResource Personal.DateHint}"/>
                                    <Expander Header="Хранение проекта" state:ViewState.Section="personal-projects/v1/storage" Margin="0,18,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Состояние" Style="{StaticResource Personal.Label}"/>
                                            <ComboBox ItemsSource="{Binding LifecycleChoices}" AutomationProperties.Name="Хранение проекта" SelectedValue="{Binding Lifecycle}" SelectedValuePath="Value" DisplayMemberPath="Name"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="2" Padding="24,16" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,1,0,0">
                                <WrapPanel HorizontalAlignment="Right">
                                    <TextBlock Text="Ctrl+Enter — сохранить" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="Отменить" Click="OnCancel" Margin="0,0,8,0"/>
                                    <Button Content="Сохранить" Click="OnSave" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalSaveProject"/>
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Personal.Feedback}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        </Border>
    </Grid>
</UserControl>
