<UserControl Language="ru-RU" UseLayoutRounding="True" SnapsToDevicePixels="True" x:Class="Task.Desktop.Views.PersonalProjectsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Личные проекты" Style="{StaticResource Task.Shell.PageTitle}"/><TextBlock Text="Объединяйте задачи и материалы проекта." Style="{StaticResource Task.State.Body}" Margin="0,4,12,0"/></StackPanel>
   <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"><Button Content="Изменить" Command="{Binding EditProjectCommand}" Margin="0,0,8,0"/><Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/><Button Content="Новый проект" Command="{Binding NewProjectCommand}" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalNewProject"/></WrapPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid>
    <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Task.DataList.Item}" AutomationProperties.Name="Личные проекты" AutomationProperties.AutomationId="PersonalProjectsList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,12"><TextBlock Text="{Binding Name}" Style="{StaticResource Task.Table.TitleText}" TextWrapping="Wrap"/><Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,8,0,0"><TextBlock Text="{Binding StatusText}" Style="{StaticResource Task.Table.CellText}"/></Border><TextBlock Text="{Binding LifecycleText}" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><TextBlock Text="Проектов пока нет" Style="{StaticResource Task.State.Title}"/><TextBlock Text="Создайте проект, чтобы собрать задачи вместе." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Column="2">
    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.Inspector.Panel}"><Style.Triggers><DataTrigger Binding="{Binding IsProjectEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{Binding SelectedProject.Name,TargetNullValue=Выберите проект,FallbackValue=Выберите проект}" Style="{StaticResource Task.State.Title}"/><TextBlock Text="{Binding SelectedProject.Description}" Style="{StaticResource Task.State.Body}" Margin="0,12,0,0"/><Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,12,0,8"><TextBlock Text="{Binding SelectedProject.StatusText}" Style="{StaticResource Task.Table.CellText}"/></Border>
     <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="Начало" Style="{StaticResource Personal.Label}"/><TextBlock Text="{Binding SelectedProject.StartDate,StringFormat={}{0:dd.MM.yyyy},TargetNullValue=Без даты}"/>
      <TextBlock Text="Плановое окончание" Style="{StaticResource Personal.Label}"/><TextBlock Text="{Binding SelectedProject.PlannedEndDate,StringFormat={}{0:dd.MM.yyyy},TargetNullValue=Без даты}"/>
     </StackPanel><TextBlock Text="{Binding SelectedProject.LifecycleText}" Style="{StaticResource Task.State.Body}"/><Button Content="Добавить задачу" Command="{Binding DataContext.AddProjectTaskCommand,RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="{Binding DataContext.ProjectTaskActionHint,RelativeSource={RelativeSource AncestorType=Window}}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Добавить задачу" AutomationProperties.AutomationId="PersonalProjectAddTask"/></StackPanel></ScrollViewer></Border>
    <Border Style="{StaticResource Task.Inspector.Panel}" Padding="0" PreviewKeyDown="OnEditorKey" Visibility="{Binding IsProjectEditing,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Проект" Style="{StaticResource Task.State.Title}" Margin="24,18"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,24,24">
       <TextBlock Text="Название (обязательно)" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding ProjectName,UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Название проекта" AutomationProperties.AutomationId="PersonalProjectName"/>
       <TextBlock Text="Описание" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding ProjectDescription,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="Описание проекта"/>
       <TextBlock Text="Статус" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding StatusChoices}" SelectedValue="{Binding ProjectStatus}" SelectedValuePath="Value" DisplayMemberPath="Name" AutomationProperties.Name="Статус проекта"/>
       <WrapPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Начало" Style="{StaticResource Personal.Label}"/><DatePicker SelectedDate="{Binding StartDate}" Width="170" AutomationProperties.Name="Дата начала проекта"/></StackPanel><StackPanel><TextBlock Text="Плановое окончание" Style="{StaticResource Personal.Label}"/><DatePicker SelectedDate="{Binding EndDate}" Width="170" AutomationProperties.Name="Плановое окончание проекта"/></StackPanel></WrapPanel><TextBlock Text="ДД.ММ.ГГГГ · даты необязательны" Style="{StaticResource Personal.DateHint}"/>
       <Expander Header="Хранение проекта" state:ViewState.Section="personal-projects/v1/storage" Margin="0,18,0,0"><StackPanel><TextBlock Text="Состояние" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding LifecycleChoices}" AutomationProperties.Name="Хранение проекта" SelectedValue="{Binding Lifecycle}" SelectedValuePath="Value" DisplayMemberPath="Name"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
      <Border Grid.Row="2" Padding="24,16" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,1,0,0"><WrapPanel HorizontalAlignment="Right"><TextBlock Text="Ctrl+Enter — сохранить" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="Отменить" Click="OnCancel" Margin="0,0,8,0"/><Button Content="Сохранить" Click="OnSave" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="PersonalSaveProject"/></WrapPanel></Border>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Personal.Feedback}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/></Border>
 </Grid>
</UserControl>
