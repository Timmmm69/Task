<UserControl x:Class="Task.Desktop.Views.AnalyticsNoticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Loaded="OnLoaded"
             AutomationProperties.AutomationId="TaskAnalyticsNotice">
    <Border Background="{DynamicResource Task.Brush.Surface.Subtle}"
            BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="16,10">
        <StackPanel>
            <TextBlock Text="Приложение автоматически отправляет в PostHog статистику запусков и успешных действий. Содержимое задач, событий и проектов не передаётся. Отправку можно отключить здесь или в настройках."
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel Margin="0,6,0,0">
                <Button x:Name="DisableButton" Content="Отключить статистику" Click="OnDisable"
                        Style="{StaticResource Task.Button.Secondary}" Margin="0,0,8,0"/>
                <Button Content="Понятно" Click="OnDismiss" Style="{StaticResource Task.Button.Secondary}"/>
            </WrapPanel>
            <TextBlock x:Name="Feedback" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </Border>
</UserControl>
