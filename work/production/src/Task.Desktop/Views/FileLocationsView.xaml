<UserControl x:Class="Task.Desktop.Views.FileLocationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="{Binding IsVisible, Converter={StaticResource Task.BooleanToVisibilityConverter}}"
    AutomationProperties.Name="Расположения файла" AutomationProperties.AutomationId="FileLocationsManager"
    UseLayoutRounding="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Continue">
    <StackPanel>
        <Border Style="{StaticResource Task.Files.Header}" Padding="0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource Task.Files.Title}"><Run Text="Расположения ("/><Run Text="{Binding Items.Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                <TextBlock Text="Доступные пути к файлу или папке" Style="{StaticResource Task.Files.Hint}"/>
            </StackPanel>
        </Border>
        <WrapPanel Margin="0,12,0,4">
            <Button Content="+ Добавить расположение" Command="{Binding AddCommand}" Style="{StaticResource Task.Files.PrimaryAction}" AutomationProperties.AutomationId="AddLocationButton"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="RefreshLocationsButton"/>
        </WrapPanel>
        <Border Style="{StaticResource Task.State.Inline}" Margin="0,0,0,12" Visibility="{Binding IsLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <StackPanel><ProgressBar IsIndeterminate="True" Style="{StaticResource Task.Progress.Indeterminate}" Margin="0,0,0,8"/><TextBlock Text="Загружаем расположения…" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LocationsLoading"/></StackPanel>
        </Border>
        <StackPanel Margin="20,24" Visibility="{Binding IsEmpty, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <Path Data="{StaticResource Task.Icon.Catalog}" Style="{StaticResource Task.Files.Icon}" Width="26" Height="26" HorizontalAlignment="Center"/>
            <TextBlock Text="Расположений пока нет" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="Добавьте ссылку на файл или папку." Style="{StaticResource Task.Files.Hint}" TextAlignment="Center" AutomationProperties.AutomationId="LocationsEmpty"/>
        </StackPanel>
        <Border Style="{StaticResource Task.State.Inline}" Margin="0,0,0,12" Visibility="{Binding HasPartialAccess, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <TextBlock Text="Часть путей скрыта или недоступна на этом компьютере." Style="{StaticResource Task.Files.Hint}"/>
        </Border>
        <ListBox ItemsSource="{Binding Items}" Style="{StaticResource Task.DataList}" BorderThickness="0" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Список расположений" AutomationProperties.AutomationId="LocationsList">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource Task.DataList.Item}">
                <Setter Property="AutomationProperties.Name" Value="{Binding PathLabel}"/><Setter Property="Padding" Value="12,12"/>
            </Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Path Data="{StaticResource Task.Icon.Catalog}" Style="{StaticResource Task.Files.Icon}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding PathLabel}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="LocationPath"/>
                        <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Task.Files.Hint}"/>
                        <TextBlock Text="{Binding ScopeLabel}" Style="{StaticResource Task.Files.Hint}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,0,8,4"><TextBlock Text="{Binding PrimaryLabel}" FontSize="{DynamicResource Task.Font.Size.Metadata}"/></Border>
                            <Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,0,0,4"><TextBlock Text="{Binding EnabledLabel}" FontSize="{DynamicResource Task.Font.Size.Metadata}"/></Border>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,-8">
                            <Button Content="Изменить" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="EditLocationButton"/>
                            <Button Content="Сделать основным" Command="{Binding DataContext.MakePrimaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="MakePrimaryLocationButton"/>
                            <Button Content="Удалить" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Files.RemoveAction}" ToolTip="Удалить только ссылку на расположение" AutomationProperties.AutomationId="DeleteLocationButton"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Style="{StaticResource Task.Files.Panel}" Padding="0,16" BorderThickness="0,1,0,1" Margin="0,16,0,12" Visibility="{Binding EditorVisible, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="LocationEditor">
            <StackPanel IsEnabled="{Binding IsFormEnabled}">
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Task.Files.Title}"/>
                <TextBlock Text="Путь и тип расположения" Style="{StaticResource Task.Files.Hint}"/>
                <TextBlock Text="Тип расположения" Style="{StaticResource Task.Files.Label}"/>
                <ComboBox ItemsSource="{Binding LocationTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LocationType}" IsEnabled="{Binding PathEditable}" Style="{StaticResource Task.Files.Combo}" AutomationProperties.Name="Тип расположения" AutomationProperties.AutomationId="LocationTypeCombo"/>
                <TextBlock Text="Путь" Style="{StaticResource Task.Files.Label}"/>
                <TextBox Text="{Binding RawPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PathEditable}" Style="{StaticResource Task.Files.Text}" AutomationProperties.Name="Путь к файлу или папке" AutomationProperties.AutomationId="LocationPathTextBox"/>
                <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding PathEditable}">
                    <Button Content="Выбрать файл…" Click="PickFile" Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="PickLocationFileButton"/>
                    <Button Content="Выбрать папку…" Click="PickFolder" Style="{StaticResource Task.Files.Action}" AutomationProperties.AutomationId="PickLocationFolderButton"/>
                </WrapPanel>
                <StackPanel Visibility="{Binding IsUnc, Converter={StaticResource Task.BooleanToVisibilityConverter}}" IsEnabled="{Binding PathEditable}">
                    <TextBlock Text="Разрешённый сетевой ресурс" Style="{StaticResource Task.Files.Label}"/>
                    <ComboBox ItemsSource="{Binding NetworkResources}" SelectedItem="{Binding NetworkResource}" DisplayMemberPath="Name" Style="{StaticResource Task.Files.Combo}" AutomationProperties.Name="Разрешённый сетевой ресурс" AutomationProperties.AutomationId="LocationNetworkResourceCombo"/>
                    <TextBlock Text="{Binding NetworkResource.PathLabel}" Style="{StaticResource Task.Files.Hint}"/>
                </StackPanel>
                <TextBlock Text="Загружаем сетевые ресурсы…" Style="{StaticResource Task.Files.Hint}" Visibility="{Binding ResourcesLoading, Converter={StaticResource Task.BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Polite"/>
                <Separator Margin="0,16,0,12"/>
                <TextBlock Text="Порядок открытия" FontWeight="SemiBold"/>
                <TextBlock Text="Приоритет" Style="{StaticResource Task.Files.Label}"/>
                <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Files.Text}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="Приоритет расположения" AutomationProperties.HelpText="Меньшее число означает более высокий приоритет" AutomationProperties.AutomationId="LocationPriorityTextBox"/>
                <TextBlock Text="Меньшее число — выше в порядке выбора расположений." Style="{StaticResource Task.Files.Hint}"/>
                <WrapPanel Margin="0,12,0,0">
                    <CheckBox Content="Основное" IsChecked="{Binding IsPrimary}" Style="{StaticResource Task.Files.Check}" AutomationProperties.AutomationId="LocationPrimaryCheckBox"/>
                    <CheckBox Content="Включено" IsChecked="{Binding IsEnabled}" Style="{StaticResource Task.Files.Check}" AutomationProperties.AutomationId="LocationEnabledCheckBox"/>
                </WrapPanel>
                <Separator Margin="0,12,0,16"/>
                <WrapPanel Margin="0,0,0,-8">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource Task.Files.PrimaryAction}" AutomationProperties.AutomationId="SaveLocationButton"/>
                    <Button Content="Отмена" Command="{Binding CancelEditCommand}" Style="{StaticResource Task.Files.Action}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Task.State.Inline}" Margin="0,12,0,12" Visibility="{Binding ShowDeleteConfirmation, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Удалить расположение?" FontWeight="SemiBold"/>
                <TextBlock Text="Удаляется только ссылка. Файл или папка на диске останутся без изменений." Style="{StaticResource Task.Files.Hint}"/>
                <TextBlock Text="{Binding PendingDelete.PathLabel}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                <WrapPanel Margin="0,0,0,-8">
                    <Button Content="Удалить ссылку" Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource Task.Files.RemoveAction}" AutomationProperties.AutomationId="ConfirmDeleteLocationButton"/>
                    <Button Content="Отмена" Command="{Binding CancelDeleteCommand}" Style="{StaticResource Task.Files.Action}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Message}" Style="{StaticResource Task.Files.Hint}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LocationsMessage"/>
    </StackPanel>
</UserControl>
