<UserControl x:Class="Task.Desktop.Views.ProjectsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="980"
        AutomationProperties.Name="Проекты" AutomationProperties.AutomationId="ProjectsView">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Проекты команды" FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding AccessText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Task.Brush.Semantic.Critical}" Margin="0,4,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,8,0"
                        AutomationProperties.Name="Обновить проекты" AutomationProperties.AutomationId="ProjectsRefreshButton"/>
                <Button Content="Новый проект" Command="{Binding NewProjectCommand}" Style="{StaticResource Task.Button.Primary}"
                        AutomationProperties.Name="Создать проект" AutomationProperties.AutomationId="NewProjectButton"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Task.Surface.Subtle}" Padding="8">
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0"
                         AutomationProperties.Name="Список проектов" AutomationProperties.AutomationId="ProjectsList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding DatesText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" FontSize="{DynamicResource Task.Font.Size.Metadata}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel DataContext="{Binding SelectedItem}">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1">
                            <Button Content="Изменить" Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource Task.Button.Secondary}" Margin="8,0,8,0" AutomationProperties.Name="Изменить проект"/>
                            <Button Content="В архив" Command="{Binding DataContext.ArchiveProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource Task.Button.Secondary}" AutomationProperties.Name="Архивировать завершённый проект"/>
                        </WrapPanel>
                    </Grid>
                    <UniformGrid Columns="3" Margin="0,16,0,16">
                        <Border Style="{StaticResource Task.Surface.Subtle}" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Статус" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Task.Surface.Subtle}" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Владелец" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/><TextBlock Text="{Binding Source.OwnerUserId}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Task.Surface.Subtle}" Padding="12"><StackPanel><TextBlock Text="Руководитель" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/><TextBlock Text="{Binding Source.ManagerUserId, TargetNullValue=Не назначен}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                    </UniformGrid>

                    <Expander Header="Участники проекта" IsExpanded="True" Margin="0,0,0,14">
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,10,0,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewMemberUserId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}" Margin="0,0,8,0"
                                         AutomationProperties.Name="UUID сотрудника" AutomationProperties.AutomationId="ProjectMemberUserId"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding NewMemberRole}" DisplayMemberPath="Name"
                                          Style="{StaticResource Task.Input.Combo}" Margin="0,0,8,0" AutomationProperties.Name="Роль участника"/>
                                <Button Grid.Column="2" Content="Добавить" Command="{Binding AddMemberCommand}" Style="{StaticResource Task.Button.Primary}"
                                        AutomationProperties.Name="Добавить участника" AutomationProperties.AutomationId="AddProjectMemberButton"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding UserText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name"
                                                      Style="{StaticResource Task.Input.Combo}" Margin="8,0" AutomationProperties.Name="Роль участника"/>
                                            <Button Grid.Column="2" Content="Сохранить роль" Margin="0,0,8,0" Style="{StaticResource Task.Button.Secondary}"
                                                    Command="{Binding DataContext.ChangeMemberRoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Grid.Column="3" Content="Удалить" Style="{StaticResource Task.Button.Secondary}"
                                                    Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Для добавления укажите UUID активной учётной записи сотрудника. Владелец удаляется только после передачи владения."
                                       TextWrapping="Wrap" Foreground="{DynamicResource Task.Brush.Text.Secondary}" FontSize="{DynamicResource Task.Font.Size.Metadata}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Связанные задачи" IsExpanded="True">
                        <ItemsControl ItemsSource="{Binding DataContext.RelatedTasks, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Task.Surface.Subtle}" Padding="10" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.ColumnSpan="3" HorizontalAlignment="Right" Width="420" Background="{DynamicResource Task.Brush.Surface.Base}"
                    BorderBrush="{DynamicResource Task.Brush.Border.Strong}" BorderThickness="1,0,0,0" Padding="20" Panel.ZIndex="10"
                    DataContext="{Binding Editor}" AutomationProperties.Name="Форма проекта" AutomationProperties.AutomationId="ProjectEditorPanel">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="{Binding Heading}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Название" FontWeight="SemiBold"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Style="{StaticResource Task.Input.Text}" Margin="0,5,0,12" AutomationProperties.AutomationId="ProjectNameTextBox"/>
                    <TextBlock Text="Описание" FontWeight="SemiBold"/><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="88" TextWrapping="Wrap" Style="{StaticResource Task.Input.Text}" Margin="0,5,0,12"/>
                    <TextBlock Text="Руководитель (UUID, необязательно)" FontWeight="SemiBold"/><TextBox Text="{Binding ManagerId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}" Margin="0,5,0,12"/>
                    <TextBlock Text="Статус" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" DisplayMemberPath="Text" Style="{StaticResource Task.Input.Combo}" Margin="0,5,0,12"/>
                    <TextBlock Text="Дата начала (ДД.ММ.ГГГГ)" FontWeight="SemiBold"/><TextBox Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}" Margin="0,5,0,12"/>
                    <TextBlock Text="Плановое завершение (ДД.ММ.ГГГГ)" FontWeight="SemiBold"/><TextBox Text="{Binding PlannedEndDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Task.Input.Text}" Margin="0,5,0,12"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Task.Brush.Semantic.Critical}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive"/>
                    <WrapPanel><Button Content="{Binding SubmitText}" Command="{Binding DataContext.SaveProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Task.Button.Primary}" Margin="0,0,8,0" AutomationProperties.AutomationId="SaveProjectButton"/><Button Content="Отмена" Command="{Binding DataContext.CancelEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Task.Button.Secondary}"/></WrapPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
