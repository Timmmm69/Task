<UserControl x:Class="Task.Desktop.Views.CalendarView"
             x:Name="CalendarRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Календарь недели"
             AutomationProperties.AutomationId="CalendarScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding WeekRangeText}" FontSize="18" FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="CalendarWeekRange" />
                <TextBlock Text="{Binding LastSuccessfulRefreshText}" Margin="0,3,0,0"
                           Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="Предыдущая" Command="{Binding PreviousWeekCommand}" Style="{StaticResource Task.Button.Secondary}"
                        Margin="0,0,8,0" AutomationProperties.Name="Предыдущая неделя" />
                <Button Content="Сегодня" Command="{Binding TodayCommand}" Style="{StaticResource Task.Button.Secondary}"
                        Margin="0,0,8,0" AutomationProperties.Name="Текущая неделя" />
                <Button Content="Следующая" Command="{Binding NextWeekCommand}" Style="{StaticResource Task.Button.Secondary}"
                        Margin="0,0,8,0" AutomationProperties.Name="Следующая неделя" />
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Task.Button.Secondary}"
                        Margin="0,0,8,0" AutomationProperties.Name="Обновить календарь" />
                <Button Content="Новое событие" Command="{Binding NewEventCommand}" Style="{StaticResource Task.Button.Primary}"
                        AutomationProperties.Name="Создать событие календаря" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,12"
                AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Message}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding ShowMessage}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="48" Height="4" IsIndeterminate="True" Margin="0,0,10,0">
                    <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding Days}" MinWidth="770">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,1,0" MinHeight="430" Padding="8"
                                        AutomationProperties.Name="{Binding AutomationName}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Padding="4,2" Margin="0,0,0,8">
                                            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{DynamicResource Task.Brush.Brand.Subtle}" /><Setter Property="CornerRadius" Value="4" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextAlignment="Center" />
                                        </Border>
                                        <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent"
                                                 SelectionChanged="OnDaySelectionChanged"
                                                 AutomationProperties.Name="{Binding Header}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="7" Margin="0,0,0,6" CornerRadius="5"
                                                            BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1"
                                                            Background="{DynamicResource Task.Brush.Surface.Subtle}"
                                                            AutomationProperties.Name="{Binding AutomationName}"
                                                            AutomationProperties.ItemStatus="{Binding ConflictText}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding TimeText}" FontSize="11" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                                                            <TextBlock Text="{Binding ConflictText}" FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource Task.Brush.Semantic.Critical}">
                                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0" Padding="14" Style="{StaticResource Task.Surface.Subtle}"
                    AutomationProperties.Name="Инспектор расписания">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Детали" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Выберите задачу или событие в календаре." TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel DataContext="{Binding SelectedItem}">
                            <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <TextBlock Text="{Binding TimeText}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding StatusText}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PriorityText}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap" Foreground="{DynamicResource Task.Brush.Semantic.Critical}" />
                        </StackPanel>
                        <StackPanel DataContext="{Binding SelectedEvent}" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Description, TargetNullValue=Без описания}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TimeZoneId, StringFormat=Часовой пояс: {0}}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ProjectId, StringFormat=Проект: {0}, TargetNullValue=Без проекта}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Content="Изменить событие" Command="{Binding EditEventCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.ColumnSpan="2" Background="#99000000" Padding="24" Panel.ZIndex="10">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Editor}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Border Width="460" MaxHeight="560" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22"
                        Background="{DynamicResource Task.Brush.Surface.Base}" CornerRadius="8" DataContext="{Binding Editor}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Событие календаря" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="Название" /><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                            <TextBlock Text="Дата" /><DatePicker SelectedDate="{Binding Date}" Margin="0,4,0,12" />
                            <CheckBox Content="Весь день" IsChecked="{Binding IsAllDay}" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Начало (ЧЧ:ММ)" /><TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Окончание (ЧЧ:ММ)" /><TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" /></StackPanel>
                            </Grid>
                            <TextBlock Text="Описание" /><TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" Margin="0,4,0,12" />
                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource Task.Brush.Semantic.Critical}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive" />
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="Сохранить" Command="{Binding DataContext.SaveEventCommand, ElementName=CalendarRoot}" Style="{StaticResource Task.Button.Primary}" Margin="0,0,8,0" />
                                <Button Content="Отмена" Command="{Binding DataContext.CancelEditorCommand, ElementName=CalendarRoot}" Style="{StaticResource Task.Button.Secondary}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Announcement}" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Announcement}" />
    </Grid>
</UserControl>
