<UserControl x:Class="Task.Desktop.Views.CalendarView"
             x:Name="CalendarRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Task.Desktop.Views"
             xmlns:vm="clr-namespace:Task.Desktop.ViewModels"
             AutomationProperties.Name="Календарь"
             AutomationProperties.AutomationId="CalendarScreen"
             PreviewKeyDown="OnCalendarPreviewKeyDown"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/Calendar.Forms.xaml" />
            <ResourceDictionary Source="../Resources/Personal.Airbnb.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="Calendar.Line" Color="#E9E5E5" />
        <SolidColorBrush x:Key="Calendar.Coral" Color="#CC244C" />
        <SolidColorBrush x:Key="Calendar.Rose" Color="#FFF2F5" />
        <Style x:Key="Calendar.Meta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Calendar.Button" TargetType="Button" BasedOn="{StaticResource Task.Button.Base}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Calendar.Line}" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A98691" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Calendar.Coral}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False" />
                                    <Condition Property="AutomationProperties.ItemStatus" Value="" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.65" />
                            </MultiTrigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                                    <Condition Binding="{Binding (AutomationProperties.ItemStatus), RelativeSource={RelativeSource Self}}" Value="Выбрано" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                                    <Condition Binding="{Binding (AutomationProperties.ItemStatus), RelativeSource={RelativeSource Self}}" Value="Выбранная дата" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Calendar.EventPrimary" TargetType="Button" BasedOn="{StaticResource Calendar.Button}">
            <Setter Property="Background" Value="{StaticResource Calendar.Coral}" />
            <Setter Property="BorderBrush" Value="{StaticResource Calendar.Coral}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B51C40" /></Trigger>
                <DataTrigger Binding="{Binding DataContext.IsPersonal, RelativeSource={RelativeSource AncestorType=views:CalendarView}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Personal.Airbnb.Accent}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Accent}" />
                    <Setter Property="Template" Value="{StaticResource Personal.Airbnb.ButtonTemplate}" />
                    <Setter Property="Padding" Value="18,10" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Calendar.EventSecondary" TargetType="Button" BasedOn="{StaticResource Calendar.Button}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsPersonal, RelativeSource={RelativeSource AncestorType=views:CalendarView}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Personal.Airbnb.Hairline}" />
                    <Setter Property="Template" Value="{StaticResource Personal.Airbnb.ButtonTemplate}" />
                    <Setter Property="Padding" Value="18,10" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Calendar.ModeButton" TargetType="Button" BasedOn="{StaticResource Calendar.Button}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="9,0" />
        </Style>
        <Style x:Key="Calendar.PeriodButton" TargetType="Button" BasedOn="{StaticResource Calendar.Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="Calendar.Panel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Calendar.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Calendar.GridHeader" TargetType="Border">
            <Setter Property="Background" Value="#FBFAFA" />
            <Setter Property="BorderBrush" Value="{StaticResource Calendar.Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Calendar.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Metadata}" />
            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Calendar.DayButton" TargetType="Button" BasedOn="{StaticResource Calendar.ModeButton}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Secondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Calendar.Rose}" />
                    <Setter Property="Foreground" Value="{StaticResource Calendar.Coral}" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="Сегодня" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectedDate}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Calendar.Coral}" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="Выбранная дата" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Calendar.Entry" TargetType="Button" BasedOn="{StaticResource Calendar.Button}">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#E9F5F4" />
            <Setter Property="BorderBrush" Value="#C2E0DD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ToolTip" Value="{Binding AutomationName}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCalendarEvent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Calendar.Rose}" />
                    <Setter Property="BorderBrush" Value="#F1D2DC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                    <Setter Property="BorderBrush" Value="#B88849" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="#F3F2F2" />
                    <Setter Property="BorderBrush" Value="#E2DFDF" />
                    <Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Secondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasConflict}" Value="True">
                    <Setter Property="BorderBrush" Value="#A65A18" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Calendar.Coral}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Calendar.CompactEntry">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid x:Name="CorporateCalendarLayout" Margin="20,12">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers>
            <DataTrigger Binding="{Binding IsPersonal}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding CorporatePeriodText}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CorporatePeriodText}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.AutomationId="CalendarWeekRange" />
                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding TimeZoneLabel}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Calendar.Meta}">
                            <Setter Property="Text" Value="{Binding SelectedDateUtcOffsetText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:CalendarScreenState.Refreshing}">
                                    <Setter Property="Text" Value="Обновляем расписание…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding NewEventCommand}" Style="{StaticResource Calendar.EventPrimary}"
                    VerticalAlignment="Center" MinHeight="38" Padding="14,0"
                    AutomationProperties.Name="Создать событие календаря" AutomationProperties.AutomationId="CalendarNewEvent">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{DynamicResource Task.Icon.Add}" Width="13" Height="13" Stretch="Uniform" Fill="White" Margin="0,0,7,0" />
                    <TextBlock Text="Новое событие" />
                </StackPanel>
            </Button>
        </Grid>

        <DockPanel x:Name="CalendarToolbar" Grid.Row="1" Margin="0,0,0,8"
                   AutomationProperties.Name="Команды календаря" AutomationProperties.AutomationId="CalendarCommandBar">
            <Border DockPanel.Dock="Right" Background="{StaticResource Personal.Airbnb.Soft}" CornerRadius="10"
                    Padding="3" Margin="8,0,0,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Button Content="День" Command="{Binding DayModeCommand}" AutomationProperties.Name="Режим дня">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Calendar.ModeButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:CalendarViewMode.Day}">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Calendar.Line}" />
                                        <Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Ink}" />
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Выбрано" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Неделя" Command="{Binding WeekModeCommand}" AutomationProperties.Name="Режим недели">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Calendar.ModeButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:CalendarViewMode.Week}">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Calendar.Line}" />
                                        <Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Ink}" />
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Выбрано" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Месяц" Command="{Binding MonthModeCommand}" AutomationProperties.Name="Режим месяца">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Calendar.ModeButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:CalendarViewMode.Month}">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Calendar.Line}" />
                                        <Setter Property="Foreground" Value="{StaticResource Personal.Airbnb.Ink}" />
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Выбрано" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,6,2">
                    <Button Command="{Binding PreviousWeekCommand}" Style="{StaticResource Calendar.PeriodButton}"
                            ToolTip="Предыдущий период" AutomationProperties.Name="Предыдущий период">
                        <Path Data="M 6,0 L 0,6 L 6,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                    </Button>
                    <Button Content="Сегодня" Command="{Binding TodayCommand}" Style="{StaticResource Calendar.Button}"
                            Margin="4,0" AutomationProperties.Name="Вернуться к текущей дате" />
                    <Button Command="{Binding NextWeekCommand}" Style="{StaticResource Calendar.PeriodButton}"
                            ToolTip="Следующий период" AutomationProperties.Name="Следующий период">
                        <Path Data="M 0,0 L 6,6 L 0,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,6,2">
                    <DatePicker x:Name="CalendarDatePicker" SelectedDate="{Binding SelectedDate}" Width="136" MinHeight="34"
                                Style="{StaticResource Calendar.Form.Date}" AutomationProperties.Name="Дата календаря" />
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource Calendar.PeriodButton}" Margin="4,0,0,0"
                            ToolTip="Обновить календарь" AutomationProperties.Name="Обновить календарь" AutomationProperties.AutomationId="CalendarRefresh">
                        <Path Data="{DynamicResource Task.Icon.Refresh}" Width="15" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Button Content="Найти время" Command="{Binding FindTimeCommand}" Style="{StaticResource Calendar.Button}"
                            Margin="0,0,4,0" AutomationProperties.Name="Найти свободное рабочее окно" AutomationProperties.AutomationId="CalendarFindTime" />
                    <Button Content="Серии" Command="{Binding Recurrence.OpenCommand}" Style="{StaticResource Calendar.Button}"
                            ToolTip="Повторяющиеся задачи" AutomationProperties.Name="Повторяющиеся задачи" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <StackPanel Grid.Row="2">
            <Border Padding="8" Margin="0,0,0,8">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasChosenFreeTime}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding ChosenFreeTime.Label}" TextWrapping="Wrap"/>
                    <TextBlock Text="Окно не зарезервировано. Проверьте данные перед сохранением." TextWrapping="Wrap"/>
                    <Button Content="Создать задачу в это время" Command="{Binding CreateTaskAtFreeTimeCommand}" Style="{StaticResource Task.Button.Secondary}" HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.Name="Открыть обычный черновик задачи на выбранное время"/>
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowReadOnlyState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Path Data="{DynamicResource Task.Icon.Lock}" Width="18" Height="18" Stretch="Uniform"
                          Fill="{DynamicResource Task.Brush.Text.Secondary}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Только чтение" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="CalendarReadOnlyBanner" />
                        <TextBlock Text="{Binding WriteAccessText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.WarningSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Warning}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowRollback}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding RollbackMessage}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.AutomationId="CalendarRollbackBanner" />
            </Border>
            <Border Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.CriticalSoft}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowStateBanner}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Data="{DynamicResource Task.Icon.Error}" Width="18" Height="18" Stretch="Uniform"
                          Fill="{DynamicResource Task.Brush.Semantic.Critical}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StateTitle}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                   AutomationProperties.LiveSetting="Assertive"
                                   AutomationProperties.AutomationId="CalendarStateBanner" />
                        <TextBlock Text="{Binding StateDescription}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Повторить" Command="{Binding RefreshCommand}"
                            Style="{StaticResource Task.Button.Secondary}" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <Border Style="{StaticResource Calendar.Panel}" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="CalendarHorizontalScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsTimelineMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Width="{Binding ViewportWidth, ElementName=CalendarHorizontalScroll}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="MinWidth" Value="570" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:CalendarViewMode.Day}">
                                            <Setter Property="MinWidth" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="Auto" MaxHeight="82" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Calendar.GridHeader}" />
                            <TextBlock Text="Время" Width="58" HorizontalAlignment="Left" VerticalAlignment="Center"
                                       TextAlignment="Center" FontSize="11" Style="{StaticResource Calendar.Meta}" />
                            <ItemsControl ItemsSource="{Binding Days}" Margin="58,0,0,0" HorizontalAlignment="Left"
                                          Width="{Binding ActualWidth, ElementName=CalendarTimelineDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding DataContext.CalendarColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Calendar.Line}" BorderThickness="1,0,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DayName}" VerticalAlignment="Center" Margin="0,0,3,0"
                                                           Style="{StaticResource Calendar.Meta}" />
                                                <Button Content="{Binding DayNumberText}" Style="{StaticResource Calendar.DayButton}"
                                                        Click="OnSelectDate" AutomationProperties.Name="{Binding Header}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="1" Style="{StaticResource Calendar.GridHeader}" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Весь день" VerticalAlignment="Top" TextAlignment="Center" Margin="0,9,0,0"
                                               FontSize="11" Style="{StaticResource Calendar.Meta}" />
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Days}" MinHeight="32" HorizontalAlignment="Left"
                                                      Width="{Binding ActualWidth, ElementName=CalendarTimelineDays}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding DataContext.CalendarColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Calendar.Line}" BorderThickness="1,0,0,0" Padding="3,3,3,0">
                                                        <ItemsControl ItemsSource="{Binding AllDayItems}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=views:CalendarView}}"
                                                                            CommandParameter="{Binding}" Style="{StaticResource Calendar.Entry}" Margin="0,0,0,3"
                                                                            Content="{Binding}" ContentTemplate="{StaticResource Calendar.CompactEntry}"
                                                                            AutomationProperties.Name="{Binding AutomationName}"
                                                                            AutomationProperties.ItemStatus="{Binding StatusText}"
                                                                            AutomationProperties.AutomationId="CalendarAllDayItem" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <ScrollViewer x:Name="CalendarTimelineScroll" Grid.Row="2"
                                          VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="True" AutomationProperties.Name="Временная сетка календаря"
                                          AutomationProperties.AutomationId="CalendarTimeline">
                                <Grid x:Name="CalendarTimelineHost" Height="{Binding CorporateTimelineHeight}" Background="Transparent">
                                    <Canvas Panel.ZIndex="10" IsHitTestVisible="False" Margin="58,0,0,0">
                                        <Border Canvas.Top="{Binding ChosenFreeTime.Top}" Height="{Binding ChosenFreeTime.Height}"
                                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                BorderThickness="3" BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                                Background="Transparent">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding ShowFreeTimeHighlight}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style></Border.Style>
                                        </Border>
                                    </Canvas>
                                    <ItemsControl ItemsSource="{Binding HourMarkers}" IsHitTestVisible="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Top}" /></Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="{Binding ActualWidth, ElementName=CalendarTimelineHost}" Height="69">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Margin="0,2,10,0" TextAlignment="Right"
                                                               FontSize="11" Style="{StaticResource Calendar.Meta}" />
                                                    <Border Grid.Column="1" BorderBrush="{StaticResource Calendar.Line}"
                                                            BorderThickness="0,1,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Days}" Panel.ZIndex="8" IsHitTestVisible="False"
                                                  Width="58" HorizontalAlignment="Left">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Top" Value="{Binding CurrentTimeTop}" />
                                                <Setter Property="Width" Value="54" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowCurrentTime}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Calendar.Coral}" CornerRadius="4" Padding="4,1"
                                                        HorizontalAlignment="Right" Margin="0,-8,0,0">
                                                    <TextBlock Text="{Binding CurrentTimeText}" Foreground="White" FontSize="10" FontWeight="SemiBold"
                                                               AutomationProperties.Name="{Binding CurrentTimeText, StringFormat='Текущее время {0}'}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="CalendarTimelineDays" ItemsSource="{Binding Days}" Margin="58,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.CalendarColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Border BorderBrush="{StaticResource Calendar.Line}" BorderThickness="1,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="#13FF385C" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Canvas IsHitTestVisible="False" Panel.ZIndex="8">
                                                        <Grid Height="0" Canvas.Top="{Binding CurrentTimeTop}"
                                                              Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                                              AutomationProperties.Name="{Binding CurrentTimeText, StringFormat='Текущее время {0}'}">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowCurrentTime}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Canvas>
                                                                <Border Height="1.5" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                                        Background="{StaticResource Calendar.Coral}" />
                                                                <Ellipse Width="7" Height="7" Canvas.Top="-3" Canvas.Left="-3"
                                                                         Fill="{StaticResource Calendar.Coral}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </Canvas>
                                                    <ItemsControl ItemsSource="{Binding TimelineItems}" Panel.ZIndex="10">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Top" Value="{Binding TimelineTop}" />
                                                                <Setter Property="Height" Value="{Binding TimelineHeight}" />
                                                                <Setter Property="Canvas.Left">
                                                                    <Setter.Value>
                                                                        <MultiBinding Converter="{StaticResource Task.CalendarLaneLeftConverter}">
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                            <Binding Path="TimelineLane" />
                                                                            <Binding Path="TimelineLaneCount" />
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Width">
                                                                    <Setter.Value>
                                                                        <MultiBinding Converter="{StaticResource Task.CalendarLaneWidthConverter}">
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                            <Binding Path="TimelineLaneCount" />
                                                                        </MultiBinding>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button DataContext="{Binding Item}"
                                                                        Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=views:CalendarView}}"
                                                                        CommandParameter="{Binding}" Style="{StaticResource Calendar.Entry}"
                                                                        Margin="0,1,0,0" Padding="4,2" VerticalAlignment="Stretch"
                                                                        VerticalContentAlignment="Top" AutomationProperties.Name="{Binding AutomationName}"
                                                                        AutomationProperties.ItemStatus="{Binding ConflictText, TargetNullValue=''}"
                                                                        AutomationProperties.AutomationId="CalendarTimelineItem">
                                                                    <StackPanel ClipToBounds="True">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                   TextWrapping="Wrap" LineHeight="14" LineStackingStrategy="BlockLineHeight">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="MaxHeight" Value="14" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource Calendar.Form.SizeAtLeast}, ConverterParameter=64}" Value="True">
                                                                                            <Setter Property="MaxHeight" Value="28" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock FontSize="11" FontWeight="Normal" TextTrimming="CharacterEllipsis" LineHeight="13">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Calendar.Meta}">
                                                                                    <Setter Property="Text" Value="{Binding CompactTimeText}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource Calendar.Form.SizeAtLeast}, ConverterParameter=66}" Value="True">
                                                                                            <Setter Property="Text" Value="{Binding TimeText}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock FontWeight="Normal" TextTrimming="CharacterEllipsis" LineHeight="13">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Calendar.Meta}">
                                                                                    <Setter Property="FontSize" Value="11" />
                                                                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                                                            <Setter Property="Text" Value="Конфликт" />
                                                                                            <Setter Property="FontSize" Value="10" />
                                                                                            <Setter Property="Foreground" Value="#894913" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>

                    <Grid Visibility="{Binding IsMonthMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Calendar.GridHeader}" />
                        <ItemsControl ItemsSource="{Binding MonthWeekdays}" HorizontalAlignment="Left"
                                      Width="{Binding ActualWidth, ElementName=CalendarMonthItems}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DayName}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Style="{StaticResource Calendar.Meta}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ScrollViewer x:Name="CalendarMonthScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      IsVisibleChanged="OnMonthVisibilityChanged"
                                      VerticalScrollBarVisibility="Visible" Focusable="True" AutomationProperties.Name="Сетка месяца">
                            <ItemsControl x:Name="CalendarMonthItems" ItemsSource="{Binding MonthWeeks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="86" Padding="3" BorderBrush="{StaticResource Calendar.Line}"
                                                            BorderThickness="0,0,1,1" AutomationProperties.Name="{Binding AutomationName}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                        <Setter Property="Background" Value="{StaticResource Personal.Airbnb.Soft}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelectedDate}" Value="True"><Setter Property="Background" Value="#FFF8FA" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <Button Content="{Binding DayNumberText}" Style="{StaticResource Calendar.DayButton}"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,3"
                                                                    Loaded="OnMonthDateLoaded" Click="OnSelectDate" AutomationProperties.Name="{Binding Header}" />
                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=views:CalendarView}}"
                                                                                CommandParameter="{Binding}" Style="{StaticResource Calendar.Entry}" Margin="0,0,0,3"
                                                                                Content="{Binding}" ContentTemplate="{StaticResource Calendar.CompactEntry}"
                                                                                AutomationProperties.ItemStatus="{Binding StatusText}" AutomationProperties.Name="{Binding AutomationName}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border Panel.ZIndex="30" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,12" MaxWidth="360">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Calendar.Panel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowInitialLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Style="{StaticResource Task.Progress.Indeterminate}" IsIndeterminate="True" Foreground="{StaticResource Calendar.Coral}" />
                            <TextBlock Text="Загрузка расписания…" TextAlignment="Center" Margin="0,14,0,0"
                                       FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="CalendarLoadingState" />
                        </StackPanel>
                    </Border>

                    <Border Panel.ZIndex="29" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,12" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Calendar.Panel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowEmptyState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{DynamicResource Task.Icon.Calendar}" Width="22" Height="22" Stretch="Uniform"
                                  Fill="{DynamicResource Task.Brush.Text.Secondary}" HorizontalAlignment="Center" />
                            <TextBlock Text="В этом периоде пока нет записей" FontSize="{DynamicResource Task.Font.Size.Section}"
                                       FontWeight="{DynamicResource Task.Font.Weight.Semibold}" TextAlignment="Center" Margin="0,12,0,0"
                                       AutomationProperties.AutomationId="CalendarEmptyState" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Panel.ZIndex="40" Padding="12" Margin="8,8,20,8" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="470">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Calendar.Panel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowFreeTime}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Длительность" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="15 мин" Command="{Binding FreeTimeDurationCommand}" CommandParameter="15" Style="{StaticResource Calendar.Button}" Margin="0,0,4,4" AutomationProperties.Name="Искать окно на 15 минут"/>
                        <Button Content="30 мин" Command="{Binding FreeTimeDurationCommand}" CommandParameter="30" Style="{StaticResource Calendar.Button}" Margin="0,0,4,4" AutomationProperties.Name="Искать окно на 30 минут"/>
                        <Button Content="60 мин" Command="{Binding FreeTimeDurationCommand}" CommandParameter="60" Style="{StaticResource Calendar.Button}" Margin="0,0,4,4" AutomationProperties.Name="Искать окно на 60 минут"/>
                        <Button Content="Закрыть" Command="{Binding CloseFreeTimeCommand}" Style="{StaticResource Calendar.Button}" Margin="0,0,4,4" AutomationProperties.Name="Закрыть поиск свободного времени"/>
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding FreeTimeMinutes, StringFormat=Выбрано: {0} минут}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Text="Рабочие часы и выходные — из ваших настроек. Учитываются доступные вам записи календаря, включая общие. Записи без времени начала и конца не блокируют точное время." TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding FreeTimeMessage}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="CalendarFreeTimeStatus"/>
                            <ItemsControl ItemsSource="{Binding FreeTimeSlots}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Content="{Binding Label}" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                            Style="{StaticResource Calendar.Button}" AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.ChooseFreeTimeCommand, ElementName=CalendarRoot}" CommandParameter="{Binding}"/>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Следующая неделя" Command="{Binding MoreFreeTimeCommand}" Style="{StaticResource Calendar.Button}" HorizontalAlignment="Left" AutomationProperties.Name="Искать в следующей неделе"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <GroupBox x:Name="CalendarInspector" Panel.ZIndex="45"
                  AutomationProperties.Name="Инспектор выбранного элемента"
                  AutomationProperties.AutomationId="CalendarSelectionInspector">
            <GroupBox.Template>
                <ControlTemplate TargetType="GroupBox">
                    <Border Style="{StaticResource Calendar.Panel}" Padding="12">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </GroupBox.Template>
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Grid.Row" Value="4" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                    <Setter Property="MaxHeight" Value="104" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedItem}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding ShowFreeTime}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding ActualHeight, ElementName=CalendarRoot, Converter={StaticResource Calendar.Form.SizeAtLeast}, ConverterParameter=490}" Value="False">
                            <Setter Property="Grid.Row" Value="3" />
                            <Setter Property="VerticalAlignment" Value="Bottom" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="8,4,20,8" />
                            <Setter Property="Width" Value="360" />
                            <Setter Property="MaxHeight" Value="128" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="Детали записи">
                    <StackPanel DataContext="{Binding SelectedItem}">
                        <TextBlock Text="{Binding TypeText}" Style="{StaticResource Calendar.Meta}" />
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,2" />
                        <WrapPanel>
                            <TextBlock Text="{Binding TimeText}" Margin="0,0,10,0" FontSize="12" />
                            <TextBlock Text="{Binding StatusText}" Margin="0,0,10,0" FontSize="12" />
                            <TextBlock Text="{Binding PriorityText}" Margin="0,0,10,0" Style="{StaticResource Calendar.Meta}" />
                            <TextBlock Text="{Binding ConflictText}" FontSize="12" Foreground="{DynamicResource Task.Brush.Semantic.Critical}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Description, TargetNullValue=Описание не добавлено.}" TextWrapping="Wrap"
                                   Margin="0,3,0,0" Style="{StaticResource Calendar.Meta}" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="CalendarEditEventButton" Content="Изменить" Command="{Binding EditEventCommand}"
                            Style="{StaticResource Calendar.Button}" MinHeight="28"
                            Visibility="{Binding SelectedItem.IsCalendarEvent, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                            AutomationProperties.Name="Изменить событие" AutomationProperties.AutomationId="CalendarEditEvent" />
                    <Button Content="Закрыть" Click="OnClearSelection" Style="{StaticResource Calendar.Button}" MinHeight="28" Margin="0,4,0,0"
                            AutomationProperties.Name="Снять выделение" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="{Binding Announcement}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Announcement}" />

    </Grid>
        <views:PersonalCalendarView x:Name="PersonalCalendarSurface">
            <views:PersonalCalendarView.Style><Style TargetType="views:PersonalCalendarView">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsPersonal}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></views:PersonalCalendarView.Style>
        </views:PersonalCalendarView>
        <Border Grid.RowSpan="5" Background="#66222222" Padding="16" Panel.ZIndex="50" Margin="16,12,16,12"
                PreviewKeyDown="OnEditorPreviewKeyDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Editor}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border x:Name="CalendarEditorDialog" MaxWidth="1040" MaxHeight="840" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Style="{StaticResource Calendar.Panel}" ClipToBounds="True"
                    DataContext="{Binding Editor}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Calendar.Line}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" VerticalAlignment="Center" Background="{StaticResource Calendar.Rose}" CornerRadius="8">
                                <Path Data="{DynamicResource Task.Icon.Calendar}" Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource Calendar.Coral}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Календарь · событие" Style="{StaticResource Calendar.Form.Hint}" Margin="0" />
                                <TextBlock Text="{Binding EditorTitle}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}"
                                           FontWeight="{DynamicResource Task.Font.Weight.Semibold}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           AutomationProperties.Name="{Binding EditorTitle}" AutomationProperties.AutomationId="CalendarEventEditor" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Calendar.Form.Hint}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Закрыть" Command="{Binding CancelCommand}" VerticalAlignment="Center"
                                    Style="{StaticResource Calendar.EventSecondary}" AutomationProperties.Name="Закрыть редактор события" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0" Padding="0">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer"><Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            </Style.Triggers></Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <Border Margin="20,16,20,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Task.State.Inline}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.CriticalSoft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Semantic.Critical}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            <DataTrigger Binding="{Binding ValidationMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding ValidationTitle}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}"
                                               AutomationProperties.LiveSetting="Assertive"
                                               AutomationProperties.AutomationId="CalendarEditorState" />
                                    <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid x:Name="CalendarEditorBody">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition>
                                        <ColumnDefinition.Style><Style TargetType="ColumnDefinition">
                                            <Setter Property="Width" Value="*" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActualWidth, ElementName=CalendarEditorDialog, Converter={StaticResource Calendar.Form.SizeAtLeast}, ConverterParameter=900}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger>
                                                <DataTrigger Binding="{Binding AllowAttendees}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style></ColumnDefinition.Style>
                                    </ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="CalendarEditorDetails">
                                    <Border Style="{StaticResource Calendar.Form.Section}">
                                        <StackPanel>
                                            <TextBlock Text="Основное" Style="{StaticResource Calendar.Form.Heading}" />
                                            <TextBlock Text="Название *" Style="{StaticResource Calendar.FieldLabel}" />
                                            <TextBox x:Name="CalendarEditorTitle" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource Calendar.Form.Text}" Margin="0,0,0,14"
                                                     IsVisibleChanged="OnEditorTitleIsVisibleChanged"
                                                     AutomationProperties.Name="Название события"
                                                     AutomationProperties.AutomationId="CalendarEventTitle" />
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Проект" Style="{StaticResource Calendar.FieldLabel}" />
                                                    <TextBox Text="{Binding ProjectId, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Идентификатор доступного проекта; поле можно оставить пустым."
                                                             AutomationProperties.Name="Идентификатор проекта">
                                                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource Calendar.Form.Text}"><Style.Triggers><DataTrigger Binding="{Binding IsPersonal}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
                                                    </TextBox>
                                                    <ComboBox ItemsSource="{Binding ProjectChoices}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" AutomationProperties.Name="Личный проект события">
                                                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource Calendar.Form.Combo}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPersonal}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Статус" Style="{StaticResource Calendar.FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding Status, Mode=TwoWay}" Style="{StaticResource Calendar.Form.Combo}"
                                                              AutomationProperties.Name="Статус события" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Описание" Style="{StaticResource Calendar.FieldLabel}" />
                                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                     MinHeight="88" MaxHeight="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     Style="{StaticResource Calendar.Form.Text}" AutomationProperties.Name="Описание события" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Calendar.Form.Section}">
                                        <StackPanel>
                                            <TextBlock Text="Дата и время" Style="{StaticResource Calendar.Form.Heading}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Дата начала *" Style="{StaticResource Calendar.FieldLabel}" />
                                                    <DatePicker SelectedDate="{Binding Date}" Style="{StaticResource Calendar.Form.Date}"
                                                                AutomationProperties.Name="Дата события" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Часовой пояс" Style="{StaticResource Calendar.FieldLabel}" />
                                                    <TextBox Text="{Binding TimeZoneText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Calendar.Form.Text}"
                                                             AutomationProperties.Name="Часовой пояс события" AutomationProperties.IsOffscreenBehavior="Onscreen" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Background="{DynamicResource Task.Brush.Surface.Subtle}" Padding="12,4" Margin="0,12,0,12"
                                                    BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource Task.Radius.Control}">
                                                <StackPanel>
                                                    <CheckBox Content="Событие на весь день" IsChecked="{Binding IsAllDay}"
                                                              Style="{StaticResource Calendar.Form.CheckBox}" AutomationProperties.Name="Событие на весь день" />
                                                    <TextBlock Text="Без привязки к часам. Введённое время сохранится при переключении." Style="{StaticResource Calendar.Form.Hint}" Margin="30,0,0,6" />
                                                </StackPanel>
                                            </Border>
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid"><Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAllDay}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                                    </Style.Triggers></Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Начало *" Style="{StaticResource Calendar.FieldLabel}" />
                                                    <TextBox Text="{Binding StartTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Calendar.Form.Text}"
                                                             AutomationProperties.Name="Время начала" />
                                                    <TextBlock Text="Окончание *" Style="{StaticResource Calendar.FieldLabel}" Margin="0,12,0,5" />
                                                    <TextBox Text="{Binding EndTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Calendar.Form.Text}"
                                                             AutomationProperties.Name="Время окончания" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Дата окончания" Style="{StaticResource Calendar.FieldLabel}" />
                                                    <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource Calendar.Form.Date}"
                                                                AutomationProperties.Name="Дата окончания события" />
                                                    <TextBlock Text="Время в формате ЧЧ:ММ, например 09:30. Для встречи через полночь укажите следующий день."
                                                               Style="{StaticResource Calendar.Form.Hint}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                                <Border x:Name="CalendarEditorAttendees">
                                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Calendar.Form.Section}">
                                        <Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActualWidth, ElementName=CalendarEditorDialog, Converter={StaticResource Calendar.Form.SizeAtLeast}, ConverterParameter=900}" Value="False">
                                                <Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" />
                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                            </DataTrigger>
                                        <DataTrigger Binding="{Binding AllowAttendees}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></Border.Style>
                                    <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource Task.Brush.Brand.Soft}" Padding="8,3"
                                                CornerRadius="{DynamicResource Task.Radius.Control}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Attendees.Count, Mode=OneWay}" Foreground="{DynamicResource Task.Brush.Brand.Strong}"
                                                       AutomationProperties.Name="Количество участников" AutomationProperties.LiveSetting="Polite" />
                                        </Border>
                                        <TextBlock Text="Участники" Style="{StaticResource Calendar.Form.Heading}" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="У вас нет разрешения менять участников. Список доступен для просмотра." TextWrapping="Wrap" Margin="0,0,0,10">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Calendar.Form.Hint}"><Style.Triggers>
                                            <DataTrigger Binding="{Binding CanEditAttendees}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Пока нет участников. Добавьте сотрудника или контакт ниже.">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Calendar.Form.Hint}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Attendees.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Attendees}" Margin="0,0,0,8" IsEnabled="{Binding CanEditAttendees}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="0,0,0,1"
                                                        Background="{DynamicResource Task.Brush.Surface.Base}"
                                                        CornerRadius="0" Padding="0,12" Margin="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="{DynamicResource Task.Font.Weight.Semibold}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Calendar.Form.Hint}" />
                                                            <TextBlock Text="{Binding Id}" FontSize="{DynamicResource Task.Font.Size.Metadata}"
                                                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap" />
                                                            <WrapPanel Margin="0,10,0,0">
                                                                <StackPanel Margin="0,0,8,8"><TextBlock Text="Роль" Style="{StaticResource Calendar.FieldLabel}" />
                                                                <ComboBox MinWidth="150" SelectedValue="{Binding Role}" SelectedValuePath="Tag"
                                                                          Style="{StaticResource Calendar.Form.Combo}"
                                                                          AutomationProperties.Name="Роль участника">
                                                                    <ComboBoxItem Tag="required" Content="Обязательный" />
                                                                    <ComboBoxItem Tag="optional" Content="Необязательный" />
                                                                    <ComboBoxItem Tag="observer" Content="Наблюдатель" />
                                                                </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,0,0,8"><TextBlock Text="Ответ" Style="{StaticResource Calendar.FieldLabel}" />
                                                                <ComboBox MinWidth="150" SelectedValue="{Binding ResponseStatus}" SelectedValuePath="Tag"
                                                                          Style="{StaticResource Calendar.Form.Combo}"
                                                                          AutomationProperties.Name="Ответ участника">
                                                                    <ComboBoxItem Tag="pending" Content="Ожидается" />
                                                                    <ComboBoxItem Tag="accepted" Content="Принят" />
                                                                    <ComboBoxItem Tag="declined" Content="Отклонён" />
                                                                    <ComboBoxItem Tag="tentative" Content="Под вопросом" />
                                                                </ComboBox>
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Удалить"
                                                                Command="{Binding DataContext.RemoveAttendeeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource Calendar.EventSecondary}"
                                                                Margin="10,0,0,0" VerticalAlignment="Top" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel IsEnabled="{Binding CanEditAttendees}">
                                        <TextBlock Text="Добавить участника" Style="{StaticResource Calendar.FieldLabel}" Margin="0,8,0,5" />
                                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AttendeeKinds}" DisplayMemberPath="Label"
                                                  SelectedValue="{Binding IsUserAttendee}" SelectedValuePath="IsUser"
                                                  Style="{StaticResource Calendar.Form.Combo}" Margin="0,0,0,8"
                                                  AutomationProperties.Name="Тип участника" />
                                        <views:EmployeePickerView DataContext="{Binding AttendeePicker}"
                                            Visibility="{Binding DataContext.ShowEmployeePicker, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                            <views:EmployeePickerView.Resources>
                                                <Style x:Key="Task.Input.Text" TargetType="TextBox" BasedOn="{StaticResource Calendar.Form.Text}" />
                                                <Style TargetType="ListBox" BasedOn="{StaticResource Task.DataList}">
                                                    <Setter Property="ItemContainerStyle" Value="{StaticResource Task.DataList.Item}" />
                                                </Style>
                                            </views:EmployeePickerView.Resources>
                                        </views:EmployeePickerView>
                                        <TextBox Text="{Binding AttendeeId, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding ShowAttendeeId, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Style="{StaticResource Calendar.Form.Text}"
                                                 AutomationProperties.AutomationId="CalendarAttendeeId"
                                                 AutomationProperties.Name="UUID сотрудника или контакта" />
                                        <TextBlock Text="{Binding AttendeeEntryHint}" TextWrapping="Wrap" Margin="0,6,0,8"
                                                   Foreground="{DynamicResource Task.Brush.Text.Secondary}" />
                                        <Button Content="Добавить" Command="{Binding AddAttendeeCommand}"
                                                HorizontalAlignment="Left" AutomationProperties.AutomationId="CalendarAddAttendee"
                                                Style="{StaticResource Calendar.EventSecondary}" />
                                    </StackPanel>
                                </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0" Background="{DynamicResource Task.Brush.Surface.Subtle}"
                            BorderBrush="{DynamicResource Task.Brush.Border.Default}">
                    <Grid x:Name="CalendarEditorActions">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar Width="72" IsIndeterminate="True">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource Task.Progress.Indeterminate}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="Сохранение…" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Task.Brush.Text.Secondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="Сохранить" MinWidth="120" Command="{Binding SaveCommand}"
                                    Style="{StaticResource Calendar.EventPrimary}" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="CalendarEventSave" />
                            <Button Content="Отмена" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Calendar.EventSecondary}" />
                        </WrapPanel>
                    </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <Border Grid.RowSpan="5" Background="#99000000" Padding="12" Panel.ZIndex="60" Margin="24,14,24,0">
            <Border.Style>
                <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Recurrence.IsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <views:RecurrenceView DataContext="{Binding Recurrence}" />
        </Border>
    </Grid>
</UserControl>
