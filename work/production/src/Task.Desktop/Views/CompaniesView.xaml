<UserControl x:Class="Task.Desktop.Views.CompaniesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Task.Desktop.Views"
 Background="{DynamicResource Task.Brush.Surface.Base}" UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.Name="Компании" AutomationProperties.AutomationId="CompaniesWorkspace">
 <UserControl.Resources>
  <Style x:Key="Company.Card" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
   <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="CornerRadius" Value="0"/>
   <Setter Property="Padding" Value="20,14,20,18"/><Setter Property="Margin" Value="0"/>
  </Style>
  <Style x:Key="Company.Heading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Section}"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,16"/>
  </Style>
  <Style x:Key="Company.Label" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Company.Hint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Metadata}"/>
   <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Secondary}"/>
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,6"/>
   <Style.Triggers><DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
   </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Company.Value" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Body}"/>
  </Style>
  <Style x:Key="Company.Status" TargetType="TextBlock">
   <Setter Property="Text" Value="{Binding Status}"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Status}" Value="active"><Setter Property="Text" Value="Активная"/></DataTrigger>
    <DataTrigger Binding="{Binding Status}" Value="inactive"><Setter Property="Text" Value="Неактивная"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Company.StatusBadge" TargetType="Border" BasedOn="{StaticResource Task.Semantic.StatusPill}">
   <Setter Property="Margin" Value="0,14,0,0"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="10,0"/><Setter Property="CornerRadius" Value="{DynamicResource Task.Radius.Control}"/><Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Strong}"/><Setter Property="BorderThickness" Value="1"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Status}" Value="active"><Setter Property="Background" Value="{DynamicResource Task.Brush.Semantic.SuccessSoft}"/></DataTrigger>
    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
     <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Company.ReadMode" TargetType="StackPanel">
   <Setter Property="Visibility" Value="Collapsed"/>
   <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
    <Condition Binding="{Binding HasDetails}" Value="True"/><Condition Binding="{Binding IsEditing}" Value="False"/>
   </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Company.Card}" Padding="0" Margin="0" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Border Height="49" Padding="14,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Task.Brush.Border.Default}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Компании" FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="{Binding Items.Count}" Style="{StaticResource Company.Hint}" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="Загружено компаний"/>
      </Grid>
     </Border><StackPanel Margin="14,12,14,8">
     <TextBlock Text="Поиск по названию" Style="{StaticResource Company.Hint}"/>
     <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Поиск компаний">
      <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RefreshCommand}"/></TextBox.InputBindings>
     </TextBox>
     <Button Content="Найти / обновить" Command="{Binding RefreshCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,8,0,8"/>
     <Button Content="Новая компания" Command="{Binding NewCommand}" Style="{StaticResource Task.Button.Primary}" Margin="0,0,0,16"/>
     <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoadingList, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
     <TextBlock Text="Компании не найдены. Измените запрос или создайте новую." Style="{StaticResource Company.Hint}" Margin="0,8" Visibility="{Binding IsEmpty, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
    </StackPanel></StackPanel>
    <Button DockPanel.Dock="Bottom" Content="Загрузить ещё компании" Command="{Binding MoreCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,8,0,0" Visibility="{Binding HasMore, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedCompany}" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Task.DataList.Item}" BorderThickness="0" AutomationProperties.Name="Список компаний" AutomationProperties.AutomationId="CompaniesList">
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Path Data="{StaticResource Task.Icon.Contacts}" Width="17" Height="17" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}" VerticalAlignment="Top" Margin="0,3,0,0"/>
      <StackPanel Grid.Column="1">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Industry}" Style="{StaticResource Company.Hint}" Margin="0,4,0,0"/>
      <Border Style="{StaticResource Company.StatusBadge}"><TextBlock Style="{StaticResource Company.Status}"/></Border>
     </StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Task.Brush.Border.Default}">    <TextBlock FontSize="{DynamicResource Task.Font.Size.Section}" FontWeight="SemiBold" Margin="20,0" VerticalAlignment="Center" TextWrapping="Wrap">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Карточка компании"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Text" Value="Редактирование компании"/></DataTrigger>
       <DataTrigger Binding="{Binding IsCreating}" Value="True"><Setter Property="Text" Value="Новая компания"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
</Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsLoadingCard, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="20,8" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="CompanyMessage"/>
    <Border>
     <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Company.Card}"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
       <Condition Binding="{Binding HasDetails}" Value="False"/><Condition Binding="{Binding IsEditing}" Value="False"/><Condition Binding="{Binding IsLoadingCard}" Value="False"/>
      </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
     </Style></Border.Style>
     <StackPanel><TextBlock Text="Выберите компанию" Style="{StaticResource Company.Heading}"/>
      <TextBlock Text="Откройте компанию из списка, чтобы посмотреть реквизиты и контактных лиц, или создайте новую." Style="{StaticResource Company.Hint}"/>
     </StackPanel>
    </Border>
    <StackPanel Style="{StaticResource Company.ReadMode}">
     <Border Style="{StaticResource Company.Card}"><StackPanel>
      <TextBlock Text="{Binding Details.Name}" FontSize="{DynamicResource Task.Font.Size.DetailTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <Border DataContext="{Binding Details}" Style="{StaticResource Company.StatusBadge}"><TextBlock Style="{StaticResource Company.Status}" VerticalAlignment="Center" AutomationProperties.Name="Бизнес-статус компании"/></Border>
      <WrapPanel Margin="0,16,0,0">
       <Button Content="Редактировать" Command="{Binding EditCommand}" Style="{StaticResource Task.Button.Primary}" Margin="0,0,8,8"/>
       <Button Content="Обновить карточку" Command="{Binding ReloadCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,0,8"/>
      </WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Company.Card}"><StackPanel>
      <TextBlock Text="Реквизиты" Style="{StaticResource Company.Heading}"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.Row="0" Text="Юр. название:" Style="{StaticResource Company.Hint}" Margin="0,0,10,12"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Details.LegalName, TargetNullValue=—}" Style="{StaticResource Company.Value}" Margin="0,0,0,12"/>
<TextBlock Grid.Row="1" Text="Налоговый ID:" Style="{StaticResource Company.Hint}" Margin="0,0,10,12"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details.TaxIdentifier, TargetNullValue=—}" Style="{StaticResource Company.Value}" Margin="0,0,0,12"/>
<TextBlock Grid.Row="2" Text="Отрасль:" Style="{StaticResource Company.Hint}" Margin="0,0,10,12"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.Industry, TargetNullValue=—}" Style="{StaticResource Company.Value}" Margin="0,0,0,12"/>
<TextBlock Grid.Row="3" Text="Сайт:" Style="{StaticResource Company.Hint}" Margin="0,0,10,12"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Details.Website, TargetNullValue=—}" Style="{StaticResource Company.Value}" Margin="0,0,0,12"/></Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource Company.Card}"><StackPanel><TextBlock Text="Заметки" Style="{StaticResource Company.Heading}"/>
      <TextBlock Text="{Binding Details.Notes, TargetNullValue=Заметок пока нет.}" Style="{StaticResource Company.Value}"/>
     </StackPanel></Border>
    </StackPanel>
    <Border Style="{StaticResource Company.Card}" Visibility="{Binding IsEditing, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
     <StackPanel>
      <StackPanel IsEnabled="{Binding CanChangeDraft}">
       <TextBlock Text="Основная информация" Style="{StaticResource Company.Heading}"/>
       <TextBlock Text="* Обязательное поле. Остальные сведения можно добавить позже." Style="{StaticResource Company.Hint}" Margin="0,0,0,16"/>
<StackPanel Margin="0,0,0,16"><TextBlock Text="Название *" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Название компании"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="Юридическое название" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Юридическое название компании"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="Отрасль" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding Industry, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Отрасль компании"/></StackPanel>
       <TextBlock Text="Бизнес-статус" Style="{StaticResource Company.Label}"/>
       <ComboBox ItemsSource="{Binding StatusChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Status}" Style="{StaticResource Task.Input.Combo}" AutomationProperties.Name="Бизнес-статус компании" Margin="0,0,0,20"/>
       <TextBlock Text="Реквизиты и сайт" Style="{StaticResource Company.Heading}"/>
<StackPanel Margin="0,0,0,16"><TextBlock Text="Налоговый идентификатор" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding TaxIdentifier, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Налоговый идентификатор компании"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="Сайт" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Сайт компании"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="Заметки" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="20000" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Заметки компании" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200" VerticalScrollBarVisibility="Auto"/></StackPanel>
      </StackPanel>
      <WrapPanel Margin="0,4,0,0">
       <Button Content="Сохранить компанию" Command="{Binding SaveCommand}" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="SaveCompanyButton" Margin="0,0,8,8"/>
       <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,0,8"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <StackPanel Style="{StaticResource Company.ReadMode}">
     <Border Style="{StaticResource Company.Card}"><StackPanel>
      <DockPanel Margin="0,0,0,16"><TextBlock DockPanel.Dock="Right" Text="{Binding RelatedContacts.Count}" Style="{StaticResource Company.Hint}" Margin="12,0,0,0" AutomationProperties.Name="Количество контактных лиц"/><TextBlock Text="Контактные лица" Style="{StaticResource Company.Heading}" Margin="0"/></DockPanel>
      <TextBlock Text="Контакты, связанные с компанией, и их роли." Style="{StaticResource Company.Hint}"/>
      <TextBlock Text="Связанных контактов пока нет." Margin="0,12" TextWrapping="Wrap">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding RelatedContacts.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
      <ItemsControl ItemsSource="{Binding RelatedContacts}" AutomationProperties.AutomationId="CompanyContacts">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Company.Card}" Padding="0,14" Margin="0"><StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource Task.Icon.Contacts}" Width="17" Height="17" Stretch="Uniform" Fill="{DynamicResource Task.Brush.Text.Secondary}" VerticalAlignment="Top" Margin="0,3,0,0"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="{DynamicResource Task.Font.Size.Body}" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid>
         <TextBlock Text="{Binding JobTitle}" Style="{StaticResource Company.Value}" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding DepartmentName}" Style="{StaticResource Company.Hint}"/>
         <Border Style="{StaticResource Task.Semantic.StatusPill}" Margin="0,4,0,8" Visibility="{Binding IsPrimary, Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="{Binding PrimaryLabel}" FontWeight="SemiBold"/></Border>
         <WrapPanel><TextBlock Text="{Binding ValidFrom, StringFormat=Начало: {0}, TargetNullValue=Начало: не указано}" Style="{StaticResource Company.Hint}" Margin="0,0,16,6"/>
          <TextBlock Text="{Binding ValidTo, StringFormat=Окончание: {0}, TargetNullValue=Окончание: не указано}" Style="{StaticResource Company.Hint}"/></WrapPanel>
         <WrapPanel Margin="0,8,0,0">
          <Button Content="Открыть контакт" Command="{Binding DataContext.OpenContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,8,8"/>
          <Button Content="Удалить связь" Command="{Binding DataContext.UnlinkContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,0,8" ToolTip="Убрать связь с компанией. Сам контакт останется."/>
         </WrapPanel>
        </StackPanel></Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Expander Header="Добавить существующий контакт" Margin="0,16,0,0" IsEnabled="{Binding CanChangeLinks}" AutomationProperties.Name="Добавить существующий контакт">
       <StackPanel Margin="0,16,0,0">
        <TextBlock Text="Поиск контакта" Style="{StaticResource Company.Label}"/>
        <TextBox Text="{Binding ContactQuery, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Имя контактного лица">
         <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchContactsCommand}"/></TextBox.InputBindings>
        </TextBox>
        <WrapPanel Margin="0,8"><Button Content="Найти контакт" Command="{Binding SearchContactsCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,8,8"/>
         <Button Content="Ещё контакты" Command="{Binding MoreContactsCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,0,8"/></WrapPanel>
        <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsSearchingContacts, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
        <ListBox ItemsSource="{Binding ContactCandidates}" SelectedItem="{Binding SelectedCandidate}" DisplayMemberPath="DisplayName" MaxHeight="160" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Task.DataList.Item}" AutomationProperties.Name="Доступные контакты" Margin="0,0,0,16"/>
<StackPanel Margin="0,0,0,16"><TextBlock Text="Должность" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Должность компании"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="Подразделение" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Подразделение компании"/></StackPanel>
        <CheckBox Content="Основной контакт" IsChecked="{Binding IsPrimary}" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,0,16"/>
        <TextBlock Text="Период связи" Style="{StaticResource Company.Label}"/>
        <TextBlock Text="Необязательно. Формат даты: ГГГГ-ММ-ДД." Style="{StaticResource Company.Hint}"/>
<StackPanel Margin="0,0,0,16"><TextBlock Text="Начало связи" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding ValidFrom, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Начало связи компании"/></StackPanel><StackPanel Margin="0,0,0,16"><TextBlock Text="Окончание связи" Style="{StaticResource Company.Label}"/>
<TextBox Text="{Binding ValidTo, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Окончание связи компании"/></StackPanel>
        <Button Content="Добавить связь" Command="{Binding LinkContactCommand}" Style="{StaticResource Task.Button.Primary}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Expander>
     </StackPanel></Border>
     <views:InteractionsView DataContext="{Binding Interactions}"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer></Grid>
 </Grid>
</UserControl>
