<UserControl x:Class="Task.Desktop.Views.TaskCardEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,10,0,5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource Task.Input.Combo}"><Setter Property="DisplayMemberPath" Value="Name"/></Style>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock Text="Описание"/>
  <TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto" MaxLength="50000" AutomationProperties.Name="Описание задачи" AutomationProperties.AutomationId="TaskDescriptionTextBox"/>
  <TextBlock Text="Дата без времени (ДД.ММ.ГГГГ). Доступна, когда поле «Начало» пустое."/>
  <TextBox Text="{Binding Date,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDateOnly}" AutomationProperties.Name="Дата задачи без времени"/>
  <TextBlock Text="Длительность, минут"/>
  <TextBox Text="{Binding Duration,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Плановая длительность"/>
  <TextBlock Text="Поиск сотрудников, проектов и контактов"/>
  <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск связей задачи"/>
  <Button Content="Найти" Command="{Binding DataContext.Tasks.LoadOptionsCommand,RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Task.Button.Secondary}" Margin="0,6,0,0"/>
  <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="Проект"/><ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" AutomationProperties.Name="Проект задачи"/>
  <TextBlock Text="Родительская задача (один уровень)"/><ComboBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding Parent}" AutomationProperties.Name="Родительская задача"/>
  <TextBlock Text="Постановщик"/><ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding Requester}" AutomationProperties.Name="Постановщик задачи"/>
  <TextBlock Text="Контакт или контрагент"/><ComboBox ItemsSource="{Binding Counterparties}" SelectedItem="{Binding Counterparty}" AutomationProperties.Name="Контрагент задачи"/>
  <TextBlock Text="Исполнители"/>
  <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Assignees}" IsEnabled="{Binding CanAssign}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <TextBlock Text="Наблюдатели"/>
  <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Watchers}" IsEnabled="{Binding CanWatch}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </StackPanel>
</UserControl>
