<UserControl x:Class="Task.Desktop.Views.EmployeePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Выбор сотрудника" KeyboardNavigation.TabNavigation="Continue"
             Background="{DynamicResource Task.Brush.Surface.Base}" Foreground="{DynamicResource Task.Brush.Text.Primary}"
             Loaded="OnLoaded" Unloaded="OnUnloaded" DataContextChanged="OnDataContextChanged"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="_Имя сотрудника" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,4"/>
        <DockPanel Grid.Row="1" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="_Найти" Command="{Binding SearchCommand}"
                    Style="{DynamicResource Task.Button.Secondary}" Margin="8,0,0,0"
                    AutomationProperties.Name="Найти сотрудника"/>
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="2000" IsEnabled="{Binding CanQuery}" Style="{DynamicResource Task.Input.Text}"
                     AutomationProperties.Name="Имя сотрудника для поиска" AutomationProperties.AutomationId="EmployeePickerSearch"/>
        </DockPanel>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="EmployeePickerStatus"/>
        <ListBox Grid.Row="3" x:Name="ResultsList" MinHeight="100" MaxHeight="320"
                 ItemsSource="{Binding Results}" SelectedItem="{Binding Candidate}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Найденные сотрудники" AutomationProperties.AutomationId="EmployeePickerResults">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Login}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding JobTitle}" Foreground="{DynamicResource Task.Brush.Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
            <Button Content="_Ещё" Command="{Binding LoadMoreCommand}" Style="{DynamicResource Task.Button.Secondary}"
                    AutomationProperties.Name="Загрузить следующих сотрудников" Margin="0,0,8,8"/>
            <Button Content="_Повторить" Command="{Binding RetryCommand}" Style="{DynamicResource Task.Button.Secondary}"
                    AutomationProperties.Name="Повторить запрос сотрудников" Margin="0,0,8,8"/>
        </WrapPanel>
        <StackPanel Grid.Row="5">
            <TextBlock Text="Выбранный сотрудник" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SelectedEmployee.DisplayName, TargetNullValue=Не выбран}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedEmployee.Login}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8,0,0">
                <Button Content="_Выбрать" Command="{Binding ConfirmCommand}" Style="{DynamicResource Task.Button.Primary}"
                        AutomationProperties.Name="Подтвердить выбор сотрудника" Margin="0,0,8,8"/>
                <Button Content="О_чистить" Command="{Binding ClearCommand}" Style="{DynamicResource Task.Button.Secondary}"
                        AutomationProperties.Name="Очистить выбранного сотрудника" Margin="0,0,8,8"/>
                <Button Content="_Отмена" Command="{Binding CancelCommand}" Click="OnCancelClick"
                        Style="{DynamicResource Task.Button.Secondary}" AutomationProperties.Name="Отменить выбор сотрудника" Margin="0,0,0,8"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
