<UserControl x:Class="Task.Desktop.Views.WorkdayFooter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Loaded="OnVisible" Unloaded="OnUnloaded" IsVisibleChanged="OnVisibilityChanged" DataContextChanged="OnContextChanged">
 <UserControl.Style><Style TargetType="UserControl"><Style.Triggers>
  <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
 </Style.Triggers></Style></UserControl.Style>
 <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Task.Brush.Border.Default}" Padding="6,5" Margin="12,0">
  <StackPanel>
   <WrapPanel>
    <Expander x:Name="DayCard" Header="{Binding DayHeading}" Margin="0,0,16,2" Expanded="OnDayOpened"
              AutomationProperties.AutomationId="WorkdaySummary" MaxWidth="410">
     <Border Padding="8,4,8,6" Background="{DynamicResource Task.Brush.Surface.Base}" CornerRadius="6">
      <StackPanel>
       <TextBlock Text="{Binding DayText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
       <DockPanel Margin="0,5,0,0">
        <Button x:Name="Cheer" DockPanel.Dock="Left" Content="★  Ура" Padding="8,2" MinHeight="26"
                AutomationProperties.Name="Ура" AutomationProperties.AutomationId="WorkdayCheer" Click="OnCheer"/>
        <Canvas x:Name="Confetti" Width="104" Height="26" ClipToBounds="True" HorizontalAlignment="Left"
                IsHitTestVisible="False" Focusable="False" Margin="5,0,0,0"/>
       </DockPanel>
      </StackPanel>
     </Border>
    </Expander>
    <Expander x:Name="WeekCard" Header="{Binding WeekHeading}" Expanded="OnWeekOpened" MaxWidth="370" Margin="0,0,0,2"
              AutomationProperties.AutomationId="WorkweekCard">
     <TextBlock Text="{Binding WeekText}" Margin="8,4" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Expander>
   </WrapPanel>
   <DockPanel LastChildFill="True" Margin="0,4,0,0">
    <Button DockPanel.Dock="Right" Content="Другая фраза" Command="{Binding AnotherPhraseCommand}" Padding="8,2" Margin="8,0,0,0"
            AutomationProperties.AutomationId="WorkdayNextPhrase" VerticalAlignment="Center"/>
    <Border Background="#F7F1E6" CornerRadius="8" Padding="16,10">
     <Border.Style>
      <Style TargetType="Border">
       <Style.Triggers>
        <DataTrigger Binding="{Binding Phrase}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
       <Rectangle Width="28" Height="1" Fill="#A68A6C" VerticalAlignment="Center"/>
       <TextBlock Text="Цитата дня" FontWeight="SemiBold" Foreground="#6C4529" Margin="10,0"/>
       <Rectangle Width="28" Height="1" Fill="#A68A6C" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="{Binding Phrase, StringFormat='«{0}»'}" TextWrapping="Wrap" TextAlignment="Center"
                 FontFamily="Georgia" FontStyle="Italic" FontSize="16" Foreground="#282019"
                 AutomationProperties.AutomationId="WorkdayPhrase"/>
     </StackPanel>
    </Border>
   </DockPanel>
  </StackPanel>
 </Border>
</UserControl>
