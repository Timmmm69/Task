<UserControl x:Class="Task.Desktop.Views.PersonalSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Task.Desktop.Views">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Management.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBox" BasedOn="{StaticResource Personal.Airbnb.Input}"><Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="#A32B17"/><Setter Property="ToolTip" Value="Проверьте введённое значение"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabItem"><Setter Property="MinWidth" Value="145"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="#717171"/><Setter Property="Padding" Value="16,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" TextElement.FontWeight="Bold"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#222222"/><Setter Property="Foreground" Value="#222222"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="Background" Value="#F7F7F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="Параметры хранятся на этом компьютере. Изменения применятся после сохранения." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,0,0,14"/>
  <StackPanel Grid.Row="1"><TextBlock x:Name="InputError" Text="Введите число в выделенном поле. Изменения ещё не сохранены." Foreground="#A32B17" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/><Border CornerRadius="12" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasFeedback,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F7F7F7"/><Style.Triggers><DataTrigger Binding="{Binding FeedbackKind}" Value="Error"><Setter Property="Background" Value="#FFF0EB"/></DataTrigger><DataTrigger Binding="{Binding FeedbackKind}" Value="Warning"><Setter Property="Background" Value="#FFF0EB"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border></StackPanel>
  <TabControl x:Name="SettingsTabs" Grid.Row="2" Background="White" BorderThickness="0"><TabControl.Template><ControlTemplate TargetType="TabControl"><DockPanel><WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,20"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></DockPanel></ControlTemplate></TabControl.Template>
<TabItem Header="Основные"><DockPanel LastChildFill="True">
      <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel>
       <TextBlock Text="{Binding ProfileSettingsError}" Style="{StaticResource Personal.Validation}" Margin="0,0,0,10"/>
       <Button x:Name="SaveProfile" Content="Сохранить параметры" Command="{Binding SaveUserSettingsCommand}" Style="{StaticResource Management.Primary}" HorizontalAlignment="Left"/>
      </StackPanel></Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
       <Border Style="{StaticResource Management.Card}" Margin="0,0,0,16"
               DataContext="{Binding DataContext.WorkPreferences, RelativeSource={RelativeSource AncestorType=Window}}"
               Visibility="{Binding IsReady, Converter={StaticResource Task.BooleanToVisibilityConverter}}">
        <StackPanel MaxWidth="300" HorizontalAlignment="Left">
         <TextBlock Text="Стартовый раздел" Style="{StaticResource Management.Section}"/>
         <ComboBox ItemsSource="{Binding StartupSections}" SelectedItem="{Binding StartupSection}" DisplayMemberPath="Title"
                   AutomationProperties.Name="Стартовый раздел" AutomationProperties.AutomationId="StartupSection"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Management.Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Календарь и рабочий день" Style="{StaticResource Management.Section}"/><WrapPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Язык" TextWrapping="Wrap" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding UserLanguage}" AutomationProperties.Name="Язык"/></StackPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Первый день недели" TextWrapping="Wrap" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding WeekdayChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding FirstDayOfWeek}" AutomationProperties.Name="Первый день недели"/></StackPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Формат времени" TextWrapping="Wrap" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding TimeFormatChoices}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding UserTimeFormat}" AutomationProperties.Name="Формат времени"/></StackPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Начало дня · ЧЧ:ММ" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding WorkdayStartDisplay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="Начало дня · ЧЧ:ММ"/></StackPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Конец дня · ЧЧ:ММ" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding WorkdayEndDisplay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="Конец дня · ЧЧ:ММ"/></StackPanel></WrapPanel></StackPanel></Border><Border Style="{StaticResource Management.Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Задачи и напоминания" Style="{StaticResource Management.Section}"/><WrapPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Длительность задачи, мин" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding DefaultTaskDurationMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="Длительность задачи, мин"/></StackPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Напоминать за, мин" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding DefaultReminderOffsetMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="Напоминать за, мин"/></StackPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Срок без времени · ЧЧ:ММ" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding ReminderTimeDisplay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="Срок без времени · ЧЧ:ММ"/></StackPanel></WrapPanel></StackPanel></Border><Border Style="{StaticResource Management.Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Файлы и запуск" Style="{StaticResource Management.Section}"/><CheckBox IsChecked="{Binding AutostartEnabled}"><TextBlock Text="Запускать «Варава Дент» вместе с Windows" TextWrapping="Wrap"/></CheckBox><CheckBox IsChecked="{Binding AllowLocalPaths}"><TextBlock Text="Разрешать локальные пути" TextWrapping="Wrap"/></CheckBox><CheckBox IsChecked="{Binding ConfirmCatalogDelete}"><TextBlock Text="Подтверждать удаление записей каталога" TextWrapping="Wrap"/></CheckBox><StackPanel MaxWidth="400" HorizontalAlignment="Left" Margin="0,16,0,0"><TextBlock Text="Если файл недоступен" Margin="0,0,0,7"/><ComboBox SelectedValue="{Binding MissingFileBehavior}" SelectedValuePath="Tag" AutomationProperties.Name="Если файл недоступен"><ComboBoxItem Content="Показать действия" Tag="show_actions"/><ComboBoxItem Content="Оставить неактивным" Tag="keep_inactive"/><ComboBoxItem Content="Предложить новый путь" Tag="prompt_relink"/></ComboBox></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
     </DockPanel></TabItem><TabItem Header="Уведомления"><DockPanel LastChildFill="True">
      <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel>
       <TextBlock Text="{Binding NotificationSettingsError}" Style="{StaticResource Personal.Validation}" Margin="0,0,0,10"/>
       <Button x:Name="SaveNotifications" Content="Сохранить уведомления" Command="{Binding SaveNotificationPreferencesCommand}" Style="{StaticResource Management.Primary}" HorizontalAlignment="Left"/>
      </StackPanel></Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel><Border Style="{StaticResource Management.Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Каналы уведомлений" Style="{StaticResource Management.Section}"/><CheckBox IsChecked="{Binding NotificationsEnabled}"><TextBlock Text="Получать уведомления" TextWrapping="Wrap"/></CheckBox><StackPanel IsEnabled="{Binding NotificationsEnabled}" Margin="30,0,0,0"><CheckBox IsChecked="{Binding DesktopNotificationsEnabled}"><TextBlock Text="Показывать уведомления на рабочем столе" TextWrapping="Wrap"/></CheckBox><CheckBox IsChecked="{Binding NotificationSoundEnabled}"><TextBlock Text="Воспроизводить звук" TextWrapping="Wrap"/></CheckBox></StackPanel><WrapPanel Margin="0,16,0,0"><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Отсрочка по умолчанию, мин" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding DefaultSnoozeMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="Отсрочка по умолчанию, мин"/></StackPanel></WrapPanel></StackPanel></Border><Border Style="{StaticResource Management.Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Не беспокоить" Style="{StaticResource Management.Section}"/><TextBlock Text="Укажите период и часовой пояс. Чтобы отключить режим, очистите все три поля." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,0,0,18"/><WrapPanel><StackPanel Width="130" Margin="0,0,18,16"><TextBlock Text="С · ЧЧ:ММ" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding QuietStartDisplay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="С · ЧЧ:ММ"/></StackPanel><StackPanel Width="130" Margin="0,0,18,16"><TextBlock Text="До · ЧЧ:ММ" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding QuietEndDisplay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="До · ЧЧ:ММ"/></StackPanel><StackPanel Width="220" Margin="0,0,18,16"><TextBlock Text="Часовой пояс" TextWrapping="Wrap" Margin="0,0,0,7"/><TextBox Text="{Binding QuietHoursTimeZone,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}" MaxLength="100" AutomationProperties.Name="Часовой пояс"/></StackPanel></WrapPanel></StackPanel></Border><TextBlock Text="После полного выхода из приложения уведомления появятся при следующем запуске." Style="{StaticResource Personal.Airbnb.Muted}" Margin="2,0,0,12"/></StackPanel></ScrollViewer>
     </DockPanel></TabItem><TabItem Header="Данные и фон"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Border Style="{StaticResource Management.Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Резервная копия личного пространства" Style="{StaticResource Management.Section}"/><TextBlock Text="Задачи, проекты, расписание, контакты и ссылки. Сами файлы каталога копируйте отдельно." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,0,0,18"/><WrapPanel><Button Content="Создать копию" Click="OnBackup" Margin="0,0,10,10" AutomationProperties.AutomationId="PersonalBackupButton"/><Button Content="Восстановить из копии…" Click="OnRestore" Margin="0,0,0,10" AutomationProperties.AutomationId="PersonalRestoreButton"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Management.Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Работа в фоне" Style="{StaticResource Management.Section}"/><TextBlock Text="Приложение продолжит работать без открытого окна. Вернуть окно можно значком в области уведомлений Windows." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,0,0,18"/><Button Content="Оставить приложение в фоне" Click="OnBackground" HorizontalAlignment="Left" IsEnabled="{Binding DataContext.BackgroundAvailable,RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel></Border>
      <Border Style="{StaticResource Management.Card}" Margin="0,0,0,16">
       <views:AnalyticsPrivacyView/>
      </Border>
     </StackPanel></ScrollViewer></TabItem>
 </TabControl></Grid></UserControl>