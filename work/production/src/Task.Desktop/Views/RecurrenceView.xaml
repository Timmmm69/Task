<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Task.Desktop.Views.RecurrenceView" x:Name="Root" AutomationProperties.Name="Повторяющиеся задачи" FontFamily="{DynamicResource Task.Font.Family}" FontSize="{DynamicResource Task.Font.Size.Body}" Foreground="{DynamicResource Task.Brush.Text.Primary}" UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.AutomationId="RecurrenceScreen">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource Task.Input.Text}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource Task.Input.Combo}"/>
        <Style x:Key="Recurrence.Card" TargetType="Border" BasedOn="{StaticResource Task.Surface.Base}">
            <Setter Property="Background" Value="{DynamicResource Task.Brush.Surface.Base}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Task.Brush.Border.Default}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="Recurrence.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource Task.Brush.Text.Primary}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Task.FocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="20" Height="20" VerticalAlignment="Center" Background="{DynamicResource Task.Brush.Surface.Base}" BorderBrush="{DynamicResource Task.Brush.Border.Strong}" BorderThickness="1" CornerRadius="4">
                                <Path x:Name="Mark" Data="M 4,9 L 8,13 L 15,5" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Task.Brush.Brand.Primary}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Task.Brush.Brand.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                                <Setter TargetName="Mark" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Recurrence.PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource Recurrence.Heading}">
            <Setter Property="Margin" Value="16,14"/>
            <Setter Property="FontSize" Value="{DynamicResource Task.Font.Size.Section}"/>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Task.Brush.Surface.Base}" CornerRadius="8" Padding="0" MaxWidth="1240" BorderBrush="{DynamicResource Task.Brush.Border.Default}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="20,16">
                <Button DockPanel.Dock="Right" Content="Закрыть" Command="{Binding CloseCommand}" Style="{StaticResource Task.Button.Secondary}"/>
                <TextBlock Text="Повторяющиеся задачи" FontWeight="SemiBold" TextWrapping="Wrap" Style="{StaticResource Task.Shell.PageTitle}"/>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="20,0,20,8">
                <ProgressBar Height="3" IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource Task.Progress.Indeterminate}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="Доступен просмотр. Изменение серий ограничено правами." TextWrapping="Wrap" Foreground="{DynamicResource Task.Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanManage}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
            <Grid Grid.Row="2" IsEnabled="{Binding CanInteract}" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="320"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=1050}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.RowSpan="2" Margin="12,0,12,12">
                    <TextBlock Text="Серии задач" Style="{StaticResource Recurrence.PanelTitle}" DockPanel.Dock="Top"/>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="Новая серия" Command="{Binding NewCommand}" Style="{StaticResource Task.Button.Primary}" Margin="0,0,6,6"/>
                        <Button Content="Обновить" Command="{Binding ReloadCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Серий пока нет. Создайте первую серию." TextWrapping="Wrap" Margin="8,16" Foreground="{DynamicResource Task.Brush.Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Series.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Series}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Серии задач" Style="{StaticResource Task.DataList}" ItemContainerStyle="{StaticResource Task.DataList.Item}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Task.Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <Grid Grid.Column="1" Background="{DynamicResource Task.Brush.Surface.Subtle}" AutomationProperties.AutomationId="RecurrenceEditorPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Правило серии" Style="{StaticResource Recurrence.PanelTitle}"/>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Grid.Row="1">
                        <StackPanel>
                            <StackPanel DataContext="{Binding Editor}" IsEnabled="{Binding DataContext.CanManage, ElementName=Root}">
                                <Border Style="{StaticResource Recurrence.Card}">
                                    <StackPanel>
                                        <TextBlock Text="Задача" Style="{StaticResource Recurrence.Heading}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Название задачи" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Название повторяющейся задачи"/>
                                        <TextBlock Text="Описание" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" MaxHeight="100" Margin="0,4,0,10" AutomationProperties.Name="Описание задачи"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Recurrence.Card}">
                                    <StackPanel>
                                        <TextBlock Text="Правило повторения" Style="{StaticResource Recurrence.Heading}" TextWrapping="Wrap"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Повторять" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{Binding Frequencies}" SelectedValuePath="Code" DisplayMemberPath="Label" SelectedValue="{Binding Frequency}" Margin="0,4,0,10" AutomationProperties.Name="Частота повторения"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Каждые N" TextWrapping="Wrap"/>
                                                <TextBox Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Интервал повторения"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Frequency}" Value="daily">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Frequency}" Value="weekly">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Дни недели через запятую: 1 — пн, 7 — вс" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding Weekdays, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Дни недели"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Frequency}" Value="monthly">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Frequency}" Value="yearly">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Дни месяца: 1–31; −1 — последний день" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding MonthDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Дни месяца"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Frequency}" Value="yearly">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Месяц года (1–12, для ежегодного повтора)" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Месяц года"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Recurrence.Card}">
                                    <StackPanel>
                                        <TextBlock Text="Дата и время" Style="{StaticResource Recurrence.Heading}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Начало серии" TextWrapping="Wrap"/>
                                        <DatePicker SelectedDate="{Binding StartDate}" Margin="0,4,0,10" AutomationProperties.Name="Начало серии"/>
                                        <CheckBox Content="Весь день" IsChecked="{Binding IsAllDay}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Начало (ЧЧ:ММ)" TextWrapping="Wrap"/>
                                                <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Время начала"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Длительность, минут" TextWrapping="Wrap"/>
                                                <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Длительность в минутах"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding TimeZoneText, StringFormat=Часовой пояс: {0}}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Recurrence.Card}">
                                    <StackPanel>
                                        <TextBlock Text="Окончание и приоритет" Style="{StaticResource Recurrence.Heading}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Когда завершить серию" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Terminations}" SelectedValuePath="Code" DisplayMemberPath="Label" SelectedValue="{Binding Termination}" Margin="0,0,0,10" AutomationProperties.Name="Условие окончания"/>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Termination}" Value="until">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Последняя дата (если выбрано окончание по дате)" TextWrapping="Wrap"/>
                                            <DatePicker SelectedDate="{Binding UntilDate}" Margin="0,4,0,10" AutomationProperties.Name="Окончание серии"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Termination}" Value="count">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Число повторений (если выбрано количество)" TextWrapping="Wrap"/>
                                            <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" AutomationProperties.Name="Число повторений"/>
                                        </StackPanel>
                                        <TextBlock Text="Приоритет" TextWrapping="Wrap"/>
                                        <ComboBox ItemsSource="{Binding Priorities}" SelectedValuePath="Code" DisplayMemberPath="Label" SelectedValue="{Binding Priority}" Margin="0,4,0,12" AutomationProperties.Name="Приоритет"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Style="{StaticResource Task.Shell.FooterSurface}" Padding="16,12" Grid.Row="2">
                        <WrapPanel>
                            <Button Content="Предпросмотр" Command="{Binding PreviewCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,8,8"/>
                            <Button Content="Сохранить правило серии" Command="{Binding SaveCommand}" Style="{StaticResource Task.Button.Primary}" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </Border>
                </Grid>
                <Border BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Task.Brush.Border.Default}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Grid.Column" Value="2"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, ElementName=Root, Converter={StaticResource Task.WindowWidthAtLeastConverter}, ConverterParameter=1050}" Value="False">
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="MaxHeight" Value="280"/>
                                    <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel AutomationProperties.AutomationId="RecurrencePreviewPanel">
                            <TextBlock Text="Предпросмотр и действия" Style="{StaticResource Recurrence.PanelTitle}"/>
                            <Border Style="{StaticResource Recurrence.Card}">
                                <StackPanel>
                                    <TextBlock Text="Предпросмотр и сохранение" Style="{StaticResource Recurrence.Heading}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Правило применяется ко всей серии. Завершённые и отдельно изменённые задачи сохраняются." TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <TextBlock Text="Нажмите «Предпросмотр», чтобы увидеть ближайшие даты повторений." TextWrapping="Wrap" Foreground="{DynamicResource Task.Brush.Text.Secondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding PreviewText}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Recurrence.Card}">
                                <StackPanel>
                                    <TextBlock Text="Изменить созданные задачи" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="Выберите задачу и область. Будут применены название, приоритет и длительность из формы." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding Occurrences}" SelectedItem="{Binding SelectedOccurrence}" Margin="0,0,0,8" AutomationProperties.Name="Экземпляр серии">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding LocalDate, StringFormat=dd.MM.yyyy}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding Title}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Область изменения" Margin="0,4,0,4"/>
                                    <ComboBox ItemsSource="{Binding Scopes}" SelectedValuePath="Code" DisplayMemberPath="Label" SelectedValue="{Binding Scope}" Margin="0,0,0,8" AutomationProperties.Name="Область изменения"/>
                                    <Button Content="Применить к выбранной области" Command="{Binding ApplyCommand}" Style="{StaticResource Task.Button.Secondary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Recurrence.Card}">
                                <StackPanel>
                                    <TextBlock Text="Горизонт расписания" Style="{StaticResource Recurrence.Heading}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Создать задачи до даты" Margin="0,12,0,4" TextWrapping="Wrap"/>
                                    <DatePicker SelectedDate="{Binding ThroughDate}" Margin="0,0,0,8" AutomationProperties.Name="Создать задачи до даты"/>
                                    <TextBlock Text="Расширяйте горизонт шагами до одного года. Повторный запрос не создаёт дубликаты." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Button Content="Расширить расписание" Command="{Binding GenerateCommand}" Style="{StaticResource Task.Button.Secondary}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Recurrence.Card}">
                                <StackPanel>
                                    <TextBlock Text="Управление серией" Style="{StaticResource Recurrence.Heading}" TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <Button Content="Приостановить" Command="{Binding PauseCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,6,6"/>
                                        <Button Content="Возобновить" Command="{Binding ResumeCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,6,6"/>
                                        <Button Content="Отменить серию" Command="{Binding CancelSeriesCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
