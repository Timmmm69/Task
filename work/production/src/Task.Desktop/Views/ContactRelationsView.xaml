<UserControl x:Class="Task.Desktop.Views.ContactRelationsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="0,16,0,0">
  <TextBlock Text="{Binding RelationAccessMessage}" TextWrapping="Wrap"/>
  <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsSaving, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  <TextBlock Text="Способы связи" FontSize="18" FontWeight="SemiBold" Margin="0,8"/>
  <TextBlock Text="Способы связи пока не добавлены." Visibility="{Binding ChannelsEmpty, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  <ItemsControl ItemsSource="{Binding Channels}" AutomationProperties.AutomationId="ContactChannels">
   <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6">
    <WrapPanel><TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding PrimaryLabel}" Margin="8,0"/></WrapPanel>
    <TextBlock Text="{Binding Value}" TextWrapping="Wrap"/><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
    <WrapPanel>
     <Button Content="Изменить канал" Command="{Binding DataContext.EditChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource Task.Button.Secondary}"/>
     <Button Content="Удалить канал" Command="{Binding DataContext.RemoveChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0" Style="{StaticResource Task.Button.Secondary}"/>
    </WrapPanel>
   </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Button Content="Добавить канал" Command="{Binding AddChannelCommand}" HorizontalAlignment="Left" Margin="0,8" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="AddContactChannel"/>
  <StackPanel Visibility="{Binding HasChannelDraft, Converter={StaticResource Task.BooleanToVisibilityConverter}}" IsEnabled="{Binding CanChangeRelationDraft}">
   <TextBlock Text="Тип канала"/><ComboBox ItemsSource="{Binding ChannelTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ChannelDraft.Type}" AutomationProperties.Name="Тип канала"/>
   <TextBlock Text="Значение"/><TextBox Text="{Binding ChannelDraft.Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Значение канала"/>
   <TextBlock Text="Подпись (необязательно)"/><TextBox Text="{Binding ChannelDraft.Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Подпись канала"/>
   <CheckBox Content="Основной канал" IsChecked="{Binding ChannelDraft.IsPrimary}" Margin="0,8"/>
  </StackPanel>
  <StackPanel Visibility="{Binding IsConfirmingChannelDelete, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="0,8">
   <TextBlock Text="Удалить этот способ связи?" TextWrapping="Wrap"/>
   <Button Content="Подтвердить удаление" Command="{Binding ConfirmChannelDeleteCommand}" HorizontalAlignment="Left" Style="{StaticResource Task.Button.Secondary}"/>
  </StackPanel>
  <TextBlock Text="Адреса" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
  <TextBlock Text="Адреса пока не добавлены." Visibility="{Binding AddressesEmpty, Converter={StaticResource Task.BooleanToVisibilityConverter}}"/>
  <ItemsControl ItemsSource="{Binding Addresses}" AutomationProperties.AutomationId="ContactAddresses">
   <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6">
    <WrapPanel><TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding PrimaryLabel}" Margin="8,0"/></WrapPanel>
    <TextBlock Text="{Binding FormattedAddress}" TextWrapping="Wrap"/><TextBlock Text="{Binding Parts}" TextWrapping="Wrap"/>
   </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Button Content="Добавить адрес" Command="{Binding AddAddressCommand}" HorizontalAlignment="Left" Margin="0,8" Style="{StaticResource Task.Button.Secondary}" AutomationProperties.AutomationId="AddContactAddress"/>
  <StackPanel Visibility="{Binding HasAddressDraft, Converter={StaticResource Task.BooleanToVisibilityConverter}}" IsEnabled="{Binding CanChangeRelationDraft}">
   <TextBlock Text="Тип адреса"/><ComboBox ItemsSource="{Binding AddressTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AddressDraft.Type}" AutomationProperties.Name="Тип адреса"/>
   <TextBlock Text="Полный адрес (обязательно)"/><TextBox Text="{Binding AddressDraft.Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="120" VerticalScrollBarVisibility="Auto" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Полный адрес"/>
   <TextBlock Text="Код страны (2 символа, необязательно)"/><TextBox Text="{Binding AddressDraft.Country, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Код страны"/>
   <TextBlock Text="Регион (необязательно)"/><TextBox Text="{Binding AddressDraft.Region, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Регион"/>
   <TextBlock Text="Город (необязательно)"/><TextBox Text="{Binding AddressDraft.City, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Город"/>
   <TextBlock Text="Улица (необязательно)"/><TextBox Text="{Binding AddressDraft.Street, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Улица"/>
   <TextBlock Text="Индекс (необязательно)"/><TextBox Text="{Binding AddressDraft.Postal, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Style="{StaticResource Task.Input.Text}" AutomationProperties.Name="Индекс"/>
   <CheckBox Content="Основной адрес" IsChecked="{Binding AddressDraft.IsPrimary}" Margin="0,8"/>
  </StackPanel>
  <WrapPanel Visibility="{Binding HasRelationDraft, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="0,8">
   <Button Content="{Binding RelationSaveLabel}" Command="{Binding SaveRelationCommand}" Visibility="{Binding HasEditableRelationDraft, Converter={StaticResource Task.BooleanToVisibilityConverter}}" Style="{StaticResource Task.Button.Primary}" AutomationProperties.AutomationId="SaveContactRelation"/>
   <Button Content="Отмена" Command="{Binding CancelRelationCommand}" Style="{StaticResource Task.Button.Secondary}" Margin="8,0"/>
  </WrapPanel>
 </StackPanel>
</UserControl>
