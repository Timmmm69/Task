<UserControl x:Class="Task.Desktop.Views.PersonalRemindersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:state="clr-namespace:Task.Desktop.Infrastructure" Background="White" Foreground="#222222" FontSize="14" SizeChanged="OnSizeChanged" PreviewKeyDown="OnKeyDown">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Personal.Controls.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style TargetType="Button" BasedOn="{StaticResource Personal.Airbnb.Compact}"/>
 <Style TargetType="TextBox" BasedOn="{StaticResource Personal.Airbnb.Input}"/>
 <Style x:Key="Notification.Tab" TargetType="TabItem"><Setter Property="Padding" Value="18,10"/><Setter Property="FontSize" Value="15"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Chrome" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Background="White"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#222222"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#F7F7F7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid Margin="24,16,24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="IntroPanel" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Всё важное в одном месте" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="{Binding NotificationSummary}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Обновить уведомления"/></Grid>
  <TabControl x:Name="CenterTabs" Grid.Row="1" Background="White" BorderThickness="0" Padding="0,16,0,0" ItemContainerStyle="{StaticResource Notification.Tab}">
   <TabItem Header="Уведомления"><Grid TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="NotificationToolbar"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="NotificationSearch" Text="{Binding NotificationQuery,UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по заголовку, источнику и дате · Ctrl+F" AutomationProperties.Name="Поиск в уведомлениях" AutomationProperties.AutomationId="NotificationSearch"/><TextBlock Text="Поиск по уведомлениям" Foreground="#717171" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NotificationQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="1" Content="Прочитать все" Command="{Binding ReadAllNotificationsCommand}" Margin="12,0,0,0" ToolTip="Отметить все доставленные уведомления прочитанными"/><Button Grid.Column="2" Content="↻" Command="{Binding RefreshCommand}" Padding="12,8" Margin="8,0,0,0" AutomationProperties.Name="Обновить список"/></Grid>
    <StackPanel Grid.Row="1"><ToggleButton x:Name="FiltersToggle" Style="{StaticResource Task.Button.Toggle}" Content="Фильтры" Checked="OnFilterToggle" Unchecked="OnFilterToggle" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,8"/><StackPanel x:Name="FiltersPanel"><WrapPanel Margin="0,10,0,8">
     <ComboBox ItemsSource="{Binding NotificationReadFilters}" SelectedItem="{Binding NotificationReadFilter}" Width="140" Margin="0,0,8,6" AutomationProperties.Name="Прочитанность"/>
     <ComboBox ItemsSource="{Binding NotificationSourceFilters}" SelectedItem="{Binding NotificationSourceFilter}" Width="170" Margin="0,0,8,6" AutomationProperties.Name="Источник уведомления"/>
     <ComboBox ItemsSource="{Binding NotificationPeriodFilters}" SelectedItem="{Binding NotificationPeriodFilter}" Width="176" Margin="0,0,8,6" AutomationProperties.Name="Период доставки"/>
     <Button Content="Сбросить" Click="OnResetFilters" IsEnabled="{Binding HasNotificationFilters}" Padding="12,8" Margin="0,0,0,6"/>
    </WrapPanel><TextBlock Text="{Binding NotificationResultText}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/></StackPanel></StackPanel>
    <Grid Grid.Row="2" x:Name="BrowserGrid" SizeChanged="OnSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="330"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
     <Grid x:Name="ListRegion" Margin="0,0,20,0"><ListBox x:Name="NotificationsList" ItemsSource="{Binding VisibleNotifications}" SelectedItem="{Binding SelectedNotificationRow}" Style="{StaticResource Personal.Airbnb.VirtualList}" ItemContainerStyle="{StaticResource Personal.Airbnb.BrowserRow}" PreviewKeyDown="OnListKey" AutomationProperties.Name="Уведомления" AutomationProperties.AutomationId="PersonalNotificationsList">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Ellipse Width="7" Height="7" Fill="#FF385C" VerticalAlignment="Top" Margin="0,7,0,0"><Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers><DataTrigger Binding="{Binding Source.IsRead}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Metadata}" FontSize="12" Foreground="#717171" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/><TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="44" LineHeight="21"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Style.Triggers><DataTrigger Binding="{Binding Source.IsRead}" Value="True"><Setter Property="FontWeight" Value="Normal"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ReadLabel}" Foreground="#717171" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Border Background="#F7F7F7" CornerRadius="16" Padding="24" Visibility="{Binding ShowNotificationEmpty,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding NotificationEmptyTitle}" Style="{StaticResource Personal.Airbnb.Heading}"/><TextBlock Text="{Binding NotificationEmptyHint}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,12,0,0"/></StackPanel></Border>
     </Grid>
     <Border x:Name="DetailsPanel" Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="16" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><Button x:Name="BackToList" Content="← К списку" Click="OnBackToList" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,10"/><TextBlock x:Name="DetailHeading" Text="Уведомление" FontWeight="Bold" FontSize="18"/></StackPanel>
      <ScrollViewer x:Name="DetailBody" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,12"><StackPanel>
       <TextBlock Text="Выберите запись, чтобы прочитать её полностью и перейти к действиям."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Personal.Airbnb.Muted}"><Style.Triggers><DataTrigger Binding="{Binding HasNotificationSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       <StackPanel Visibility="{Binding HasNotificationSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
        <TextBlock Text="{Binding SelectedNotificationRow.Metadata}" Style="{StaticResource Personal.Airbnb.Muted}" FontSize="12" Margin="0,0,0,8"/>
        <TextBox x:Name="FullNotificationText" Text="{Binding SelectedNotification.Title,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="Auto" MinHeight="42" BorderThickness="0" Padding="0" Background="Transparent" Style="{x:Null}" FontSize="17" FontWeight="Bold" AutomationProperties.Name="Полный текст уведомления"/>
        <TextBlock Text="{Binding SelectedNotificationRow.ReadLabel}" Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,12,0,0"/>
       </StackPanel>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2" Visibility="{Binding HasNotificationSelection,Converter={StaticResource Task.BooleanToVisibilityConverter}}">
       <WrapPanel><Button Content="Открыть объект" Command="{Binding OpenNotificationCommand}" Background="{StaticResource Personal.Airbnb.Accent}" Foreground="White" BorderThickness="0" Margin="0,0,8,8"/><Button Content="Прочитано" Command="{Binding ReadNotificationCommand}" Margin="0,0,0,8"/></WrapPanel>
       <Expander Header="Напомнить позже" IsEnabled="{Binding CanSnoozeSelectedNotification}" Margin="0,8,0,0"><ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,0,0"><ComboBox ItemsSource="{Binding SnoozeChoices}" SelectedItem="{Binding SnoozeChoice}" AutomationProperties.Name="Время отсрочки"/><TextBox Text="{Binding SnoozeDateTime,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsCustomSnooze,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Margin="0,8,0,0" ToolTip="ДД.ММ.ГГГГ ЧЧ:ММ" AutomationProperties.Name="Дата и время отсрочки"/><Button Content="Отложить" Command="{Binding SnoozeNotificationCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Expander>
      </StackPanel>
     </Grid></Border>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="Напоминания"><Grid TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Напоминания приходят, пока приложение работает. Работа в фоне доступна в настройках." Style="{StaticResource Personal.Airbnb.Muted}" Margin="0,8,0,0"/>
   <Expander x:Name="ReminderCreator" Header="Новое напоминание" state:ViewState.Section="personal-reminders/v1/create" Margin="0,14,0,0" IsExpanded="False"><ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Task.Inspector.Panel}" Margin="0,8,0,0"><StackPanel>
    <WrapPanel><StackPanel Width="280" Margin="0,0,12,0"><TextBlock Text="Задача или событие" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" DisplayMemberPath="Title" AutomationProperties.AutomationId="PersonalReminderTarget"/></StackPanel><StackPanel Width="180"><TextBlock Text="Когда напомнить" Style="{StaticResource Personal.Label}"/><ComboBox ItemsSource="{Binding Triggers}" SelectedItem="{Binding Trigger}" DisplayMemberPath="Name"/></StackPanel></WrapPanel>
    <WrapPanel><StackPanel Width="100" Margin="0,0,12,0" Visibility="{Binding IsRelativeReminder,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="За минут" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding OffsetMinutes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="240" Visibility="{Binding IsAbsoluteReminder,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><TextBlock Text="Дата и время" Style="{StaticResource Personal.Label}"/><TextBox Text="{Binding AbsoluteTime,UpdateSourceTrigger=PropertyChanged}" ToolTip="ДД.ММ.ГГГГ ЧЧ:ММ · местное время"/><TextBlock Text="ДД.ММ.ГГГГ ЧЧ:ММ" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,4,0,0"/></StackPanel><Button Content="Добавить напоминание" Command="{Binding AddReminderCommand}" Style="{StaticResource Personal.Airbnb.Pill}" Background="{StaticResource Personal.Airbnb.Accent}" Foreground="White" VerticalAlignment="Bottom" Margin="12,12,0,0" AutomationProperties.AutomationId="PersonalAddReminder"/></WrapPanel>
   </StackPanel></Border></ScrollViewer></Expander>
</StackPanel>   <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Напоминания" Style="{StaticResource Task.State.Title}" Margin="0,0,0,12"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}" Style="{StaticResource Personal.Airbnb.VirtualList}" ItemContainerStyle="{StaticResource Personal.Airbnb.BrowserRow}" AutomationProperties.Name="Напоминания" AutomationProperties.AutomationId="PersonalRemindersList"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,12"><TextBlock Text="{Binding Title}" Foreground="#222222" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding DueText}" Style="{StaticResource Task.State.Body}" Margin="0,4,0,0"/><TextBlock Text="{Binding State}" Style="{StaticResource Task.Inspector.FactLabel}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="1"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Task.State.Panel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Reminders.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><TextBlock Text="Напоминаний пока нет" Style="{StaticResource Task.State.Title}"/><TextBlock Text="Добавьте напоминание о задаче или событии." Style="{StaticResource Task.State.Body}" Margin="0,8,0,0"/></StackPanel></Border>
    <Button Grid.Row="2" Content="Отменить напоминание" Command="{Binding CancelReminderCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </Grid>
</Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="Обновляем уведомления…" Visibility="{Binding IsBusy,Converter={StaticResource Task.BooleanToVisibilityConverter}}" Foreground="#717171" AutomationProperties.LiveSetting="Polite"/>
   <Border Background="#FFF4F1" CornerRadius="12" Padding="12" Visibility="{Binding HasNotificationLoadError,Converter={StaticResource Task.BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="{Binding NotificationLoadError}" TextWrapping="Wrap"/><Button Content="Повторить" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#717171" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Grid>
</UserControl>
